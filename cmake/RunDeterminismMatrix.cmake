# Resolve compiler identities before manifest traversal so a missing strict-mode
# toolchain fails cheaply instead of spending setup time first.
file(STRINGS "${BIN}/CMakeCache.txt" compiler_cache REGEX "^CMAKE_C_COMPILER(:[^=]+)?=")
file(STRINGS "${BIN}/CMakeCache.txt" generator_cache REGEX "^CMAKE_GENERATOR(:[^=]+)?=")
file(STRINGS "${BIN}/CMakeCache.txt" build_type_cache REGEX "^CMAKE_BUILD_TYPE(:[^=]+)?=")
file(STRINGS "${BIN}/CMakeCache.txt" c_flags_cache REGEX "^CMAKE_C_FLAGS(:[^=]+)?=")
foreach(cache_line IN ITEMS compiler_cache generator_cache build_type_cache)
  if("${${cache_line}}" STREQUAL "")
    message(FATAL_ERROR "determinism-matrix: configured-compiler-metadata-missing:${cache_line}")
  endif()
endforeach()
string(REGEX REPLACE "^[^=]*=" "" configured_compiler "${compiler_cache}")
string(REGEX REPLACE "^[^=]*=" "" generator "${generator_cache}")
string(REGEX REPLACE "^[^=]*=" "" build_type "${build_type_cache}")
string(REGEX REPLACE "^[^=]*=" "" global_c_flags "${c_flags_cache}")
string(TOUPPER "${build_type}" build_type_upper)
set(build_type_flags "")
if(NOT build_type_upper STREQUAL "")
  file(STRINGS "${BIN}/CMakeCache.txt" build_type_flags_cache
    REGEX "^CMAKE_C_FLAGS_${build_type_upper}(:[^=]+)?=")
  if(build_type_flags_cache)
    string(REGEX REPLACE "^[^=]*=" "" build_type_flags "${build_type_flags_cache}")
  endif()
endif()
file(GLOB compiler_identity_files "${BIN}/CMakeFiles/*/CMakeCCompiler.cmake")
list(LENGTH compiler_identity_files compiler_identity_count)
if(NOT compiler_identity_count EQUAL 1)
  message(FATAL_ERROR "determinism-matrix: configured-compiler-identity-missing")
endif()
list(GET compiler_identity_files 0 compiler_identity_file)
file(STRINGS "${compiler_identity_file}" compiler_id_lines
  REGEX "^set[(]CMAKE_C_COMPILER_ID ")
if(NOT compiler_id_lines MATCHES "^set[(]CMAKE_C_COMPILER_ID \"(GNU|Clang|AppleClang)\"[)]$")
  message(FATAL_ERROR "determinism-matrix: configured-compiler-identity-invalid")
endif()
set(configured_compiler_id "${CMAKE_MATCH_1}")
if(NOT configured_compiler_id MATCHES "^(GNU|Clang|AppleClang)$")
  message(FATAL_ERROR "determinism-matrix: unsupported-host-compiler:${configured_compiler_id}")
endif()
if(MODE STREQUAL "host")
  set(compiler_paths "${configured_compiler}")
  set(compiler_labels host)
else()
  execute_process(COMMAND uname -s RESULT_VARIABLE uname_result
    OUTPUT_VARIABLE system_name OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT uname_result STREQUAL "0" OR NOT system_name STREQUAL "Linux")
    find_program(gcc_alias NAMES gcc)
    set(gcc_alias_identity "unavailable")
    if(gcc_alias)
      execute_process(COMMAND "${gcc_alias}" --version
        RESULT_VARIABLE gcc_alias_rc OUTPUT_VARIABLE gcc_alias_output
        ERROR_VARIABLE gcc_alias_error)
      if(gcc_alias_output MATCHES "Apple clang")
        set(gcc_alias_identity "AppleClang alias")
      elseif(gcc_alias_output MATCHES "clang")
        set(gcc_alias_identity "Clang, not GNU")
      elseif(gcc_alias_rc STREQUAL "0")
        string(REGEX MATCH "[^\n]+" gcc_alias_first_line "${gcc_alias_output}")
        set(gcc_alias_identity "${gcc_alias_first_line}")
      endif()
    endif()
    message(FATAL_ERROR
      "determinism-matrix: two-compilers-requires-linux; configured=${configured_compiler_id} at ${configured_compiler}; gcc candidate=${gcc_alias} (${gcc_alias_identity}); this is not GNU GCC plus Clang evidence")
  endif()
  find_program(gnu_compiler NAMES gcc gcc-15 gcc-14 gcc-13)
  find_program(clang_compiler NAMES clang clang-21 clang-20 clang-19 clang-18)
  if(NOT gnu_compiler)
    message(FATAL_ERROR "determinism-matrix: required-gnu-gcc-missing")
  endif()
  if(NOT clang_compiler)
    message(FATAL_ERROR "determinism-matrix: required-clang-missing")
  endif()
  set(compiler_paths "${gnu_compiler}" "${clang_compiler}")
  set(compiler_labels gnu clang)
endif()

