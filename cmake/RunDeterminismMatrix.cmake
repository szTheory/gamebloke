if(EXISTS "${matrix_project_file}")
  file(READ "${matrix_project_file}" previous_matrix_project)
  if(NOT previous_matrix_project STREQUAL matrix_project_contents)
    message(FATAL_ERROR "determinism-matrix: persistent-project-mismatch")
  endif()
else()
  file(WRITE "${matrix_project_file}" "${matrix_project_contents}")
endif()

include("${SRC}/cmake/ReadLogoDigest.cmake")
gbl_read_logo_digest("${SRC}/tests/signatures/logo.sha256" logo_digest)
set(variant_csv "")
set(metadata "variant\trecord_file\trecord_sha256\tcompiler_id\tversion\tcompiler_path\tflags\tsetup_cache_state\tsetup_seconds\tconfigure_cache_state\tconfigure_seconds\tbuild_cache_state\tbuild_seconds\tguest_cache_state\tguest_observation_seconds\tcomparison_cold_seconds\tcomparison_warm_seconds\trows\n")
set(first_records "")
set(compare_count 0)
set(observation_count 0)
list(LENGTH compiler_paths compiler_count)
math(EXPR compiler_last "${compiler_count}-1")
foreach(compiler_index RANGE 0 ${compiler_last})
  list(GET compiler_paths ${compiler_index} compiler_path)
  list(GET compiler_labels ${compiler_index} compiler_label)
  set(compiler_build "${matrix_root}/variants/${MODE}-${compiler_label}")
  if(IS_SYMLINK "${compiler_build}")
    message(FATAL_ERROR "determinism-matrix: unsafe-compiler-build-root:${compiler_label}")
  endif()
  if(EXISTS "${compiler_build}/CMakeCache.txt")
    set(configure_cache_state warm)
  else()
    set(configure_cache_state cold)
  endif()
  set(configure_command "${CMAKE_COMMAND}" -S "${project_root}"
    -B "${compiler_build}" -G "${generator}"
    "-DCMAKE_C_COMPILER=${compiler_path}"
    "-DCMAKE_BUILD_TYPE=${build_type}"
    "-DCMAKE_C_FLAGS=${global_c_flags}"
    "-DCMAKE_C_FLAGS_${build_type_upper}=${build_type_flags}"
    "-DGBL_SRC=${SRC}"
    "-DGBL_CONTROL_INDEX=${BIN}/generated/control"
    "-DGBL_FIXTURE_DIR=${BIN}/generated/fixtures"
    "-DGBL_LOGO_DIGEST=${logo_digest}")
  timed(configure_seconds configure_output configure_rc ${configure_command})
  file(WRITE "${run_root}/${compiler_label}-configure.log" "${configure_output}")
  if(NOT configure_rc STREQUAL "0")
    message(FATAL_ERROR "determinism-matrix: ${compiler_label}-configure-failed:${configure_output}")
  endif()
  set(identity_path "${compiler_build}/identity.txt")
  if(NOT EXISTS "${identity_path}" OR IS_DIRECTORY "${identity_path}")
    message(FATAL_ERROR "determinism-matrix: ${compiler_label}-identity-missing")
  endif()
  file(STRINGS "${identity_path}" identity_line LIMIT_COUNT 1)
  if(NOT identity_line MATCHES "^([^|]+)[|]([^|]+)[|]([^|]+)$")
    message(FATAL_ERROR "determinism-matrix: ${compiler_label}-identity-invalid")
  endif()
  set(compiler_id "${CMAKE_MATCH_1}")
  set(compiler_version "${CMAKE_MATCH_2}")
  set(compiler_real_path "${CMAKE_MATCH_3}")
  if(MODE STREQUAL "host" AND NOT compiler_id STREQUAL configured_compiler_id)
    message(FATAL_ERROR "determinism-matrix: configured-host-identity-changed:${configured_compiler_id}:${compiler_id}")
  elseif(MODE STREQUAL "two-compilers" AND compiler_label STREQUAL "gnu" AND
         NOT compiler_id STREQUAL "GNU")
    message(FATAL_ERROR "determinism-matrix: gcc-identity-is-not-gnu:${compiler_id}:${compiler_real_path}")
  elseif(MODE STREQUAL "two-compilers" AND compiler_label STREQUAL "clang" AND
         NOT compiler_id STREQUAL "Clang")
    message(FATAL_ERROR "determinism-matrix: clang-identity-is-not-clang:${compiler_id}:${compiler_real_path}")
  endif()

  file(SHA256 "${matrix_project_file}" matrix_project_sha)
  set(build_signature_material "${MODE}|${compiler_label}|${compiler_id}|${compiler_version}|${compiler_real_path}|${logo_digest}|${build_type}|${global_c_flags}|${build_type_flags}|${generator}|-O0|-O2|C17|-Werror|${matrix_project_sha}")
  foreach(source IN ITEMS
      src/version.c src/machine.c src/audio.c src/bus.c src/loader.c
      src/cpu.c src/inspect.c
      runner/run.c runner/result.c runner/sha256.c tests/determinism_test.c)
    file(SHA256 "${SRC}/${source}" source_sha)
    string(APPEND build_signature_material "|${source}=${source_sha}")
  endforeach()
  file(GLOB_RECURSE matrix_headers
    "${SRC}/include/*.h" "${SRC}/runner/*.h" "${SRC}/src/*.h")
  list(SORT matrix_headers)
  foreach(header IN LISTS matrix_headers)
    file(SHA256 "${header}" header_sha)
    string(APPEND build_signature_material "|${header}=${header_sha}")
  endforeach()
  file(SHA256 "${BIN}/generated/control/fixture_index.h" control_index_sha)
  string(APPEND build_signature_material "|control-index=${control_index_sha}")
  string(SHA256 build_signature "${build_signature_material}")
  set(build_signature_file "${compiler_build}/matrix-build.signature")
  set(build_cache_state cold)
  if(EXISTS "${build_signature_file}" AND NOT IS_DIRECTORY "${build_signature_file}" AND
     NOT IS_SYMLINK "${build_signature_file}")
    file(READ "${build_signature_file}" previous_build_signature)
    if(previous_build_signature STREQUAL build_signature)
      set(build_cache_state warm)
    endif()
  endif()

  set(build_command "${CMAKE_COMMAND}" --build "${compiler_build}" --parallel 2)
  timed(build_seconds build_output build_rc ${build_command})
  file(WRITE "${run_root}/${compiler_label}-build.log" "${build_output}")
  if(NOT build_rc STREQUAL "0")
    message(FATAL_ERROR "determinism-matrix: ${compiler_label}-build-failed:${build_output}")
  endif()
  file(WRITE "${build_signature_file}" "${build_signature}")

  foreach(level IN ITEMS O0 O2)
    if(MODE STREQUAL "host")
      set(variant "host-${level}")
    else()
      set(variant "${compiler_label}-${level}")
    endif()
    set(executable "${compiler_build}/determinism_${level}")
    if(NOT EXISTS "${executable}" OR IS_DIRECTORY "${executable}")
      message(FATAL_ERROR "determinism-matrix: missing-variant:${variant}")
    endif()
    set(record_path "${run_root}/${variant}.records.tsv")
    timed(guest_wall guest_output guest_rc "${executable}" matrix
      "${corpus}" "${BIN}" "${record_path}")
    file(WRITE "${run_root}/${variant}-guest.log" "${guest_output}")
    if(NOT guest_rc STREQUAL "0" OR
       NOT guest_output MATCHES "HOST guest-observation-seconds=([0-9]+[.][0-9]+) rows=${selected_count}")
      message(FATAL_ERROR "determinism-matrix: ${variant}-observation-failed:${guest_output}")
    endif()
    set(guest_seconds "${CMAKE_MATCH_1}")
    if(observation_count EQUAL 0)
      set(guest_cache_state cold)
    else()
      set(guest_cache_state warm)
    endif()
    math(EXPR observation_count "${observation_count}+1")
    validate_record_set("${record_path}" "${variant}")
    file(SHA256 "${record_path}" records_sha256)
    set(compare_cold_seconds 0.0)
    set(compare_warm_seconds 0.0)
    if(first_records STREQUAL "")
      set(first_records "${record_path}")
    else()
      timed(compare_seconds compare_output compare_rc
        "${executable}" matrix-compare "${first_records}" "${record_path}"
        "${selected_count}")
      file(APPEND "${run_root}/comparison.log" "${compare_output}")
      if(NOT compare_rc STREQUAL "0")
        message(FATAL_ERROR "determinism-matrix: variant-records-differ:${variant}:${compare_output}")
      endif()
      if(compare_count EQUAL 0)
        set(compare_cold_seconds "${compare_seconds}")
        timed(compare_warm_seconds warm_compare_output warm_compare_rc
          "${executable}" matrix-compare "${first_records}" "${record_path}"
          "${selected_count}")
        file(APPEND "${run_root}/comparison.log" "${warm_compare_output}")
        if(NOT warm_compare_rc STREQUAL "0")
          message(FATAL_ERROR "determinism-matrix: warm-record-comparison-failed:${variant}:${warm_compare_output}")
        endif()
      else()
        set(compare_warm_seconds "${compare_seconds}")
      endif()
      math(EXPR compare_count "${compare_count}+1")
    endif()
    list(APPEND variant_csv "${variant}")
    string(APPEND metadata
      "${variant}\t${variant}.records.tsv\t${records_sha256}\t${compiler_id}\t${compiler_version}\t${compiler_real_path}\t${global_c_flags} ${build_type_flags};-C17,-${level},-fno-stack-protector,-U_FORTIFY_SOURCE,-Wall,-Wextra,-Wpedantic,-Wconversion,-Wshadow,-Wstrict-prototypes,-Wmissing-prototypes,-Wundef,-Wcast-qual,-Werror\t${setup_cache_state}\t${setup_seconds}\t${configure_cache_state}\t${configure_seconds}\t${build_cache_state}\t${build_seconds}\t${guest_cache_state}\t${guest_seconds}\t${compare_cold_seconds}\t${compare_warm_seconds}\t${selected_count}\n")
  endforeach()
endforeach()

if(MODE STREQUAL "host")
  set(expected_variants "host-O0,host-O2")
  set(coverage_label host-only)
else()
  set(expected_variants "gnu-O0,gnu-O2,clang-O0,clang-O2")
  set(coverage_label genuine-gnu-and-clang)
endif()
string(REPLACE ";" "," actual_variants "${variant_csv}")
set(helper_executable "${BIN}/determinism_test")
if(NOT EXISTS "${helper_executable}" OR IS_DIRECTORY "${helper_executable}")
  message(FATAL_ERROR "determinism-matrix: matrix-control-helper-missing")
endif()
execute_process(COMMAND "${helper_executable}" matrix-variants
    "${expected_variants}" "${actual_variants}"
  RESULT_VARIABLE variants_rc OUTPUT_VARIABLE variants_output
  ERROR_VARIABLE variants_error)
if(NOT variants_rc STREQUAL "0")
  message(FATAL_ERROR "determinism-matrix: incomplete-variant-set:${variants_output}${variants_error}")
endif()
math(EXPR expected_compare_count "${compiler_count}*2-1")
if(NOT compare_count EQUAL expected_compare_count)
  message(FATAL_ERROR "determinism-matrix: incomplete-comparison-set:${compare_count}:${expected_compare_count}")
endif()

file(WRITE "${run_root}/matrix-metadata.tsv" "${metadata}")
file(WRITE "${run_root}/coverage.txt"
  "mode=${MODE}\ngroup=${GROUP}\nselected_rows=${selected_count}\nvariants=${actual_variants}\ncompiler_coverage=${coverage_label}\nsource_commit=${source_commit}\nsetup_cache_state=${setup_cache_state}\nsetup_seconds=${setup_seconds}\n")
if(IS_SYMLINK "${setup_marker}")
  message(FATAL_ERROR "determinism-matrix: setup-signature-symlink")
endif()
file(WRITE "${setup_marker}" "${setup_signature_sha}")
message(STATUS
  "PASS diagnostics.determinism: ${selected_count} admitted ${GROUP} rows; variants=${actual_variants}; coverage=${coverage_label}; setup=${setup_cache_state}/${setup_seconds}s (1s clock); records exactly equal")
message(STATUS "determinism-matrix: compiler/setup/build/guest/comparison timings are in ${run_root}/matrix-metadata.tsv")
message(STATUS "determinism-matrix: build logs and per-variant records are retained under ${run_root}")
