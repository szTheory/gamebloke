cmake_minimum_required(VERSION 3.25)

foreach(required IN ITEMS SRC BIN MODE GROUP)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "determinism-matrix: missing-${required}")
  endif()
endforeach()
if(NOT MODE MATCHES "^(host|two-compilers)$")
  message(FATAL_ERROR "determinism-matrix: invalid-mode:${MODE}")
endif()

function(timed seconds_out output_out result_out)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E time ${ARGN}
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  set(combined "${output}${error}")
  if(NOT combined MATCHES "Elapsed time [(]seconds[)]: ([0-9]+[.][0-9]+)")
    if(NOT rc STREQUAL "0")
      set(${seconds_out} "unknown" PARENT_SCOPE)
      set(${output_out} "${combined}" PARENT_SCOPE)
      set(${result_out} "${rc}" PARENT_SCOPE)
      return()
    endif()
    message(FATAL_ERROR "determinism-matrix: timing-output-missing:${combined}")
  endif()
  set(${seconds_out} "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${output_out} "${combined}" PARENT_SCOPE)
  set(${result_out} "${rc}" PARENT_SCOPE)
endfunction()
if(NOT GROUP MATCHES "^(all|arm|thumb)$")
  message(FATAL_ERROR "determinism-matrix: invalid-group:${GROUP}")
endif()

get_filename_component(SRC "${SRC}" ABSOLUTE)
get_filename_component(BIN "${BIN}" ABSOLUTE)
if(IS_SYMLINK "${SRC}" OR IS_SYMLINK "${BIN}")
  message(FATAL_ERROR "determinism-matrix: symlink-root")
endif()
set(build_root "${SRC}/build")
cmake_path(IS_PREFIX build_root "${BIN}" NORMALIZE bin_under_build)
if(NOT bin_under_build OR BIN STREQUAL build_root OR
   NOT EXISTS "${BIN}/CMakeCache.txt" OR IS_DIRECTORY "${BIN}/CMakeCache.txt")
  message(FATAL_ERROR "determinism-matrix: unsafe-or-unconfigured-binary-root")
endif()

string(TIMESTAMP setup_started "%s" UTC)
include("${SRC}/cmake/CheckResult.cmake")
include("${SRC}/cmake/DiagnosticMatrix.cmake")
include("${SRC}/cmake/CheckDiagnosticAuthority.cmake")
include("${SRC}/tests/gates/diagnostic_result_authority.cmake")
gbl_diagnostic_matrix("${SRC}" "${GROUP}")
gbl_diagnostic_result_authority("${SRC}")
gbl_findings_finish(result "determinism matrix authority valid")

file(STRINGS "${BIN}/diagnostics-results/all-admitted/summary.txt" source_lines
  REGEX "^(source[.]commit|outputs)=")
set(source_commit "")
set(admitted_outputs "")
foreach(line IN LISTS source_lines)
  if(line MATCHES "^source[.]commit=([0-9a-f]+)$")
    set(source_commit "${CMAKE_MATCH_1}")
  elseif(line MATCHES "^outputs=([0-9]+)$")
    set(admitted_outputs "${CMAKE_MATCH_1}")
  endif()
endforeach()
string(LENGTH "${source_commit}" source_commit_length)
if(NOT source_commit_length EQUAL 40 OR
   NOT source_commit MATCHES "^[0-9a-f]+$" OR admitted_outputs STREQUAL "")
  message(FATAL_ERROR "determinism-matrix: admitted-summary-invalid")
endif()
gbl_check_diagnostic_authority("${SRC}" "${source_commit}")

set(selected_ids "${GBL_DIAG_OUTPUTS}")
list(SORT selected_ids)
list(REMOVE_DUPLICATES selected_ids)
list(LENGTH selected_ids selected_count)
if(selected_count EQUAL 0 OR NOT admitted_outputs EQUAL selected_count)
  message(FATAL_ERROR
    "determinism-matrix: admitted-selection-count-mismatch:${admitted_outputs}:${selected_count}")
endif()

# Independently derive the owned set from canonical manifest artifact paths;
# this makes a narrowed diagnostic source matrix fail closed.
set(manifest_owned_ids "")
foreach(fid IN LISTS M_IDS)
  if(NOT M_ROW_${fid}_CLASS STREQUAL "project-authored" OR
     NOT M_ROW_${fid}_ARTIFACT_OK)
    continue()
  endif()
  set(path "${M_ROW_${fid}_ARTIFACT_PATH}")
  set(include_row FALSE)
  if(GROUP STREQUAL "all")
    if(path MATCHES "^generated/diagnostics/armv4t/(arm|thumb)/" OR
       path MATCHES "^generated/diagnostics/armv4t/roms/")
      set(include_row TRUE)
    endif()
  elseif(GROUP STREQUAL "arm")
    if(path MATCHES "^generated/diagnostics/armv4t/arm/" OR
       path MATCHES "^generated/diagnostics/armv4t/roms/")
      set(include_row TRUE)
    endif()
  elseif(path MATCHES "^generated/diagnostics/armv4t/thumb/")
    set(include_row TRUE)
  endif()
  if(include_row)
    list(APPEND manifest_owned_ids "${fid}")
  endif()
endforeach()
list(SORT manifest_owned_ids)
list(REMOVE_DUPLICATES manifest_owned_ids)
if(NOT "${selected_ids}" STREQUAL "${manifest_owned_ids}")
  message(FATAL_ERROR "determinism-matrix: diagnostic-manifest-selection-mismatch")
endif()

set(admitted_root "${BIN}/diagnostics-results/all-admitted")
set(corpus_rows "")
foreach(fid IN LISTS selected_ids)
  if(NOT M_ROW_${fid}_CLASS STREQUAL "project-authored" OR
     NOT M_ROW_${fid}_ARTIFACT_OK OR NOT M_ROW_${fid}_COMMIT STREQUAL source_commit)
    message(FATAL_ERROR "determinism-matrix: fixture-authority-mismatch:${fid}")
  endif()
  set(artifact "${BIN}/${M_ROW_${fid}_ARTIFACT_PATH}")
  if(NOT EXISTS "${artifact}" OR IS_DIRECTORY "${artifact}" OR
     IS_SYMLINK "${artifact}")
    message(FATAL_ERROR "determinism-matrix: artifact-missing:${fid}")
  endif()
  file(SHA256 "${artifact}" artifact_digest)
  if(NOT artifact_digest STREQUAL M_ROW_${fid}_ARTIFACT_SHA256 OR
     NOT artifact_digest STREQUAL M_ROW_${fid}_SHA256)
    message(FATAL_ERROR "determinism-matrix: artifact-digest-mismatch:${fid}")
  endif()

  set(expected_status PASS)
  set(expected_reason guest-mailbox-pass)
  set(expected_semantic pass)
  if(fid MATCHES "^(arm|thumb)-stop-([0-9]+)$")
    set(case_id "${CMAKE_MATCH_2}")
    set(expected_status GUEST_STOP)
    set(expected_semantic pending)
    string(JSON expected_reason GET "${GBL_DIAG_ROW_${fid}}" source_test expected_reason)
  elseif(fid MATCHES "^(arm|thumb)-([0-9]+)-broken$")
    set(case_id "${CMAKE_MATCH_2}")
    set(expected_status GUEST_FAIL)
    set(expected_reason guest-mailbox-fail)
    set(expected_semantic fail)
  elseif(fid MATCHES "^(arm|thumb)-([0-9]+)$")
    set(case_id "${CMAKE_MATCH_2}")
  elseif(fid MATCHES "^smoke(-broken)?$")
    set(case_id 20481)
    if(fid MATCHES "-broken$")
      set(expected_status GUEST_FAIL)
      set(expected_reason guest-mailbox-fail)
      set(expected_semantic fail)
    endif()
  else()
    message(FATAL_ERROR "determinism-matrix: invalid-owned-fixture-id:${fid}")
  endif()

  set(result_path "${admitted_root}/${fid}.json")
  if(NOT EXISTS "${result_path}" OR IS_DIRECTORY "${result_path}" OR
     IS_SYMLINK "${result_path}")
    message(FATAL_ERROR "determinism-matrix: admitted-result-missing:${fid}")
  endif()
  file(READ "${result_path}" result_doc)
  set_property(GLOBAL PROPERTY GBL_FINDINGS 0)
  gbl_result_check("${result_path}" M R V)
  gbl_findings_finish(result "admitted result valid:${fid}")
  foreach(field IN ITEMS status reason)
    string(JSON actual_${field} ERROR_VARIABLE error_${field} GET "${result_doc}" ${field})
    if(NOT "${error_${field}}" STREQUAL "NOTFOUND")
      message(FATAL_ERROR "determinism-matrix: admitted-result-invalid:${fid}:${field}")
    endif()
  endforeach()
  string(JSON actual_semantic ERROR_VARIABLE semantic_error GET "${result_doc}" semantic state)
  string(JSON actual_case ERROR_VARIABLE case_error GET "${result_doc}" semantic case_id)
  string(JSON cycles ERROR_VARIABLE cycles_error GET "${result_doc}" time cycles)
  string(JSON instructions ERROR_VARIABLE instructions_error GET "${result_doc}" time instructions)
  foreach(error IN ITEMS semantic_error case_error cycles_error instructions_error)
    if(NOT "${${error}}" STREQUAL "NOTFOUND")
      message(FATAL_ERROR "determinism-matrix: admitted-result-invalid:${fid}:${error}")
    endif()
  endforeach()
  if(NOT actual_status STREQUAL expected_status OR
     NOT actual_reason STREQUAL expected_reason OR
     NOT actual_semantic STREQUAL expected_semantic OR
     NOT actual_case EQUAL case_id OR cycles LESS 1 OR instructions LESS 1 OR
     cycles GREATER 1000)
    message(FATAL_ERROR "determinism-matrix: admitted-expectation-mismatch:${fid}")
  endif()

  if(fid MATCHES "^(arm|thumb)-")
    if(fid MATCHES "^arm-")
      set(producer arm)
    else()
      set(producer thumb)
    endif()
    set(relative_path "generated/diagnostics/armv4t/${producer}/roms/${fid}.gba")
  else()
    set(relative_path "generated/diagnostics/armv4t/roms/${fid}.gba")
    set(producer smoke)
  endif()
  string(APPEND corpus_rows
    "${fid}\t${relative_path}\t${producer}\t${artifact_digest}\t${expected_status}\t${expected_reason}\t${expected_semantic}\t${case_id}\t${cycles}\t${instructions}\n")
endforeach()
string(TIMESTAMP setup_finished "%s" UTC)
math(EXPR setup_seconds "${setup_finished}-${setup_started}")

set(matrix_root "${BIN}/determinism-matrix")
file(MAKE_DIRECTORY "${matrix_root}")
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef run_id)
set(run_root "${matrix_root}/${run_id}")
if(EXISTS "${run_root}")
  message(FATAL_ERROR "determinism-matrix: scratch-collision")
endif()
file(MAKE_DIRECTORY "${run_root}")
set(corpus "${run_root}/corpus.tsv")
file(WRITE "${corpus}" "gamebloke.determinism-corpus/1\t${selected_count}\n${corpus_rows}")

file(STRINGS "${BIN}/CMakeCache.txt" compiler_cache REGEX "^CMAKE_C_COMPILER(:[^=]+)?=")
file(STRINGS "${BIN}/CMakeCache.txt" compiler_id_cache REGEX "^CMAKE_C_COMPILER_ID(:[^=]+)?=")
foreach(cache_line IN ITEMS compiler_cache compiler_id_cache)
  if("${${cache_line}}" STREQUAL "")
    message(FATAL_ERROR "determinism-matrix: configured-compiler-metadata-missing:${cache_line}")
  endif()
endforeach()
string(REGEX REPLACE "^[^=]*=" "" configured_compiler "${compiler_cache}")
string(REGEX REPLACE "^[^=]*=" "" configured_compiler_id "${compiler_id_cache}")
set(helper_executable "${BIN}/determinism_test")
if(NOT MODE STREQUAL "host")
  message(FATAL_ERROR "determinism-matrix: two-compilers-mode-requires-variant-build-support")
endif()
if(NOT EXISTS "${helper_executable}" OR IS_DIRECTORY "${helper_executable}")
  message(FATAL_ERROR "determinism-matrix: matrix-control-helper-missing")
endif()
set(record_path "${run_root}/host.records.tsv")
timed(guest_wall guest_output guest_rc "${helper_executable}" matrix
  "${corpus}" "${BIN}" "${record_path}")
if(NOT guest_rc STREQUAL "0" OR NOT EXISTS "${record_path}" OR
   NOT guest_output MATCHES "HOST guest-observation-seconds=([0-9]+[.][0-9]+) rows=${selected_count}")
  message(FATAL_ERROR "determinism-matrix: host-observation-failed:${guest_output}")
endif()
set(guest_seconds "${CMAKE_MATCH_1}")
file(STRINGS "${record_path}" record_lines)
list(LENGTH record_lines record_line_count)
math(EXPR expected_lines "${selected_count}+1")
list(GET record_lines 0 record_header)
if(NOT record_line_count EQUAL expected_lines OR
   NOT record_header STREQUAL "gamebloke.determinism-records/1")
  message(FATAL_ERROR "determinism-matrix: incomplete-record-set:host")
endif()
list(REMOVE_AT record_lines 0)
set(row_index 0)
foreach(line IN LISTS record_lines)
  string(FIND "${line}" "\t" first_tab)
  if(first_tab LESS 1)
    message(FATAL_ERROR "determinism-matrix: malformed-record:host")
  endif()
  string(SUBSTRING "${line}" 0 ${first_tab} recorded_id)
  list(GET selected_ids ${row_index} expected_id)
  if(NOT recorded_id STREQUAL expected_id)
    message(FATAL_ERROR "determinism-matrix: fixture-record-set-mismatch:host:${expected_id}:${recorded_id}")
  endif()
  math(EXPR row_index "${row_index}+1")
endforeach()
file(WRITE "${run_root}/matrix-metadata.tsv"
  "variant\tcompiler_id\tcompiler_path\tflags\tsetup_seconds\tguest_observation_seconds\trows\n"
  "host\t${configured_compiler_id}\t${configured_compiler}\tconfigured-default\t${setup_seconds}\t${guest_seconds}\t${selected_count}\n")
file(WRITE "${run_root}/coverage.txt"
  "mode=host\ngroup=${GROUP}\nselected_rows=${selected_count}\ncompiler_coverage=host-only\nsource_commit=${source_commit}\n")
message(STATUS
  "determinism-matrix: ${selected_count} admitted ${GROUP} rows observed; compiler=${configured_compiler_id}; host-only; setup=${setup_seconds}s (1s clock), guest=${guest_seconds}s; records=${run_root}/host.records.tsv")
message(STATUS "determinism-matrix: metadata=${run_root}/matrix-metadata.tsv")
