function(timed seconds_out output_out result_out)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E time ${ARGN}
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  set(combined "${output}${error}")
  if(NOT combined MATCHES "Elapsed time [(]seconds[)]: ([0-9]+[.][0-9]+)")
    if(NOT rc STREQUAL "0")
      set(${seconds_out} "unknown" PARENT_SCOPE)
      set(${output_out} "${combined}" PARENT_SCOPE)
      set(${result_out} "${rc}" PARENT_SCOPE)
      return()
    endif()
    message(FATAL_ERROR "determinism-matrix: timing-output-missing:${combined}")
  endif()
  set(${seconds_out} "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${output_out} "${combined}" PARENT_SCOPE)
  set(${result_out} "${rc}" PARENT_SCOPE)
endfunction()

function(receipt_field out receipt key owner)
  string(JSON value ERROR_VARIABLE error GET "${receipt}" "${key}")
  if(NOT "${error}" STREQUAL "NOTFOUND")
    message(FATAL_ERROR "determinism-matrix: receipt-field-invalid:${owner}:${key}:${error}")
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(validate_record_set path variant)
  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
    message(FATAL_ERROR "determinism-matrix: missing-record-artifact:${variant}")
  endif()
  file(STRINGS "${path}" record_lines)
  list(LENGTH record_lines record_line_count)
  math(EXPR expected_lines "${selected_count}+1")
  if(NOT record_line_count EQUAL expected_lines)
    message(FATAL_ERROR "determinism-matrix: incomplete-record-set:${variant}")
  endif()
  list(GET record_lines 0 record_header)
  if(NOT record_header STREQUAL "gamebloke.determinism-records/1")
    message(FATAL_ERROR "determinism-matrix: invalid-record-header:${variant}")
  endif()
  list(REMOVE_AT record_lines 0)
  set(row_index 0)
  foreach(line IN LISTS record_lines)
    string(FIND "${line}" "\t" first_tab)
    if(first_tab LESS 1)
      message(FATAL_ERROR "determinism-matrix: malformed-record:${variant}")
    endif()
    string(SUBSTRING "${line}" 0 ${first_tab} recorded_id)
    list(GET selected_ids ${row_index} expected_id)
    if(NOT recorded_id STREQUAL expected_id)
      message(FATAL_ERROR "determinism-matrix: fixture-record-set-mismatch:${variant}:${expected_id}:${recorded_id}")
    endif()
    math(EXPR row_index "${row_index}+1")
  endforeach()
endfunction()
