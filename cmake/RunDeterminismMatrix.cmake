set(admitted_root "${BIN}/diagnostics-results/all-admitted")
set(corpus_rows "")
foreach(fid IN LISTS selected_ids)
  if(NOT M_ROW_${fid}_CLASS STREQUAL "project-authored" OR
     NOT M_ROW_${fid}_ARTIFACT_OK OR NOT M_ROW_${fid}_COMMIT STREQUAL source_commit)
    message(FATAL_ERROR "determinism-matrix: fixture-authority-mismatch:${fid}")
  endif()
  set(artifact "${BIN}/${M_ROW_${fid}_ARTIFACT_PATH}")
  if(NOT EXISTS "${artifact}" OR IS_DIRECTORY "${artifact}" OR
     IS_SYMLINK "${artifact}")
    message(FATAL_ERROR "determinism-matrix: artifact-missing:${fid}")
  endif()
  file(SHA256 "${artifact}" artifact_digest)
  if(NOT artifact_digest STREQUAL M_ROW_${fid}_ARTIFACT_SHA256 OR
     NOT artifact_digest STREQUAL M_ROW_${fid}_SHA256)
    message(FATAL_ERROR "determinism-matrix: artifact-digest-mismatch:${fid}")
  endif()

  set(expected_status PASS)
  set(expected_reason guest-mailbox-pass)
  set(expected_termination mailbox-complete)
  set(expected_semantic pass)
  if(fid MATCHES "^(arm|thumb)-stop-([0-9]+)$")
    set(case_id "${CMAKE_MATCH_2}")
    set(expected_status GUEST_STOP)
    set(expected_semantic pending)
    string(JSON expected_reason GET "${GBL_DIAG_ROW_${fid}}" source_test expected_reason)
    set(expected_termination "${expected_reason}")
  elseif(fid MATCHES "^(arm|thumb)-([0-9]+)-broken$")
    set(case_id "${CMAKE_MATCH_2}")
    set(expected_status GUEST_FAIL)
    set(expected_reason guest-mailbox-fail)
    set(expected_semantic fail)
  elseif(fid MATCHES "^(arm|thumb)-([0-9]+)$")
    set(case_id "${CMAKE_MATCH_2}")
  elseif(fid MATCHES "^smoke(-broken)?$")
    set(case_id 20481)
    if(fid MATCHES "-broken$")
      set(expected_status GUEST_FAIL)
      set(expected_reason guest-mailbox-fail)
      set(expected_semantic fail)
    endif()
  else()
    message(FATAL_ERROR "determinism-matrix: invalid-owned-fixture-id:${fid}")
  endif()

  set(result_path "${admitted_root}/${fid}.json")
  if(NOT EXISTS "${result_path}" OR IS_DIRECTORY "${result_path}" OR
     IS_SYMLINK "${result_path}")
    message(FATAL_ERROR "determinism-matrix: admitted-result-missing:${fid}")
  endif()
  set(receipt_path "${receipt_root}/${fid}.json")
  if(NOT EXISTS "${receipt_path}" OR IS_DIRECTORY "${receipt_path}" OR
     IS_SYMLINK "${receipt_path}")
    message(FATAL_ERROR "determinism-matrix: admitted-case-receipt-missing:${fid}")
  endif()
  file(READ "${receipt_path}" fixture_receipt)
  foreach(key IN ITEMS token stage group reviewed_head source_commit)
    receipt_field("fixture_${key}" "${fixture_receipt}" "${key}" "${fid}")
    if(NOT fixture_${key} STREQUAL run_${key})
      message(FATAL_ERROR "determinism-matrix: admitted-case-receipt-identity-mismatch:${fid}:${key}")
    endif()
  endforeach()
  receipt_field(receipt_fixture_id "${fixture_receipt}" fixture_id "${fid}")
  receipt_field(receipt_result_path "${fixture_receipt}" result_path "${fid}")
  receipt_field(receipt_result_sha "${fixture_receipt}" result_sha256 "${fid}")
  receipt_field(receipt_status "${fixture_receipt}" status "${fid}")
  receipt_field(receipt_reason "${fixture_receipt}" reason "${fid}")
  receipt_field(receipt_termination "${fixture_receipt}" termination "${fid}")
  receipt_field(receipt_state "${fixture_receipt}" semantic_state "${fid}")
  receipt_field(receipt_case_id "${fixture_receipt}" semantic_case_id "${fid}")
  file(SHA256 "${result_path}" current_result_sha)
  if(NOT receipt_fixture_id STREQUAL fid OR
     NOT receipt_result_path STREQUAL result_path OR
     NOT receipt_result_sha STREQUAL current_result_sha OR
     NOT receipt_status STREQUAL expected_status OR
     NOT receipt_reason STREQUAL expected_reason OR
     NOT receipt_termination STREQUAL expected_termination OR
     NOT receipt_state STREQUAL expected_semantic OR
     NOT receipt_case_id STREQUAL case_id)
    message(FATAL_ERROR "determinism-matrix: admitted-case-receipt-mismatch:${fid}")
  endif()
  file(READ "${result_path}" result_doc)
  foreach(field IN ITEMS status reason)
    string(JSON actual_${field} ERROR_VARIABLE error_${field} GET "${result_doc}" ${field})
    if(NOT "${error_${field}}" STREQUAL "NOTFOUND")
      message(FATAL_ERROR "determinism-matrix: admitted-result-invalid:${fid}:${field}")
    endif()
  endforeach()
  string(JSON actual_semantic ERROR_VARIABLE semantic_error GET "${result_doc}" semantic state)
  string(JSON actual_case ERROR_VARIABLE case_error GET "${result_doc}" semantic case_id)
  string(JSON cycles ERROR_VARIABLE cycles_error GET "${result_doc}" time cycles)
  string(JSON budget_cycles ERROR_VARIABLE budget_error GET "${result_doc}" time budget_cycles)
  string(JSON instructions ERROR_VARIABLE instructions_error GET "${result_doc}" time instructions)
  foreach(error IN ITEMS semantic_error case_error cycles_error budget_error instructions_error)
    if(NOT "${${error}}" STREQUAL "NOTFOUND")
      message(FATAL_ERROR "determinism-matrix: admitted-result-invalid:${fid}:${error}")
    endif()
  endforeach()
  if(NOT actual_status STREQUAL expected_status OR
     NOT actual_reason STREQUAL expected_reason OR
     NOT actual_semantic STREQUAL expected_semantic OR
     NOT actual_case EQUAL case_id OR cycles LESS 1 OR instructions LESS 1 OR
     cycles GREATER budget_cycles)
    message(FATAL_ERROR "determinism-matrix: admitted-expectation-mismatch:${fid}")
  endif()
  if(cycles GREATER 3000)
    message(FATAL_ERROR "determinism-matrix: admitted-cycle-count-exceeds-matrix-budget:${fid}:${cycles}")
  endif()

  if(fid MATCHES "^(arm|thumb)-")
    if(fid MATCHES "^arm-")
      set(producer arm)
    else()
      set(producer thumb)
    endif()
    set(relative_path "generated/diagnostics/armv4t/${producer}/roms/${fid}.gba")
  else()
    set(relative_path "generated/diagnostics/armv4t/roms/${fid}.gba")
    set(producer smoke)
  endif()
  string(APPEND corpus_rows
    "${fid}\t${relative_path}\t${producer}\t${artifact_digest}\t${expected_status}\t${expected_reason}\t${expected_semantic}\t${case_id}\t${cycles}\t${instructions}\n")
endforeach()
