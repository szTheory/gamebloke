# Independently derive the owned set from canonical manifest artifact paths;
# this makes a narrowed diagnostic source matrix fail closed.
set(manifest_owned_ids "")
foreach(fid IN LISTS M_IDS)
  if(NOT M_ROW_${fid}_CLASS STREQUAL "project-authored" OR
     NOT M_ROW_${fid}_ARTIFACT_OK)
    continue()
  endif()
  set(path "${M_ROW_${fid}_ARTIFACT_PATH}")
  set(include_row FALSE)
  if(GROUP STREQUAL "all")
    if(path MATCHES "^generated/diagnostics/armv4t/(arm|thumb)/" OR
       path MATCHES "^generated/diagnostics/armv4t/roms/")
      set(include_row TRUE)
    endif()
  elseif(GROUP STREQUAL "arm")
    if(path MATCHES "^generated/diagnostics/armv4t/arm/" OR
       path MATCHES "^generated/diagnostics/armv4t/roms/")
      set(include_row TRUE)
    endif()
  elseif(path MATCHES "^generated/diagnostics/armv4t/thumb/")
    set(include_row TRUE)
  endif()
  if(include_row)
    list(APPEND manifest_owned_ids "${fid}")
  endif()
endforeach()
list(SORT manifest_owned_ids)
list(REMOVE_DUPLICATES manifest_owned_ids)
