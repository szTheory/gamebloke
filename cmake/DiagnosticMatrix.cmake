include_guard(GLOBAL)

# Parse each ledger object once. The resulting lists are shared by registration
# and execution; no consumer reparses the full manifest once per output.
function(gbl_diagnostic_matrix source group)
  file(READ "${source}/diagnostics/armv4t/cases.json" matrix)
  string(JSON cases GET "${matrix}" cases)
  string(JSON count LENGTH "${cases}")
  math(EXPR last "${count}-1")
  set(outputs "")
  set(apis "")
  set(selectors "")
  foreach(index RANGE 0 ${last})
    string(JSON row GET "${cases}" ${index})
    string(JSON id GET "${row}" id)
    string(JSON isa GET "${row}" isa)
    string(JSON kind GET "${row}" source_test kind)
    if(kind STREQUAL "cpu-api")
      # API-only boundaries are ARM-owned in the hosted split.
      if(group STREQUAL "thumb")
        continue()
      endif()
      list(APPEND apis "${id}")
      set(GBL_DIAG_API_${id} "${row}" PARENT_SCOPE)
      string(JSON evidence GET "${row}" native_evidence)
      string(JSON native_count LENGTH "${evidence}")
      math(EXPR native_last "${native_count}-1")
      foreach(native_index RANGE 0 ${native_last})
        string(JSON selector GET "${evidence}" ${native_index} selector)
        list(APPEND selectors "${selector}")
      endforeach()
      continue()
    endif()
    if(kind STREQUAL "registered-smoke-pair")
      if(group STREQUAL "thumb")
        continue()
      endif()
      set(names smoke smoke-broken)
      set(producer smoke)
    else()
      if(NOT group STREQUAL "all" AND NOT isa STREQUAL group)
        continue()
      endif()
      set(producer "${isa}")
      if(kind STREQUAL "semantic")
        set(names "${isa}-${id}" "${isa}-${id}-broken")
      elseif(kind STREQUAL "guest-stop")
        set(names "${isa}-stop-${id}")
      else()
        message(FATAL_ERROR "diagnostics: unknown-source-kind:${id}")
      endif()
    endif()
    foreach(fid IN LISTS names)
      list(APPEND outputs "${fid}")
      set(GBL_DIAG_ROW_${fid} "${row}" PARENT_SCOPE)
      set(GBL_DIAG_GROUP_${fid} "${producer}" PARENT_SCOPE)
    endforeach()
  endforeach()
  list(SORT outputs)
  list(SORT apis)
  list(REMOVE_DUPLICATES selectors)
  list(SORT selectors)
  set(GBL_DIAG_OUTPUTS "${outputs}" PARENT_SCOPE)
  set(GBL_DIAG_APIS "${apis}" PARENT_SCOPE)
  set(GBL_DIAG_SELECTORS "${selectors}" PARENT_SCOPE)
endfunction()

function(gbl_diagnostic_input_digest source out)
  file(STRINGS "${source}/diagnostics/armv4t/inputs.txt" paths)
  set(material "")
  foreach(path IN LISTS paths)
    if(path STREQUAL "" OR path MATCHES "^#")
      continue()
    endif()
    if(NOT path MATCHES "^[A-Za-z0-9._/-]+$" OR path MATCHES "(^|/)\\.\\.?(/|$)" OR
       IS_SYMLINK "${source}/${path}" OR NOT EXISTS "${source}/${path}" OR
       IS_DIRECTORY "${source}/${path}")
      message(FATAL_ERROR "diagnostics: invalid-producer-input:${path}")
    endif()
    file(SHA256 "${source}/${path}" sha)
    string(APPEND material "${path}=${sha}\n")
  endforeach()
  string(SHA256 digest "${material}")
  set(${out} "${digest}" PARENT_SCOPE)
endfunction()

function(gbl_diagnostic_tool source root host required out)
  set(install "${root}/arm-none-eabi/${host}-15.2.1-1.1")
  if(NOT EXISTS "${install}" AND NOT IS_SYMLINK "${install}")
    if(required)
      message(FATAL_ERROR "diagnostics: required-arm-toolchain-absent")
    endif()
    set(${out} absent PARENT_SCOPE)
    return()
  endif()
  execute_process(COMMAND sh "${source}/scripts/fetch-toolchain.sh" --check
    --host "${host}" --root "${root}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "diagnostics: arm-toolchain-unusable:${output}${error}")
  endif()
  set(${out} available PARENT_SCOPE)
endfunction()
