cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/CiJobBudgets.cmake")

# Explicit per-preset fields keep cached or inherited proof settings from
# silently becoming the final required path. Developer proof uses an override.
function(gbl_ci_admission_presets presets_file)
  gbl_json_load(presets "${presets_file}")
  string(JSON count LENGTH "${presets}" configurePresets)
  math(EXPR last "${count} - 1")
  set(seen "")
  foreach(i RANGE 0 ${last})
    string(JSON name GET "${presets}" configurePresets ${i} name)
    if(name MATCHES "^(ci|asan|diagnostics|diagnostics-arm|diagnostics-thumb)$")
      string(JSON stage ERROR_VARIABLE error GET "${presets}" configurePresets ${i}
        cacheVariables GBL_DIAGNOSTIC_STAGE)
      if(NOT error STREQUAL "NOTFOUND" OR NOT stage STREQUAL "admitted" OR name IN_LIST seen)
        message(FATAL_ERROR "ci-preflight: preset-admission-required:${name}")
      endif()
      list(APPEND seen "${name}")
    endif()
  endforeach()
  list(SORT seen)
  if(NOT seen STREQUAL "asan;ci;diagnostics;diagnostics-arm;diagnostics-thumb")
    message(FATAL_ERROR "ci-preflight: admitted-preset-set-mismatch")
  endif()
endfunction()

# Deliberately limited parser for this committed workflow's known layout. Fail
# closed on extra rows/fields, renamed jobs and changes to the timeout mapping.
function(gbl_ci_workflow source workflow)
  gbl_ci_policy("${source}")
  file(STRINGS "${workflow}" lines)
  set(jobs "")
  set(rows "")
  set(job "")
  set(row "")
  foreach(line IN LISTS lines)
    if(line STREQUAL "jobs:")
      set(in_jobs TRUE)
    endif()
    if(NOT in_jobs)
      continue()
    endif()
    if(line MATCHES "^  ([a-z][a-z-]*):$")
      if(row)
        list(APPEND rows "${job}|${row}")
        set(row "")
      endif()
      set(job "${CMAKE_MATCH_1}")
      list(APPEND jobs "${job}")
    elseif(line MATCHES "^          - runner: (.+)$")
      if(row)
        list(APPEND rows "${job}|${row}")
      endif()
      set(row "runner=${CMAKE_MATCH_1}")
    elseif(line MATCHES "^            ([a-z]+): (.+)$")
      string(APPEND row ",${CMAKE_MATCH_1}=${CMAKE_MATCH_2}")
    elseif(line MATCHES "^    timeout-minutes: ([^#]+)")
      string(STRIP "${CMAKE_MATCH_1}" timeout_${job})
    elseif(line MATCHES "^    name: (.+)$")
      set(name_${job} "${CMAKE_MATCH_1}")
    elseif(line MATCHES "^    runs-on: (.+)$")
      set(runner_${job} "${CMAKE_MATCH_1}")
    elseif(job STREQUAL "diagnostics" AND line MATCHES "^      GBL_PRODUCER_HEAD: (.+)$")
      list(APPEND producer_pins "${CMAKE_MATCH_1}")
    elseif(line MATCHES "^          fetch-depth: (.+)$")
      list(APPEND depth_${job} "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  set(expected_jobs changes hygiene title build asan diagnostics ci-required)
  if(NOT jobs STREQUAL expected_jobs)
    message(FATAL_ERROR "ci-preflight: workflow-job-set-mismatch")
  endif()
  set(expected_rows
    "build|runner=ubuntu-26.04,cc=gcc,id=GNU,minutes=4"
    "build|runner=macos-26,cc=cc,id=AppleClang,minutes=5"
    "diagnostics|runner=ubuntu-26.04,host=linux-x64,group=arm,cc=gcc,id=GNU,minutes=3"
    "diagnostics|runner=macos-26,host=darwin-arm64,group=arm,cc=cc,id=AppleClang,minutes=5"
    "diagnostics|runner=ubuntu-26.04,host=linux-x64,group=thumb,cc=gcc,id=GNU,minutes=3"
    "diagnostics|runner=macos-26,host=darwin-arm64,group=thumb,cc=cc,id=AppleClang,minutes=3")
  if(NOT rows STREQUAL expected_rows)
    message(FATAL_ERROR "ci-preflight: workflow-budget-matrix-mismatch")
  endif()
  foreach(job IN LISTS expected_jobs)
    set(expected 3)
    if(job MATCHES "^(build|diagnostics)$")
      set(expected [=[${{ matrix.minutes }}]=])
    endif()
    if(NOT "${timeout_${job}}" STREQUAL expected)
      message(FATAL_ERROR "ci-preflight: workflow-job-timeout-mismatch:${job}")
    endif()
    set(expected_runner ubuntu-26.04)
    if(job MATCHES "^(build|diagnostics)$")
      set(expected_runner [=[${{ matrix.runner }}]=])
    endif()
    if(NOT "${runner_${job}}" STREQUAL expected_runner)
      message(FATAL_ERROR "ci-preflight: workflow-job-platform-mismatch:${job}")
    endif()
  endforeach()
  if(NOT name_build STREQUAL [=[build (${{ matrix.runner }}, ${{ matrix.cc }}, ${{ matrix.id }})]=] OR
     NOT name_diagnostics STREQUAL [=[diagnostics (${{ matrix.host }}, ${{ matrix.group }})]=] OR
     NOT name_ci-required STREQUAL "CI required")
    message(FATAL_ERROR "ci-preflight: workflow-job-name-mismatch")
  endif()
  if(NOT producer_pins STREQUAL GBL_CI_PRODUCER_HEAD)
    message(FATAL_ERROR "ci-preflight: workflow-producer-pin-mismatch")
  endif()
  foreach(job IN ITEMS build asan diagnostics)
    if(NOT "${depth_${job}}" STREQUAL "0")
      message(FATAL_ERROR "ci-preflight: workflow-full-history-required:${job}")
    endif()
  endforeach()
endfunction()

function(gbl_ci_preflight source require_authority)
  gbl_ci_policy("${source}")
  gbl_ci_admission_presets("${source}/CMakePresets.json")
  gbl_ci_workflow("${source}" "${source}/.github/workflows/ci.yml")
  if(GBL_DIAGNOSTIC_STAGE STREQUAL "proof" AND
      (GBL_LANE STREQUAL "diagnostics" OR GBL_REQUIRE_DIAGNOSTICS OR "$ENV{CI}" STREQUAL "true"))
    message(FATAL_ERROR "ci-preflight: required-proof-stage-forbidden")
  endif()
  if(GBL_LANE MATCHES "^(ci|asan|diagnostics)$" AND NOT GBL_DIAGNOSTIC_STAGE STREQUAL "proof")
    set(require_authority TRUE)
  endif()
  if(NOT "$ENV{GBL_PRODUCER_HEAD}" STREQUAL "" AND
     NOT "$ENV{GBL_PRODUCER_HEAD}" STREQUAL GBL_CI_PRODUCER_HEAD)
    message(FATAL_ERROR "ci-preflight: producer-pin-mismatch")
  endif()
  include("${source}/cmake/DiagnosticMatrix.cmake")
  gbl_diagnostic_input_digest("${source}" digest)
  if(NOT digest STREQUAL GBL_CI_PRODUCER_INPUT)
    message(FATAL_ERROR "ci-preflight: producer-input-digest-mismatch")
  endif()
  execute_process(COMMAND git -C "${source}" rev-parse --is-shallow-repository
    RESULT_VARIABLE rc OUTPUT_VARIABLE shallow OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "ci-preflight: git-history-unavailable")
  endif()
  if(require_authority AND shallow STREQUAL "true")
    message(FATAL_ERROR "ci-preflight: admitted-full-history-required")
  endif()
  if(require_authority OR shallow STREQUAL "false")
    include("${source}/cmake/CheckDiagnosticAuthority.cmake")
    gbl_check_diagnostic_authority("${source}" "${GBL_CI_PRODUCER_HEAD}")
    message(STATUS "ci-preflight: 11 exact job budgets; producer bytes/modes/ancestry verified")
  else()
    message(STATUS "ci-preflight: 11 exact job budgets; producer digest verified; ancestry/modes NOT checked (shallow metadata-only checkout)")
  endif()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  if(NOT DEFINED SRC)
    get_filename_component(SRC "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
  endif()
  if(DEFINED PRESETS)
    gbl_ci_admission_presets("${PRESETS}")
  elseif(DEFINED WORKFLOW)
    gbl_ci_workflow("${SRC}" "${WORKFLOW}")
  else()
    gbl_ci_preflight("${SRC}" "${REQUIRE_AUTHORITY}")
  endif()
endif()
