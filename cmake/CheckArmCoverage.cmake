  elseif(row_isa MATCHES "^(arm|thumb)$")
    gbl_cov_error(arm-source-test-missing "${row_id}")
  endif()
  if(row_isa STREQUAL "thumb")
    string(JSON thumb_format GET "${row_json}" format)
    string(JSON probe_count ERROR_VARIABLE probe_error LENGTH "${row_json}" source_test encoding_checks)
    string(JSON program GET "${row_json}" source_test program)
    if(NOT probe_error STREQUAL "NOTFOUND" OR probe_count LESS 1)
      gbl_cov_error(thumb-encoding-check-missing "${row_id}")
    else()
      math(EXPR probe_last "${probe_count}-1")
      foreach(probe RANGE 0 ${probe_last})
        foreach(field IN ITEMS symbol mask value width)
          string(JSON p_${field} ERROR_VARIABLE p_error GET "${row_json}" source_test encoding_checks ${probe} ${field})
          if(NOT p_error STREQUAL "NOTFOUND")
            gbl_cov_error(thumb-encoding-check-invalid "${row_id}:${field}")
          endif()
        endforeach()
        string(FIND "${program}" "${p_symbol}:\n" probe_at)
        if(probe_at LESS 0 OR NOT p_symbol MATCHES "^gbl_[a-z0-9_]+$" OR
           NOT p_mask MATCHES "^0x[0-9a-f]+$" OR NOT p_value MATCHES "^0x[0-9a-f]+$" OR
           NOT p_width EQUAL 2)
