if(MODE STREQUAL "smoke-admission")
  # This narrow mode checks source-state to fixture-ID membership. The
  # production index path separately validates manifest digests and rights.
  if(NOT DEFINED MANIFEST OR "${MANIFEST}" STREQUAL "")
    gbl_cov_error(smoke-admission-manifest-required "MANIFEST must name the admission manifest")
  elseif(NOT EXISTS "${MANIFEST}" OR IS_DIRECTORY "${MANIFEST}" OR IS_SYMLINK "${MANIFEST}")
    gbl_cov_error(manifest-missing "${MANIFEST}")
  else()
    file(READ "${MANIFEST}" admission_manifest_json)
    gbl_json_type(admission_manifest_type "${admission_manifest_json}")
    if(NOT admission_manifest_type STREQUAL "OBJECT")
      gbl_cov_error(manifest-malformed "${MANIFEST}")
    else()
      gbl_json_length(admission_fixture_count "${admission_manifest_json}" fixtures)
      if(admission_fixture_count LESS 1)
        gbl_cov_error(smoke-admission-fixture-link-missing "manifest has no fixtures")
      else()
        set(admission_fixture_ids "")
        math(EXPR admission_fixture_last "${admission_fixture_count}-1")
        foreach(admission_index RANGE 0 ${admission_fixture_last})
          gbl_json_string(admission_fixture_id "${admission_manifest_json}" fixtures ${admission_index} id)
          list(APPEND admission_fixture_ids "${admission_fixture_id}")
        endforeach()
        if(NOT smoke_row_state STREQUAL "source-verified")
          gbl_cov_error(smoke-admission-state "expected source-verified smoke row")
        endif()
        set(admission_links 0)
        foreach(fixture_id IN ITEMS "${smoke_positive_fixture}" "${smoke_negative_fixture}")
          list(FIND admission_fixture_ids "${fixture_id}" fixture_found)
          if(fixture_found EQUAL -1)
            gbl_cov_error(smoke-admission-fixture-link-missing "${fixture_id}")
          else()
            math(EXPR admission_links "${admission_links}+1")
          endif()
        endforeach()
        set(smoke_admission_links "${admission_links}")
      endif()
    endif()
  endif()
elseif(MODE STREQUAL "final")
  if(DEFINED MANIFEST AND NOT "${MANIFEST}" STREQUAL "")
    set(manifest_path "${MANIFEST}")
  else()
    get_filename_component(matrix_dir "${MATRIX}" DIRECTORY)
    get_filename_component(source_dir "${matrix_dir}/../.." ABSOLUTE)
    set(manifest_path "${source_dir}/tests/fixtures/manifest.json")
  endif()
  if(NOT EXISTS "${manifest_path}" OR IS_DIRECTORY "${manifest_path}" OR IS_SYMLINK "${manifest_path}")
    gbl_cov_error(manifest-missing "${manifest_path}")
  else()
    file(READ "${manifest_path}" manifest_json)
    gbl_json_length(manifest_fixture_count "${manifest_json}" fixtures)
    if(manifest_fixture_count GREATER 0)
      math(EXPR manifest_fixture_last "${manifest_fixture_count}-1")
      set(manifest_fixture_ids "")
      foreach(manifest_index RANGE 0 ${manifest_fixture_last})
        gbl_json_string(manifest_fixture_id "${manifest_json}" fixtures ${manifest_index} id)
        list(APPEND manifest_fixture_ids "${manifest_fixture_id}")
      endforeach()
      foreach(index RANGE 0 ${case_last})
        string(JSON row_json GET "${matrix_json}" cases ${index})
        gbl_json_string(row_state "${row_json}" coverage_state)
        if(row_state STREQUAL "verified")
          gbl_json_string(positive_fixture "${row_json}" positive_fixture)
          gbl_json_string(negative_fixture "${row_json}" negative_fixture)
          foreach(fixture_id IN ITEMS "${positive_fixture}" "${negative_fixture}")
            list(FIND manifest_fixture_ids "${fixture_id}" fixture_found)
            if(fixture_found EQUAL -1)
              string(JSON row_id GET "${row_json}" id)
              gbl_cov_error(fixture-link-missing "case=${row_id} fixture=${fixture_id}")
            endif()
          endforeach()
        endif()
      endforeach()
    else()
      gbl_cov_error(manifest-empty "${manifest_path}")
    endif()
  endif()
endif()

