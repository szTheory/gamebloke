set(GBL_COV_ERRORS "")
function(gbl_cov_error code detail)
  set(errors "${GBL_COV_ERRORS}")
  list(APPEND errors "${code}: ${detail}")
  set(GBL_COV_ERRORS "${errors}" PARENT_SCOPE)
endfunction()

set(actual_inventory "")
set(all_ids "")
set(selectors "")
set(thumb_formats "")
set(pending_count 0)
set(verified_count 0)
set(smoke_count 0)
set(quirk_forms "")
math(EXPR case_last "${case_count}-1")
foreach(index RANGE 0 ${case_last})
  string(JSON row_json GET "${matrix_json}" cases ${index})
  gbl_json_type(row_type "${row_json}")
  if(NOT "${row_type}" STREQUAL "OBJECT")
    gbl_cov_error(wrong-type "cases[${index}] is not an object")
    continue()
  endif()
  string(JSON row_id_type ERROR_VARIABLE id_error TYPE "${row_json}" id)
  if(NOT "${id_error}" STREQUAL "NOTFOUND" OR NOT "${row_id_type}" STREQUAL "NUMBER")
    gbl_cov_error(invalid-id "cases[${index}] must have a numeric nonzero uint32 id")
    set(row_id "")
  else()
    string(JSON row_id GET "${row_json}" id)
    if(NOT "${row_id}" MATCHES "^[0-9]+$" OR row_id LESS 1 OR row_id GREATER 4294967295)
      gbl_cov_error(invalid-id "cases[${index}] id=${row_id}")
    endif()
  endif()
  if(NOT "${row_id}" STREQUAL "")
    list(FIND all_ids "${row_id}" id_seen)
    if(NOT id_seen EQUAL -1)
      gbl_cov_error(duplicate-id "${row_id}")
    else()
      list(APPEND all_ids "${row_id}")
    endif()
  endif()

  foreach(field IN ITEMS isa family form setup observe source_reference native_selector coverage_state)
    gbl_json_string(value "${row_json}" ${field})
    if("${value}" STREQUAL "<missing>")
      gbl_cov_error(missing-field "cases[${index}].${field}")
    endif()
    set(row_${field} "${value}")
  endforeach()
  gbl_json_type(target_type "${row_json}" inventory_target)
  if(NOT "${target_type}" STREQUAL "BOOLEAN")
    gbl_cov_error(wrong-type "cases[${index}].inventory_target")
    set(is_target FALSE)
  else()
    string(JSON target_value GET "${row_json}" inventory_target)
    if("${target_value}" STREQUAL "ON" OR "${target_value}" STREQUAL "true")
      set(is_target TRUE)
    else()
      set(is_target FALSE)
    endif()
  endif()
  gbl_json_type(trace_type "${row_json}" trace_required)
  if(NOT "${trace_type}" STREQUAL "BOOLEAN")
    gbl_cov_error(wrong-type "cases[${index}].trace_required")
  endif()
  gbl_json_type(quirk_type "${row_json}" cpu_quirk)
  gbl_json_length(quirk_count "${row_json}" cpu_quirk)
  if(NOT "${quirk_type}" STREQUAL "ARRAY")
    gbl_cov_error(wrong-type "cases[${index}].cpu_quirk must be an array")
  elseif(quirk_count GREATER 0)
    math(EXPR quirk_last "${quirk_count}-1")
    foreach(quirk_index RANGE ${quirk_last})
      gbl_json_string(quirk "${row_json}" cpu_quirk ${quirk_index})
      if(NOT quirk MATCHES "^CPU-[1-9]$")
        gbl_cov_error(bad-cpu-quirk "cases[${index}]: ${quirk}")
      endif()
    endforeach()
  endif()
  gbl_json_type(expected_type "${row_json}" expected)
  gbl_json_string(expected_derivation "${row_json}" expected derivation)
  gbl_json_string(expected_value "${row_json}" expected value)
  if(NOT "${expected_type}" STREQUAL "OBJECT" OR
     "${expected_derivation}" STREQUAL "<missing>" OR
     "${expected_value}" STREQUAL "<missing>")
    gbl_cov_error(missing-expected-derivation "cases[${index}]")
  endif()
  list(FIND selectors "${row_native_selector}" selector_seen)
  if(NOT selector_seen EQUAL -1)
    gbl_cov_error(duplicate-selector "${row_native_selector}")
  else()
    list(APPEND selectors "${row_native_selector}")
  endif()

  gbl_json_type(positive_type "${row_json}" positive_fixture)
  gbl_json_type(negative_type "${row_json}" negative_fixture)
  gbl_json_type(fail_case_type "${row_json}" expected_fail_case_id)
  if(row_coverage_state STREQUAL "pending")
    math(EXPR pending_count "${pending_count}+1")
    if(NOT positive_type STREQUAL "NULL" OR NOT negative_type STREQUAL "NULL" OR
       NOT fail_case_type STREQUAL "NULL")
      gbl_cov_error(pending-has-witness "${row_id}")
    endif()
  elseif(row_coverage_state STREQUAL "source-verified-pending-admission")
    if(NOT row_family STREQUAL "diagnostic-harness")
      gbl_cov_error(unexpected-pending-admission "${row_id}")
    endif()
    math(EXPR smoke_count "${smoke_count}+1")
    gbl_json_string(positive_fixture "${row_json}" positive_fixture)
    gbl_json_string(negative_fixture "${row_json}" negative_fixture)
    string(JSON fail_case GET "${row_json}" expected_fail_case_id)
    if(NOT positive_fixture STREQUAL "smoke" OR
       NOT negative_fixture STREQUAL "smoke-broken" OR
       NOT fail_case STREQUAL "20481" OR NOT row_id STREQUAL "20481" OR
       NOT row_native_selector STREQUAL "smoke-pair")
      gbl_cov_error(wrong-variant "${row_id}")
    endif()
    gbl_json_type(broken_assertion_type "${row_json}" broken_assertion)
    gbl_json_string(broken_source "${row_json}" broken_assertion source)
    gbl_json_type(arm_clean_type "${row_json}" broken_assertion arm_clean_operand)
    gbl_json_type(arm_broken_type "${row_json}" broken_assertion arm_broken_operand)
    gbl_json_type(thumb_clean_type "${row_json}" broken_assertion thumb_clean_operand)
    gbl_json_type(thumb_broken_type "${row_json}" broken_assertion thumb_broken_operand)
    string(JSON arm_clean GET "${row_json}" broken_assertion arm_clean_operand)
    string(JSON arm_broken GET "${row_json}" broken_assertion arm_broken_operand)
    string(JSON thumb_clean GET "${row_json}" broken_assertion thumb_clean_operand)
    string(JSON thumb_broken GET "${row_json}" broken_assertion thumb_broken_operand)
    gbl_json_type(broken_id_type "${row_json}" broken_assertion fail_case_id)
    string(JSON broken_id GET "${row_json}" broken_assertion fail_case_id)
    if(NOT broken_assertion_type STREQUAL "OBJECT" OR
       NOT arm_clean_type STREQUAL "NUMBER" OR NOT arm_broken_type STREQUAL "NUMBER" OR
       NOT thumb_clean_type STREQUAL "NUMBER" OR NOT thumb_broken_type STREQUAL "NUMBER" OR
       NOT broken_id_type STREQUAL "NUMBER" OR
       NOT broken_source STREQUAL "diagnostics/armv4t/smoke.S GBL_BROKEN comparison operands" OR
       NOT arm_clean STREQUAL "5" OR NOT arm_broken STREQUAL "6" OR
       NOT thumb_clean STREQUAL "6" OR NOT thumb_broken STREQUAL "7" OR
       NOT broken_id STREQUAL "20481")
      gbl_cov_error(broken-assertion-invalid "${row_id}")
    endif()
  elseif(row_coverage_state STREQUAL "verified")
    math(EXPR verified_count "${verified_count}+1")
    gbl_json_string(positive_fixture "${row_json}" positive_fixture)
    gbl_json_string(negative_fixture "${row_json}" negative_fixture)
    string(JSON fail_case GET "${row_json}" expected_fail_case_id)
    if(positive_fixture STREQUAL "<missing>" OR negative_fixture STREQUAL "<missing>" OR
       positive_fixture STREQUAL negative_fixture OR
       NOT "${fail_case}" STREQUAL "${row_id}")
      gbl_cov_error(incomplete-verified-witness "${row_id}")
    endif()
  else()
    gbl_cov_error(bad-coverage-state "${row_id}: ${row_coverage_state}")
  endif()

  if(is_target)
    if(row_isa STREQUAL "thumb")
      string(JSON format_type ERROR_VARIABLE format_error TYPE "${row_json}" format)
      if(NOT "${format_error}" STREQUAL "NOTFOUND" OR NOT format_type STREQUAL "NUMBER")
        gbl_cov_error(missing-thumb-format "${row_id}")
        set(format "none")
      else()
        string(JSON format GET "${row_json}" format)
        if(NOT format MATCHES "^[0-9]+$" OR format LESS 1 OR format GREATER 19)
          gbl_cov_error(bad-thumb-format "${row_id}: ${format}")
        endif()
        list(FIND thumb_formats "${format}" format_seen)
        if(format_seen EQUAL -1)
          list(APPEND thumb_formats "${format}")
        endif()
      endif()
    else()
      set(format "none")
    endif()
    set(key "${row_isa}|${row_family}|${row_form}|${format}")
    list(FIND actual_inventory "${key}" key_seen)
    if(NOT key_seen EQUAL -1)
      gbl_cov_error(duplicate-form "${key}")
    else()
      list(APPEND actual_inventory "${key}")
    endif()
  endif()

  if(row_family STREQUAL "cpu-quirk")
    list(APPEND quirk_forms "${row_form}")
  endif()
  if(MODE STREQUAL "final" AND NOT row_coverage_state STREQUAL "verified")
    gbl_cov_error(pending-case "${row_id}: ${row_coverage_state}")
  endif()
endforeach()

foreach(expected_key IN LISTS expected_inventory)
  list(FIND actual_inventory "${expected_key}" found)
  if(found EQUAL -1)
    gbl_cov_error(missing-form "${expected_key}")
  endif()
endforeach()
foreach(actual_key IN LISTS actual_inventory)
  list(FIND expected_inventory "${actual_key}" found)
  if(found EQUAL -1)
    gbl_cov_error(unexpected-form "${actual_key}")
  endif()
endforeach()
list(LENGTH expected_inventory expected_target_count)
list(LENGTH actual_inventory actual_target_count)
if(NOT expected_target_count EQUAL actual_target_count)
  gbl_cov_error(inventory-count "expected=${expected_target_count} actual=${actual_target_count}")
endif()
foreach(format RANGE 1 19)
  list(FIND thumb_formats "${format}" found)
  if(found EQUAL -1)
    gbl_cov_error(missing-thumb-format "format-${format}")
  endif()
endforeach()
foreach(quirk IN ITEMS "CPU-1 ARM version boundaries" "CPU-2 shifter and carry"
    "CPU-3 PC operands" "CPU-4 block transfers" "CPU-5 alignment" "CPU-6 multiply"
    "CPU-7 Thumb BL boundary" "CPU-8 status and return" "CPU-9 exception decode")
  list(FIND quirk_forms "${quirk}" found)
  if(found EQUAL -1)
    gbl_cov_error(missing-cpu-quirk "${quirk}")
  endif()
endforeach()
if(NOT smoke_count EQUAL 1)
  gbl_cov_error(smoke-pair-count "expected one same-case smoke pair; found ${smoke_count}")
endif()

if(MODE STREQUAL "final")
  if(DEFINED MANIFEST AND NOT "${MANIFEST}" STREQUAL "")
    set(manifest_path "${MANIFEST}")
  else()
    get_filename_component(matrix_dir "${MATRIX}" DIRECTORY)
    get_filename_component(source_dir "${matrix_dir}/../.." ABSOLUTE)
    set(manifest_path "${source_dir}/tests/fixtures/manifest.json")
  endif()
  if(NOT EXISTS "${manifest_path}" OR IS_DIRECTORY "${manifest_path}" OR IS_SYMLINK "${manifest_path}")
    gbl_cov_error(manifest-missing "${manifest_path}")
  else()
    file(READ "${manifest_path}" manifest_json)
    gbl_json_length(manifest_fixture_count "${manifest_json}" fixtures)
    if(manifest_fixture_count GREATER 0)
      math(EXPR manifest_fixture_last "${manifest_fixture_count}-1")
      set(manifest_fixture_ids "")
      foreach(manifest_index RANGE 0 ${manifest_fixture_last})
        gbl_json_string(manifest_fixture_id "${manifest_json}" fixtures ${manifest_index} id)
        list(APPEND manifest_fixture_ids "${manifest_fixture_id}")
      endforeach()
      foreach(index RANGE 0 ${case_last})
        string(JSON row_json GET "${matrix_json}" cases ${index})
        gbl_json_string(row_state "${row_json}" coverage_state)
        if(row_state STREQUAL "verified")
          gbl_json_string(positive_fixture "${row_json}" positive_fixture)
          gbl_json_string(negative_fixture "${row_json}" negative_fixture)
          foreach(fixture_id IN ITEMS "${positive_fixture}" "${negative_fixture}")
            list(FIND manifest_fixture_ids "${fixture_id}" fixture_found)
            if(fixture_found EQUAL -1)
              string(JSON row_id GET "${row_json}" id)
              gbl_cov_error(fixture-link-missing "case=${row_id} fixture=${fixture_id}")
            endif()
          endforeach()
        endif()
      endforeach()
    else()
      gbl_cov_error(manifest-empty "${manifest_path}")
    endif()
  endif()
endif()

if(NOT "${GBL_COV_ERRORS}" STREQUAL "")
  foreach(error IN LISTS GBL_COV_ERRORS)
    message(STATUS "coverage: ${error}")
  endforeach()
  message(FATAL_ERROR "coverage: invalid-ledger")
endif()
if(MODE STREQUAL "draft")
  message("coverage: ok (draft; targets=${actual_target_count}; pending=${pending_count}; verified=${verified_count})")
else()
  message("coverage: ok (final; targets=${actual_target_count}; pending=${pending_count}; verified=${verified_count})")
endif()
