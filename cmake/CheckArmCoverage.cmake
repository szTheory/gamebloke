    gbl_json_string(positive_fixture "${row_json}" positive_fixture)
    gbl_json_string(negative_fixture "${row_json}" negative_fixture)
    set(fail_case "<missing>")
    if(fail_case_type STREQUAL "NUMBER")
      string(JSON fail_case GET "${row_json}" expected_fail_case_id)
    endif()
    set(smoke_row_state "${row_coverage_state}")
    set(smoke_positive_fixture "${positive_fixture}")
    set(smoke_negative_fixture "${negative_fixture}")
    gbl_json_type(target_type "${row_json}" inventory_target)
    gbl_json_string(smoke_form "${row_json}" form)
    gbl_json_string(smoke_expected_value "${row_json}" expected value)
    string(TOLOWER "${smoke_expected_value}" smoke_expected_value_lower)
    if(NOT row_coverage_state MATCHES "^(source-verified|verified)$" OR
       NOT row_id STREQUAL "20481" OR NOT row_isa STREQUAL "arm" OR
       NOT row_family STREQUAL "diagnostic-harness" OR
       NOT smoke_form STREQUAL "smoke-positive-and-real-assertion-broken-same-case-pair" OR
       NOT target_type STREQUAL "BOOLEAN" OR is_target OR
       NOT row_native_selector STREQUAL "smoke-pair" OR
       NOT positive_fixture STREQUAL "smoke" OR
       NOT negative_fixture STREQUAL "smoke-broken" OR
       NOT fail_case STREQUAL "20481")
      gbl_cov_error(wrong-variant "${row_id}")
    endif()
    if(smoke_expected_value_lower MATCHES "(await|pending|admission|hosted|pin)")
      gbl_cov_error(smoke-temporal-expectation "${row_id}")
    endif()
    gbl_json_type(broken_assertion_type "${row_json}" broken_assertion)
    gbl_json_string(broken_source "${row_json}" broken_assertion source)
    gbl_json_type(arm_clean_type "${row_json}" broken_assertion arm_clean_operand)
    gbl_json_type(arm_broken_type "${row_json}" broken_assertion arm_broken_operand)
    gbl_json_type(thumb_clean_type "${row_json}" broken_assertion thumb_clean_operand)
    gbl_json_type(thumb_broken_type "${row_json}" broken_assertion thumb_broken_operand)
    gbl_json_type(broken_id_type "${row_json}" broken_assertion fail_case_id)
    set(arm_clean "<missing>")
    set(arm_broken "<missing>")
    set(thumb_clean "<missing>")
    set(thumb_broken "<missing>")
    set(broken_id "<missing>")
    if(arm_clean_type STREQUAL "NUMBER")
