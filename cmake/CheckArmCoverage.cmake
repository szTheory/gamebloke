set(GBL_COV_ERRORS "")
function(gbl_cov_error code detail)
  set(errors "${GBL_COV_ERRORS}")
  list(APPEND errors "${code}: ${detail}")
  set(GBL_COV_ERRORS "${errors}" PARENT_SCOPE)
endfunction()

set(actual_inventory "")
set(all_ids "")
set(selectors "")
set(thumb_formats "")
set(pending_count 0)
set(source_verified_count 0)
set(verified_count 0)
set(smoke_count 0)
set(quirk_forms "")
set(source_semantic_count 0)
set(thumb_semantic_count 0)
set(thumb_stop_count 0)
set(guest_stop_count 0)
set(cpu_api_count 0)
set(guest_stop_reasons "")
set(companion_pairs "")
math(EXPR case_last "${case_count}-1")
foreach(index RANGE 0 ${case_last})
  string(JSON row_json GET "${matrix_json}" cases ${index})
  gbl_json_type(row_type "${row_json}")
  if(NOT "${row_type}" STREQUAL "OBJECT")
    gbl_cov_error(wrong-type "cases[${index}] is not an object")
    continue()
  endif()
  string(JSON row_id_type ERROR_VARIABLE id_error TYPE "${row_json}" id)
  if(NOT "${id_error}" STREQUAL "NOTFOUND" OR NOT "${row_id_type}" STREQUAL "NUMBER")
    gbl_cov_error(invalid-id "cases[${index}] must have a numeric nonzero uint32 id")
    set(row_id "")
  else()
    string(JSON row_id GET "${row_json}" id)
    if(NOT "${row_id}" MATCHES "^[0-9]+$" OR row_id LESS 1 OR row_id GREATER 4294967295)
      gbl_cov_error(invalid-id "cases[${index}] id=${row_id}")
    endif()
  endif()
  if(NOT "${row_id}" STREQUAL "")
    list(FIND all_ids "${row_id}" id_seen)
    if(NOT id_seen EQUAL -1)
      gbl_cov_error(duplicate-id "${row_id}")
    else()
      list(APPEND all_ids "${row_id}")
    endif()
  endif()

  foreach(field IN ITEMS isa family form setup observe source_reference native_selector coverage_state)
    gbl_json_string(value "${row_json}" ${field})
    if("${value}" STREQUAL "<missing>")
      gbl_cov_error(missing-field "cases[${index}].${field}")
    endif()
    set(row_${field} "${value}")
  endforeach()
  gbl_json_type(target_type "${row_json}" inventory_target)
  if(NOT "${target_type}" STREQUAL "BOOLEAN")
    gbl_cov_error(wrong-type "cases[${index}].inventory_target")
    set(is_target FALSE)
  else()
    string(JSON target_value GET "${row_json}" inventory_target)
    if("${target_value}" STREQUAL "ON" OR "${target_value}" STREQUAL "true")
      set(is_target TRUE)
    else()
      set(is_target FALSE)
    endif()
  endif()
  gbl_json_type(trace_type "${row_json}" trace_required)
  if(NOT "${trace_type}" STREQUAL "BOOLEAN")
    gbl_cov_error(wrong-type "cases[${index}].trace_required")
  endif()
  gbl_json_string(row_boundary "${row_json}" execution_boundary)
  gbl_json_string(row_expected_status "${row_json}" expected_status)
  gbl_json_type(companion_type "${row_json}" companion_case_ids)
  gbl_json_length(companion_count "${row_json}" companion_case_ids)
  string(JSON source_kind ERROR_VARIABLE source_kind_error GET
    "${row_json}" source_test kind)
  if(row_isa MATCHES "^(arm|thumb)$")
    if("${row_boundary}" STREQUAL "<missing>" OR
       "${row_expected_status}" STREQUAL "<missing>" OR
       NOT "${companion_type}" STREQUAL "ARRAY")
      gbl_cov_error(missing-execution-boundary "${row_id}")
    endif()
    if(NOT row_boundary MATCHES "^(guest-semantic|guest-stop|cpu-api)$")
      gbl_cov_error(bad-execution-boundary "${row_id}: ${row_boundary}")
    endif()
  endif()
  if(row_isa MATCHES "^(arm|thumb)$" AND NOT "${companion_type}" STREQUAL "ARRAY")
    gbl_cov_error(bad-companion-case-ids "${row_id}: expected array")
  elseif("${companion_type}" STREQUAL "ARRAY" AND companion_count GREATER 0)
    math(EXPR companion_last "${companion_count}-1")
    set(row_companions "")
    foreach(companion_index RANGE 0 ${companion_last})
      gbl_json_type(companion_id_type "${row_json}" companion_case_ids ${companion_index})
      if(NOT companion_id_type STREQUAL "NUMBER")
        gbl_cov_error(bad-companion-case-id "${row_id}: index=${companion_index}")
        continue()
      endif()
      string(JSON companion_id GET "${row_json}" companion_case_ids ${companion_index})
      if(NOT "${companion_id}" MATCHES "^[1-9][0-9]*$" OR
         companion_id GREATER 4294967295)
        gbl_cov_error(bad-companion-case-id "${row_id}: ${companion_id}")
      endif()
      list(FIND row_companions "${companion_id}" companion_duplicate)
      if(NOT companion_duplicate EQUAL -1)
        gbl_cov_error(duplicate-companion-case-id "${row_id}: ${companion_id}")
      else()
        list(APPEND row_companions "${companion_id}")
      endif()
      list(APPEND companion_pairs "${row_id}|${companion_id}")
    endforeach()
  else()
    set(row_companions "")
  endif()
  if(NOT "${source_kind_error}" STREQUAL "NOTFOUND")
    set(source_kind "<missing>")
  endif()
  if(source_kind STREQUAL "semantic")
    if(row_isa STREQUAL "arm")
      math(EXPR source_semantic_count "${source_semantic_count}+1")
    else()
      math(EXPR thumb_semantic_count "${thumb_semantic_count}+1")
    endif()
    string(JSON program GET "${row_json}" source_test program)
    string(JSON expected_value GET "${row_json}" source_test
      independent_expectation expected_value)
    string(JSON broken_expected GET "${row_json}" source_test
      independent_expectation broken_expected)
    string(JSON semantic_derivation GET "${row_json}" source_test
      independent_expectation derivation)
    string(JSON broken_claim GET "${row_json}" source_test
      independent_expectation broken_expectation)
    if(NOT row_isa MATCHES "^(arm|thumb)$" OR NOT is_target OR
       NOT row_boundary STREQUAL "guest-semantic" OR
       NOT row_expected_status STREQUAL "GUEST_STOP/unregistered-content; semantic PASS/FAIL" OR
       "${expected_value}" STREQUAL "${broken_expected}" OR
       "${semantic_derivation}" STREQUAL "" OR "${broken_claim}" STREQUAL "" OR
       NOT program MATCHES "GBL_ASSERT_(EQ|MASKED)" OR
       NOT program MATCHES "${expected_value}" OR
       NOT program MATCHES "${broken_expected}")
      gbl_cov_error(semantic-source-invalid "${row_id}")
    endif()
    if(row_family STREQUAL "multiply")
      string(TOLOWER "${row_form}" multiply_form_lower)
      string(TOLOWER "${program}" multiply_program_lower)
      string(FIND "${multiply_program_lower}" "${multiply_form_lower} " non_s_multiply_position)
      string(FIND "${multiply_program_lower}" "${multiply_form_lower}s " s_multiply_position)
      string(REGEX MATCHALL "GBL_ASSERT_MASKED" masked_assertions "${program}")
      list(LENGTH masked_assertions masked_assertion_count)
      if(non_s_multiply_position LESS 0 OR s_multiply_position LESS 0 OR
         masked_assertion_count LESS 3 OR
         NOT program MATCHES "0xF0000000" OR
         NOT program MATCHES "0xC0000000" OR
         NOT program MATCHES "0x30000000")
        gbl_cov_error(semantic-multiply-flags-invalid "${row_id}")
      endif()
    endif()
    # Deliberately narrow source contracts for the reviewed architectural edges.
    # Actual assembler output is checked by BuildArmDiagnostics, not reassembled here.
    if(row_form STREQUAL "arm-register-shifted-operand-pc-plus-12")
      set(pc_sequence "mov r2,#3\nmov r3,#1\n.Lpc_operand:\n.inst 0xE082031F\nadr r1,.Lpc_operand\nadd r1,r1,#12\nmov r1,r1,lsl #1\nadd r1,r1,#3\nsub r0,r0,r1\nGBL_ASSERT_EQ r0, 0x00000000, 0xFFFFFFF8\n")
      string(FIND "${program}" "${pc_sequence}" pc_sequence_at)
      if(pc_sequence_at LESS 0)
        gbl_cov_error(semantic-pc-operand-invalid "${row_id}: Rm=PC,Rs=r3,+12 arithmetic required")
      endif()
    endif()
    if(row_family STREQUAL "block-transfer" AND row_form MATCHES ":normal-no-writeback$")
      string(REPLACE ":" ";" block_parts "${row_form}")
      list(GET block_parts 0 block_op)
      list(GET block_parts 1 block_mode)
      string(TOLOWER "${block_op}${block_mode}" block_mnemonic)
      string(FIND "${program}" "mov r6,r4\n" snapshot_at)
      string(FIND "${program}" "${block_mnemonic} r4, {r0,r1}\n" block_at)
      string(FIND "${program}" "cmp r4,r6\nbne .Ldiagnostic_assert_fail\n" base_at)
      string(JSON block_writeback GET "${row_json}" source_test independent_expectation writeback)
      if(block_writeback OR snapshot_at LESS 0 OR block_at LESS snapshot_at OR
         base_at LESS block_at OR program MATCHES "r4!")
        gbl_cov_error(semantic-block-writeback-invalid "${row_id}: W=0 and preserved base required")
      endif()
    endif()
    if(row_family STREQUAL "halfword-signed-transfer" AND row_form MATCHES "force-user")
      gbl_cov_error(semantic-mode3-form-invalid "${row_id}: P=0,W=1 is UNPREDICTABLE")
    endif()
    if(row_form STREQUAL "incoming-c-boundary-vectors" OR
       row_form STREQUAL "zero-one-sign-bit-and-all-ones-operands")
      foreach(vector IN ITEMS 0x00000000 0x00000001 0x80000000 0xFFFFFFFF)
        foreach(carry IN ITEMS 0 1)
          math(EXPR seed "${carry} * 0x20000000" OUTPUT_FORMAT HEXADECIMAL)
          set(zero_flag 0)
          if(vector STREQUAL "0x00000000")
            set(zero_flag 0x40000000)
          endif()
          math(EXPR flags "(${vector} & 0x80000000) | ${zero_flag} | ${seed}" OUTPUT_FORMAT HEXADECIMAL)
          math(EXPR wrong_value "${vector} ^ 1" OUTPUT_FORMAT HEXADECIMAL)
          math(EXPR wrong_flags "${flags} ^ 0x20000000" OUTPUT_FORMAT HEXADECIMAL)
          # Normalize numeric spellings so this checks executed operand/result/flags
          # together, rather than accepting vector labels or stray constants.
          string(TOLOWER "${program}" boundary_program)
          string(REGEX REPLACE "0x0+([0-9a-f])" "0x\\1" boundary_program "${boundary_program}")
          if(row_form STREQUAL "incoming-c-boundary-vectors")
            set(boundary_op "movs r0,r1,lsl #0")
          else()
            set(boundary_op "mov r2,#0\nmovs r0,r1,ror r2")
          endif()
          math(EXPR normalized_vector "${vector}" OUTPUT_FORMAT HEXADECIMAL)
          set(boundary_sequence "ldr r5,=${seed}\nmsr cpsr_f,r5\nldr r1,=${normalized_vector}\n${boundary_op}\nmrs r3,cpsr\ngbl_assert_eq r0, ${normalized_vector}, ${wrong_value}\ngbl_assert_masked r3, 0xf0000000, ${flags}, ${wrong_flags}\n")
          string(FIND "${boundary_program}" "${boundary_sequence}" boundary_at)
          if(boundary_at LESS 0)
            gbl_cov_error(semantic-boundary-vector-invalid "${row_id}: operand=${vector},C=${carry}")
          endif()
        endforeach()
      endforeach()
    endif()
    if(row_id STREQUAL "529906570")
      if(NOT program MATCHES "0xFFFFFFFC" OR
         NOT program MATCHES "0x01800002" OR
         NOT program MATCHES "0x03000000" OR
         NOT program MATCHES "r5, LSL #1" OR
         NOT program MATCHES "0x11223344")
        gbl_cov_error(semantic-source-edge-invalid "${row_id}: scaled-address-wrap")
      endif()
    elseif(row_id STREQUAL "363662911")
      if(NOT program MATCHES "ldrh r0, \\[r4, #5\\]" OR
         NOT program MATCHES "0x44000033")
        gbl_cov_error(semantic-source-edge-invalid "${row_id}: odd-LDRH-rotation")
      endif()
    elseif(row_id STREQUAL "375018760")
      if(NOT program MATCHES "ldrsh r0, \\[r4, #5\\]" OR
         NOT program MATCHES "0xFFFFFF80")
        gbl_cov_error(semantic-source-edge-invalid "${row_id}: odd-LDRSH-signed-byte")
      endif()
    elseif(row_id STREQUAL "397407432")
      if(NOT program MATCHES "strh r2, \\[r4, #5\\]" OR
         NOT program MATCHES "0x5566C3D4")
        gbl_cov_error(semantic-source-edge-invalid "${row_id}: odd-STRH-align-down")
      endif()
    elseif(row_id STREQUAL "314196076" OR row_id STREQUAL "433134728")
      if(NOT program MATCHES "Lpc_target\\+3" OR
         NOT program MATCHES "0x00000011" OR
         NOT program MATCHES "0x00000022" OR
         NOT program MATCHES "mrs r1,cpsr")
        gbl_cov_error(semantic-source-edge-invalid "${row_id}: odd-loaded-PC-target")
      endif()
    endif()
  elseif(source_kind STREQUAL "guest-stop")
    if(row_isa STREQUAL "arm")
      math(EXPR guest_stop_count "${guest_stop_count}+1")
    else()
      math(EXPR thumb_stop_count "${thumb_stop_count}+1")
    endif()
    string(JSON program GET "${row_json}" source_test program)
    string(JSON operation GET "${row_json}" source_test operation)
    string(JSON stop_reason GET "${row_json}" source_test expected_reason)
    string(JSON witness_id GET "${row_json}" source_test witness_id)
    set(expected_stop_status "GUEST_STOP/${stop_reason}; semantic PENDING")
    string(FIND "${program}" "0x47424C4B" magic_position)
    string(FIND "${program}" "str r2,[r1,#4]" version_position)
    string(REPLACE "movs r2" "mov r2" stop_program "${program}")
    string(FIND "${stop_program}" "mov r2,#1\nstr r2,[r1,#8]" running_state_position)
    string(FIND "${program}" "str r2,[r1,#12]" id_position)
    string(FIND "${program}" "str r2,[r1,#16]" completion_position)
    string(FIND "${program}" "${operation}" operation_position)
    string(TOLOWER "${program}" normalized_stop_program)
    math(EXPR witness_hex "${row_id}" OUTPUT_FORMAT HEXADECIMAL)
    string(TOLOWER "${witness_hex}" witness_hex)
    if(NOT row_boundary STREQUAL "guest-stop" OR
       NOT row_expected_status STREQUAL expected_stop_status OR
       NOT "${witness_id}" STREQUAL "${row_id}" OR
       NOT "${stop_reason}" MATCHES "^(no-bios-swi|no-bios-undefined|no-bios-coprocessor|unpredictable-instruction)$" OR
       NOT normalized_stop_program MATCHES "${witness_hex}" OR
       magic_position LESS 0 OR version_position LESS 0 OR
       running_state_position LESS 0 OR id_position LESS 0 OR
       completion_position LESS 0 OR operation_position LESS completion_position OR
       "${operation}" STREQUAL "" OR program MATCHES "GBL_ASSERT_")
      gbl_cov_error(guest-stop-source-invalid "${row_id}")
    endif()
    if(row_isa STREQUAL "arm")
    list(FIND guest_stop_reasons "${stop_reason}" stop_reason_seen)
    if(NOT stop_reason_seen EQUAL -1)
      gbl_cov_error(duplicate-guest-stop-reason "${stop_reason}")
    endif()
    list(APPEND guest_stop_reasons "${stop_reason}")
    endif()
    list(APPEND guest_stop_ids "${row_id}")
  elseif(source_kind STREQUAL "cpu-api")
    math(EXPR cpu_api_count "${cpu_api_count}+1")
    string(JSON api_evidence GET "${row_json}" source_test evidence)
    if(NOT row_boundary STREQUAL "cpu-api" OR
       NOT row_expected_status MATCHES "^API_ONLY($|/no-bios-vector-boundary$)" OR
       "${api_evidence}" STREQUAL "")
      gbl_cov_error(cpu-api-boundary-invalid "${row_id}")
    endif()
    if(row_id STREQUAL "1147774326")
      if(NOT row_companions STREQUAL "419836810;301305780" OR
         NOT api_evidence MATCHES "exact MUL and MLA source cases")
        gbl_cov_error(policy-companion-map-invalid "${row_id}: short-multiply-flags")
      endif()
    elseif(row_id STREQUAL "1263725929")
      if(NOT row_companions STREQUAL "320234117;378322231;324645631;519488761" OR
         NOT api_evidence MATCHES "exact UMULL, UMLAL, SMULL and SMLAL")
        gbl_cov_error(policy-companion-map-invalid "${row_id}: long-multiply-flags")
      endif()
    elseif(row_id STREQUAL "1275797271")
      if(NOT row_companions STREQUAL "529906570" OR
         NOT api_evidence MATCHES "exact scaled-register LDR case")
        gbl_cov_error(policy-companion-map-invalid "${row_id}: data-address-wrap")
      endif()
    elseif(row_id STREQUAL "1214630623")
      if(NOT row_companions STREQUAL "314196076;433134728" OR
         NOT api_evidence MATCHES "deliberately odd \.Lpc_target\\+3")
        gbl_cov_error(policy-companion-map-invalid "${row_id}: loaded-PC-alignment")
      endif()
    elseif(row_id STREQUAL "1232880025" OR row_id STREQUAL "1129470292")
