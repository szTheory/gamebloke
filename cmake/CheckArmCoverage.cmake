# ARM7TDMI ARMv4T family/form coverage ledger. MODE=draft permits visibly
# pending implementation rows; MODE=final refuses any missing/unwitnessed row.
cmake_minimum_required(VERSION 3.25)

foreach(required IN ITEMS MODE MATRIX)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "coverage: missing-${required}")
  endif()
endforeach()
if(NOT MODE MATCHES "^(draft|final)$")
  message(FATAL_ERROR "coverage: unsupported-mode: ${MODE}")
endif()
if(NOT EXISTS "${MATRIX}" OR IS_DIRECTORY "${MATRIX}" OR IS_SYMLINK "${MATRIX}")
  message(FATAL_ERROR "coverage: matrix-missing")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/GblJson.cmake")
file(READ "${MATRIX}" matrix_json)
string(JSON matrix_type ERROR_VARIABLE matrix_error TYPE "${matrix_json}")
if(NOT "${matrix_error}" STREQUAL "NOTFOUND" OR NOT "${matrix_type}" STREQUAL "OBJECT")
  message(FATAL_ERROR "coverage: malformed-matrix")
endif()
gbl_json_string(schema "${matrix_json}" schema)
gbl_json_string(stage "${matrix_json}" stage)
gbl_json_string(id_allocation "${matrix_json}" id_allocation)
gbl_json_length(case_count "${matrix_json}" cases)
if(NOT "${schema}" STREQUAL "gamebloke.armv4t-coverage/1")
  message(FATAL_ERROR "coverage: bad-schema")
endif()
if(case_count LESS 1)
  message(FATAL_ERROR "coverage: empty-cases")
endif()
if(NOT "${stage}" STREQUAL "${MODE}")
  message(FATAL_ERROR "coverage: stage-mode-mismatch: matrix=${stage} mode=${MODE}")
endif()
if("${id_allocation}" STREQUAL "<missing>" OR
   NOT "${id_allocation}" MATCHES "ordering is never used")
  message(FATAL_ERROR "coverage: unstable-id-allocation")
endif()

# These required keys are derived from the full ARMv4T boundary in 05-CPU-NOTES.md.
# Case IDs are explicit data; inventory completeness is checked by family/form.
set(expected_inventory "")
macro(gbl_expect_form isa family form format)
  list(APPEND expected_inventory "${isa}|${family}|${form}|${format}")
endmacro()

