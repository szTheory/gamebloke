# Read the single trusted Nintendo logo-window digest authority row without
# exposing its content in diagnostics.
function(gbl_read_logo_digest path out_var)
  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
    message(FATAL_ERROR "logo-digest: invalid-authority")
  endif()

  file(READ "${path}" content)
  string(REPLACE "\r\n" "\n" content "${content}")
  if(content MATCHES ";")
    message(FATAL_ERROR "logo-digest: invalid-authority")
  endif()
  string(REPLACE "\n" ";" lines "${content}")

  set(rows "")
  foreach(line IN LISTS lines)
    if(line STREQUAL "" OR line MATCHES "^#")
      continue()
    endif()
    list(APPEND rows "${line}")
  endforeach()
  list(LENGTH rows row_count)
  if(NOT row_count EQUAL 1)
    message(FATAL_ERROR "logo-digest: invalid-authority")
  endif()

  list(GET rows 0 row)
  if(row MATCHES "^owner-pending nintendo-logo-window$")
    set(digest "")
  elseif(row MATCHES "^([0-9a-f]+) nintendo-logo-window$")
    set(digest "${CMAKE_MATCH_1}")
    string(LENGTH "${digest}" digest_length)
    if(NOT digest_length EQUAL 64)
      message(FATAL_ERROR "logo-digest: invalid-authority")
    endif()
  else()
    message(FATAL_ERROR "logo-digest: invalid-authority")
  endif()

  set(${out_var} "${digest}" PARENT_SCOPE)
endfunction()
