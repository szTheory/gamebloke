cmake_minimum_required(VERSION 3.25)
include_guard(GLOBAL)

# Resolve an existing path or its nearest existing ancestor. A dangling
# symlink is surfaced instead of being treated as an ordinary missing leaf.
function(gbl_resolve_path out_path out_status path)
  get_filename_component(absolute_path "${path}" ABSOLUTE)
  set(ancestor "${absolute_path}")
  while(NOT EXISTS "${ancestor}" AND NOT IS_SYMLINK "${ancestor}")
    get_filename_component(parent "${ancestor}" DIRECTORY)
    if(parent STREQUAL ancestor)
      set(${out_path} "" PARENT_SCOPE)
      set(${out_status} "unresolvable" PARENT_SCOPE)
      return()
    endif()
    set(ancestor "${parent}")
  endwhile()
  if(IS_SYMLINK "${ancestor}" AND NOT EXISTS "${ancestor}")
    set(${out_path} "" PARENT_SCOPE)
    set(${out_status} "dangling-symlink" PARENT_SCOPE)
    return()
  endif()

  file(REAL_PATH "${ancestor}" resolved_ancestor)
  file(RELATIVE_PATH suffix "${ancestor}" "${absolute_path}")
  if(suffix STREQUAL "")
    set(resolved "${resolved_ancestor}")
  else()
    set(resolved "${resolved_ancestor}/${suffix}")
  endif()
  cmake_path(NORMAL_PATH resolved)
  set(${out_path} "${resolved}" PARENT_SCOPE)
  set(${out_status} "ok" PARENT_SCOPE)
endfunction()

function(gbl_path_is_within out_is_within root candidate)
  if("${candidate}" STREQUAL "${root}")
    set(${out_is_within} TRUE PARENT_SCOPE)
    return()
  endif()
  set(root_path "${root}")
  cmake_path(IS_PREFIX root_path "${candidate}" NORMALIZE is_within)
  set(${out_is_within} "${is_within}" PARENT_SCOPE)
endfunction()

# Resolve both paths before comparing them. The root itself may be a symlink;
# containment is defined relative to its resolved location.
function(gbl_resolve_contained_path out_path out_status root candidate)
  gbl_resolve_path(root_real root_status "${root}")
  if(NOT root_status STREQUAL "ok")
    set(${out_path} "" PARENT_SCOPE)
    set(${out_status} "root-${root_status}" PARENT_SCOPE)
    return()
  endif()
  gbl_resolve_path(candidate_real candidate_status "${candidate}")
  if(NOT candidate_status STREQUAL "ok")
    set(${out_path} "" PARENT_SCOPE)
    set(${out_status} "${candidate_status}" PARENT_SCOPE)
    return()
  endif()
  gbl_path_is_within(is_within "${root_real}" "${candidate_real}")
  if(NOT is_within)
    set(${out_path} "${candidate_real}" PARENT_SCOPE)
    set(${out_status} "path-escape" PARENT_SCOPE)
    return()
  endif()
  set(${out_path} "${candidate_real}" PARENT_SCOPE)
  set(${out_status} "ok" PARENT_SCOPE)
endfunction()

function(gbl_ensure_directory_contained out_status root directory)
  gbl_resolve_contained_path(directory_real status "${root}" "${directory}")
  if(NOT status STREQUAL "ok")
    set(${out_status} "${status}" PARENT_SCOPE)
    return()
  endif()
  if(EXISTS "${directory}" AND NOT IS_DIRECTORY "${directory}")
    set(${out_status} "not-a-directory" PARENT_SCOPE)
    return()
  endif()
  file(MAKE_DIRECTORY "${directory}")
  gbl_resolve_contained_path(directory_real status "${root}" "${directory}")
  set(${out_status} "${status}" PARENT_SCOPE)
endfunction()

# Remove one generated file only after checking its resolved destination. This
# lets callers clear stale metadata without following an escaping link.
function(gbl_remove_file_contained out_status root path)
  gbl_resolve_contained_path(path_real status "${root}" "${path}")
  if(status STREQUAL "ok")
    file(REMOVE "${path}")
  endif()
  set(${out_status} "${status}" PARENT_SCOPE)
endfunction()

function(gbl_write_file_contained out_status out_reason root path contents)
  gbl_resolve_contained_path(path_real status "${root}" "${path}")
  if(NOT status STREQUAL "ok")
    set(${out_status} "${status}" PARENT_SCOPE)
    set(${out_reason} "write-destination-${status}" PARENT_SCOPE)
    return()
  endif()
  if(EXISTS "${path}" AND IS_DIRECTORY "${path}")
    set(${out_status} "destination-not-file" PARENT_SCOPE)
    set(${out_reason} "write-destination-not-file" PARENT_SCOPE)
    return()
  endif()
  get_filename_component(parent "${path}" DIRECTORY)
  gbl_ensure_directory_contained(parent_status "${root}" "${parent}")
  if(NOT parent_status STREQUAL "ok")
    set(${out_status} "${parent_status}" PARENT_SCOPE)
    set(${out_reason} "write-parent-${parent_status}" PARENT_SCOPE)
    return()
  endif()
  gbl_resolve_contained_path(path_real status "${root}" "${path}")
  if(NOT status STREQUAL "ok")
    set(${out_status} "${status}" PARENT_SCOPE)
    set(${out_reason} "write-destination-${status}" PARENT_SCOPE)
    return()
  endif()
  if(EXISTS "${path}" AND IS_DIRECTORY "${path}")
    set(${out_status} "destination-not-file" PARENT_SCOPE)
    set(${out_reason} "write-destination-not-file" PARENT_SCOPE)
    return()
  endif()
  file(WRITE "${path}" "${contents}")
  set(${out_status} "ok" PARENT_SCOPE)
  set(${out_reason} "" PARENT_SCOPE)
endfunction()

# Copy through a unique temporary file at the resolved root. The destination
# and its parent are checked before any directory creation and checked again
# before the staged file is atomically moved into place.
function(gbl_copy_file_contained out_status out_reason source root destination)
  gbl_resolve_path(root_real root_status "${root}")
  if(NOT root_status STREQUAL "ok")
    set(${out_status} "${root_status}" PARENT_SCOPE)
    set(${out_reason} "copy-root-${root_status}" PARENT_SCOPE)
    return()
  endif()
  gbl_resolve_contained_path(destination_real destination_status
    "${root_real}" "${destination}")
  if(NOT destination_status STREQUAL "ok")
    set(${out_status} "${destination_status}" PARENT_SCOPE)
    set(${out_reason} "copy-destination-${destination_status}" PARENT_SCOPE)
    return()
  endif()
  if(NOT EXISTS "${source}" OR IS_SYMLINK "${source}" OR IS_DIRECTORY "${source}")
    set(${out_status} "source-not-regular" PARENT_SCOPE)
    set(${out_reason} "copy-source-not-regular" PARENT_SCOPE)
    return()
  endif()
  if(EXISTS "${destination}" AND IS_DIRECTORY "${destination}")
    set(${out_status} "destination-not-file" PARENT_SCOPE)
    set(${out_reason} "copy-destination-not-file" PARENT_SCOPE)
    return()
  endif()

  get_filename_component(destination_dir "${destination}" DIRECTORY)
  gbl_ensure_directory_contained(directory_status "${root_real}" "${destination_dir}")
  if(NOT directory_status STREQUAL "ok")
    set(${out_status} "${directory_status}" PARENT_SCOPE)
    set(${out_reason} "copy-parent-${directory_status}" PARENT_SCOPE)
    return()
  endif()
  gbl_resolve_contained_path(destination_real destination_status
    "${root_real}" "${destination}")
  if(NOT destination_status STREQUAL "ok")
    set(${out_status} "${destination_status}" PARENT_SCOPE)
    set(${out_reason} "copy-destination-${destination_status}" PARENT_SCOPE)
    return()
  endif()
  if(EXISTS "${destination}" AND IS_DIRECTORY "${destination}")
    set(${out_status} "destination-not-file" PARENT_SCOPE)
    set(${out_reason} "copy-destination-not-file" PARENT_SCOPE)
    return()
  endif()

  string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef stage_token)
  set(stage "${root_real}/.gbl-admission-${stage_token}.tmp")
  gbl_resolve_contained_path(stage_real stage_status "${root_real}" "${stage}")
  if(NOT stage_status STREQUAL "ok" OR EXISTS "${stage}" OR IS_SYMLINK "${stage}")
    set(${out_status} "staging-path-unavailable" PARENT_SCOPE)
    set(${out_reason} "copy-staging-path-unavailable" PARENT_SCOPE)
    return()
  endif()

  file(COPY_FILE "${source}" "${stage}" RESULT copy_result)
  if(NOT copy_result STREQUAL "0")
    file(REMOVE "${stage}")
    set(${out_status} "copy-failed" PARENT_SCOPE)
    set(${out_reason} "copy-staging-failed:${copy_result}" PARENT_SCOPE)
    return()
  endif()
  gbl_resolve_contained_path(destination_real destination_status
    "${root_real}" "${destination}")
  if(NOT destination_status STREQUAL "ok")
    file(REMOVE "${stage}")
    set(${out_status} "${destination_status}" PARENT_SCOPE)
    set(${out_reason} "copy-destination-${destination_status}" PARENT_SCOPE)
    return()
  endif()
  file(RENAME "${stage}" "${destination}" RESULT rename_result)
  if(NOT rename_result STREQUAL "0")
    file(REMOVE "${stage}")
    set(${out_status} "copy-failed" PARENT_SCOPE)
    set(${out_reason} "copy-publish-failed:${rename_result}" PARENT_SCOPE)
    return()
  endif()
  set(${out_status} "ok" PARENT_SCOPE)
  set(${out_reason} "" PARENT_SCOPE)
endfunction()
