# Ruleset validator, projecting canonicalizer, and JSON readers for
# scripts/apply-repo-settings.sh (D-13, orchestrator resolution 2).
#
#   cmake -DMODE=validate        -DFILE=<ruleset.json>                      -P cmake/RulesetCheck.cmake
#   cmake -DMODE=canon           -DFILE=<ruleset.json> [-DREF=<ruleset.json>] -P ...
#   cmake -DMODE=find-id         -DFILE=<rulesets listing, paginate --slurp>  -P ...
#   cmake -DMODE=ci-required-ok  -DFILE=<check-runs response>                 -P ...
#   cmake -DMODE=advisory        -DREPO_JSON=<repo json> -DPERMS_JSON=<actions permissions json> -P ...
#
# All JSON goes through string(JSON); no gh --jq is involved, so a stub gh can
# serve every branch of the apply script offline (W4).
#
# validate: the authorization is the ruleset named `main` on the default
# branch, active, with no bypass actor and exactly two rules, pull_request and
# required_status_checks, whose only required check is `CI required` from
# GitHub Actions (integration id 15368). Every finding is printed, then exit 1.
#
# canon (W-8): prints sorted canonical lines so two rulesets compare with
# diff. With REF (the committed file) the input is projected onto what REF
# sets: a top-level key, a key inside conditions, or a key inside a rule's
# parameters is kept only when REF sets the same key at the same place
# (recursively for nested objects), and the server-only fields are dropped. A
# server-filled default the committed file omits is therefore not drift. These
# parts are compared in full whatever REF says: the set of rule types, the
# bypass actors, the ref_name include and exclude lists, and the required
# status check list. Without REF every non-server-only key is printed.
#
# Reason codes (standard error, exit 1):
#   ruleset: bypass-actors
#   ruleset: unauthorized-rule: <type>
#   ruleset: missing-rule: <type>
#   ruleset: required-check
#   ruleset: enforcement: <what>      (enforcement, target, name or ref scope)
#   ruleset: unreadable: <why>
#   ruleset: ok                       (validate success)
if(NOT DEFINED MODE)
  message(FATAL_ERROR "ruleset: usage: -DMODE=validate|canon|find-id|ci-required-ok|advisory")
endif()

set(RS_SERVER_ONLY id node_id source source_type created_at updated_at _links
  current_user_can_bypass)
set(RS_AUTHORIZED_RULES pull_request required_status_checks)
set(RS_CHECK_CONTEXT "CI required")
set(RS_CHECK_INTEGRATION 15368)

# --- helpers ---------------------------------------------------------------

function(rs__read out path)
  if("${path}" STREQUAL "" OR NOT EXISTS "${path}")
    message(FATAL_ERROR "ruleset: unreadable: no such file: ${path}")
  endif()
  file(READ "${path}" text)
  string(JSON t ERROR_VARIABLE err TYPE "${text}")
  if(NOT "${err}" STREQUAL "NOTFOUND")
    message(FATAL_ERROR "ruleset: unreadable: not JSON: ${path}")
  endif()
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

# JSON type of the element at the key path, or MISSING.
function(rs__type out json)
  string(JSON t ERROR_VARIABLE err TYPE "${json}" ${ARGN})
  if(NOT "${err}" STREQUAL "NOTFOUND")
    set(${out} "MISSING" PARENT_SCOPE)
  else()
    set(${out} "${t}" PARENT_SCOPE)
  endif()
endfunction()

# Escape what would split or unbalance a CMake list, so a canonical line is
# always one list element.
function(rs__esc out value)
  string(REPLACE ";" "%3B" value "${value}")
  string(REPLACE "[" "%5B" value "${value}")
  string(REPLACE "]" "%5D" value "${value}")
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

# Printable scalar at the key path: `<absent>` when missing, `<OBJECT>` or
# `<ARRAY>` for containers, true/false/null/number/string otherwise.
function(rs__scalar out json)
  rs__type(t "${json}" ${ARGN})
  if(t STREQUAL "MISSING")
    set(${out} "<absent>" PARENT_SCOPE)
    return()
  endif()
  if(t STREQUAL "OBJECT" OR t STREQUAL "ARRAY")
    set(${out} "<${t}>" PARENT_SCOPE)
    return()
  endif()
  if(t STREQUAL "NULL")
    set(${out} "null" PARENT_SCOPE)
    return()
  endif()
  string(JSON v GET "${json}" ${ARGN})
  if(t STREQUAL "BOOLEAN")
    if(v)
      set(v "true")
    else()
      set(v "false")
    endif()
  endif()
  rs__esc(v "${v}")
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Sorted, comma-joined scalar elements of the array at the key path; empty when
# the array is empty or absent.
function(rs__list out json)
  rs__type(t "${json}" ${ARGN})
  set(items "")
  if(t STREQUAL "ARRAY")
    string(JSON n LENGTH "${json}" ${ARGN})
    if(n GREATER 0)
      math(EXPR last "${n} - 1")
      foreach(i RANGE ${last})
        rs__scalar(v "${json}" ${ARGN} ${i})
        list(APPEND items "${v}")
      endforeach()
    endif()
  endif()
  list(SORT items)
  list(JOIN items "," joined)
  set(${out} "${joined}" PARENT_SCOPE)
endfunction()

function(rs__emit line)
  set_property(GLOBAL APPEND PROPERTY RS_LINES "${line}")
endfunction()

# Print text on standard output (message() would go to standard error).
function(rs__print text)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${text}")
endfunction()

# Generic flatten of an OBJECT into path=value lines. With use_ref, a member is
# kept only when refjson sets the same key, and descends with that member of
# refjson. Arrays are compared in full (their elements are not projected).
function(rs__flat prefix json refjson use_ref skip)
  string(JSON n LENGTH "${json}")
  if(n EQUAL 0)
    return()
  endif()
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON key MEMBER "${json}" ${i})
    if(key IN_LIST skip)
      continue()
    endif()
    set(child_ref "")
    if(use_ref)
      rs__type(rt "${refjson}" "${key}")
      if(rt STREQUAL "MISSING")
        continue()
      endif()
      if(rt STREQUAL "OBJECT")
        string(JSON child_ref GET "${refjson}" "${key}")
      endif()
    endif()
    if("${prefix}" STREQUAL "")
      set(path "${key}")
    else()
      set(path "${prefix}.${key}")
    endif()
    rs__type(ct "${json}" "${key}")
    if(ct STREQUAL "OBJECT")
      string(JSON child GET "${json}" "${key}")
      set(sub_use_ref ${use_ref})
      if(use_ref AND NOT rt STREQUAL "OBJECT")
        # REF holds a non-object here: keep the remote object whole so the
        # difference shows.
        set(sub_use_ref 0)
      endif()
      rs__flat("${path}" "${child}" "${child_ref}" ${sub_use_ref} "")
    elseif(ct STREQUAL "ARRAY")
      string(JSON len LENGTH "${json}" "${key}")
      rs__emit("${path}.length=${len}")
      if(len GREATER 0)
        math(EXPR alast "${len} - 1")
        foreach(j RANGE ${alast})
          rs__type(et "${json}" "${key}" ${j})
          if(et STREQUAL "OBJECT")
            string(JSON elem GET "${json}" "${key}" ${j})
            rs__flat("${path}.${j}" "${elem}" "" 0 "")
          else()
            rs__scalar(v "${json}" "${key}" ${j})
            rs__emit("${path}.${j}=${v}")
          endif()
        endforeach()
      endif()
    else()
      rs__scalar(v "${json}" "${key}")
      rs__emit("${path}=${v}")
    endif()
  endforeach()
endfunction()

# Required status check list of a rule's parameters, as sorted
# <context>:<integration id> lines under the given prefix.
function(rs__emit_checks prefix json ruleidx)
  rs__type(t "${json}" rules ${ruleidx} parameters required_status_checks)
  if(NOT t STREQUAL "ARRAY")
    return()
  endif()
  string(JSON n LENGTH "${json}" rules ${ruleidx} parameters required_status_checks)
  if(n EQUAL 0)
    return()
  endif()
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    rs__scalar(ctx "${json}" rules ${ruleidx} parameters required_status_checks ${i} context)
    rs__scalar(iid "${json}" rules ${ruleidx} parameters required_status_checks ${i} integration_id)
    rs__emit("${prefix}.required_check=${ctx}:${iid}")
  endforeach()
endfunction()

function(rs__canon json ref use_ref)
  set_property(GLOBAL PROPERTY RS_LINES "")

  # Top level: everything but the server-only fields and the three parts that
  # are compared specially below.
  rs__flat("" "${json}" "${ref}" ${use_ref}
    "${RS_SERVER_ONLY};rules;bypass_actors;conditions")

  # conditions: other keys are projected; the ref_name lists are always
  # compared in full (an absent list equals an empty one).
  rs__type(ct "${json}" conditions)
  if(ct STREQUAL "OBJECT")
    string(JSON cj GET "${json}" conditions)
    set(cref "")
    set(cuse ${use_ref})
    if(use_ref)
      rs__type(rct "${ref}" conditions)
      if(rct STREQUAL "OBJECT")
        string(JSON cref GET "${ref}" conditions)
      else()
        set(cuse 0)
        set(skip_conditions 1)
      endif()
    endif()
    if(NOT skip_conditions)
      rs__flat("conditions" "${cj}" "${cref}" ${cuse} "ref_name")
    endif()
  endif()
  rs__list(inc "${json}" conditions ref_name include)
  rs__list(exc "${json}" conditions ref_name exclude)
  rs__emit("conditions.ref_name.include=${inc}")
  rs__emit("conditions.ref_name.exclude=${exc}")

  # bypass_actors: count plus every actor, always.
  rs__type(bt "${json}" bypass_actors)
  set(bn 0)
  if(bt STREQUAL "ARRAY")
    string(JSON bn LENGTH "${json}" bypass_actors)
  endif()
  rs__emit("bypass_actors.count=${bn}")
  if(bn GREATER 0)
    math(EXPR blast "${bn} - 1")
    foreach(i RANGE ${blast})
      rs__scalar(aid "${json}" bypass_actors ${i} actor_id)
      rs__scalar(aty "${json}" bypass_actors ${i} actor_type)
      rs__scalar(amo "${json}" bypass_actors ${i} bypass_mode)
      rs__emit("bypass_actor=${aid},${aty},${amo}")
    endforeach()
  endif()

  # rules: the type set is always compared; parameters are projected onto the
  # committed rule of the same type, except the required check list.
  rs__type(rt "${json}" rules)
  if(rt STREQUAL "ARRAY")
    string(JSON rn LENGTH "${json}" rules)
    if(rn GREATER 0)
      math(EXPR rlast "${rn} - 1")
      foreach(i RANGE ${rlast})
        rs__scalar(rtype "${json}" rules ${i} type)
        rs__emit("rule_type=${rtype}")
        if(rtype STREQUAL "required_status_checks")
          rs__emit_checks("rule.${rtype}" "${json}" ${i})
        endif()
        rs__type(pt "${json}" rules ${i} parameters)
        if(NOT pt STREQUAL "OBJECT")
          continue()
        endif()
        string(JSON pj GET "${json}" rules ${i} parameters)
        set(pref "")
        set(puse 0)
        if(use_ref)
          # Find the committed rule of the same type; none means nothing to
          # project onto (the type set already shows the difference).
          set(found 0)
          rs__type(rrt "${ref}" rules)
          if(rrt STREQUAL "ARRAY")
            string(JSON rrn LENGTH "${ref}" rules)
            if(rrn GREATER 0)
              math(EXPR rrlast "${rrn} - 1")
              foreach(k RANGE ${rrlast})
                rs__scalar(kt "${ref}" rules ${k} type)
                if(kt STREQUAL rtype)
                  rs__type(kpt "${ref}" rules ${k} parameters)
                  if(kpt STREQUAL "OBJECT")
                    string(JSON pref GET "${ref}" rules ${k} parameters)
                    set(found 1)
                  endif()
                  break()
                endif()
              endforeach()
            endif()
          endif()
          if(NOT found)
            continue()
          endif()
          set(puse 1)
        endif()
        rs__flat("rule.${rtype}" "${pj}" "${pref}" ${puse} "required_status_checks")
      endforeach()
    endif()
  endif()

  get_property(lines GLOBAL PROPERTY RS_LINES)
  list(SORT lines)
  list(REMOVE_DUPLICATES lines)
  list(JOIN lines "\n" text)
  rs__print("${text}")
endfunction()

# --- modes -----------------------------------------------------------------

function(rs__validate json)
  set(findings "")

  rs__scalar(v "${json}" name)
  if(NOT v STREQUAL "main")
    list(APPEND findings "ruleset: enforcement: name=${v} (must be main)")
  endif()
  rs__scalar(v "${json}" target)
  if(NOT v STREQUAL "branch")
    list(APPEND findings "ruleset: enforcement: target=${v} (must be branch)")
  endif()
  rs__scalar(v "${json}" enforcement)
  if(NOT v STREQUAL "active")
    list(APPEND findings "ruleset: enforcement: enforcement=${v} (must be active)")
  endif()
  rs__list(inc "${json}" conditions ref_name include)
  rs__list(exc "${json}" conditions ref_name exclude)
  if(NOT inc STREQUAL "~DEFAULT_BRANCH" OR NOT exc STREQUAL "")
    list(APPEND findings
      "ruleset: enforcement: ref_name include=${inc} exclude=${exc} (must be ~DEFAULT_BRANCH and none)")
  endif()

  rs__type(bt "${json}" bypass_actors)
  set(bn -1)
  if(bt STREQUAL "ARRAY")
    string(JSON bn LENGTH "${json}" bypass_actors)
  endif()
  if(NOT bn EQUAL 0)
    list(APPEND findings "ruleset: bypass-actors (must be present and empty)")
  endif()

  set(seen "")
  set(check_idx -1)
  rs__type(rt "${json}" rules)
  if(rt STREQUAL "ARRAY")
    string(JSON rn LENGTH "${json}" rules)
    if(rn GREATER 0)
      math(EXPR rlast "${rn} - 1")
      foreach(i RANGE ${rlast})
        rs__scalar(rtype "${json}" rules ${i} type)
        if(NOT rtype IN_LIST RS_AUTHORIZED_RULES)
          list(APPEND findings "ruleset: unauthorized-rule: ${rtype}")
        elseif(rtype IN_LIST seen)
          list(APPEND findings "ruleset: unauthorized-rule: ${rtype} (duplicate)")
        else()
          list(APPEND seen "${rtype}")
          if(rtype STREQUAL "required_status_checks")
            set(check_idx ${i})
          endif()
        endif()
      endforeach()
    endif()
  endif()
  foreach(need IN LISTS RS_AUTHORIZED_RULES)
    if(NOT need IN_LIST seen)
      list(APPEND findings "ruleset: missing-rule: ${need}")
    endif()
  endforeach()

  if(check_idx GREATER_EQUAL 0)
    set(ok 0)
    rs__type(ct "${json}" rules ${check_idx} parameters required_status_checks)
    if(ct STREQUAL "ARRAY")
      string(JSON cn LENGTH "${json}" rules ${check_idx} parameters required_status_checks)
      if(cn EQUAL 1)
        rs__scalar(ctx "${json}" rules ${check_idx} parameters required_status_checks 0 context)
        rs__scalar(iid "${json}" rules ${check_idx} parameters required_status_checks 0 integration_id)
        if(ctx STREQUAL RS_CHECK_CONTEXT AND iid STREQUAL RS_CHECK_INTEGRATION)
          set(ok 1)
        endif()
      endif()
    endif()
    if(NOT ok)
      list(APPEND findings
        "ruleset: required-check (must be exactly one check, context '${RS_CHECK_CONTEXT}', integration_id ${RS_CHECK_INTEGRATION})")
    endif()
  endif()

  if(findings)
    list(JOIN findings "\n" text)
    message(FATAL_ERROR "${text}")
  endif()
  rs__print("ruleset: ok")
endfunction()

function(rs__find_id json)
  rs__type(rt "${json}")
  if(NOT rt STREQUAL "ARRAY")
    return()
  endif()
  string(JSON n LENGTH "${json}")
  if(n EQUAL 0)
    return()
  endif()
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    rs__type(et "${json}" ${i})
    if(et STREQUAL "ARRAY")
      string(JSON pn LENGTH "${json}" ${i})
      if(pn GREATER 0)
        math(EXPR plast "${pn} - 1")
        foreach(j RANGE ${plast})
          rs__scalar(nm "${json}" ${i} ${j} name)
          if(nm STREQUAL "main")
            rs__scalar(id "${json}" ${i} ${j} id)
            rs__print("${id}")
            return()
          endif()
        endforeach()
      endif()
    elseif(et STREQUAL "OBJECT")
      rs__scalar(nm "${json}" ${i} name)
      if(nm STREQUAL "main")
        rs__scalar(id "${json}" ${i} id)
        rs__print("${id}")
        return()
      endif()
    endif()
  endforeach()
endfunction()

function(rs__ci_required_ok json)
  rs__type(t "${json}" check_runs)
  if(NOT t STREQUAL "ARRAY")
    return()
  endif()
  string(JSON n LENGTH "${json}" check_runs)
  if(n EQUAL 0)
    return()
  endif()
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    rs__scalar(nm "${json}" check_runs ${i} name)
    rs__scalar(cc "${json}" check_runs ${i} conclusion)
    if(nm STREQUAL RS_CHECK_CONTEXT AND cc STREQUAL "success")
      rs__print("success")
      return()
    endif()
  endforeach()
endfunction()

function(rs__advisory repo perms)
  rs__scalar(a "${repo}" squash_merge_commit_title)
  rs__scalar(b "${perms}" sha_pinning_required)
  rs__scalar(c "${repo}" security_and_analysis secret_scanning status)
  rs__scalar(d "${repo}" security_and_analysis secret_scanning_push_protection status)
  set(out "")
  foreach(pair IN ITEMS
      "squash_merge_commit_title|${a}"
      "actions sha_pinning_required|${b}"
      "secret_scanning|${c}"
      "secret_scanning_push_protection|${d}")
    string(REPLACE "|" ";" kv "${pair}")
    list(GET kv 0 key)
    list(GET kv 1 val)
    if(val STREQUAL "<absent>" OR val STREQUAL "null" OR val STREQUAL "<OBJECT>"
        OR val STREQUAL "<ARRAY>")
      set(val "unknown")
    endif()
    list(APPEND out "${key}=${val}")
  endforeach()
  list(JOIN out "\n" text)
  rs__print("${text}")
endfunction()

if(MODE STREQUAL "validate")
  rs__read(j "${FILE}")
  rs__validate("${j}")
elseif(MODE STREQUAL "canon")
  rs__read(j "${FILE}")
  set(ref_json "")
  set(use_ref 0)
  if(DEFINED REF AND NOT "${REF}" STREQUAL "")
    rs__read(ref_json "${REF}")
    set(use_ref 1)
  endif()
  rs__canon("${j}" "${ref_json}" ${use_ref})
elseif(MODE STREQUAL "find-id")
  rs__read(j "${FILE}")
  rs__find_id("${j}")
elseif(MODE STREQUAL "ci-required-ok")
  rs__read(j "${FILE}")
  rs__ci_required_ok("${j}")
elseif(MODE STREQUAL "advisory")
  rs__read(r "${REPO_JSON}")
  rs__read(p "${PERMS_JSON}")
  rs__advisory("${r}" "${p}")
else()
  message(FATAL_ERROR "ruleset: usage: unknown MODE '${MODE}'")
endif()
