cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED CASE OR NOT CASE STREQUAL "preset-contract")
  message(FATAL_ERROR "toolchain: unsupported-case")
endif()
if(NOT DEFINED SRC OR "${SRC}" STREQUAL "")
  message(FATAL_ERROR "toolchain: missing-source-root")
endif()

file(READ "${SRC}/CMakePresets.json" presets)
foreach(kind IN ITEMS configurePresets buildPresets testPresets workflowPresets)
  string(JSON count LENGTH "${presets}" "${kind}")
  set(found FALSE)
  if(count GREATER 0)
    math(EXPR last_index "${count} - 1")
    foreach(index RANGE 0 ${last_index})
      string(JSON name GET "${presets}" "${kind}" ${index} name)
      if(name STREQUAL "diagnostics")
        set(found TRUE)
        break()
      endif()
    endforeach()
  endif()
  if(NOT found)
    message(FATAL_ERROR "toolchain: missing-${kind}-diagnostics-preset")
  endif()
endforeach()

message(STATUS "toolchain: diagnostics-preset-contract ok")
