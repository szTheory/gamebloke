# Cheap profile/document/runtime policy gate for WAITCNT and DMA.
# This gate consumes existing selectors only; it never configures or builds.
cmake_minimum_required(VERSION 3.25)

foreach(required IN ITEMS SRC BIN)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "phase9-policy: missing-${required}")
  endif()
endforeach()
if(NOT DEFINED CASE)
  set(CASE all)
elseif("${CASE}" STREQUAL "")
  message(FATAL_ERROR "phase9-policy: invalid-case")
endif()
if(NOT CASE MATCHES "^(all|verify|control)$")
  message(FATAL_ERROR "phase9-policy: invalid-case")
endif()

get_filename_component(GBL_PHASE9_DEFAULT_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)
get_filename_component(GBL_PHASE9_SRC "${SRC}" REALPATH BASE_DIR "${GBL_PHASE9_DEFAULT_ROOT}")
get_filename_component(GBL_PHASE9_BIN "${BIN}" REALPATH BASE_DIR "${GBL_PHASE9_SRC}")
if(NOT IS_DIRECTORY "${GBL_PHASE9_SRC}" OR NOT IS_DIRECTORY "${GBL_PHASE9_BIN}" OR
   NOT "${GBL_PHASE9_SRC}" STREQUAL "${GBL_PHASE9_DEFAULT_ROOT}")
  message(FATAL_ERROR "phase9-policy: source-or-build-directory-missing-or-wrong-root")
endif()
set(cache_file "${GBL_PHASE9_BIN}/CMakeCache.txt")
if(NOT EXISTS "${cache_file}")
  message(FATAL_ERROR "phase9-policy: configured-build-cache-missing")
endif()
file(STRINGS "${cache_file}" source_root_line REGEX "^CMAKE_HOME_DIRECTORY:INTERNAL=")
string(REPLACE "CMAKE_HOME_DIRECTORY:INTERNAL=" "" configured_source "${source_root_line}")
get_filename_component(configured_source "${configured_source}" REALPATH)
if(NOT "${configured_source}" STREQUAL "${GBL_PHASE9_SRC}")
  message(FATAL_ERROR "phase9-policy: configured-source-root-mismatch")
endif()

include("${GBL_PHASE9_SRC}/cmake/GblJson.cmake")
find_program(CMAKE_PROGRAM NAMES cmake REQUIRED)
set(profile_file "${GBL_PHASE9_SRC}/profiles/agb.json")
set(doc_file "${GBL_PHASE9_SRC}/docs/profile-agb.md")
set(registry_file "${GBL_PHASE9_SRC}/registry/disputes.json")
set(vocab_file "${GBL_PHASE9_SRC}/contracts/evidence.json")
set(checker_file "${GBL_PHASE9_SRC}/cmake/CheckProfile.cmake")
set(bus_test "${GBL_PHASE9_BIN}/bus_test")
set(dma_test "${GBL_PHASE9_BIN}/dma_test")
set(timer_test "${GBL_PHASE9_BIN}/timer_test")
foreach(executable IN ITEMS "${bus_test}" "${dma_test}" "${timer_test}")
  if(NOT EXISTS "${executable}" OR IS_DIRECTORY "${executable}")
    message(FATAL_ERROR "phase9-policy: runtime-binary-missing")
  endif()
endforeach()

function(gbl_phase9_json out json)
  string(JSON value ERROR_VARIABLE error GET "${json}" ${ARGN})
  if(NOT "${error}" STREQUAL "NOTFOUND" AND NOT "${error}" STREQUAL "")
    set(value "")
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(gbl_phase9_observations out_records out_output executable selector expected_kind expected_count)
  execute_process(COMMAND "${executable}" "${selector}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(selector STREQUAL "waitcnt.matrix")
    set(selector_ok FALSE)
    if("${output}" MATCHES "waitcnt.matrix: all windows, selectors, widths, roles and directions ok")
      set(selector_ok TRUE)
    endif()
  else()
    set(selector_ok FALSE)
    if("${output}" MATCHES "TAP version 13")
      set(selector_ok TRUE)
    endif()
  endif()
  if(NOT "${result}" STREQUAL "0" OR NOT selector_ok)
    message(FATAL_ERROR "phase9-policy: runtime-selector-${selector}-failed (${result})\n${output}${error}")
  endif()
  string(REPLACE "\r" "" output "${output}")
  string(REPLACE "\n" ";" lines "${output}")
  set(records)
  foreach(line IN LISTS lines)
    if(line MATCHES "^phase9-observation:(.*)$")
      set(record "${CMAKE_MATCH_1}")
      gbl_phase9_json(schema "${record}" schema)
      gbl_phase9_json(kind "${record}" kind)
      if(NOT schema STREQUAL "gamebloke.phase9-observation/1" OR
         (NOT "${expected_kind}" STREQUAL "" AND NOT kind STREQUAL "${expected_kind}"))
        message(FATAL_ERROR "phase9-policy: runtime-observation-${selector}-wrong-type")
      endif()
      list(APPEND records "${record}")
    endif()
  endforeach()
  list(LENGTH records record_count)
  if(NOT record_count EQUAL expected_count)
    message(FATAL_ERROR "phase9-policy: runtime-observation-${selector}-count-${record_count}")
  endif()
  set(${out_records} "${records}" PARENT_SCOPE)
  set(${out_output} "${output}" PARENT_SCOPE)
endfunction()

function(gbl_phase9_expect_array reason_out json expected)
  string(JSON actual ERROR_VARIABLE error GET "${json}" ${ARGN})
  string(REPLACE " " "" actual "${actual}")
  string(REPLACE "\n" "" actual "${actual}")
  string(REPLACE "\r" "" actual "${actual}")
  if((NOT "${error}" STREQUAL "NOTFOUND" AND NOT "${error}" STREQUAL "") OR
     NOT "${actual}" STREQUAL "${expected}")
    set(${reason_out} "mismatch" PARENT_SCOPE)
  else()
    set(${reason_out} "" PARENT_SCOPE)
  endif()
endfunction()

function(gbl_phase9_check_profile candidate_profile reason_out)
  file(READ "${candidate_profile}" candidate)
  set(reason "")

  gbl_phase9_json(boot "${candidate}" boot)
  gbl_phase9_json(bios "${candidate}" bios_provider)
  if(NOT boot STREQUAL "direct-start" OR NOT bios STREQUAL "none")
    set(reason bios-policy)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()

  gbl_json_type(waitcnt_type "${candidate}" waitcnt_policy)
  gbl_json_type(dma_type "${candidate}" dma_policy)
  if(NOT waitcnt_type STREQUAL "OBJECT" OR NOT dma_type STREQUAL "OBJECT")
    set(reason missing-policy)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()

  # The independent table expectations are deliberately literal and separate
  # from the profile values that the records are being checked against.
  gbl_phase9_expect_array(array_reason "${candidate}" "[4,3,2,8]"
    waitcnt_policy windows 0 nonsequential_wait_choices)
  if(NOT array_reason STREQUAL "")
    set(reason wait-table)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()
  gbl_phase9_expect_array(array_reason "${candidate}" "[4,3,2,8]"
    waitcnt_policy windows 1 nonsequential_wait_choices)
  if(NOT array_reason STREQUAL "")
    set(reason wait-table)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()
  gbl_phase9_expect_array(array_reason "${candidate}" "[4,3,2,8]"
    waitcnt_policy windows 2 nonsequential_wait_choices)
  if(NOT array_reason STREQUAL "")
    set(reason wait-table)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()
  foreach(pair IN ITEMS "0;[2,1]" "1;[4,1]" "2;[8,1]")
    list(GET pair 0 window_index)
    list(GET pair 1 expected)
    gbl_phase9_expect_array(array_reason "${candidate}" "${expected}"
      waitcnt_policy windows ${window_index} sequential_wait_choices)
    if(NOT array_reason STREQUAL "")
      set(reason wait-table)
      set(${reason_out} "${reason}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(pair IN ITEMS "0;ws0;0x08000000;0x09FFFFFF" "1;ws1;0x0A000000;0x0BFFFFFF" "2;ws2;0x0C000000;0x0DFFFFFF")
    list(GET pair 0 window_index)
    list(GET pair 1 expected_id)
    list(GET pair 2 expected_first)
    list(GET pair 3 expected_last)
    gbl_phase9_json(window_id "${candidate}" waitcnt_policy windows ${window_index} id)
    gbl_phase9_json(window_first "${candidate}" waitcnt_policy windows ${window_index} first)
    gbl_phase9_json(window_last "${candidate}" waitcnt_policy windows ${window_index} last)
    if(NOT window_id STREQUAL expected_id OR NOT window_first STREQUAL expected_first OR
       NOT window_last STREQUAL expected_last)
      set(reason wait-table)
      set(${reason_out} "${reason}" PARENT_SCOPE)
      return()
    endif()
  endforeach()

  list(LENGTH GBL_PHASE9_BUS_RECORDS bus_record_count)
  if(NOT bus_record_count EQUAL 6)
    set(reason wait-table)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()
  foreach(window_index RANGE 0 2)
    math(EXPR quote_index "${window_index}*2")
    math(EXPR boundary_index "${quote_index}+1")
    list(GET GBL_PHASE9_BUS_RECORDS ${quote_index} quote)
    list(GET GBL_PHASE9_BUS_RECORDS ${boundary_index} boundary)
    gbl_phase9_json(window_id "${candidate}" waitcnt_policy windows ${window_index} id)
    gbl_phase9_json(n_wait "${candidate}" waitcnt_policy windows ${window_index} nonsequential_wait_choices 0)
    gbl_phase9_json(s_wait "${candidate}" waitcnt_policy windows ${window_index} sequential_wait_choices 0)
    math(EXPR expected_n_cycles "${n_wait}+1")
    math(EXPR expected_s_cycles "${s_wait}+1")
    gbl_phase9_json(waitcnt "${quote}" waitcnt)
    gbl_phase9_json(address "${quote}" address)
    gbl_phase9_json(width "${quote}" width)
    gbl_phase9_json(sequence "${quote}" requested_sequence)
    gbl_phase9_json(actual_window "${quote}" window)
    gbl_phase9_json(cycles "${quote}" cycles)
    gbl_phase9_json(beat_count "${quote}" beat_count)
    gbl_phase9_json(beat_cycle "${quote}" beat_cycles 0)
    gbl_phase9_json(provenance "${quote}" cost_provenance)
    gbl_phase9_json(cost_model "${quote}" cost_model)
    gbl_phase9_json(prefetch "${quote}" prefetch)
    gbl_phase9_json(qualification "${quote}" hardware_qualification)
    if(NOT waitcnt STREQUAL "0x0000" OR NOT width STREQUAL "2" OR
       NOT sequence STREQUAL "nonsequential" OR NOT actual_window STREQUAL "WS${window_index}" OR
       NOT beat_count STREQUAL "1" OR NOT beat_cycle STREQUAL "${expected_n_cycles}" OR
       NOT cycles STREQUAL "${expected_n_cycles}" OR NOT address MATCHES "^0x(08|0A|0C)000100$" OR
       NOT provenance STREQUAL "source-backed" OR
       NOT cost_model STREQUAL "nintendo-agb-programming-manual-v1.1" OR
       NOT prefetch STREQUAL "unmodeled" OR NOT qualification STREQUAL "UNKNOWN")
      set(reason wait-table)
      set(${reason_out} "${reason}" PARENT_SCOPE)
      return()
    endif()

    gbl_phase9_json(boundary_waitcnt "${boundary}" waitcnt)
    gbl_phase9_json(boundary_address "${boundary}" address)
    gbl_phase9_json(boundary_width "${boundary}" width)
    gbl_phase9_json(boundary_sequence "${boundary}" requested_sequence)
    gbl_phase9_json(boundary_window "${boundary}" window)
    gbl_phase9_json(boundary_cycles "${boundary}" cycles)
    gbl_phase9_json(boundary_count "${boundary}" beat_count)
    gbl_phase9_json(first_beat "${boundary}" beat_cycles 0)
    gbl_phase9_json(second_beat "${boundary}" beat_cycles 1)
    gbl_phase9_json(effective_first "${boundary}" effective_sequences 0)
    gbl_phase9_json(effective_second "${boundary}" effective_sequences 1)
    gbl_phase9_json(boundary_provenance "${boundary}" boundary_provenance)
    gbl_phase9_json(boundary_cost_source "${boundary}" cost_provenance)
    gbl_phase9_json(boundary_prefetch "${boundary}" prefetch)
    gbl_phase9_json(boundary_qualification "${boundary}" hardware_qualification)
    math(EXPR expected_boundary_cycles "${expected_s_cycles}+${expected_n_cycles}")
    if(NOT boundary_waitcnt STREQUAL "0x0000" OR
       NOT boundary_address MATCHES "^0x(08|0A|0C)01FFFE$" OR
       NOT boundary_width STREQUAL "4" OR NOT boundary_sequence STREQUAL "sequential" OR
       NOT boundary_window STREQUAL "WS${window_index}" OR NOT boundary_count STREQUAL "2" OR
       NOT first_beat STREQUAL "${expected_s_cycles}" OR
       NOT second_beat STREQUAL "${expected_n_cycles}" OR
       NOT boundary_cycles STREQUAL "${expected_boundary_cycles}" OR
       NOT effective_first STREQUAL "sequential" OR
       NOT effective_second STREQUAL "nonsequential" OR
       NOT boundary_provenance STREQUAL "community-gbatek-3.06" OR
       NOT boundary_cost_source STREQUAL "source-backed" OR
       NOT boundary_prefetch STREQUAL "unmodeled" OR
       NOT boundary_qualification STREQUAL "UNKNOWN")
      set(reason wait-table)
      set(${reason_out} "${reason}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  gbl_phase9_json(boundary_class "${candidate}" waitcnt_policy boundary classification)
  gbl_phase9_json(boundary_status "${candidate}" waitcnt_policy boundary hardware_qualification)
  gbl_phase9_json(boundary_provenance "${candidate}" waitcnt_policy boundary provenance)
  if(NOT boundary_class STREQUAL "secondary-community" OR
     NOT boundary_status STREQUAL "UNKNOWN" OR
     NOT boundary_provenance STREQUAL "GBATEK 3.06, Game Pak 128 KiB sequential boundary; secondary/community source only.")
    set(reason boundary-class)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()
  gbl_phase9_json(prefetch_execution "${candidate}" waitcnt_policy prefetch execution)
  gbl_phase9_json(prefetch_bit "${candidate}" waitcnt_policy register prefetch_bit)
  if(NOT prefetch_execution STREQUAL "unmodeled" OR NOT prefetch_bit STREQUAL "14")
    set(reason prefetch-unmodeled)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()

  # timer_test's contextual table supplies observed non-reset WAITCNT rows.
  set(context_count 0)
  set(nonreset_count 0)
  foreach(line IN LISTS GBL_PHASE9_CONTEXT_LINES)
    if(line MATCHES "^ws([0-2]),")
      string(REPLACE "," ";" fields "${line}")
      list(LENGTH fields field_count)
      if(NOT field_count EQUAL 8)
        set(reason wait-table)
        set(${reason_out} "${reason}" PARENT_SCOPE)
        return()
      endif()
      list(GET fields 0 window)
      list(GET fields 1 address)
      list(GET fields 2 waitcnt)
      list(GET fields 3 width)
      list(GET fields 4 sequence)
      list(GET fields 5 cycles)
      list(GET fields 6 cost_provenance)
      list(GET fields 7 cost_model)
      if(NOT cost_provenance STREQUAL "source-backed" OR
         NOT cost_model STREQUAL "nintendo-agb-programming-manual-v1.1")
        set(reason wait-table)
        set(${reason_out} "${reason}" PARENT_SCOPE)
        return()
      endif()
      math(EXPR context_count "${context_count}+1")
      if(waitcnt STREQUAL "06d8")
        math(EXPR nonreset_count "${nonreset_count}+1")
        if(window STREQUAL "ws0")
          set(index 0)
        elseif(window STREQUAL "ws1")
          set(index 1)
        else()
          set(index 2)
        endif()
        string(JSON n_bit GET "${candidate}" waitcnt_policy windows ${index} nonsequential_bits 0)
        string(JSON s_bit GET "${candidate}" waitcnt_policy windows ${index} sequential_bit)
        math(EXPR wait_value "0x${waitcnt}")
        math(EXPR n_selector "(${wait_value} >> ${n_bit}) & 3")
        math(EXPR s_selector "(${wait_value} >> ${s_bit}) & 1")
        gbl_phase9_json(n_wait "${candidate}" waitcnt_policy windows ${index} nonsequential_wait_choices ${n_selector})
        gbl_phase9_json(s_wait "${candidate}" waitcnt_policy windows ${index} sequential_wait_choices ${s_selector})
        if(sequence STREQUAL "n")
          set(first_wait "${n_wait}")
        elseif(sequence STREQUAL "s")
          set(first_wait "${s_wait}")
        else()
          set(reason wait-table)
          set(${reason_out} "${reason}" PARENT_SCOPE)
          return()
        endif()
        math(EXPR expected_cycles "${first_wait}+1")
        if(width STREQUAL "4")
          math(EXPR expected_cycles "${expected_cycles}+${s_wait}+1")
        elseif(NOT width STREQUAL "2")
          set(reason wait-table)
          set(${reason_out} "${reason}" PARENT_SCOPE)
          return()
        endif()
        if(NOT cycles STREQUAL "${expected_cycles}")
          set(reason wait-table)
          set(${reason_out} "${reason}" PARENT_SCOPE)
          return()
        endif()
      elseif(NOT waitcnt STREQUAL "0000")
        set(reason wait-table)
        set(${reason_out} "${reason}" PARENT_SCOPE)
        return()
      endif()
    endif()
  endforeach()
  if(NOT context_count EQUAL 24 OR NOT nonreset_count EQUAL 12)
    set(reason wait-table)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()

  # DMA manual register/address facts stay source-backed and independently
  # tied to the executable's focused register/transfer cases.
  foreach(pair IN ITEMS
      "source_address_masks;[\"0x07FFFFFF\",\"0x0FFFFFFF\",\"0x0FFFFFFF\",\"0x0FFFFFFF\"]"
      "destination_address_masks;[\"0x07FFFFFF\",\"0x07FFFFFF\",\"0x07FFFFFF\",\"0x0FFFFFFF\"]"
      "count_masks;[\"0x3FFF\",\"0x3FFF\",\"0x3FFF\",\"0xFFFF\"]"
      "zero_count_expansions;[16384,16384,16384,65536]"
      "transfer_width_bytes;[2,4]"
      "completion_if_bits;[8,9,10,11]"
      "source_modes;[\"increment\",\"decrement\",\"fixed\",\"unsupported\"]"
      "destination_modes;[\"increment\",\"decrement\",\"fixed\",\"increment-and-reload-channel-3-only\"]")
    list(GET pair 0 field)
    list(GET pair 1 expected)
    gbl_phase9_expect_array(array_reason "${candidate}" "${expected}" dma_policy source_facts ${field})
    if(NOT array_reason STREQUAL "")
      set(reason channel-mask)
      set(${reason_out} "${reason}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  gbl_phase9_json(dma_registers "${candidate}" dma_policy registers channel_count)
  gbl_phase9_json(dma_stride "${candidate}" dma_policy registers channel_stride_bytes)
  gbl_phase9_json(dma_control_mask "${candidate}" dma_policy registers control_mask)
  if(NOT dma_registers STREQUAL "4" OR NOT dma_stride STREQUAL "12" OR
     NOT dma_control_mask STREQUAL "0xFFE0")
    set(reason channel-mask)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()
  foreach(required_text IN ITEMS
      "four channels apply source, destination, and count masks"
      "byte, halfword, and word lanes program registers and enable edges relatch"
      "zero count expands per channel and active addresses align to transfer width"
      "DMA0 performs a timed halfword unit and raises its completion IF bit")
    string(FIND "${GBL_PHASE9_DMA_REGISTERS_OUTPUT}" "${required_text}" test_case)
    if(test_case EQUAL -1)
      set(reason channel-mask)
      set(${reason_out} "${reason}" PARENT_SCOPE)
      return()
    endif()
  endforeach()

  list(GET GBL_PHASE9_ARBITRATION_RECORDS 0 arbitration)
  gbl_phase9_json(startup "${candidate}" dma_policy startup_policy master_cycles)
  gbl_phase9_json(arbitration_startup "${arbitration}" startup_cycles)
  gbl_phase9_json(startup_provenance "${arbitration}" startup_provenance)
  gbl_phase9_json(startup_class "${candidate}" dma_policy startup_policy classification)
  gbl_phase9_json(startup_status "${candidate}" dma_policy startup_policy hardware_qualification)
  if(NOT startup STREQUAL arbitration_startup OR
     NOT startup_provenance STREQUAL "project-selected" OR
     NOT startup_class STREQUAL "project-selected" OR NOT startup_status STREQUAL "UNKNOWN")
    set(reason startup-policy)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()
  gbl_phase9_json(priority_policy "${candidate}" dma_policy arbitration_policy priority_order)
  gbl_phase9_expect_array(array_reason "${candidate}" "[0,1,2,3]" dma_policy arbitration_policy priority_order)
  gbl_phase9_expect_array(priority_runtime_reason "${arbitration}" "[0,1,2,3]" priority)
  gbl_phase9_json(resume_channel "${arbitration}" resume_channel)
  gbl_phase9_json(resume_sequence "${arbitration}" resume_sequence)
  gbl_phase9_json(owner_policy "${candidate}" dma_policy arbitration_policy ownership)
  gbl_phase9_json(unit_boundary "${candidate}" dma_policy arbitration_policy unit_boundary)
  gbl_phase9_json(restart_policy "${candidate}" dma_policy arbitration_policy sequence_restart_after_suspension)
  gbl_phase9_json(arbitration_class "${candidate}" dma_policy arbitration_policy classification)
  gbl_phase9_json(arbitration_status "${candidate}" dma_policy arbitration_policy hardware_qualification)
  gbl_phase9_json(finer_boundary "${candidate}" dma_policy arbitration_policy finer_boundary)
  if(NOT array_reason STREQUAL "" OR NOT priority_runtime_reason STREQUAL "" OR
     NOT resume_channel STREQUAL "3" OR NOT resume_sequence STREQUAL "N" OR
     NOT owner_policy STREQUAL "active DMA pauses CPU execution" OR
     NOT unit_boundary STREQUAL "one source access plus one destination access" OR
     NOT restart_policy STREQUAL "nonsequential" OR
     NOT arbitration_class STREQUAL "project-selected" OR
     NOT arbitration_status STREQUAL "UNKNOWN" OR NOT finer_boundary STREQUAL "unmodeled")
    set(reason ownership-policy)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()
  foreach(required_text IN ITEMS
      "same-cycle delayed channels start in DMA0 to DMA3 priority order"
      "a DMA0 request waits for a DMA3 unit then suspends and resumes it at the next boundary")
    string(FIND "${GBL_PHASE9_DMA_ARBITRATION_OUTPUT}" "${required_text}" test_case)
    if(test_case EQUAL -1)
      set(reason ownership-policy)
      set(${reason_out} "${reason}" PARENT_SCOPE)
      return()
    endif()
  endforeach()

  list(GET GBL_PHASE9_EVENT_RECORDS 0 events)
  gbl_phase9_json(event_order "${candidate}" dma_policy arbitration_policy event_order)
  gbl_phase9_json(runtime_event_order "${events}" event_priority)
  string(REPLACE " " "" event_order "${event_order}")
  string(REPLACE "\n" "" event_order "${event_order}")
  string(REPLACE " " "" runtime_event_order "${runtime_event_order}")
  string(REPLACE "\n" "" runtime_event_order "${runtime_event_order}")
  if(NOT event_order STREQUAL runtime_event_order OR
     NOT event_order STREQUAL "[\"timer0-3\",\"keypad\",\"dma-ready0-3\"]")
    set(reason ownership-policy)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()
  gbl_phase9_json(event_startup "${events}" startup_cycles)
  gbl_phase9_json(event_prefetch "${events}" prefetch)
  gbl_phase9_json(event_qualification "${events}" hardware_qualification)
  if(NOT event_startup STREQUAL startup OR NOT event_prefetch STREQUAL "unmodeled" OR
     NOT event_qualification STREQUAL "UNKNOWN" OR
     NOT "${GBL_PHASE9_DMA_EVENTS_OUTPUT}" MATCHES "timer and keypad events run during DMA startup and both unit intervals")
    set(reason ownership-policy)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()

  list(GET GBL_PHASE9_CONTROL_RECORDS 0 controls)
  gbl_phase9_json(immediate_repeat "${candidate}" dma_policy trigger_policy immediate_repeat)
  gbl_phase9_json(runtime_immediate "${controls}" immediate_repeat)
  gbl_phase9_json(delayed_repeat "${candidate}" dma_policy completion_policy delayed_repeat)
  gbl_phase9_json(runtime_delayed "${controls}" delayed_repeat)
  gbl_phase9_json(reload_policy "${candidate}" dma_policy completion_policy destination_reload)
  gbl_phase9_json(runtime_reload "${controls}" destination_reload)
  gbl_phase9_json(trigger_scope "${candidate}" dma_policy trigger_policy deferred_behavior)
  gbl_phase9_json(runtime_trigger_scope "${controls}" production_triggers)
  gbl_phase9_json(control_qualification "${controls}" hardware_qualification)
  if(NOT immediate_repeat STREQUAL runtime_immediate OR
     NOT runtime_immediate STREQUAL "one-shot" OR
     NOT runtime_delayed STREQUAL "armed" OR
     NOT reload_policy STREQUAL "channel 3 mode 3 only" OR
     NOT runtime_reload STREQUAL "channel3" OR
     NOT runtime_trigger_scope STREQUAL "deferred" OR
     NOT control_qualification STREQUAL "UNKNOWN")
    set(reason ownership-policy)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()
  gbl_phase9_json(latch_dispute "${candidate}" dma_policy latch_policy dispute_id)
  gbl_phase9_json(latch_status "${candidate}" dma_policy latch_policy dispute_status)
  gbl_phase9_json(latch_class "${candidate}" dma_policy latch_policy result_classification)
  gbl_phase9_json(latch_qualification "${candidate}" dma_policy latch_policy hardware_qualification)
  if(NOT latch_dispute STREQUAL "disp-dma-latch" OR NOT latch_status STREQUAL "open" OR
     NOT latch_class STREQUAL "disputed" OR NOT latch_qualification STREQUAL "UNKNOWN")
    set(reason ownership-policy)
  endif()
  set(${reason_out} "${reason}" PARENT_SCOPE)
endfunction()

function(gbl_phase9_check_profile_document description profile_path doc_path)
  execute_process(
    COMMAND "${CMAKE_PROGRAM}" "-DPROFILE=${profile_path}" "-DDOC=${doc_path}"
      "-DREGISTRY=${registry_file}" "-DVOCAB=${vocab_file}" -P "${checker_file}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "phase9-policy: ${description}-profile-document-mismatch\n${output}${error}")
  endif()
endfunction()

if(NOT CASE STREQUAL "control")
  gbl_phase9_check_profile_document("verify" "${profile_file}" "${doc_file}")
endif()

gbl_phase9_observations(GBL_PHASE9_BUS_RECORDS GBL_PHASE9_BUS_OUTPUT
  "${bus_test}" waitcnt.matrix "" 6)
gbl_phase9_observations(GBL_PHASE9_ARBITRATION_RECORDS GBL_PHASE9_DMA_ARBITRATION_OUTPUT
  "${dma_test}" arbitration dma-arbitration 1)
gbl_phase9_observations(GBL_PHASE9_EVENT_RECORDS GBL_PHASE9_DMA_EVENTS_OUTPUT
  "${dma_test}" events dma-events 1)
gbl_phase9_observations(GBL_PHASE9_CONTROL_RECORDS GBL_PHASE9_DMA_CONTROLS_OUTPUT
  "${dma_test}" controls dma-control-policy 1)
execute_process(COMMAND "${dma_test}" registers
  RESULT_VARIABLE dma_register_result OUTPUT_VARIABLE GBL_PHASE9_DMA_REGISTERS_OUTPUT
  ERROR_VARIABLE dma_register_error)
if(NOT "${dma_register_result}" STREQUAL "0" OR
   NOT "${GBL_PHASE9_DMA_REGISTERS_OUTPUT}" MATCHES "TAP version 13" OR
   NOT "${GBL_PHASE9_DMA_REGISTERS_OUTPUT}" MATCHES "1\\.\\.6")
  message(FATAL_ERROR "phase9-policy: runtime-selector-registers-failed\n${GBL_PHASE9_DMA_REGISTERS_OUTPUT}${dma_register_error}")
endif()
execute_process(COMMAND "${dma_test}" arbitration
  RESULT_VARIABLE dma_arbitration_result OUTPUT_VARIABLE GBL_PHASE9_DMA_ARBITRATION_OUTPUT
  ERROR_VARIABLE dma_arbitration_error)
if(NOT "${dma_arbitration_result}" STREQUAL "0")
  message(FATAL_ERROR "phase9-policy: runtime-selector-arbitration-failed\n${GBL_PHASE9_DMA_ARBITRATION_OUTPUT}${dma_arbitration_error}")
endif()
execute_process(COMMAND "${dma_test}" events
  RESULT_VARIABLE dma_events_result OUTPUT_VARIABLE GBL_PHASE9_DMA_EVENTS_OUTPUT
  ERROR_VARIABLE dma_events_error)
if(NOT "${dma_events_result}" STREQUAL "0")
  message(FATAL_ERROR "phase9-policy: runtime-selector-events-failed\n${GBL_PHASE9_DMA_EVENTS_OUTPUT}${dma_events_error}")
endif()
execute_process(COMMAND "${dma_test}" controls
  RESULT_VARIABLE dma_controls_result OUTPUT_VARIABLE GBL_PHASE9_DMA_CONTROLS_OUTPUT
  ERROR_VARIABLE dma_controls_error)
if(NOT "${dma_controls_result}" STREQUAL "0")
  message(FATAL_ERROR "phase9-policy: runtime-selector-controls-failed\n${GBL_PHASE9_DMA_CONTROLS_OUTPUT}${dma_controls_error}")
endif()
execute_process(COMMAND "${timer_test}" costs
  RESULT_VARIABLE costs_result OUTPUT_VARIABLE costs_output ERROR_VARIABLE costs_error)
if(NOT "${costs_result}" STREQUAL "0")
  message(FATAL_ERROR "phase9-policy: runtime-selector-costs-failed\n${costs_output}${costs_error}")
endif()
string(REPLACE "\r" "" costs_output "${costs_output}")
string(REPLACE "\n" ";" costs_lines "${costs_output}")
set(GBL_PHASE9_CONTEXT_LINES)
set(in_context FALSE)
foreach(line IN LISTS costs_lines)
  if(line STREQUAL "contextual-rom,address,waitcnt,width,sequence,cycles,provenance,model")
    set(in_context TRUE)
  elseif(in_context AND line MATCHES "^ws[0-2],")
    list(APPEND GBL_PHASE9_CONTEXT_LINES "${line}")
  endif()
endforeach()

if(NOT CASE STREQUAL "control")
  gbl_phase9_check_profile("${profile_file}" policy_reason)
  if(NOT policy_reason STREQUAL "")
    message(FATAL_ERROR "phase9-policy: ${policy_reason}")
  endif()
  message(STATUS "phase9-policy: runtime observations, profile/document policy and BIOS policy passed")
endif()

if(NOT CASE STREQUAL "verify")
  set(control_root "${GBL_PHASE9_BIN}/nc/phase9-policy")
  file(MAKE_DIRECTORY "${control_root}")
  set(GBL_PHASE9_BUS_COPY "${control_root}/bus-observations.jsonl")
  set(GBL_PHASE9_CONTEXT_COPY "${control_root}/contextual-costs.csv")
  set(GBL_PHASE9_DMA_COPY "${control_root}/dma-observations.txt")
  string(REPLACE ";" "\n" bus_text "${GBL_PHASE9_BUS_RECORDS}")
  file(WRITE "${GBL_PHASE9_BUS_COPY}" "${bus_text}\n")
  string(REPLACE ";" "\n" context_text "${GBL_PHASE9_CONTEXT_LINES}")
  file(WRITE "${GBL_PHASE9_CONTEXT_COPY}" "${context_text}\n")
  file(WRITE "${GBL_PHASE9_DMA_COPY}"
    "${GBL_PHASE9_DMA_ARBITRATION_OUTPUT}\n${GBL_PHASE9_DMA_EVENTS_OUTPUT}\n${GBL_PHASE9_DMA_CONTROLS_OUTPUT}\n${GBL_PHASE9_DMA_REGISTERS_OUTPUT}\n")

  function(gbl_phase9_control name expected operation path encoded_value)
    set(control_dir "${control_root}/${name}")
    file(REMOVE_RECURSE "${control_dir}")
    file(MAKE_DIRECTORY "${control_dir}")
    set(candidate_profile "${control_dir}/profile.json")
    set(candidate_doc "${control_dir}/profile.md")
    file(COPY_FILE "${profile_file}" "${candidate_profile}")
    file(COPY_FILE "${doc_file}" "${candidate_doc}")
    file(COPY_FILE "${GBL_PHASE9_BUS_COPY}" "${control_dir}/bus-observations.jsonl")
    file(COPY_FILE "${GBL_PHASE9_CONTEXT_COPY}" "${control_dir}/contextual-costs.csv")
    file(COPY_FILE "${GBL_PHASE9_DMA_COPY}" "${control_dir}/dma-observations.txt")
    file(READ "${candidate_profile}" candidate_json)
    string(REPLACE "." ";" json_path "${path}")
    if(operation STREQUAL "remove")
      string(JSON candidate_json ERROR_VARIABLE mutation_error REMOVE "${candidate_json}" ${json_path})
    else()
      string(JSON candidate_json ERROR_VARIABLE mutation_error SET "${candidate_json}" ${json_path} "${encoded_value}")
    endif()
    if(NOT "${mutation_error}" STREQUAL "NOTFOUND" AND NOT "${mutation_error}" STREQUAL "")
      message(FATAL_ERROR "phase9-policy: control-${name}-stale-mutation")
    endif()
    file(WRITE "${candidate_profile}" "${candidate_json}\n")

    set(clean_twin "${control_dir}/clean-twin.json")
    file(COPY_FILE "${profile_file}" "${clean_twin}")
    gbl_phase9_check_profile("${clean_twin}" clean_reason)
    if(NOT clean_reason STREQUAL "")
      message(FATAL_ERROR "phase9-policy: control-${name}-clean-twin-${clean_reason}")
    endif()
    gbl_phase9_check_profile("${candidate_profile}" actual_reason)
    if(NOT "${actual_reason}" MATCHES "^${expected}$")
      message(FATAL_ERROR "phase9-policy: control-${name}-wrong-reason-${actual_reason}")
    endif()
  endfunction()

  gbl_phase9_control(wait-table wait-table set "waitcnt_policy.windows.0.nonsequential_wait_choices.0" "7")
  gbl_phase9_control(boundary-class boundary-class set "waitcnt_policy.boundary.classification" "\"source-backed\"")
  gbl_phase9_control(startup-policy startup-policy set "dma_policy.startup_policy.master_cycles" "3")
  gbl_phase9_control(channel-mask channel-mask set "dma_policy.source_facts.source_address_masks.0" "\"0xFFFFFFFF\"")
  gbl_phase9_control(ownership-policy ownership-policy set "dma_policy.arbitration_policy.unit_boundary" "\"after each bus beat\"")
  gbl_phase9_control(prefetch-unmodeled prefetch-unmodeled set "waitcnt_policy.prefetch.execution" "\"modeled\"")
  gbl_phase9_control(bios-policy bios-policy set "boot" "\"bios\"")
  gbl_phase9_control(missing-policy missing-policy remove "waitcnt_policy" "")
  message(STATUS "phase9-policy: eight causal drift controls and clean twins passed")
endif()
