cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS SRC BIN TOKEN GROUP STAGE TOOLCHAIN_ROOT HOST)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "diagnostic-setup: missing-${required}")
  endif()
endforeach()
get_filename_component(SRC "${SRC}" ABSOLUTE)
get_filename_component(BIN "${BIN}" ABSOLUTE)
include("${SRC}/cmake/DiagnosticMatrix.cmake")
include("${SRC}/cmake/PathContainment.cmake")
include("${SRC}/cmake/CheckDiagnosticAuthority.cmake")
gbl_resolve_contained_path(binary_real binary_status "${SRC}/build" "${BIN}")
if(NOT binary_status STREQUAL "ok" OR BIN STREQUAL "${SRC}/build")
  message(FATAL_ERROR "diagnostic-setup: unsafe-binary-root")
endif()
gbl_diagnostic_matrix("${SRC}" "${GROUP}")
set(root "${BIN}/diagnostic-execution")
gbl_resolve_contained_path(root_real status "${BIN}" "${root}")
if(NOT status STREQUAL "ok" OR NOT root_real STREQUAL root)
  message(FATAL_ERROR "diagnostic-setup: output-${status}")
endif()
# A new test run can never consume yesterday's successful setup receipt.
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}/native")
file(SHA256 "${SRC}/tests/fixtures/manifest.json" manifest_sha)
file(SHA256 "${BIN}/gamebloke-run" runner_sha)
file(SHA256 "${BIN}/cpu_test" native_sha)
gbl_diagnostic_input_digest("${SRC}" inputs_sha)
execute_process(COMMAND git -C "${SRC}" rev-parse HEAD
  RESULT_VARIABLE rc OUTPUT_VARIABLE authority OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT rc STREQUAL "0")
  message(FATAL_ERROR "diagnostic-setup: source-authority-unavailable")
endif()
set(reviewed_head "${authority}")
if(STAGE STREQUAL "proof")
  include("${SRC}/cmake/CiJobBudgets.cmake")
  gbl_ci_policy("${SRC}")
  set(authority "${GBL_CI_PRODUCER_HEAD}")
endif()
set(identity "{}")
foreach(pair IN ITEMS "token|${TOKEN}" "stage|${STAGE}" "group|${GROUP}"
    "reviewed_head|${reviewed_head}"
    "manifest_sha256|${manifest_sha}" "source_input_sha256|${inputs_sha}"
    "runner_sha256|${runner_sha}" "native_sha256|${native_sha}" "source_commit|${authority}")
  string(REPLACE "|" ";" pair "${pair}")
  list(GET pair 0 key)
  list(GET pair 1 value)
  string(JSON identity SET "${identity}" "${key}" "\"${value}\"")
endforeach()
foreach(selector IN LISTS GBL_DIAG_SELECTORS)
  execute_process(COMMAND "${BIN}/cpu_test" "${selector}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE tap ERROR_VARIABLE error)
  if(NOT rc STREQUAL "0" OR tap MATCHES "(^|\n)not ok ")
    message(FATAL_ERROR "diagnostic-setup: native-failure:${selector}:${tap}${error}")
  endif()
  file(WRITE "${root}/native/${selector}.tap" "${tap}")
endforeach()
function(write_api_receipts)
  foreach(api IN LISTS GBL_DIAG_APIS)
    string(JSON api_receipt SET "${identity}" evidence "${GBL_DIAG_API_${api}}")
    file(WRITE "${root}/api-${api}.json" "${api_receipt}\n")
  endforeach()
endfunction()
gbl_diagnostic_tool("${SRC}" "${TOOLCHAIN_ROOT}" "${HOST}" "${REQUIRED}" tools)
string(JSON run SET "${identity}" tools "\"${tools}\"")
if(tools STREQUAL "absent")
  write_api_receipts()
  string(JSON run SET "${run}" outputs "[]")
  file(WRITE "${root}/run.json" "${run}\n")
  message("SKIPPED: arm-toolchain-absent")
  return()
endif()
if(NOT STAGE MATCHES "^(proof|admitted)$")
  message(FATAL_ERROR "diagnostic-setup: invalid-stage")
endif()

if(TRACER)
  gbl_check_diagnostic_authority("${SRC}" "${authority}")
  if(NOT STAGE STREQUAL "proof")
    message(FATAL_ERROR "diagnostic-setup: tracer-is-not-admitted-evidence")
  endif()
  set(GBL_DIAG_OUTPUTS arm-343721884 arm-343721884-broken)
  set(tracer_root "${SRC}/build/phase05-spike/plan23-tracer")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DSRC=${SRC}"
    "-DOUT=${tracer_root}" "-DTOOLCHAIN_ROOT=${TOOLCHAIN_ROOT}"
    "-DSOURCE_COMMIT=${authority}" -DMODE=case -DISA=arm -DCASE_ID=343721884
    -P "${SRC}/cmake/BuildArmDiagnostics.cmake"
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  file(WRITE "${root}/tracer-build.log" "${output}${error}")
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "diagnostic-setup: tracer-build-failed:${output}${error}")
  endif()
elseif(STAGE STREQUAL "admitted")
  execute_process(COMMAND "${CMAKE_COMMAND}" -DCASE=all-admitted "-DGROUP=${GROUP}"
    "-DSRC=${SRC}" "-DBIN=${BIN}" "-DTOOLCHAIN_ROOT=${TOOLCHAIN_ROOT}"
    -P "${SRC}/tests/gates/diagnostics_case.cmake"
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  file(WRITE "${root}/admitted.log" "${output}${error}")
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "diagnostic-setup: admitted-execution-failed:${output}${error}")
  endif()
  file(STRINGS "${BIN}/diagnostics-results/all-admitted/summary.txt" source_line
    REGEX "^source[.]commit=")
  string(REGEX REPLACE "^source[.]commit=" "" authority "${source_line}")
  string(JSON identity SET "${identity}" source_commit "\"${authority}\"")
  string(JSON run SET "${run}" source_commit "\"${authority}\"")
  # Admission regenerates the immutable index and may relink this executable.
  # Bind receipts to the actual runner that just produced the admitted results,
  # rather than the executable captured before that build (Mach-O may differ).
  file(SHA256 "${BIN}/gamebloke-run" runner_sha)
  string(JSON identity SET "${identity}" runner_sha256 "\"${runner_sha}\"")
  string(JSON run SET "${run}" runner_sha256 "\"${runner_sha}\"")
else()
  # Exact source proof is produced once per group by the build target. Optional
  # ci/asan lanes build it here when a real pinned tool is present.
  gbl_check_diagnostic_authority("${SRC}" "${authority}")
  if(NOT DEFINED PROOF_ROOT)
    set(PROOF_ROOT "${SRC}/build/final-proof")
    if(NOT GROUP STREQUAL "all")
      set(PROOF_ROOT "${SRC}/build/final-proof-${GROUP}")
    endif()
  endif()
  if(NOT EXISTS "${PROOF_ROOT}/complete-host.json")
    execute_process(COMMAND "${CMAKE_COMMAND}" -DCASE=final-host-build
      "-DSRC=${SRC}" "-DBIN=${PROOF_ROOT}" "-DPROOF_GROUP=${GROUP}"
      "-DTOOLCHAIN_ROOT=${TOOLCHAIN_ROOT}"
      -P "${SRC}/tests/gates/toolchain_spike.cmake"
      RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${root}/build.log" "${output}${error}")
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "diagnostic-setup: source-build-failed:${output}${error}")
    endif()
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -DCASE=final-host-set
    "-DSRC=${SRC}" "-DBIN=${PROOF_ROOT}" "-DPROOF_GROUP=${GROUP}"
    "-DTOOLCHAIN_ROOT=${TOOLCHAIN_ROOT}"
    -P "${SRC}/tests/gates/toolchain_spike.cmake"
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "diagnostic-setup: source-output-set-invalid:${output}${error}")
  endif()
  set(isas arm thumb)
  if(NOT GROUP STREQUAL "all")
    set(isas "${GROUP}")
  endif()
  include("${SRC}/tests/gates/diagnostic_result_authority.cmake")
  gbl_diagnostic_result_authority("${SRC}")
  function(observe_raw isa lane_root)
    set(CASE "${isa}-pre-admission")
    set(ARTIFACT_ROOT "${lane_root}")
    # A function scope contains the included script's temporary variables;
    # inherited canonical prefixes remain bound to the setup's exact files.
    include("${SRC}/tests/gates/diagnostics_case.cmake")
  endfunction()
  foreach(isa IN LISTS isas)
    set(lane_root "${BIN}/generated/diagnostics/proof/${isa}")
    gbl_resolve_contained_path(lane_real lane_status "${BIN}" "${lane_root}")
    if(NOT lane_status STREQUAL "ok" OR NOT lane_real STREQUAL lane_root)
      message(FATAL_ERROR "diagnostic-setup: proof-copy-${lane_status}")
    endif()
    file(REMOVE_RECURSE "${lane_root}")
    file(MAKE_DIRECTORY "${lane_root}")
    file(COPY "${SRC}/build/phase05-matrix/${isa}/" DESTINATION "${lane_root}")
    observe_raw("${isa}" "${lane_root}")
    # Full diagnostics now reach the enclosing CTest log directly. Keep the
    # same named per-group artifact with its exact checked observation summary.
    file(COPY_FILE "${BIN}/diagnostics-results/${isa}-pre-admission/summary.txt"
      "${root}/${isa}-observations.log")
  endforeach()
endif()

write_api_receipts()
if(STAGE STREQUAL "proof" AND (TRACER OR NOT GROUP STREQUAL "thumb"))
  include("${SRC}/tests/gates/diagnostic_result_authority.cmake")
  gbl_diagnostic_result_authority("${SRC}")
endif()
set(outputs "[]")
set(output_index 0)
foreach(fid IN LISTS GBL_DIAG_OUTPUTS)
  set(row "${GBL_DIAG_ROW_${fid}}")
  string(JSON id GET "${row}" id)
  string(JSON kind GET "${row}" source_test kind)
  set(producer "${GBL_DIAG_GROUP_${fid}}")
  set(state pass)
  if(fid MATCHES "-broken$")
    set(state fail)
  endif()
  set(reason unregistered-content)
  set(status GUEST_STOP)
  set(termination unregistered-content)
  if(kind STREQUAL "guest-stop")
    set(state pending)
    string(JSON reason GET "${row}" source_test expected_reason)
    set(termination "${reason}")
  endif()
  if(STAGE STREQUAL "admitted")
    set(admitted_root "${BIN}/generated/diagnostics/armv4t")
    if(NOT producer STREQUAL "smoke")
      string(APPEND admitted_root "/${producer}")
    endif()
    set(rom "${admitted_root}/roms/${fid}.gba")
    set(result "${BIN}/diagnostics-results/all-admitted/${fid}.json")
    if(state STREQUAL "pass")
      set(status PASS)
      set(reason guest-mailbox-pass)
      set(termination mailbox-complete)
    elseif(state STREQUAL "fail")
      set(status GUEST_FAIL)
      set(reason guest-mailbox-fail)
      set(termination mailbox-complete)
    endif()
  elseif(TRACER)
    set(rom "${tracer_root}/roms/${fid}.gba")
    set(result "${root}/${fid}.result.json")
  elseif(producer STREQUAL "smoke")
    set(rom "${BIN}/generated/diagnostics/proof/smoke/roms/${fid}.gba")
    gbl_copy_file_contained(copy_status copy_reason "${SRC}/build/phase05-spike/final-smoke/roms/${fid}.gba"
      "${BIN}" "${rom}")
    if(NOT copy_status STREQUAL "ok")
      message(FATAL_ERROR "diagnostic-setup: smoke-copy-${copy_reason}")
    endif()
    set(result "${root}/${fid}.result.json")
  else()
    set(rom "${BIN}/generated/diagnostics/proof/${producer}/roms/${fid}.gba")
    set(result "${BIN}/diagnostics-results/${producer}-pre-admission/${fid}.gba.json")
  endif()
  if(TRACER OR (STAGE STREQUAL "proof" AND producer STREQUAL "smoke"))
    execute_process(COMMAND "${BIN}/gamebloke-run" --rom "${rom}" --cycles 1000
      RESULT_VARIABLE rc OUTPUT_VARIABLE doc ERROR_VARIABLE error)
    if(NOT rc STREQUAL "1")
      message(FATAL_ERROR "diagnostic-setup: raw-exit-mismatch:${fid}:${doc}${error}")
    endif()
    file(WRITE "${result}" "${doc}")
    set_property(GLOBAL PROPERTY GBL_FINDINGS 0)
    gbl_result_check("${result}" M R V)
    get_property(findings GLOBAL PROPERTY GBL_FINDINGS)
    string(JSON raw_fixture TYPE "${doc}" fixture id)
    string(JSON raw_evidence LENGTH "${doc}" claim evidence)
    if(NOT findings EQUAL 2 OR NOT raw_fixture STREQUAL "NULL" OR NOT raw_evidence EQUAL 0)
      message(FATAL_ERROR "diagnostic-setup: raw-canonical-refusal-mismatch:${fid}")
    endif()
    set_property(GLOBAL PROPERTY GBL_FINDINGS 0)
  else()
    file(READ "${result}" doc)
  endif()
  file(SHA256 "${rom}" sha)
  if(STAGE STREQUAL "proof" AND output_index EQUAL 0)
    # Historical metadata must never qualify a proof runner, including when
    # the freshly rebuilt bytes happen to match the historical digest.
    execute_process(COMMAND "${BIN}/gamebloke-run" --rom "${rom}"
      --fixture "${fid}" --cycles 1000 RESULT_VARIABLE refusal_rc
      OUTPUT_VARIABLE refusal ERROR_VARIABLE refusal_error)
    string(JSON refusal_status GET "${refusal}" status)
    string(JSON refusal_reason GET "${refusal}" reason)
    string(JSON refusal_ran GET "${refusal}" fixture ran)
    string(JSON refusal_cycles GET "${refusal}" time cycles)
    string(JSON refusal_instructions GET "${refusal}" time instructions)
    if(NOT refusal_rc STREQUAL "1" OR NOT refusal_status STREQUAL "REFUSED" OR
       NOT refusal_reason STREQUAL "fixture-unknown" OR refusal_ran OR
       NOT refusal_cycles EQUAL 0 OR NOT refusal_instructions EQUAL 0)
      message(FATAL_ERROR "diagnostic-setup: proof-runtime-authority-leak:${refusal}${refusal_error}")
    endif()
    file(WRITE "${root}/proof-refusal.json" "${refusal}")
  endif()
  file(SHA256 "${result}" result_sha)
  set(receipt "${identity}")
  foreach(pair IN ITEMS "fixture_id|${fid}" "rom_path|${rom}" "rom_sha256|${sha}"
      "result_path|${result}" "result_sha256|${result_sha}" "status|${status}"
      "reason|${reason}" "termination|${termination}" "semantic_state|${state}"
      "semantic_case_id|${id}")
    string(REPLACE "|" ";" pair "${pair}")
    list(GET pair 0 key)
    list(GET pair 1 value)
    string(JSON receipt SET "${receipt}" "${key}" "\"${value}\"")
  endforeach()
  file(WRITE "${root}/${fid}.json" "${receipt}\n")
  string(JSON outputs SET "${outputs}" ${output_index} "\"${fid}\"")
  math(EXPR output_index "${output_index}+1")
endforeach()
string(JSON run SET "${run}" outputs "${outputs}")
if(STAGE STREQUAL "proof")
  gbl_diagnostic_result_authority("${SRC}")
endif()
file(WRITE "${root}/run.json" "${run}\n")
message(STATUS "diagnostic-setup: ${output_index} actual ${STAGE} results; fresh token ${TOKEN}")
