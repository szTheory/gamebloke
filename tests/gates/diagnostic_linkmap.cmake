cmake_minimum_required(VERSION 3.25)

foreach(required IN ITEMS MAP OBJECTS ATTRIBUTES SECTIONS DISASSEMBLY SRC)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "linkmap: missing-${required}")
  endif()
endforeach()
if(NOT EXISTS "${MAP}" OR IS_DIRECTORY "${MAP}" OR IS_SYMLINK "${MAP}")
  message(FATAL_ERROR "linkmap: map-not-regular")
endif()
file(REAL_PATH "${SRC}" source_root)

set(expected_objects "${OBJECTS}")
list(LENGTH expected_objects expected_count)
if(expected_count LESS 1)
  message(FATAL_ERROR "linkmap: empty-object-list")
endif()
foreach(path IN LISTS expected_objects ATTRIBUTES SECTIONS DISASSEMBLY)
  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
    message(FATAL_ERROR "linkmap: evidence-not-regular")
  endif()
endforeach()

file(READ "${MAP}" map_text)
string(TOLOWER "${map_text}" map_lower)
if(map_lower MATCHES "(libgcc[.]a|libc[.]a|newlib|crt[0-9a-z_.-]*[.]o)")
  message(FATAL_ERROR "linkmap: runtime-input")
endif()

file(STRINGS "${MAP}" map_lines)
set(actual_objects "")
set(linker_stubs 0)
foreach(line IN LISTS map_lines)
  if(line MATCHES "^LOAD[ ]+")
    string(REGEX REPLACE "^LOAD[ ]+" "" loaded "${line}")
    string(STRIP "${loaded}" loaded)
    if(loaded STREQUAL "linker stubs")
      math(EXPR linker_stubs "${linker_stubs} + 1")
    elseif(loaded MATCHES "[(]" OR loaded MATCHES "[.]a($|[ ])")
      message(FATAL_ERROR "linkmap: archive-input")
    else()
      if(IS_ABSOLUTE "${loaded}")
        set(loaded_path "${loaded}")
      else()
        set(loaded_path "${source_root}/${loaded}")
      endif()
      if(NOT EXISTS "${loaded_path}" OR IS_DIRECTORY "${loaded_path}" OR
         IS_SYMLINK "${loaded_path}")
        message(FATAL_ERROR "linkmap: map-input-not-regular")
      endif()
      file(REAL_PATH "${loaded_path}" loaded_real)
      list(APPEND actual_objects "${loaded_real}")
    endif()
  endif()
endforeach()
if(NOT linker_stubs EQUAL 1)
  message(FATAL_ERROR "linkmap: linker-stubs-count")
endif()

set(expected_real "")
foreach(path IN LISTS expected_objects)
  if(IS_ABSOLUTE "${path}")
    set(object_path "${path}")
  else()
    set(object_path "${source_root}/${path}")
  endif()
  if(NOT EXISTS "${object_path}" OR IS_DIRECTORY "${object_path}" OR
     IS_SYMLINK "${object_path}")
    message(FATAL_ERROR "linkmap: expected-input-not-regular")
  endif()
  file(REAL_PATH "${object_path}" object_real)
  list(APPEND expected_real "${object_real}")
endforeach()
list(SORT actual_objects)
list(SORT expected_real)
if(NOT "${actual_objects}" STREQUAL "${expected_real}")
  message(FATAL_ERROR "linkmap: map-input-set-mismatch")
endif()

# Attribute, section and disassembly checks are added beside their focused
# negative controls in the Task 2 RED/GREEN sequence.
message(STATUS "linkmap: ok objects=${expected_count} linker_stubs=${linker_stubs}")
