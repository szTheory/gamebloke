cmake_minimum_required(VERSION 3.25)

foreach(required IN ITEMS MAP OBJECTS ATTRIBUTES SECTIONS DISASSEMBLY SRC)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "linkmap: missing-${required}")
  endif()
endforeach()
if(NOT EXISTS "${MAP}" OR IS_DIRECTORY "${MAP}" OR IS_SYMLINK "${MAP}")
  message(FATAL_ERROR "linkmap: map-not-regular")
endif()
file(REAL_PATH "${SRC}" source_root)

set(expected_objects "${OBJECTS}")
list(LENGTH expected_objects expected_count)
if(expected_count LESS 1)
  message(FATAL_ERROR "linkmap: empty-object-list")
endif()
foreach(path IN LISTS expected_objects ATTRIBUTES SECTIONS DISASSEMBLY)
  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
    message(FATAL_ERROR "linkmap: evidence-not-regular")
  endif()
endforeach()
list(LENGTH ATTRIBUTES attribute_count)
math(EXPR required_attribute_count "${expected_count} + 1")
if(NOT attribute_count EQUAL required_attribute_count)
  message(FATAL_ERROR "linkmap: attribute-input-count")
endif()

file(READ "${MAP}" map_text)
string(TOLOWER "${map_text}" map_lower)
if(map_lower MATCHES "(libgcc[.]a|libc[.]a|newlib|crt[0-9a-z_.-]*[.]o)")
  message(FATAL_ERROR "linkmap: runtime-input")
endif()

file(STRINGS "${MAP}" map_lines)
set(actual_objects "")
set(linker_stubs 0)
foreach(line IN LISTS map_lines)
  if(line MATCHES "^LOAD[ ]+")
    string(REGEX REPLACE "^LOAD[ ]+" "" loaded "${line}")
    string(STRIP "${loaded}" loaded)
    if(loaded STREQUAL "linker stubs")
      math(EXPR linker_stubs "${linker_stubs} + 1")
    elseif(loaded MATCHES "[(]" OR loaded MATCHES "[.]a($|[ ])")
      message(FATAL_ERROR "linkmap: archive-input")
    else()
      if(IS_ABSOLUTE "${loaded}")
        set(loaded_path "${loaded}")
      else()
        set(loaded_path "${source_root}/${loaded}")
      endif()
      if(NOT EXISTS "${loaded_path}" OR IS_DIRECTORY "${loaded_path}" OR
         IS_SYMLINK "${loaded_path}")
        message(FATAL_ERROR "linkmap: map-input-not-regular")
      endif()
      file(REAL_PATH "${loaded_path}" loaded_real)
      list(APPEND actual_objects "${loaded_real}")
    endif()
  endif()
endforeach()
if(NOT linker_stubs EQUAL 1)
  message(FATAL_ERROR "linkmap: linker-stubs-count")
endif()

set(expected_real "")
foreach(path IN LISTS expected_objects)
  if(NOT path MATCHES "[.]o$")
    message(FATAL_ERROR "linkmap: non-object-input")
  endif()
  if(IS_ABSOLUTE "${path}")
    set(object_path "${path}")
  else()
    set(object_path "${source_root}/${path}")
  endif()
  if(NOT EXISTS "${object_path}" OR IS_DIRECTORY "${object_path}" OR
     IS_SYMLINK "${object_path}")
    message(FATAL_ERROR "linkmap: expected-input-not-regular")
  endif()
  file(REAL_PATH "${object_path}" object_real)
  cmake_path(IS_PREFIX source_root "${object_real}" NORMALIZE object_under_source)
  if(NOT object_under_source)
    message(FATAL_ERROR "linkmap: input-outside-source")
  endif()
  list(APPEND expected_real "${object_real}")
endforeach()
list(SORT actual_objects)
list(SORT expected_real)
if(NOT "${actual_objects}" STREQUAL "${expected_real}")
  message(FATAL_ERROR "linkmap: map-input-set-mismatch")
endif()

foreach(attribute_file IN LISTS ATTRIBUTES)
  file(READ "${attribute_file}" attributes_text)
  string(REGEX MATCHALL "Tag_CPU_arch: [^\r\n]+" cpu_arch_tags
    "${attributes_text}")
  list(LENGTH cpu_arch_tags cpu_arch_count)
  if(NOT cpu_arch_count EQUAL 1 OR
     NOT "${cpu_arch_tags}" STREQUAL "Tag_CPU_arch: v4T")
    message(FATAL_ERROR "linkmap: architecture-cpu")
  endif()
  string(REGEX MATCHALL "Tag_ARM_ISA_use: Yes" arm_tags "${attributes_text}")
  string(REGEX MATCHALL "Tag_THUMB_ISA_use: Thumb-1" thumb_tags "${attributes_text}")
  list(LENGTH arm_tags arm_count)
  list(LENGTH thumb_tags thumb_count)
  if(NOT arm_count EQUAL 1 OR NOT thumb_count EQUAL 1)
    message(FATAL_ERROR "linkmap: architecture-isa")
  endif()
endforeach()

file(STRINGS "${SECTIONS}" section_lines)
set(executable_sections "")
foreach(line IN LISTS section_lines)
  if(line MATCHES "^  \\[[ ]*[0-9]+\\]" AND line MATCHES " [A-Z]*X[ ]")
    string(REGEX REPLACE "^  \\[[ ]*[0-9]+\\][ ]+" "" section_tail "${line}")
    string(REGEX MATCH "^[^ ]+" section_name "${section_tail}")
    list(APPEND executable_sections "${section_name}")
  endif()
endforeach()
list(REMOVE_DUPLICATES executable_sections)
list(SORT executable_sections)
set(expected_executable_sections ".gba_header" ".text")
if(NOT "${executable_sections}" STREQUAL "${expected_executable_sections}")
  foreach(section IN LISTS executable_sections)
    if(NOT section STREQUAL ".gba_header" AND NOT section STREQUAL ".text")
      message(FATAL_ERROR "linkmap: executable-extension")
    endif()
  endforeach()
  message(FATAL_ERROR "linkmap: executable-section-missing")
endif()

file(READ "${DISASSEMBLY}" disassembly)
if(NOT disassembly MATCHES "Disassembly of section [.]gba_header" OR
   NOT disassembly MATCHES "Disassembly of section [.]text" OR
   NOT disassembly MATCHES "_start" OR
   NOT disassembly MATCHES "diagnostic_main" OR
   NOT disassembly MATCHES "thumb_probe" OR
   NOT disassembly MATCHES "bx")
  message(FATAL_ERROR "linkmap: executable-disassembly-incomplete")
endif()

message(STATUS
  "linkmap: ok objects=${expected_count} executable_sections=.gba_header,.text linker_stubs=${linker_stubs}")
