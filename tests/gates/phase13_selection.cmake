  "ppu.refusal bus,core,ppu,unit"
  "profile.lint gate,profile"
  "profile.nc.ppu_policy control,profile")

function(gbl_phase13_json_property json index wanted property_out found_out)
  set(found FALSE)
  set(value)
  string(JSON property_count ERROR_VARIABLE property_error LENGTH
    "${json}" tests ${index} properties)
  if(NOT "${property_error}" STREQUAL "NOTFOUND")
    set(${property_out} "" PARENT_SCOPE)
    set(${found_out} FALSE PARENT_SCOPE)
    return()
  endif()
  if(property_count GREATER 0)
    math(EXPR property_last "${property_count} - 1")
    foreach(property_index RANGE 0 ${property_last})
      string(JSON property_name GET "${json}" tests ${index}
        properties ${property_index} name)
      if(NOT property_name STREQUAL wanted)
        continue()
      endif()
      string(JSON value_type TYPE "${json}" tests ${index}
        properties ${property_index} value)
      if(value_type STREQUAL "ARRAY")
        string(JSON value_count LENGTH "${json}" tests ${index}
          properties ${property_index} value)
        if(value_count GREATER 0)
          math(EXPR value_last "${value_count} - 1")
          foreach(value_index RANGE 0 ${value_last})
            string(JSON item GET "${json}" tests ${index}
              properties ${property_index} value ${value_index})
            list(APPEND value "${item}")
          endforeach()
        endif()
      elseif(value_type STREQUAL "STRING" OR value_type STREQUAL "BOOLEAN")
        string(JSON value GET "${json}" tests ${index}
          properties ${property_index} value)
      endif()
      set(found TRUE)
      break()
    endforeach()
  endif()
  set(${property_out} "${value}" PARENT_SCOPE)
  set(${found_out} "${found}" PARENT_SCOPE)
endfunction()

function(gbl_phase13_find_test json wanted index_out count_out)
  set(found_index -1)
  set(found_count 0)
  string(JSON count ERROR_VARIABLE error LENGTH "${json}" tests)
  if("${error}" STREQUAL "NOTFOUND" AND count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
      string(JSON name GET "${json}" tests ${index} name)
      if(name STREQUAL wanted)
        math(EXPR found_count "${found_count} + 1")
        set(found_index ${index})
      endif()
    endforeach()
  endif()
  set(${index_out} "${found_index}" PARENT_SCOPE)
  set(${count_out} "${found_count}" PARENT_SCOPE)
endfunction()

function(gbl_phase13_expected_command name json index reason_out)
  string(JSON command_count ERROR_VARIABLE command_error LENGTH
    "${json}" tests ${index} command)
  if(NOT "${command_error}" STREQUAL "NOTFOUND" OR command_count LESS 1)
    set(${reason_out} wrong-command PARENT_SCOPE)
    return()
  endif()
  string(JSON program GET "${json}" tests ${index} command 0)
  file(REAL_PATH "${program}" actual_program)
  file(REAL_PATH "${CMAKE_COMMAND}" cmake_program)
  if(name MATCHES "^ppu[.]")
    set(expected_program "${GBL_PHASE13_BIN}/bus_test${CMAKE_EXECUTABLE_SUFFIX}")
    file(REAL_PATH "${expected_program}" expected_program)
    string(JSON argument GET "${json}" tests ${index} command 1)
    if(NOT actual_program STREQUAL expected_program OR
        NOT command_count EQUAL 2 OR NOT argument STREQUAL name)
      set(${reason_out} wrong-command PARENT_SCOPE)
      return()
    endif()
  elseif(name MATCHES "^phase13[.]selection[.](control|verify|order)$")
    if(NOT actual_program STREQUAL cmake_program OR NOT command_count EQUAL 6)
      set(${reason_out} wrong-command PARENT_SCOPE)
      return()
    endif()
    if(name STREQUAL "phase13.selection.control")
      set(expected_case control)
    elseif(name STREQUAL "phase13.selection.order")
      set(expected_case order)
    else()
      set(expected_case verify)
    endif()
    set(expected_args
      "-DSRC=${GBL_PHASE13_SRC}" "-DBIN=${GBL_PHASE13_BIN}"
      "-DCASE=${expected_case}" -P "${GBL_PHASE13_GATE}")
    foreach(command_index RANGE 1 5)
      string(JSON actual_arg GET "${json}" tests ${index} command ${command_index})
      math(EXPR expected_index "${command_index} - 1")
      list(GET expected_args ${expected_index} expected_arg)
      if(NOT actual_arg STREQUAL expected_arg)
        set(${reason_out} wrong-command PARENT_SCOPE)
        return()
      endif()
    endforeach()
  elseif(name MATCHES "^determinism[.]phase13([.]controls)?$")
    set(expected_program "${GBL_PHASE13_BIN}/determinism_test${CMAKE_EXECUTABLE_SUFFIX}")
    file(REAL_PATH "${expected_program}" expected_program)
    if(NOT actual_program STREQUAL expected_program OR NOT command_count EQUAL 2)
      set(${reason_out} wrong-command PARENT_SCOPE)
      return()
    endif()
    if(name STREQUAL "determinism.phase13.controls")
      set(expected_argument phase13-controls)
    else()
      set(expected_argument phase13)
    endif()
    string(JSON argument GET "${json}" tests ${index} command 1)
    if(NOT argument STREQUAL expected_argument)
      set(${reason_out} wrong-command PARENT_SCOPE)
      return()
    endif()
  elseif(name STREQUAL "profile.lint")
    set(expected_program "${CMAKE_COMMAND}")
    file(REAL_PATH "${expected_program}" expected_program)
    set(expected_args
      "-DPROFILE=${GBL_PHASE13_SRC}/profiles/agb.json"
      "-DDOC=${GBL_PHASE13_SRC}/docs/profile-agb.md"
      "-DREGISTRY=${GBL_PHASE13_SRC}/registry/disputes.json"
      "-DVOCAB=${GBL_PHASE13_SRC}/contracts/evidence.json"
      -P "${GBL_PHASE13_SRC}/cmake/CheckProfile.cmake")
    if(NOT actual_program STREQUAL expected_program OR NOT command_count EQUAL 7)
      set(${reason_out} wrong-command PARENT_SCOPE)
      return()
    endif()
    foreach(command_index RANGE 1 6)
      string(JSON actual_arg GET "${json}" tests ${index} command ${command_index})
      math(EXPR expected_index "${command_index} - 1")
      list(GET expected_args ${expected_index} expected_arg)
      if(NOT actual_arg STREQUAL expected_arg)
        set(${reason_out} wrong-command PARENT_SCOPE)
        return()
      endif()
    endforeach()
  elseif(name STREQUAL "profile.nc.ppu_policy")
    if(NOT actual_program STREQUAL cmake_program OR NOT command_count EQUAL 6)
      set(${reason_out} wrong-command PARENT_SCOPE)
      return()
    endif()
    set(expected_args
      "-DSRC=${GBL_PHASE13_SRC}" "-DBIN=${GBL_PHASE13_BIN}"
      -DCASE=ppu_policy -P "${GBL_PHASE13_SRC}/tests/gates/profile_case.cmake")
    foreach(command_index RANGE 1 5)
      string(JSON actual_arg GET "${json}" tests ${index} command ${command_index})
      math(EXPR expected_index "${command_index} - 1")
      list(GET expected_args ${expected_index} expected_arg)
      if(NOT actual_arg STREQUAL expected_arg)
        set(${reason_out} wrong-command PARENT_SCOPE)
        return()
      endif()
    endforeach()
  else()
    set(${reason_out} wrong-command PARENT_SCOPE)
    return()
  endif()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase13_validate_selection json reason_out)
  string(JSON kind ERROR_VARIABLE kind_error GET "${json}" kind)
  string(JSON count ERROR_VARIABLE count_error LENGTH "${json}" tests)
  if(NOT "${kind_error}" STREQUAL "NOTFOUND" OR NOT kind STREQUAL "ctestInfo" OR
      NOT "${count_error}" STREQUAL "NOTFOUND")
    set(${reason_out} malformed PARENT_SCOPE)
    return()
  endif()
  list(LENGTH GBL_PHASE13_EXPECTED expected_count)
  if(NOT count EQUAL expected_count)
    set(${reason_out} selection-count PARENT_SCOPE)
    return()
  endif()
  set(actual_names)
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    string(JSON name ERROR_VARIABLE name_error GET "${json}" tests ${index} name)
    if(NOT "${name_error}" STREQUAL "NOTFOUND" OR "${name}" STREQUAL "")
      set(${reason_out} malformed PARENT_SCOPE)
      return()
    endif()
    if(name IN_LIST actual_names)
      set(${reason_out} duplicate-selector PARENT_SCOPE)
      return()
    endif()
    list(APPEND actual_names "${name}")
  endforeach()
  foreach(expected IN LISTS GBL_PHASE13_EXPECTED)
    if(NOT expected IN_LIST actual_names)
      set(${reason_out} missing-selector PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(index RANGE 0 ${last})
    string(JSON name GET "${json}" tests ${index} name)
    gbl_phase13_expected_command("${name}" "${json}" ${index} command_reason)
    if(NOT "${command_reason}" STREQUAL "")
      set(${reason_out} "${command_reason}" PARENT_SCOPE)
      return()
    endif()
    gbl_phase13_json_property("${json}" ${index} LABELS labels has_labels)
    if(NOT has_labels)
      set(${reason_out} wrong-label PARENT_SCOPE)
      return()
    endif()
    if(name MATCHES "^(ppu[.]obj[.](tracer|regular|affine|budget)|ppu[.]composition)$")
      set(expected_labels bus core integration ppu)
    elseif(name MATCHES "^ppu[.]")
      set(expected_labels bus core ppu unit)
    elseif(name STREQUAL "phase13.selection.control")
      set(expected_labels gate ppu time)
    elseif(name MATCHES "^determinism[.]phase13([.]controls)?$")
      set(expected_labels determinism gate integration)
    elseif(name STREQUAL "profile.lint")
      set(expected_labels gate profile)
    elseif(name STREQUAL "profile.nc.ppu_policy")
      set(expected_labels control profile)
    endif()
    set(actual_labels ${labels})
    list(SORT actual_labels)
    list(SORT expected_labels)
    if(NOT "${actual_labels}" STREQUAL "${expected_labels}")
      set(${reason_out} wrong-label PARENT_SCOPE)
      return()
    endif()
    gbl_phase13_json_property("${json}" ${index} WORKING_DIRECTORY
      working_directory has_working_directory)
    if(NOT has_working_directory)
      set(${reason_out} wrong-root PARENT_SCOPE)
      return()
    endif()
    file(REAL_PATH "${working_directory}" working_directory_real)
    if(NOT working_directory_real STREQUAL GBL_PHASE13_BIN)
      set(${reason_out} wrong-root PARENT_SCOPE)
      return()
    endif()
    gbl_phase13_json_property("${json}" ${index} SKIP_REGULAR_EXPRESSION
      skip_expression has_skip_expression)
    if(has_skip_expression)
      set(${reason_out} skippable PARENT_SCOPE)
      return()
    endif()
    gbl_phase13_json_property("${json}" ${index} DISABLED disabled has_disabled)
    if(has_disabled AND disabled)
      set(${reason_out} disabled PARENT_SCOPE)
      return()
    endif()
    gbl_phase13_json_property("${json}" ${index} FIXTURES_SETUP setup has_setup)
    if(NOT has_setup OR NOT "phase13_fast" IN_LIST setup)
      set(${reason_out} setup-set PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase13_discover build_dir regex output_var)
  execute_process(
    COMMAND "${CTEST_PROGRAM}" --test-dir "${build_dir}" --show-only=json-v1
      --fixture-exclude-any "^(phase7_fast|phase8_fast|phase9_fast|phase10_fast|phase11_fast|phase12_fast)$"
      -R "${regex}"
    RESULT_VARIABLE result OUTPUT_VARIABLE json ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "phase13-selection: discovery-failed: ${result}\n${error}")
  endif()
  set(${output_var} "${json}" PARENT_SCOPE)
endfunction()

function(gbl_phase13_check_inventory path lane reason_out)
  if(NOT EXISTS "${path}")
    set(${reason_out} inventory-missing PARENT_SCOPE)
    return()
  endif()
  file(STRINGS "${path}" rows)
  set(sorted_rows ${rows})
  list(SORT sorted_rows)
  if(NOT "${rows}" STREQUAL "${sorted_rows}")
    set(${reason_out} inventory-unsorted PARENT_SCOPE)
    return()
  endif()
  foreach(expected_row IN LISTS GBL_PHASE13_INVENTORY_ROWS)
    string(REGEX MATCH "^([^ ]+)" name "${expected_row}")
    if(lane STREQUAL "asan" AND name MATCHES "^profile[.]")
      continue()
    endif()
    string(REPLACE "." "[.]" name_regex "${name}")
    file(STRINGS "${path}" matching_rows REGEX "^${name_regex} ")
    list(LENGTH matching_rows row_count)
    if(NOT row_count EQUAL 1)
      set(${reason_out} "inventory-${name}-count-${row_count}" PARENT_SCOPE)
      return()
    endif()
    list(GET matching_rows 0 actual_row)
    if(NOT actual_row STREQUAL expected_row)
      set(${reason_out} "inventory-${name}-labels" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  if(lane STREQUAL "asan")
    file(STRINGS "${path}" profile_rows REGEX "^profile[.]lint |^profile[.]nc[.]ppu_policy ")
    if(profile_rows)
      set(${reason_out} asan-invented-profile-gate PARENT_SCOPE)
      return()
    endif()
  endif()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase13_write_scratch_selection source_dir build_dir)
  file(MAKE_DIRECTORY "${source_dir}")
  set(project_text
    "cmake_minimum_required(VERSION 3.25)\nproject(phase13_selection_scratch NONE)\nenable_testing()\n")
  foreach(name IN LISTS GBL_PHASE13_EXPECTED)
    if(name MATCHES "^(ppu[.]obj[.](tracer|regular|affine|budget)|ppu[.]composition)$")
      string(APPEND project_text
        "add_test(NAME ${name} COMMAND \"${GBL_PHASE13_BIN}/bus_test\" ${name})\n")
      set(labels "bus;core;integration;ppu")
    elseif(name MATCHES "^ppu[.]")
      string(APPEND project_text
        "add_test(NAME ${name} COMMAND \"${GBL_PHASE13_BIN}/bus_test\" ${name})\n")
      set(labels "bus;core;ppu;unit")
    elseif(name STREQUAL "phase13.selection.control")
      string(APPEND project_text
        "add_test(NAME ${name} COMMAND \"${CMAKE_PROGRAM}\" \"-DSRC=${GBL_PHASE13_SRC}\" \"-DBIN=${GBL_PHASE13_BIN}\" -DCASE=control -P \"${GBL_PHASE13_GATE}\")\n")
      set(labels "gate;ppu;time")
    elseif(name MATCHES "^determinism[.]phase13([.]controls)?$")
      if(name STREQUAL "determinism.phase13.controls")
        set(argument phase13-controls)
      else()
        set(argument phase13)
      endif()
      string(APPEND project_text
        "add_test(NAME ${name} COMMAND \"${GBL_PHASE13_BIN}/determinism_test\" ${argument})\n")
      set(labels "determinism;gate;integration")
    elseif(name STREQUAL "profile.lint")
      string(APPEND project_text
        "add_test(NAME ${name} COMMAND \"${CMAKE_PROGRAM}\" \"-DPROFILE=${GBL_PHASE13_SRC}/profiles/agb.json\" \"-DDOC=${GBL_PHASE13_SRC}/docs/profile-agb.md\" \"-DREGISTRY=${GBL_PHASE13_SRC}/registry/disputes.json\" \"-DVOCAB=${GBL_PHASE13_SRC}/contracts/evidence.json\" -P \"${GBL_PHASE13_SRC}/cmake/CheckProfile.cmake\")\n")
      set(labels "gate;profile")
    else()
      string(APPEND project_text
        "add_test(NAME ${name} COMMAND \"${CMAKE_PROGRAM}\" \"-DSRC=${GBL_PHASE13_SRC}\" \"-DBIN=${GBL_PHASE13_BIN}\" -DCASE=ppu_policy -P \"${GBL_PHASE13_SRC}/tests/gates/profile_case.cmake\")\n")
      set(labels "control;profile")
    endif()
    string(APPEND project_text
      "set_tests_properties(${name} PROPERTIES LABELS \"${labels}\" FIXTURES_SETUP phase13_fast WORKING_DIRECTORY \"${GBL_PHASE13_BIN}\")\n")
  endforeach()
  file(WRITE "${source_dir}/CMakeLists.txt" "${project_text}")
  execute_process(
    COMMAND "${CMAKE_PROGRAM}" -S "${source_dir}" -B "${build_dir}"
    RESULT_VARIABLE configure_result
    OUTPUT_VARIABLE configure_output ERROR_VARIABLE configure_error)
  if(NOT "${configure_result}" STREQUAL "0")
    message(FATAL_ERROR
      "phase13-selection-control: scratch-configure\n${configure_output}${configure_error}")
  endif()
endfunction()

function(gbl_phase13_expect_invocation_rejection name marker)
  execute_process(
    COMMAND ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  set(combined "${output}${error}")
  string(FIND "${combined}" "${marker}" marker_index)
  if("${result}" STREQUAL "0" OR marker_index EQUAL -1)
    message(FATAL_ERROR
      "phase13-selection-control: ${name}: expected-${marker}; result=${result}\n${combined}")
  endif()
  message(STATUS "phase13-selection-control: ${name}: causal rejection ok")
endfunction()

function(gbl_phase13_check_selection_controls scratch_root)
  set(source_dir "${scratch_root}/selection/source")
  set(build_dir "${scratch_root}/selection/build")
  gbl_phase13_write_scratch_selection("${source_dir}" "${build_dir}")
  execute_process(
    COMMAND "${CTEST_PROGRAM}" --test-dir "${build_dir}" --show-only=json-v1
    RESULT_VARIABLE discovery_result OUTPUT_VARIABLE clean_json
    ERROR_VARIABLE discovery_error)
  if(NOT "${discovery_result}" STREQUAL "0")
    message(FATAL_ERROR
      "phase13-selection-control: scratch-discovery\n${discovery_error}")
  endif()
  gbl_phase13_validate_selection("${clean_json}" clean_reason)
  if(NOT "${clean_reason}" STREQUAL "")
    message(FATAL_ERROR "phase13-selection-control: clean-twin-${clean_reason}")
  endif()
  message(STATUS "phase13-selection-control: scratch clean selection twin passed")

  set(empty_json "{\"kind\":\"ctestInfo\",\"tests\":[]}")
  gbl_phase13_validate_selection("${empty_json}" empty_reason)
  if(NOT empty_reason STREQUAL "selection-count")
    message(FATAL_ERROR
      "phase13-selection-control: empty-selection-not-causal-${empty_reason}")
  endif()
  message(STATUS "phase13-selection-control: empty-selection: causal rejection ok")

  gbl_phase13_find_test("${clean_json}" ppu.obj.tracer tracer_index tracer_count)
  if(NOT tracer_count EQUAL 1)
    message(FATAL_ERROR "phase13-selection-control: clean-twin-missing-ppu.obj.tracer")
  endif()
  gbl_phase13_find_test("${clean_json}" ppu.refusal refusal_index refusal_count)
  if(NOT refusal_count EQUAL 1)
    message(FATAL_ERROR "phase13-selection-control: clean-twin-missing-ppu.refusal")
  endif()
  string(JSON duplicate_json SET "${clean_json}" tests ${refusal_index} name
    "\"ppu.obj.tracer\"")
  gbl_phase13_validate_selection("${duplicate_json}" duplicate_reason)
  if(NOT duplicate_reason STREQUAL "duplicate-selector")
    message(FATAL_ERROR
      "phase13-selection-control: duplicate-selector-not-causal-${duplicate_reason}")
  endif()
  message(STATUS "phase13-selection-control: duplicate-selector: causal rejection ok")

  gbl_phase13_find_test("${clean_json}" ppu.obj.tracer tracer_index tracer_count)
  if(NOT tracer_count EQUAL 1)
    message(FATAL_ERROR "phase13-selection-control: clean-twin-missing-ppu.obj.tracer")
  endif()
  string(JSON missing_json REMOVE "${clean_json}" tests ${tracer_index})
  gbl_phase13_validate_selection("${missing_json}" missing_reason)
  if(NOT missing_reason STREQUAL "selection-count")
    message(FATAL_ERROR
      "phase13-selection-control: missing-selector-not-causal-${missing_reason}")
  endif()
  message(STATUS "phase13-selection-control: missing-selector: causal rejection ok")

  gbl_phase13_find_test("${clean_json}" ppu.obj.affine affine_index affine_count)
  if(NOT affine_count EQUAL 1)
    message(FATAL_ERROR
      "phase13-selection-control: clean-twin-missing-ppu.obj.affine")
  endif()
  string(JSON affine_missing_json REMOVE "${clean_json}" tests ${affine_index})
  gbl_phase13_validate_selection("${affine_missing_json}"
    affine_missing_reason)
  if(NOT affine_missing_reason STREQUAL "selection-count")
    message(FATAL_ERROR
      "phase13-selection-control: affine-omission-not-causal-${affine_missing_reason}")
  endif()
  message(STATUS
    "phase13-selection-control: affine-omission: causal rejection ok")

  gbl_phase13_find_test("${clean_json}" ppu.obj.budget budget_index budget_count)
  if(NOT budget_count EQUAL 1)
    message(FATAL_ERROR
      "phase13-selection-control: clean-twin-missing-ppu.obj.budget")
  endif()
  string(JSON budget_missing_json REMOVE "${clean_json}" tests ${budget_index})
  gbl_phase13_validate_selection("${budget_missing_json}"
    budget_missing_reason)
  if(NOT budget_missing_reason STREQUAL "selection-count")
    message(FATAL_ERROR
      "phase13-selection-control: budget-omission-not-causal-${budget_missing_reason}")
  endif()
  message(STATUS
    "phase13-selection-control: budget-omission: causal rejection ok")

  gbl_phase13_find_test("${clean_json}" ppu.obj.tracer tracer_index tracer_count)
  file(MAKE_DIRECTORY "${scratch_root}/missing")
  file(WRITE "${scratch_root}/missing/bus_test" "not a test executable\n")
  set(wrong_command_json "${clean_json}")
  string(JSON wrong_command_json SET "${wrong_command_json}" tests ${tracer_index}
    command 0 "\"${scratch_root}/missing/bus_test\"")
  gbl_phase13_validate_selection("${wrong_command_json}" wrong_command_reason)
  if(NOT wrong_command_reason STREQUAL "wrong-command")
    message(FATAL_ERROR
      "phase13-selection-control: wrong-command-not-causal-${wrong_command_reason}")
  endif()
  message(STATUS "phase13-selection-control: wrong-command: causal rejection ok")

  set(wrong_argument_json "${clean_json}")
  string(JSON wrong_argument_json SET "${wrong_argument_json}" tests ${tracer_index}
    command 1 "\"ppu.obj.regular\"")
  gbl_phase13_validate_selection("${wrong_argument_json}" wrong_argument_reason)
  if(NOT wrong_argument_reason STREQUAL "wrong-command")
    message(FATAL_ERROR
      "phase13-selection-control: wrong-argument-not-causal-${wrong_argument_reason}")
  endif()
  message(STATUS "phase13-selection-control: wrong-argument: causal rejection ok")

  gbl_phase13_find_test("${clean_json}" ppu.obj.tracer tracer_index tracer_count)
  string(JSON property_count LENGTH "${clean_json}" tests ${tracer_index} properties)
  set(labels_property -1)
  set(working_directory_property -1)
  if(property_count GREATER 0)
    math(EXPR property_last "${property_count} - 1")
    foreach(property_index RANGE 0 ${property_last})
      string(JSON property_name GET "${clean_json}" tests ${tracer_index}
        properties ${property_index} name)
      if(property_name STREQUAL "LABELS")
        set(labels_property ${property_index})
      elseif(property_name STREQUAL "WORKING_DIRECTORY")
        set(working_directory_property ${property_index})
      endif()
    endforeach()
  endif()
  if(labels_property EQUAL -1)
    message(FATAL_ERROR "phase13-selection-control: clean-twin-missing-labels")
  endif()
  string(JSON wrong_labels_json SET "${clean_json}" tests ${tracer_index}
    properties ${labels_property} value 0 "\"wrong\"")
  gbl_phase13_validate_selection("${wrong_labels_json}" wrong_labels_reason)
  if(NOT wrong_labels_reason STREQUAL "wrong-label")
    message(FATAL_ERROR
      "phase13-selection-control: wrong-label-not-causal-${wrong_labels_reason}")
  endif()
  message(STATUS "phase13-selection-control: wrong-label: causal rejection ok")

  set(foreign_working_directory "${scratch_root}/foreign-working-directory")
  file(MAKE_DIRECTORY "${foreign_working_directory}")
  if(working_directory_property EQUAL -1)
    message(FATAL_ERROR "phase13-selection-control: clean-twin-missing-working-directory")
  endif()
  set(wrong_root_json "${clean_json}")
  string(JSON wrong_root_json SET "${wrong_root_json}" tests ${tracer_index}
    properties ${working_directory_property} value
    "\"${foreign_working_directory}\"")
  gbl_phase13_validate_selection("${wrong_root_json}" wrong_root_reason)
  if(NOT wrong_root_reason STREQUAL "wrong-root")
    message(FATAL_ERROR
      "phase13-selection-control: wrong-root-not-causal-${wrong_root_reason}")
  endif()
  message(STATUS "phase13-selection-control: wrong-root: causal rejection ok")

  gbl_phase13_find_test("${clean_json}" ppu.obj.tracer tracer_index tracer_count)
  string(JSON skipped_json GET "${clean_json}" tests ${tracer_index})
  string(JSON property_count LENGTH "${skipped_json}" properties)
  set(skip_property "{\"name\":\"SKIP_REGULAR_EXPRESSION\",\"value\":\"skip\"}")
  string(JSON skipped_json SET "${skipped_json}" properties ${property_count}
    "${skip_property}")
  set(skipped_graph "${clean_json}")
  string(JSON skipped_graph SET "${skipped_graph}" tests ${tracer_index}
    "${skipped_json}")
  gbl_phase13_validate_selection("${skipped_graph}" skipped_reason)
  if(NOT skipped_reason STREQUAL "skippable")
    message(FATAL_ERROR
      "phase13-selection-control: skipped-case-not-causal-${skipped_reason}")
  endif()
  message(STATUS "phase13-selection-control: skipped-case: causal rejection ok")

  string(JSON disabled_json GET "${clean_json}" tests ${tracer_index})
  string(JSON disabled_property_count LENGTH "${disabled_json}" properties)
  string(JSON disabled_json SET "${disabled_json}" properties ${disabled_property_count}
    "{\"name\":\"DISABLED\",\"value\":true}")
  set(disabled_graph "${clean_json}")
  string(JSON disabled_graph SET "${disabled_graph}" tests ${tracer_index}
    "${disabled_json}")
  gbl_phase13_validate_selection("${disabled_graph}" disabled_reason)
  if(NOT disabled_reason STREQUAL "disabled")
    message(FATAL_ERROR
      "phase13-selection-control: disabled-case-not-causal-${disabled_reason}")
  endif()
  message(STATUS "phase13-selection-control: disabled-case: causal rejection ok")

  set(foreign_root "${scratch_root}/foreign-root")
  file(MAKE_DIRECTORY "${foreign_root}")
  gbl_phase13_expect_invocation_rejection(foreign-root "source-build-mismatch"
    "${CMAKE_PROGRAM}" "-DSRC=${foreign_root}" "-DBIN=${GBL_PHASE13_BIN}"
    -DCASE=verify -P "${GBL_PHASE13_GATE}")

  set(foreign_script "${scratch_root}/foreign-script/phase13_selection.cmake")
  get_filename_component(foreign_script_dir "${foreign_script}" DIRECTORY)
  file(MAKE_DIRECTORY "${foreign_script_dir}")
  file(COPY_FILE "${GBL_PHASE13_GATE}" "${foreign_script}")
  gbl_phase13_expect_invocation_rejection(foreign-script "script-source-mismatch"
    "${CMAKE_PROGRAM}" "-DSRC=${GBL_PHASE13_SRC}" "-DBIN=${GBL_PHASE13_BIN}"
    -DCASE=verify -P "${foreign_script}")

  set(empty_build "${scratch_root}/empty-build")
  file(MAKE_DIRECTORY "${empty_build}")
  gbl_phase13_expect_invocation_rejection(empty-build "build-cache-missing"
    "${CMAKE_PROGRAM}" "-DSRC=${GBL_PHASE13_SRC}" "-DBIN=${empty_build}"
    -DCASE=verify -P "${GBL_PHASE13_GATE}")

  set(ci_inventory "${GBL_PHASE13_SRC}/tests/inventory/ci.txt")
  file(READ "${ci_inventory}" inventory_text)
  set(control_row "phase13.selection.control gate,ppu,time")
  string(REPLACE "${control_row}\n" "${control_row}\n${control_row}\n"
    duplicate_inventory "${inventory_text}")
  set(duplicate_inventory_path "${scratch_root}/duplicate-ci.txt")
  file(WRITE "${duplicate_inventory_path}" "${duplicate_inventory}")
  gbl_phase13_check_inventory("${duplicate_inventory_path}" ci duplicate_reason)
  if(NOT duplicate_reason STREQUAL "inventory-phase13.selection.control-count-2")
    message(FATAL_ERROR
      "phase13-selection-control: duplicate-inventory-not-causal-${duplicate_reason}")
  endif()
  message(STATUS "phase13-selection-control: duplicate-inventory-row: causal rejection ok")
endfunction()

function(gbl_phase13_required_names lane output_var)
  set(names phase13.selection.verify phase13.selection.order)
  set(${output_var} "${names}" PARENT_SCOPE)
endfunction()

function(gbl_phase13_validate_order json reason_out)
  set(expected_setup
    ppu.obj.tracer ppu.obj.regular ppu.obj.affine ppu.obj.budget
    ppu.obj.boundary ppu.obj.controls ppu.composition ppu.refusal
    determinism.phase13 determinism.phase13.controls
    phase13.selection.control)
  if(GBL_PHASE13_LANE STREQUAL "ci")
    list(APPEND expected_setup profile.lint profile.nc.ppu_policy)
  endif()
  gbl_phase13_required_names("${GBL_PHASE13_LANE}" expected_required)
  string(JSON count ERROR_VARIABLE count_error LENGTH "${json}" tests)
  if(NOT "${count_error}" STREQUAL "NOTFOUND")
    set(${reason_out} malformed PARENT_SCOPE)
    return()
  endif()
  set(actual_setup)
  set(actual_required)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
      string(JSON name GET "${json}" tests ${index} name)
      gbl_phase13_json_property("${json}" ${index} FIXTURES_SETUP setup has_setup)
      gbl_phase13_json_property("${json}" ${index} FIXTURES_REQUIRED required has_required)
      if(has_setup AND "phase13_fast" IN_LIST setup)
        list(APPEND actual_setup "${name}")
        if("phase13_fast" IN_LIST required)
          set(${reason_out} "setup-self-cycle-${name}" PARENT_SCOPE)
          return()
        endif()
      endif()
      if(has_required AND "phase13_fast" IN_LIST required)
        list(APPEND actual_required "${name}")
      endif()
    endforeach()
  endif()
  list(SORT actual_setup)
  list(SORT expected_setup)
  if(NOT "${actual_setup}" STREQUAL "${expected_setup}")
    set(${reason_out} setup-set PARENT_SCOPE)
    return()
  endif()
  list(SORT actual_required)
  list(SORT expected_required)
  if(NOT "${actual_required}" STREQUAL "${expected_required}")
    foreach(name IN LISTS expected_required)
      if(NOT name IN_LIST actual_required)
        set(${reason_out} "missing-predecessor-${name}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
    set(${reason_out} unexpected-required-set PARENT_SCOPE)
    return()
  endif()
  foreach(name IN LISTS expected_setup expected_required)
    gbl_phase13_find_test("${json}" "${name}" index found_count)
    if(NOT found_count EQUAL 1)
      set(${reason_out} "registration-count-${name}-${found_count}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(name IN ITEMS phase13.selection.control phase13.selection.verify
      phase13.selection.order)
    gbl_phase13_find_test("${json}" "${name}" index found_count)
    if(NOT found_count EQUAL 1)
      set(${reason_out} "registration-count-${name}-${found_count}" PARENT_SCOPE)
      return()
    endif()
    gbl_phase13_expected_command("${name}" "${json}" ${index} command_reason)
    if(NOT "${command_reason}" STREQUAL "")
      set(${reason_out} "${name}-${command_reason}" PARENT_SCOPE)
      return()
    endif()
    gbl_phase13_json_property("${json}" ${index} LABELS labels has_labels)
    set(expected_labels gate ppu time)
    set(actual_labels ${labels})
    list(SORT actual_labels)
    list(SORT expected_labels)
    if(NOT has_labels OR NOT "${actual_labels}" STREQUAL "${expected_labels}")
      set(${reason_out} "${name}-wrong-label" PARENT_SCOPE)
      return()
    endif()
    gbl_phase13_json_property("${json}" ${index} WORKING_DIRECTORY workdir has_workdir)
    if(NOT has_workdir)
      set(${reason_out} "${name}-missing-root" PARENT_SCOPE)
      return()
    endif()
    file(REAL_PATH "${workdir}" workdir_real)
    if(NOT workdir_real STREQUAL GBL_PHASE13_BIN)
      set(${reason_out} "${name}-wrong-root" PARENT_SCOPE)
      return()
    endif()
    gbl_phase13_json_property("${json}" ${index} SKIP_REGULAR_EXPRESSION
      skip_expression has_skip)
    gbl_phase13_json_property("${json}" ${index} DISABLED disabled has_disabled)
    if(has_skip OR (has_disabled AND disabled))
      set(${reason_out} "${name}-skippable" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(name IN ITEMS profile.lint profile.nc.ppu_policy)
    if(NOT name IN_LIST expected_setup)
      continue()
    endif()
    gbl_phase13_find_test("${json}" "${name}" index found_count)
    gbl_phase13_expected_command("${name}" "${json}" ${index} command_reason)
    if(NOT "${command_reason}" STREQUAL "")
      set(${reason_out} "${name}-${command_reason}" PARENT_SCOPE)
      return()
    endif()
    gbl_phase13_json_property("${json}" ${index} LABELS labels has_labels)
    if(name STREQUAL "profile.lint")
      set(expected_labels gate profile)
    else()
      set(expected_labels control profile)
    endif()
    set(actual_labels ${labels})
    list(SORT actual_labels)
    list(SORT expected_labels)
    if(NOT has_labels OR NOT "${actual_labels}" STREQUAL "${expected_labels}")
      set(${reason_out} "${name}-wrong-label" PARENT_SCOPE)
      return()
    endif()
    gbl_phase13_json_property("${json}" ${index} WORKING_DIRECTORY workdir has_workdir)
    if(NOT has_workdir)
      set(${reason_out} "${name}-missing-root" PARENT_SCOPE)
      return()
    endif()
    file(REAL_PATH "${workdir}" workdir_real)
    if(NOT workdir_real STREQUAL GBL_PHASE13_BIN)
      set(${reason_out} "${name}-wrong-root" PARENT_SCOPE)
      return()
    endif()
    gbl_phase13_json_property("${json}" ${index} SKIP_REGULAR_EXPRESSION
      skip_expression has_skip)
    gbl_phase13_json_property("${json}" ${index} DISABLED disabled has_disabled)
    if(has_skip OR (has_disabled AND disabled))
      set(${reason_out} "${name}-skippable" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(name IN ITEMS ppu.refusal)
    gbl_phase13_find_test("${json}" "${name}" index found_count)
    gbl_phase13_json_property("${json}" ${index} FIXTURES_SETUP setup has_setup)
    if(NOT "phase13_fast" IN_LIST setup OR NOT "phase10_fast" IN_LIST setup)
      set(${reason_out} "setup-ownership-${name}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase13_check_helper_controls scratch_root)
  set(helper "${GBL_PHASE13_SRC}/scripts/verify-phase13-fast.sh")
  if(NOT EXISTS "${helper}")
    message(FATAL_ERROR "phase13-helper-control: helper-missing")
  endif()
  set(control_root "${scratch_root}/helper")
  set(source_dir "${control_root}/source")
  set(build_dir "${control_root}/build")
  set(shim_dir "${control_root}/shim")
  file(MAKE_DIRECTORY "${source_dir}" "${shim_dir}")
  set(project_text
    "cmake_minimum_required(VERSION 3.25)\nproject(phase13_helper_scratch NONE)\nenable_testing()\nset(GBL_LANE asan CACHE STRING \"lane\")\n")
  set(control_expected
    ppu.obj.tracer ppu.obj.regular ppu.obj.affine ppu.obj.budget
    ppu.obj.boundary ppu.obj.controls ppu.composition ppu.refusal
    determinism.phase13 determinism.phase13.controls
    phase13.selection.control)
  file(MAKE_DIRECTORY "${build_dir}")
  foreach(name IN LISTS control_expected)
    if(name MATCHES "^ppu[.]")
      string(APPEND project_text
        "add_test(NAME ${name} COMMAND \"${build_dir}/bus_test${CMAKE_EXECUTABLE_SUFFIX}\" ${name})\n")
      if(name MATCHES "^(ppu[.]obj[.](tracer|regular|affine|budget)|ppu[.]composition)$")
        set(labels "bus;core;integration;ppu")
      else()
        set(labels "bus;core;ppu;unit")
      endif()
    elseif(name MATCHES "^determinism[.]phase13([.]controls)?$")
      if(name STREQUAL "determinism.phase13.controls")
        set(argument phase13-controls)
      else()
        set(argument phase13)
      endif()
      string(APPEND project_text
        "add_test(NAME ${name} COMMAND \"${build_dir}/determinism_test${CMAKE_EXECUTABLE_SUFFIX}\" ${argument})\n")
      set(labels "determinism;gate;integration")
    elseif(name STREQUAL "phase13.selection.control")
      string(APPEND project_text
        "add_test(NAME ${name} COMMAND \"${CMAKE_COMMAND}\" \"-DSRC=${GBL_PHASE13_SRC}\" \"-DBIN=${build_dir}\" -DCASE=control -P \"${GBL_PHASE13_GATE}\")\n")
      set(labels "gate;ppu;time")
    endif()
    if(name STREQUAL "ppu.refusal")
      set(setup_fixtures "phase10_fast;phase13_fast")
    else()
      set(setup_fixtures phase13_fast)
    endif()
    string(APPEND project_text
      "set_tests_properties(${name} PROPERTIES LABELS \"${labels}\" FIXTURES_SETUP \"${setup_fixtures}\" WORKING_DIRECTORY \"${build_dir}\")\n")
  endforeach()
  foreach(case IN ITEMS verify order)
    set(name "phase13.selection.${case}")
    string(APPEND project_text
      "add_test(NAME ${name} COMMAND \"${CMAKE_COMMAND}\" \"-DSRC=${GBL_PHASE13_SRC}\" \"-DBIN=${build_dir}\" -DCASE=${case} -P \"${GBL_PHASE13_GATE}\")\n")
    string(APPEND project_text
      "set_tests_properties(${name} PROPERTIES LABELS \"gate;ppu;time\" FIXTURES_REQUIRED phase13_fast WORKING_DIRECTORY \"${build_dir}\")\n")
  endforeach()
  file(WRITE "${source_dir}/CMakeLists.txt" "${project_text}")
  file(WRITE "${build_dir}/bus_test${CMAKE_EXECUTABLE_SUFFIX}"
    "#!/bin/sh\nif [ \"\${GBL_PHASE13_CONTROL_FAIL:-}\" = \"\$1\" ]; then exit 31; fi\nexit 0\n")
  file(WRITE "${build_dir}/determinism_test${CMAKE_EXECUTABLE_SUFFIX}"
    "#!/bin/sh\nexit 0\n")
  file(CHMOD "${build_dir}/bus_test${CMAKE_EXECUTABLE_SUFFIX}"
    PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
  file(CHMOD "${build_dir}/determinism_test${CMAKE_EXECUTABLE_SUFFIX}"
    PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
  file(WRITE "${shim_dir}/sh"
    "#!/bin/sh\ncase \"\${1:-}\" in\n  */scripts/verify-phase12-fast.sh)\n    printf 'closure\\n' >> \"\$GBL_PHASE13_CONTROL_CLOSURE_SENTINEL\"\n    printf '%s\\n' 'phase13-helper-control: inherited closure sentinel reached'\n    exit 0\n    ;;\nesac\nexec /bin/sh \"\$@\"\n")
  file(CHMOD "${shim_dir}/sh" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)

  execute_process(
    COMMAND "${CMAKE_PROGRAM}" -S "${source_dir}" -B "${build_dir}"
    RESULT_VARIABLE configure_result OUTPUT_VARIABLE configure_output
    ERROR_VARIABLE configure_error)
  if(NOT "${configure_result}" STREQUAL "0")
    file(REMOVE_RECURSE "${control_root}")
    message(FATAL_ERROR
      "phase13-helper-control: scratch-configure\n${configure_output}${configure_error}")
  endif()
  file(READ "${build_dir}/CMakeCache.txt" cache_text)
  string(REPLACE "CMAKE_HOME_DIRECTORY:INTERNAL=${source_dir}"
    "CMAKE_HOME_DIRECTORY:INTERNAL=${GBL_PHASE13_SRC}" cache_text "${cache_text}")
  file(WRITE "${build_dir}/CMakeCache.txt" "${cache_text}")

  set(fail_sentinel "${control_root}/fail-closure.ran")
  execute_process(
    COMMAND "${CMAKE_PROGRAM}" -E env
      "PATH=${shim_dir}:$ENV{PATH}"
      "GBL_PHASE13_SKIP_HELPER_CONTROL=1"
      "GBL_PHASE13_CONTROL_CLOSURE_SENTINEL=${fail_sentinel}"
      "GBL_PHASE13_CONTROL_FAIL=ppu.obj.tracer"
      "${helper}" --bin "${build_dir}"
    RESULT_VARIABLE fail_result OUTPUT_VARIABLE fail_output ERROR_VARIABLE fail_error)
  string(FIND "${fail_output}${fail_error}" "phase13-selector-failure" failure_marker)
  if("${fail_result}" STREQUAL "0" OR failure_marker EQUAL -1 OR
      EXISTS "${fail_sentinel}")
    file(REMOVE_RECURSE "${control_root}")
    message(FATAL_ERROR
      "phase13-helper-control: cheap-failure-did-not-block-closure\n${fail_output}${fail_error}")
  endif()

  set(pass_sentinel "${control_root}/pass-closure.ran")
  execute_process(
    COMMAND "${CMAKE_PROGRAM}" -E env
      "PATH=${shim_dir}:$ENV{PATH}"
      "GBL_PHASE13_SKIP_HELPER_CONTROL=1"
      "GBL_PHASE13_CONTROL_CLOSURE_SENTINEL=${pass_sentinel}"
      "GBL_PHASE13_CONTROL_FAIL="
      "${helper}" --bin "${build_dir}"
    RESULT_VARIABLE pass_result OUTPUT_VARIABLE pass_output ERROR_VARIABLE pass_error)
  if(NOT "${pass_result}" STREQUAL "0" OR
      NOT "${pass_output}${pass_error}" MATCHES "phase13-helper-control: inherited closure sentinel reached" OR
      NOT EXISTS "${pass_sentinel}")
    file(REMOVE_RECURSE "${control_root}")
    message(FATAL_ERROR
      "phase13-helper-control: clean-run-did-not-reach-closure\n${pass_output}${pass_error}")
  endif()
  file(READ "${pass_sentinel}" pass_contents)
  if(NOT pass_contents STREQUAL "closure\n")
    file(REMOVE_RECURSE "${control_root}")
    message(FATAL_ERROR
      "phase13-helper-control: closure-sentinel-count-not-one: ${pass_contents}")
  endif()
  file(REMOVE_RECURSE "${control_root}")
  message(STATUS
    "phase13-helper-control: cheap failure blocks closure; clean exact run reaches it once")
endfunction()

function(gbl_phase13_check_fixture_controls scratch_root)
  foreach(mode IN ITEMS fail pass)
    set(source "${scratch_root}/fixture-${mode}/source")
    set(build "${scratch_root}/fixture-${mode}/build")
    set(sentinel "${scratch_root}/fixture-${mode}/downstream.ran")
    file(MAKE_DIRECTORY "${source}")
    if(mode STREQUAL "fail")
      set(setup_body "message(FATAL_ERROR \"phase13-order: intentional setup fault\")")
    else()
      set(setup_body "message(STATUS \"phase13-order: setup succeeded\")")
    endif()
    file(WRITE "${source}/setup.cmake" "${setup_body}\n")
    file(WRITE "${source}/downstream.cmake" "file(WRITE \"${sentinel}\" ran)\n")
    file(WRITE "${source}/CMakeLists.txt"
      "cmake_minimum_required(VERSION 3.25)\nproject(phase13_fixture_${mode} NONE)\nenable_testing()\nadd_test(NAME cheap_setup COMMAND \"${CMAKE_PROGRAM}\" -P \"${source}/setup.cmake\")\nset_tests_properties(cheap_setup PROPERTIES FIXTURES_SETUP phase13_fast)\nadd_test(NAME downstream_sentinel COMMAND \"${CMAKE_PROGRAM}\" -P \"${source}/downstream.cmake\")\nset_tests_properties(downstream_sentinel PROPERTIES FIXTURES_REQUIRED phase13_fast)\n")
    execute_process(
      COMMAND "${CMAKE_PROGRAM}" -S "${source}" -B "${build}"
      RESULT_VARIABLE configure_result OUTPUT_VARIABLE configure_output
      ERROR_VARIABLE configure_error)
    if(NOT "${configure_result}" STREQUAL "0")
      message(FATAL_ERROR
        "phase13-order: scratch-configure-${mode}\n${configure_output}${configure_error}")
    endif()
  endforeach()
  set(fail_build "${scratch_root}/fixture-fail/build")
  set(fail_sentinel "${scratch_root}/fixture-fail/downstream.ran")
  set(pass_build "${scratch_root}/fixture-pass/build")
  set(pass_sentinel "${scratch_root}/fixture-pass/downstream.ran")
  file(REMOVE "${fail_sentinel}" "${pass_sentinel}")
  execute_process(
    COMMAND "${CTEST_PROGRAM}" --test-dir "${fail_build}" --output-on-failure
      --no-tests=error -R "^downstream_sentinel$"
    RESULT_VARIABLE fail_result OUTPUT_VARIABLE fail_output ERROR_VARIABLE fail_error)
  string(FIND "${fail_output}${fail_error}" "intentional setup fault" fault_index)
  if("${fail_result}" STREQUAL "0" OR EXISTS "${fail_sentinel}" OR
      fault_index EQUAL -1 OR NOT "${fail_output}${fail_error}" MATCHES "Not Run")
    message(FATAL_ERROR
      "phase13-order: failing-setup-did-not-block-sentinel\n${fail_output}${fail_error}")
  endif()
  execute_process(
    COMMAND "${CTEST_PROGRAM}" --test-dir "${pass_build}" --output-on-failure
      --no-tests=error -R "^downstream_sentinel$"
    RESULT_VARIABLE pass_result OUTPUT_VARIABLE pass_output ERROR_VARIABLE pass_error)
  if(NOT "${pass_result}" STREQUAL "0" OR NOT EXISTS "${pass_sentinel}")
    message(FATAL_ERROR
      "phase13-order: clean-setup-did-not-permit-sentinel\n${pass_output}${pass_error}")
  endif()
  file(READ "${pass_sentinel}" pass_sentinel_contents)
  string(REGEX MATCHALL "[0-9]+/[0-9]+ Test #[0-9]+: downstream_sentinel"
    downstream_runs "${pass_output}")
  list(LENGTH downstream_runs downstream_run_count)
  if(NOT pass_sentinel_contents STREQUAL "ran" OR
      NOT downstream_run_count EQUAL 1)
    message(FATAL_ERROR
      "phase13-order: clean-setup-sentinel-not-exactly-once\n${pass_output}")
  endif()
  message(STATUS "phase13-order: failing setup blocks sentinel; clean setup permits it")
endfunction()

function(gbl_phase13_check_order_controls json scratch_root)
  gbl_phase13_validate_order("${json}" clean_reason)
  if(NOT "${clean_reason}" STREQUAL "")
    message(FATAL_ERROR "phase13-order-control: clean-twin-${clean_reason}")
  endif()
  gbl_phase13_find_test("${json}" phase13.selection.verify tracer_index tracer_count)
  if(NOT tracer_count EQUAL 1)
    message(FATAL_ERROR "phase13-order-control: clean-twin-missing-phase13.selection.verify")
  endif()
  set(missing_json "${json}")
  string(JSON property_count LENGTH "${missing_json}" tests ${tracer_index} properties)
  set(required_property -1)
  if(property_count GREATER 0)
    math(EXPR property_last "${property_count} - 1")
    foreach(property_index RANGE 0 ${property_last})
      string(JSON property_name GET "${missing_json}" tests ${tracer_index}
        properties ${property_index} name)
      if(property_name STREQUAL "FIXTURES_REQUIRED")
        set(required_property ${property_index})
        break()
      endif()
    endforeach()
  endif()
  if(required_property EQUAL -1)
    message(FATAL_ERROR "phase13-order-control: no-required-fixture-property")
  endif()
  string(JSON fixture_count LENGTH "${missing_json}" tests ${tracer_index}
    properties ${required_property} value)
  set(missing_phase13 -1)
  if(fixture_count GREATER 0)
    math(EXPR fixture_last "${fixture_count} - 1")
    foreach(fixture_index RANGE 0 ${fixture_last})
      string(JSON fixture GET "${missing_json}" tests ${tracer_index}
        properties ${required_property} value ${fixture_index})
      if(fixture STREQUAL "phase13_fast")
        set(missing_phase13 ${fixture_index})
        break()
      endif()
    endforeach()
  endif()
  if(missing_phase13 EQUAL -1)
    message(FATAL_ERROR "phase13-order-control: clean-twin-lacks-predecessor")
  endif()
  string(JSON missing_json REMOVE "${missing_json}" tests ${tracer_index}
    properties ${required_property} value ${missing_phase13})
  gbl_phase13_validate_order("${missing_json}" missing_reason)
  if(NOT missing_reason STREQUAL "missing-predecessor-phase13.selection.verify")
    message(FATAL_ERROR
      "phase13-order-control: missing-predecessor-not-causal-${missing_reason}")
  endif()
  message(STATUS "phase13-order-control: missing-predecessor: causal rejection ok")
  gbl_phase13_check_fixture_controls("${scratch_root}/sentinel")
endfunction()

function(gbl_phase13_check_order_graph scratch_root)
  gbl_phase13_required_names("${GBL_PHASE13_LANE}" required_names)
  set(names ${required_names} ${GBL_PHASE13_EXPECTED}
    phase13.selection.verify phase13.selection.order)
  set(regex_parts)
  foreach(name IN LISTS names)
    string(REPLACE "." "[.]" escaped "${name}")
    list(APPEND regex_parts "${escaped}")
  endforeach()
  list(REMOVE_DUPLICATES regex_parts)
  list(JOIN regex_parts "|" order_regex)
  gbl_phase13_discover("${GBL_PHASE13_BIN}" "^(${order_regex})$" order_json)
  gbl_phase13_validate_order("${order_json}" order_reason)
  if(NOT "${order_reason}" STREQUAL "")
    message(FATAL_ERROR "phase13-order: ${order_reason}")
  endif()
  gbl_phase13_check_order_controls("${order_json}" "${scratch_root}")
  message(STATUS "phase13-order: exact Phase 13 fixture graph passed")
endfunction()

if(CASE STREQUAL "manifest")
  list(LENGTH GBL_PHASE13_EXPECTED manifest_count)
  message("phase13-manifest-count=${manifest_count}")
  message("phase13-manifest-regex=${GBL_PHASE13_REGEX}")
  list(LENGTH GBL_PHASE13_INHERITED_PROFILE inherited_profile_count)
  message("phase13-manifest-inherited-count=${inherited_profile_count}")
  foreach(name IN LISTS GBL_PHASE13_EXPECTED)
    message("phase13-manifest-name=${name}")
  endforeach()
  foreach(name IN LISTS GBL_PHASE13_INHERITED_PROFILE)
    message("phase13-manifest-inherited-name=${name}")
  endforeach()
elseif(CASE STREQUAL "verify")
  foreach(lane IN ITEMS ci asan)
    gbl_phase13_check_inventory(
      "${GBL_PHASE13_SRC}/tests/inventory/${lane}.txt" "${lane}" inventory_reason)
    if(NOT "${inventory_reason}" STREQUAL "")
      message(FATAL_ERROR "phase13-selection: ${lane}-${inventory_reason}")
    endif()
  endforeach()
  gbl_phase13_discover("${GBL_PHASE13_BIN}" "${GBL_PHASE13_REGEX}" selected_json)
  gbl_phase13_validate_selection("${selected_json}" selection_reason)
  if(NOT "${selection_reason}" STREQUAL "")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "TAP version 13")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "1..1")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo
      "not ok 1 - exact Phase 13 cheap selector fixture membership")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo
      "# observed ${selection_reason}; expected the exact lane set to set up phase13_fast")
    message(FATAL_ERROR "phase13-selection: ${selection_reason}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "TAP version 13")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "1..1")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo
    "ok 1 - exact Phase 13 cheap selector fixture membership")
  message(STATUS "phase13-selection: exact cheap selector set passed")
elseif(CASE STREQUAL "control")
  gbl_phase13_check_selection_controls("${GBL_PHASE13_BIN}/phase13-selection-controls")
  if(NOT DEFINED ENV{GBL_PHASE13_SKIP_HELPER_CONTROL})
    gbl_phase13_check_helper_controls("${GBL_PHASE13_BIN}/phase13-helper-controls")
  endif()
elseif(CASE STREQUAL "order")
  gbl_phase13_check_order_graph("${GBL_PHASE13_BIN}/phase13-order-controls")
else()
  message(FATAL_ERROR "phase13-selection: invalid-case")
endif()
