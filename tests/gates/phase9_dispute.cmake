# Dispute-link gate for every typed DMA latch observation.
# The selected latch interpretation remains project policy and disputed.
cmake_minimum_required(VERSION 3.25)

foreach(required IN ITEMS SRC BIN)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "phase9-dispute: missing-${required}")
  endif()
endforeach()
if(NOT DEFINED CASE)
  set(CASE all)
elseif("${CASE}" STREQUAL "")
  message(FATAL_ERROR "phase9-dispute: invalid-case")
endif()
if(NOT CASE MATCHES "^(all|verify|control)$")
  message(FATAL_ERROR "phase9-dispute: invalid-case")
endif()

get_filename_component(DEFAULT_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)
get_filename_component(SRC_ROOT "${SRC}" REALPATH BASE_DIR "${DEFAULT_ROOT}")
get_filename_component(BIN_ROOT "${BIN}" REALPATH BASE_DIR "${SRC_ROOT}")
if(NOT IS_DIRECTORY "${SRC_ROOT}" OR NOT IS_DIRECTORY "${BIN_ROOT}" OR
   NOT "${SRC_ROOT}" STREQUAL "${DEFAULT_ROOT}")
  message(FATAL_ERROR "phase9-dispute: source-or-build-directory-missing-or-wrong-root")
endif()
set(cache_file "${BIN_ROOT}/CMakeCache.txt")
if(NOT EXISTS "${cache_file}")
  message(FATAL_ERROR "phase9-dispute: configured-build-cache-missing")
endif()
file(STRINGS "${cache_file}" source_root_line REGEX "^CMAKE_HOME_DIRECTORY:INTERNAL=")
string(REPLACE "CMAKE_HOME_DIRECTORY:INTERNAL=" "" configured_source "${source_root_line}")
get_filename_component(configured_source "${configured_source}" REALPATH)
if(NOT "${configured_source}" STREQUAL "${SRC_ROOT}")
  message(FATAL_ERROR "phase9-dispute: configured-source-root-mismatch")
endif()

include("${SRC_ROOT}/cmake/GblJson.cmake")
find_program(CMAKE_PROGRAM NAMES cmake REQUIRED)
set(profile_file "${SRC_ROOT}/profiles/agb.json")
set(doc_file "${SRC_ROOT}/docs/profile-agb.md")
set(registry_file "${SRC_ROOT}/registry/disputes.json")
set(vocab_file "${SRC_ROOT}/contracts/evidence.json")
set(checker_file "${SRC_ROOT}/cmake/CheckProfile.cmake")
set(registry_checker "${SRC_ROOT}/cmake/CheckRegistry.cmake")
set(contract_checker "${SRC_ROOT}/cmake/CheckContract.cmake")
set(GBL_PHASE9_DISPUTE_AUTHORITY_FILES
  "${profile_file}"
  "${doc_file}"
  "${registry_file}"
  "${vocab_file}"
  "${checker_file}"
  "${registry_checker}"
  "${contract_checker}"
  "${SRC_ROOT}/cmake/GblJson.cmake")
set(GBL_PHASE9_DISPUTE_AUTHORITY_HASHES)
foreach(authority_file IN LISTS GBL_PHASE9_DISPUTE_AUTHORITY_FILES)
  if(NOT EXISTS "${authority_file}" OR IS_DIRECTORY "${authority_file}")
    message(FATAL_ERROR "phase9-dispute: authority-file-missing")
  endif()
  file(SHA256 "${authority_file}" authority_hash)
  list(APPEND GBL_PHASE9_DISPUTE_AUTHORITY_HASHES "${authority_hash}")
endforeach()

function(gbl_phase9_dispute_assert_authority_unchanged)
  list(LENGTH GBL_PHASE9_DISPUTE_AUTHORITY_FILES authority_count)
  if(authority_count EQUAL 0)
    message(FATAL_ERROR "phase9-dispute: authority-file-list-empty")
  endif()
  math(EXPR last_authority "${authority_count}-1")
  foreach(authority_index RANGE 0 ${last_authority})
    list(GET GBL_PHASE9_DISPUTE_AUTHORITY_FILES ${authority_index} authority_file)
    list(GET GBL_PHASE9_DISPUTE_AUTHORITY_HASHES ${authority_index} expected_hash)
    if(NOT EXISTS "${authority_file}" OR IS_DIRECTORY "${authority_file}")
      message(FATAL_ERROR "phase9-dispute: authority-file-removed")
    endif()
    file(SHA256 "${authority_file}" actual_hash)
    if(NOT "${actual_hash}" STREQUAL "${expected_hash}")
      message(FATAL_ERROR "phase9-dispute: authority-file-mutated (${authority_file})")
    endif()
  endforeach()
endfunction()
set(dma_test "${BIN_ROOT}/dma_test")
if(NOT EXISTS "${dma_test}" OR IS_DIRECTORY "${dma_test}")
  message(FATAL_ERROR "phase9-dispute: runtime-binary-missing")
endif()

function(gbl_phase9_dispute_json out json)
  string(JSON value ERROR_VARIABLE error GET "${json}" ${ARGN})
  if(NOT "${error}" STREQUAL "NOTFOUND" AND NOT "${error}" STREQUAL "")
    set(value "")
  endif()
  if(value STREQUAL "OFF")
    set(value "false")
  elseif(value STREQUAL "ON")
    set(value "true")
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(gbl_phase9_dispute_runtime out_record out_output)
  execute_process(COMMAND "${dma_test}" latch
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "0" OR NOT "${output}" MATCHES "TAP version 13" OR
     NOT "${output}" MATCHES "retained channel latches isolate halfword replication, word replacement, absent-source fallback, open bus, and reset")
    message(FATAL_ERROR "phase9-dispute: runtime-selector-latch-failed\n${output}${error}")
  endif()
  string(REPLACE "\r" "" output "${output}")
  string(REPLACE "\n" ";" lines "${output}")
  set(record_count 0)
  set(record "")
  foreach(line IN LISTS lines)
    if(line MATCHES "^phase9-observation:(.*)$")
      math(EXPR record_count "${record_count}+1")
      set(record "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  if(NOT record_count EQUAL 1)
    message(FATAL_ERROR "phase9-dispute: runtime-observation-count-${record_count}")
  endif()
  gbl_phase9_dispute_json(schema "${record}" schema)
  gbl_phase9_dispute_json(kind "${record}" kind)
  if(NOT schema STREQUAL "gamebloke.phase9-observation/1" OR NOT kind STREQUAL "dma-latch")
    message(FATAL_ERROR "phase9-dispute: runtime-observation-untagged-or-wrong-kind")
  endif()
  set(${out_record} "${record}" PARENT_SCOPE)
  set(${out_output} "${output}" PARENT_SCOPE)
endfunction()

function(gbl_phase9_dispute_check record_path registry_path profile_path reason_out)
  file(READ "${record_path}" record)
  file(READ "${registry_path}" registry)
  file(READ "${profile_path}" profile)
  set(reason "")

  gbl_phase9_dispute_json(profile_dispute "${profile}" dma_policy latch_policy dispute_id)
  gbl_phase9_dispute_json(profile_status "${profile}" dma_policy latch_policy dispute_status)
  gbl_phase9_dispute_json(profile_selection "${profile}" dma_policy latch_policy selection)
  gbl_phase9_dispute_json(profile_selection_class "${profile}" dma_policy latch_policy selection_classification)
  gbl_phase9_dispute_json(profile_result_class "${profile}" dma_policy latch_policy result_classification)
  gbl_phase9_dispute_json(profile_qualification "${profile}" dma_policy latch_policy hardware_qualification)
  if(NOT profile_dispute STREQUAL "disp-dma-latch" OR NOT profile_selection STREQUAL "per-channel" OR
     NOT profile_selection_class STREQUAL "project-selected" OR
     NOT profile_result_class STREQUAL "disputed" OR NOT profile_qualification STREQUAL "UNKNOWN")
    set(reason missing-link)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()
  if(NOT profile_status STREQUAL "open")
    set(reason closed-dispute)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()

  gbl_phase9_dispute_json(schema "${record}" schema)
  gbl_phase9_dispute_json(kind "${record}" kind)
  if(NOT schema STREQUAL "gamebloke.phase9-observation/1" OR NOT kind STREQUAL "dma-latch")
    set(reason missing-provenance)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()
  gbl_json_length(case_count "${record}" cases)
  if(NOT case_count EQUAL 4)
    set(reason missing-link)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()

  # Pin the complete currently emitted record set, including transfer width,
  # fallback/interposition and reset cases. No unobserved case is invented.
  set(expected_channels 0 1 0 2)
  set(expected_modes halfword-replicated word-replaced absent-source-recall reset-latch-zero)
  set(expected_values 0x34123412 0xC3D2A1B0 0x34123412 0x00000000)
  set(expected_latch_use false false true true)
  math(EXPR last_case "${case_count}-1")
  foreach(i RANGE ${last_case})
    gbl_phase9_dispute_json(channel "${record}" cases ${i} channel)
    gbl_phase9_dispute_json(mode "${record}" cases ${i} mode)
    gbl_phase9_dispute_json(value "${record}" cases ${i} value)
    gbl_phase9_dispute_json(used_latch "${record}" cases ${i} used_channel_latch)
    gbl_phase9_dispute_json(value_provenance "${record}" cases ${i} expected_value_provenance)
    gbl_phase9_dispute_json(result_class "${record}" cases ${i} result_classification)
    gbl_phase9_dispute_json(dispute_id "${record}" cases ${i} dispute_id)
    gbl_phase9_dispute_json(qualification "${record}" cases ${i} hardware_qualification)
    list(GET expected_channels ${i} expected_channel)
    list(GET expected_modes ${i} expected_mode)
    list(GET expected_values ${i} expected_value)
    list(GET expected_latch_use ${i} expected_used_latch)
    if(NOT channel STREQUAL "${expected_channel}" OR NOT mode STREQUAL "${expected_mode}" OR
       NOT value STREQUAL "${expected_value}")
      set(reason value-mismatch)
      set(${reason_out} "${reason}" PARENT_SCOPE)
      return()
    endif()
    if(NOT value_provenance STREQUAL "project-selected")
      set(reason missing-provenance)
      set(${reason_out} "${reason}" PARENT_SCOPE)
      return()
    endif()
    if(NOT dispute_id STREQUAL "disp-dma-latch")
      if(dispute_id STREQUAL "" OR dispute_id STREQUAL "<missing>")
        set(reason missing-link)
      else()
        set(reason unknown-link)
      endif()
      set(${reason_out} "${reason}" PARENT_SCOPE)
      return()
    endif()
    if(NOT result_class STREQUAL "disputed")
      set(reason settled-claim)
      set(${reason_out} "${reason}" PARENT_SCOPE)
      return()
    endif()
    if(NOT qualification STREQUAL "UNKNOWN" OR
       NOT used_latch STREQUAL "${expected_used_latch}")
      set(reason missing-provenance)
      set(${reason_out} "${reason}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  gbl_phase9_dispute_json(prefetch "${record}" prefetch)
  if(NOT prefetch STREQUAL "unmodeled")
    set(reason missing-provenance)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()

  gbl_json_length(registry_count "${registry}" entries)
  set(found_index -1)
  if(registry_count GREATER 0)
    math(EXPR last_entry "${registry_count}-1")
    foreach(i RANGE ${last_entry})
      gbl_phase9_dispute_json(id "${registry}" entries ${i} id)
      if(id STREQUAL "disp-dma-latch")
        if(found_index GREATER_EQUAL 0)
          set(reason unknown-link)
          set(${reason_out} "${reason}" PARENT_SCOPE)
          return()
        endif()
        set(found_index ${i})
      endif()
    endforeach()
  endif()
  if(found_index LESS 0)
    set(reason unknown-link)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()
  gbl_phase9_dispute_json(registry_status "${registry}" entries ${found_index} status)
  if(NOT registry_status STREQUAL "open")
    set(reason closed-dispute)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()
  gbl_json_length(source_count "${registry}" entries ${found_index} sources)
  if(NOT source_count EQUAL 3)
    set(reason missing-provenance)
    set(${reason_out} "${reason}" PARENT_SCOPE)
    return()
  endif()
  foreach(i RANGE 0 2)
    gbl_phase9_dispute_json(source_label "${registry}" entries ${found_index} sources ${i} label)
    gbl_phase9_dispute_json(source_ref "${registry}" entries ${found_index} sources ${i} ref)
    gbl_phase9_dispute_json(source_note "${registry}" entries ${found_index} sources ${i} note)
    if(source_label STREQUAL "" OR source_ref STREQUAL "" OR source_note STREQUAL "")
      set(reason missing-provenance)
      set(${reason_out} "${reason}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase9_registry_validator registry_path)
  execute_process(
    COMMAND "${CMAKE_PROGRAM}" "-DREGISTRY=${registry_path}" "-DVOCAB=${vocab_file}"
      -P "${registry_checker}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "phase9-dispute: registry-validator-failed\n${output}${error}")
  endif()
endfunction()

function(gbl_phase9_dispute_profile_check profile_path doc_path)
  execute_process(
    COMMAND "${CMAKE_PROGRAM}" "-DPROFILE=${profile_path}" "-DDOC=${doc_path}"
      "-DREGISTRY=${registry_file}" "-DVOCAB=${vocab_file}" -P "${checker_file}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "phase9-dispute: profile-document-check-failed\n${output}${error}")
  endif()
endfunction()

if(NOT CASE STREQUAL "control")
  gbl_phase9_registry_validator("${registry_file}")
  gbl_phase9_dispute_profile_check("${profile_file}" "${doc_file}")
endif()
gbl_phase9_dispute_runtime(GBL_PHASE9_LATCH_RECORD GBL_PHASE9_LATCH_OUTPUT)

if(NOT CASE STREQUAL "control")
  set(record_file "${BIN_ROOT}/nc/phase9-dispute/record.json")
  file(MAKE_DIRECTORY "${BIN_ROOT}/nc/phase9-dispute")
  file(WRITE "${record_file}" "${GBL_PHASE9_LATCH_RECORD}\n")
  gbl_phase9_dispute_check("${record_file}" "${registry_file}" "${profile_file}" dispute_reason)
  if(NOT dispute_reason STREQUAL "")
    message(FATAL_ERROR "phase9-dispute: ${dispute_reason}")
  endif()
  message(STATUS "phase9-dispute: all four dependent latch records link to the open registry entry")
endif()

if(NOT CASE STREQUAL "verify")
  set(control_root "${BIN_ROOT}/nc/phase9-dispute-controls")
  file(MAKE_DIRECTORY "${control_root}")
  file(WRITE "${control_root}/latch-observation.json" "${GBL_PHASE9_LATCH_RECORD}\n")
  foreach(name IN ITEMS missing-link unknown-link closed-dispute missing-provenance settled-claim missing-case)
    set(control_dir "${control_root}/${name}")
    file(REMOVE_RECURSE "${control_dir}")
    file(MAKE_DIRECTORY "${control_dir}")
    file(COPY_FILE "${control_root}/latch-observation.json" "${control_dir}/record.json")
    file(COPY_FILE "${registry_file}" "${control_dir}/registry.json")
    file(COPY_FILE "${profile_file}" "${control_dir}/profile.json")
    file(COPY_FILE "${doc_file}" "${control_dir}/profile.md")
    file(COPY_FILE "${control_dir}/record.json" "${control_dir}/clean-twin.json")
    gbl_phase9_dispute_check("${control_dir}/clean-twin.json" "${control_dir}/registry.json"
      "${control_dir}/profile.json" clean_reason)
    if(NOT clean_reason STREQUAL "")
      message(FATAL_ERROR "phase9-dispute: ${name}-clean-twin-${clean_reason}")
    endif()
    file(READ "${control_dir}/record.json" record_json)
    file(READ "${control_dir}/registry.json" registry_json)
    if(name STREQUAL "missing-link")
      string(JSON record_json ERROR_VARIABLE mutation_error REMOVE "${record_json}" cases 0 dispute_id)
      set(expected missing-link)
    elseif(name STREQUAL "unknown-link")
      string(JSON record_json ERROR_VARIABLE mutation_error SET "${record_json}" cases 0 dispute_id "\"disp-no-such-entry\"")
      set(expected unknown-link)
    elseif(name STREQUAL "closed-dispute")
      string(JSON entry_count LENGTH "${registry_json}" entries)
      set(dispute_index -1)
      math(EXPR last_entry "${entry_count}-1")
      foreach(i RANGE ${last_entry})
        string(JSON id GET "${registry_json}" entries ${i} id)
        if(id STREQUAL "disp-dma-latch")
          set(dispute_index ${i})
        endif()
      endforeach()
      if(dispute_index LESS 0)
        message(FATAL_ERROR "phase9-dispute: closed-dispute-control-anchor-missing")
      endif()
      string(JSON registry_json ERROR_VARIABLE mutation_error SET "${registry_json}" entries ${dispute_index} status "\"resolved\"")
      set(expected closed-dispute)
    elseif(name STREQUAL "missing-provenance")
      string(JSON record_json ERROR_VARIABLE mutation_error REMOVE "${record_json}" cases 0 expected_value_provenance)
      set(expected missing-provenance)
    elseif(name STREQUAL "settled-claim")
      string(JSON record_json ERROR_VARIABLE mutation_error SET "${record_json}" cases 0 result_classification "\"project-selected\"")
      set(expected settled-claim)
    else()
      string(JSON record_json ERROR_VARIABLE mutation_error REMOVE "${record_json}" cases 3)
      set(expected missing-link)
    endif()
    if(NOT "${mutation_error}" STREQUAL "NOTFOUND" AND NOT "${mutation_error}" STREQUAL "")
      message(FATAL_ERROR "phase9-dispute: ${name}-stale-mutation")
    endif()
    file(WRITE "${control_dir}/record.json" "${record_json}\n")
    file(WRITE "${control_dir}/registry.json" "${registry_json}\n")
    gbl_phase9_dispute_check("${control_dir}/record.json" "${control_dir}/registry.json"
      "${control_dir}/profile.json" actual_reason)
    if(NOT actual_reason STREQUAL expected)
      message(FATAL_ERROR "phase9-dispute: ${name}-wrong-reason-${actual_reason}")
    endif()
    if(name STREQUAL "closed-dispute")
      execute_process(
        COMMAND "${CMAKE_PROGRAM}" "-DREGISTRY=${control_dir}/registry.json"
          "-DVOCAB=${vocab_file}" -P "${registry_checker}"
        RESULT_VARIABLE validator_result OUTPUT_VARIABLE validator_output ERROR_VARIABLE validator_error)
      if("${validator_result}" STREQUAL "0" OR
         NOT "${validator_output}${validator_error}" MATCHES "registry: bad-status")
        message(FATAL_ERROR "phase9-dispute: closed-dispute-registry-validator-control-failed")
      endif()
    endif()
  endforeach()
  message(STATUS "phase9-dispute: six causal dispute controls and clean twins passed")
endif()
gbl_phase9_dispute_assert_authority_unchanged()
message(STATUS "phase9-dispute: canonical profile, document, registry, vocabulary, and profile/registry/contract checker inputs unchanged")
