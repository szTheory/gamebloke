# Included only after mandatory-final has verified the exact actual receipt set.
# Compact text witnesses go into the job log; no ROM/binary upload is needed.
include("${SRC}/cmake/CiJobBudgets.cmake")
gbl_ci_policy("${SRC}")
foreach(field IN ITEMS source_commit source_input_sha256 reviewed_head)
  string(JSON ${field} GET "${run}" ${field})
endforeach()
if(NOT source_commit STREQUAL GBL_CI_PRODUCER_HEAD OR
    NOT source_input_sha256 STREQUAL GBL_CI_PRODUCER_INPUT)
  message(FATAL_ERROR "diagnostic-hosted-log: source-authority-mismatch")
endif()
set(run_id 0)
if(NOT "$ENV{GBL_PROOF_RUN_ID}" STREQUAL "")
  if(NOT "$ENV{GBL_PROOF_RUN_ID}" MATCHES "^[1-9][0-9]*$" OR NOT group MATCHES "^(arm|thumb)$")
    message(FATAL_ERROR "diagnostic-hosted-log: invalid-hosted-context")
  endif()
  set(run_id "$ENV{GBL_PROOF_RUN_ID}")
endif()
file(STRINGS "${SRC}/toolchain/arm-none-eabi.lock" lock REGEX "^${HOST} ")
string(REPLACE " " ";" lock "${lock}")
list(GET lock 2 tool_sha)
string(JSON identity REMOVE "${run}" outputs)
foreach(pair IN ITEMS "format|gamebloke.admitted-host-log/1" "host|${HOST}"
    "job_name|diagnostics (${HOST}, ${group})" "toolchain_archive_sha256|${tool_sha}")
  string(REPLACE "|" ";" pair "${pair}")
  list(GET pair 0 key)
  list(GET pair 1 value)
  string(JSON identity SET "${identity}" "${key}" "\"${value}\"")
endforeach()
string(JSON identity SET "${identity}" run_id "${run_id}")
string(REGEX REPLACE "[\n\r]" " " identity "${identity}")
message(STATUS "admitted-proof: identity ${identity}")
string(JSON count LENGTH "${run}" outputs)
math(EXPR last "${count}-1")
foreach(i RANGE 0 ${last})
  string(JSON fid GET "${run}" outputs ${i})
  file(READ "${BIN}/diagnostic-execution/${fid}.json" receipt)
  foreach(field IN ITEMS rom_path result_path rom_sha256 result_sha256 status reason
      termination semantic_state semantic_case_id)
    string(JSON ${field} GET "${receipt}" ${field})
  endforeach()
  file(READ "${result_path}" result)
  foreach(field IN ITEMS cycles instructions budget_cycles)
    string(JSON ${field} GET "${result}" time ${field})
  endforeach()
  file(SIZE "${rom_path}" bytes)
  set(producer smoke)
  if(fid MATCHES "^(arm|thumb)-")
    set(producer "${CMAKE_MATCH_1}")
  endif()
  message(STATUS "admitted-proof: result {\"name\":\"${producer}/${fid}.gba\",\"fixture_id\":\"${fid}\",\"case_id\":${semantic_case_id},\"sha256\":\"${rom_sha256}\",\"result_sha256\":\"${result_sha256}\",\"bytes\":${bytes},\"status\":\"${status}\",\"reason\":\"${reason}\",\"termination\":\"${termination}\",\"state\":\"${semantic_state}\",\"ran\":true,\"cycles\":${cycles},\"instructions\":${instructions},\"budget_cycles\":${budget_cycles}}")
endforeach()
gbl_diagnostic_matrix("${SRC}" "${group}")
foreach(api IN LISTS GBL_DIAG_APIS)
  file(READ "${BIN}/diagnostic-execution/api-${api}.json" api_receipt)
  string(REGEX REPLACE "[\n\r]" " " api_receipt "${api_receipt}")
  message(STATUS "admitted-proof: api ${api_receipt}")
endforeach()
list(LENGTH GBL_DIAG_APIS api_count)
message(STATUS "admitted-proof: complete {\"outputs\":${count},\"apis\":${api_count},\"stage\":\"admitted\"}")
