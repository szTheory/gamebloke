cmake_minimum_required(VERSION 3.25)

foreach(required IN ITEMS SRC BIN)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "audio-guest: missing required argument ${required}")
  endif()
endforeach()
get_filename_component(SRC "${SRC}" ABSOLUTE)
get_filename_component(BIN "${BIN}" ABSOLUTE)

set(audio_image "${BIN}/generated/fixtures/owned-audio-mix.gba")
message("1..1")
if(EXISTS "${audio_image}" AND NOT IS_DIRECTORY "${audio_image}")
  message("ok 1 - local audio diagnostic image exists")
else()
  message("not ok 1 - local audio diagnostic image exists")
  if(CMAKE_VERSION VERSION_GREATER_EQUAL "3.29")
    cmake_language(EXIT 1)
  endif()
  message(FATAL_ERROR "audio-guest: diagnostic image has not been generated")
endif()
