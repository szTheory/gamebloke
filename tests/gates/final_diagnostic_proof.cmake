  foreach(pair IN ITEMS
      "2026-11-13T00:03:01Z|required-job-over-budget"
      "2026-11-12T23:59:59Z|required-job-over-budget"
      "2026-02-30T00:00:00Z|job-time-invalid"
      "2026-13-13T00:00:00Z|job-time-invalid"
      "invalid|job-time-invalid"
      "|job-time-invalid")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 end)
