    execute_process(COMMAND /usr/bin/time -p "${CMAKE_COMMAND}" "-DSRC=${source_root}"
      "-DOUT=${root}" "-DTOOLCHAIN_ROOT=${TOOLCHAIN_ROOT}" "-DMODE=${mode}"
