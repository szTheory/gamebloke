  foreach(required IN ITEMS HOSTED_RECEIPT LIVE_RUN LIVE_JOBS LOCAL_RECEIPT)
    if(NOT DEFINED ${required} OR NOT EXISTS "${${required}}" OR IS_SYMLINK "${${required}}")
      message(FATAL_ERROR "final-proof: missing-${required}")
    endif()
  endforeach()
  file(READ "${LIVE_RUN}" run)
  string(JSON run_head GET "${run}" head_sha)
  string(JSON run_id GET "${run}" id)
  string(JSON run_status GET "${run}" status)
  string(JSON run_conclusion GET "${run}" conclusion)
  if(NOT run_head STREQUAL source_head OR NOT run_status STREQUAL "completed" OR
     NOT run_conclusion STREQUAL "success")
    message(FATAL_ERROR "final-proof: live-run-not-current-green")
  endif()
  file(READ "${LIVE_JOBS}" jobs_doc)
  string(JSON jobs GET "${jobs_doc}" jobs)
  string(JSON job_count LENGTH "${jobs}")
  set(required_jobs changes hygiene title asan "CI required"
    "build (ubuntu-26.04, gcc, GNU)" "build (macos-26, cc, AppleClang)"
    "diagnostics (ubuntu-26.04, linux-x64, gcc, GNU)"
    "diagnostics (macos-26, darwin-arm64, cc, AppleClang)")
  set(seen_jobs "")
  math(EXPR last "${job_count}-1")
  foreach(index RANGE 0 ${last})
    string(JSON job GET "${jobs}" ${index})
    foreach(field IN ITEMS id name run_id head_sha status conclusion started_at completed_at)
      string(JSON job_${field} GET "${job}" "${field}")
    endforeach()
    if(NOT job_run_id STREQUAL run_id OR NOT job_head_sha STREQUAL source_head OR
       NOT job_status STREQUAL "completed" OR NOT job_conclusion STREQUAL "success")
      message(FATAL_ERROR "final-proof: required-job-not-current-green:${job_name}")
    endif()
    proof_epoch("${job_started_at}" start)
    proof_epoch("${job_completed_at}" finish)
    math(EXPR elapsed "${finish}-${start}")
    if(elapsed LESS 0 OR elapsed GREATER 180)
      message(FATAL_ERROR "final-proof: required-job-over-budget:${job_name}:${elapsed}")
    endif()
    list(APPEND seen_jobs "${job_name}")
    if(job_name MATCHES "^diagnostics [(]ubuntu")
      set(job_linux-x64 "${job_id}")
    elseif(job_name MATCHES "^diagnostics [(]macos")
      set(job_darwin-arm64 "${job_id}")
    endif()
  endforeach()
  proof_assert_set("${seen_jobs}" "${required_jobs}" "required-job-set-mismatch")
  proof_expected()
  # Refuse incomplete hosted sets before revalidating complete local sets.
  # Every successful path still validates the same complete authority.
  file(READ "${HOSTED_RECEIPT}" hosted)
  string(JSON hosted_run GET "${hosted}" run_id)
  string(JSON hosts GET "${hosted}" hosts)
  string(JSON host_count LENGTH "${hosts}")
  if(NOT hosted_run STREQUAL run_id OR NOT host_count EQUAL 2)
    message(FATAL_ERROR "final-proof: hosted-run-identity-mismatch")
  endif()
  set(seen_hosts "")
  foreach(index RANGE 0 1)
    string(JSON row GET "${hosts}" ${index})
    string(JSON host GET "${row}" host)
    string(JSON job GET "${row}" job_id)
    string(JSON receipt GET "${row}" proof)
    if(NOT host MATCHES "^(linux-x64|darwin-arm64)$" OR
       NOT job STREQUAL "${job_${host}}")
      message(FATAL_ERROR "final-proof: hosted-job-binding-invalid")
    endif()
    proof_host_receipt("${receipt}" "${host}")
    set("hosted_proof_${host}" "${receipt}")
    list(APPEND seen_hosts "${host}")
    foreach(name IN LISTS expected_names)
      string(MAKE_C_IDENTIFIER "${name}" key)
      set("hosted_${host}_sha_${key}" "${proof_sha_${key}}")
      set("hosted_${host}_bytes_${key}" "${proof_bytes_${key}}")
    endforeach()
  endforeach()
  proof_assert_set("${seen_hosts}" "linux-x64;darwin-arm64" "hosted-host-set-mismatch")
  file(READ "${LOCAL_RECEIPT}" local)
  string(JSON local_head GET "${local}" source_head)
  string(JSON local_linux GET "${local}" linux_arm64)
  string(JSON local_macos GET "${local}" macos)
  string(JSON local_format GET "${local}" format)
  string(JSON compared GET "${local}" literal_cmp_count)
  list(LENGTH expected_names expected_count)
  if(NOT local_head STREQUAL source_head)
    message(FATAL_ERROR "final-proof: stale-local-source")
  endif()
  if(NOT local_format STREQUAL "gamebloke.final-local-proof/1" OR NOT compared EQUAL expected_count)
    message(FATAL_ERROR "final-proof: local-comparison-incomplete")
  endif()
  # Reuse only exact JSON-equivalent authority in this invocation, never a
  # pathname or a persistent receipt cache. A changed local receipt is checked.
  string(JSON same_macos EQUAL "${local_macos}" "${hosted_proof_darwin-arm64}")
  if(NOT same_macos)
    proof_host_receipt("${local_macos}" darwin-arm64)
    foreach(name IN LISTS expected_names)
      string(MAKE_C_IDENTIFIER "${name}" key)
      if(NOT "${proof_sha_${key}}" STREQUAL "${hosted_darwin-arm64_sha_${key}}" OR
         NOT "${proof_bytes_${key}}" STREQUAL "${hosted_darwin-arm64_bytes_${key}}")
        message(FATAL_ERROR "final-proof: local-macos-hash-mismatch:${name}")
      endif()
    endforeach()
  endif()
  proof_host_receipt("${local_linux}" linux-arm64)
  foreach(host IN ITEMS linux-x64 darwin-arm64)
    foreach(name IN LISTS expected_names)
      string(MAKE_C_IDENTIFIER "${name}" key)
      if(NOT "${proof_sha_${key}}" STREQUAL "${hosted_${host}_sha_${key}}" OR
         NOT "${proof_bytes_${key}}" STREQUAL "${hosted_${host}_bytes_${key}}")
        message(FATAL_ERROR "final-proof: hosted-hash-mismatch:${host}:${name}")
      endif()
    endforeach()
  endforeach()
  message(STATUS "final-proof: current complete hosted hashes and every green required job verified within 180s; hash witness is distinct from local literal cmp")
  return()
endif()
if(CASE STREQUAL "final-scan-witness-check")
  foreach(required IN ITEMS WITNESS GROUP_COUNT GROUP)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
      message(FATAL_ERROR "final-proof: scan-witness-control-missing-${required}")
    endif()
  endforeach()
  proof_assert_parent_signature_witness("${WITNESS}" "${GROUP_COUNT}" "${GROUP}")
  message(STATUS "final-proof: parent scan witness accepted for ${GROUP}")
  return()
endif()

if(CASE STREQUAL "final-scan-witness-controls")
  proof_inputs(input_digest)
  set(group arm)
  set(root "${source_root}/build/phase05-matrix/${group}")
  file(READ "${root}/proof/build-receipt.json" receipt)
  string(JSON revision GET "${receipt}" source_commit)
  string(JSON scan GET "${receipt}" signature_scan)
  if(NOT revision STREQUAL source_head OR NOT scan STREQUAL "passed")
    message(FATAL_ERROR "final-proof: scan-witness-control-stale-receipt:${group}")
  endif()
  proof_array("${receipt}" output_names group_names)
  list(LENGTH group_names group_count)
  file(READ "${root}/proof/matrix-parent.json" parent)
  string(JSON parent_digest GET "${parent}" source_input_sha256)
  if(NOT parent_digest STREQUAL input_digest)
    message(FATAL_ERROR "final-proof: scan-witness-control-input-binding:${group}")
  endif()

  set(witness "${root}/proof/signature-scan.txt")
  set(expected_signature "signature: ok (${group_count} files)\n")
  proof_assert_parent_signature_witness("${witness}" "${group_count}" "${group}")
  file(READ "${witness}" original)
  set(control_root "${bin_root}/witness-controls")
  if(EXISTS "${control_root}")
    message(FATAL_ERROR "final-proof: preserve-existing-scan-witness-controls")
  endif()
  file(MAKE_DIRECTORY "${control_root}")
  file(WRITE "${control_root}/clean.log"
    "clean-first actual ${group} parent witness accepted; source=${source_head}; files=${group_count}\n")
  message(STATUS "final-proof: scan-witness control clean real parent witness accepted")

  function(run_scan_witness_refusal label mutation contents expected_reason)
    set(target "${control_root}/symlink-target.txt")
    if(mutation STREQUAL "write")
      file(WRITE "${witness}" "${contents}")
    elseif(mutation STREQUAL "symlink")
      file(WRITE "${target}" "${original}")
      file(REMOVE "${witness}")
      file(CREATE_LINK "${target}" "${witness}" SYMBOLIC RESULT link_rc)
      if(NOT link_rc STREQUAL "0")
        file(WRITE "${witness}" "${original}")
        message(FATAL_ERROR "final-proof: scan-witness-control-symlink-setup-failed:${link_rc}")
      endif()
    elseif(mutation STREQUAL "missing")
      file(REMOVE "${witness}")
    else()
      message(FATAL_ERROR "final-proof: scan-witness-control-unknown-mutation:${label}")
    endif()

    execute_process(COMMAND "${CMAKE_COMMAND}" -DCASE=final-scan-witness-check
        "-DSRC=${source_root}" "-DBIN=${control_root}/checks/${label}"
        "-DWITNESS=${witness}" "-DGROUP=${group}"
        "-DGROUP_COUNT=${group_count}" -P "${final_proof_script}"
      RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)

    file(REMOVE "${witness}")
    file(WRITE "${witness}" "${original}")
    file(READ "${witness}" restored)
    if(IS_SYMLINK "${witness}" OR NOT restored STREQUAL original)
      message(FATAL_ERROR "final-proof: scan-witness-control-restore-failed:${label}")
    endif()

    set(report "${output}${error}")
    file(APPEND "${control_root}/${label}.log"
      "mutation=${label}; expected=${expected_reason}; exit=${rc}\n${report}\n")
    if(rc STREQUAL "0" OR NOT report MATCHES "${expected_reason}")
      message(FATAL_ERROR "final-proof: scan-witness-control-missed:${label}:${report}")
    endif()
    message(STATUS "final-proof: scan-witness control ${label} refused with ${expected_reason}; witness restored")
  endfunction()

  set(prefix "unexpected prefix\n${expected_signature}")
  run_scan_witness_refusal(prefix write "${prefix}"
    "parent-signature-proof-invalid:${group}")
  set(suffix "${expected_signature}unexpected suffix\n")
  run_scan_witness_refusal(suffix write "${suffix}"
    "parent-signature-proof-invalid:${group}")
  string(REPLACE "signature: ok" "signature: altered" substituted
    "${expected_signature}")
  run_scan_witness_refusal(substituted write "${substituted}"
    "parent-signature-proof-invalid:${group}")
  math(EXPR wrong_count "${group_count}+1")
  set(wrong_count_text "signature: ok (${wrong_count} files)\n")
  run_scan_witness_refusal(wrong-count write "${wrong_count_text}"
    "parent-signature-proof-invalid:${group}")
  string(LENGTH "${expected_signature}" expected_length)
  math(EXPR without_newline_length "${expected_length}-1")
  string(SUBSTRING "${expected_signature}" 0 "${without_newline_length}"
    missing_newline)
  run_scan_witness_refusal(missing-newline write "${missing_newline}"
    "parent-signature-proof-invalid:${group}")
  run_scan_witness_refusal(symlink symlink ""
    "parent-signature-proof-not-regular:${group}")
  run_scan_witness_refusal(missing-witness missing ""
    "parent-signature-proof-missing:${group}")
  file(REMOVE "${control_root}/symlink-target.txt")
  message(STATUS "final-proof: seven actual scan-witness refusal controls passed; no hosted evidence claimed")
  return()
endif()

if(CASE STREQUAL "final-proof-controls")
  # These are expressly synthetic parser/control inputs, never hosted receipts.
  # Real evidence is supplied separately by the parent from GitHub job logs/API.
  proof_expected()
  proof_inputs(input_digest)
  string(REPEAT "0" 64 synthetic_sha)
  set(output_rows "")
  set(names_json "")
  foreach(name IN LISTS expected_names)
    if(name MATCHES "^smoke/")
      set(id 20481)
    else()
      string(REGEX MATCH "[0-9]+" id "${name}")
    endif()
    if(NOT output_rows STREQUAL "")
      string(APPEND output_rows ",")
      string(APPEND names_json ",")
    endif()
    string(APPEND output_rows "{\"name\":\"${name}\",\"case_id\":${id},\"sha256\":\"${synthetic_sha}\",\"bytes\":192}")
    string(APPEND names_json "\"${name}\"")
  endforeach()
  string(JOIN "," ids ${expected_ids})
  set(base "{\"synthetic_control\":true,\"format\":\"gamebloke.final-diagnostic-host/1\",\"stage\":\"pre-admission\",\"host\":\"linux-arm64\",\"source_head\":\"${source_head}\",\"source_input_sha256\":\"${input_digest}\",\"toolchain_archive_sha256\":\"67980c7990eba7bb7ffdf39699102effd70889f5ac427be19a8c8a6c5fab2972\",\"case_ids\":[${ids}],\"output_names\":[${names_json}],\"outputs\":[${output_rows}]}")
  set(linux "${base}")
  string(JSON mac SET "${base}" host "\"darwin-arm64\"")
  string(JSON mac SET "${mac}" toolchain_archive_sha256 "\"574082d35e49a2bcbdc355836b2a3ae5e5bb3b9456c9f5e37177db2ab4aad870\"")
  string(JSON x64 SET "${base}" host "\"linux-x64\"")
  string(JSON x64 SET "${x64}" toolchain_archive_sha256 "\"da6a49ad4003944b823c6c93702a8787c922ab34bd7e918ec0eaf6933a9b1ff6\"")
  list(LENGTH expected_names count)
  set(local "{\"synthetic_control\":true,\"format\":\"gamebloke.final-local-proof/1\",\"source_head\":\"${source_head}\",\"literal_cmp_count\":${count},\"macos\":${mac},\"linux_arm64\":${linux}}")
  set(hosted "{\"synthetic_control\":true,\"run_id\":1,\"hosts\":[{\"host\":\"linux-x64\",\"job_id\":8,\"proof\":${x64}},{\"host\":\"darwin-arm64\",\"job_id\":9,\"proof\":${mac}}]}")
  set(run "{\"synthetic_control\":true,\"head_sha\":\"${source_head}\",\"id\":1,\"status\":\"completed\",\"conclusion\":\"success\"}")
  set(names changes hygiene title asan "CI required"
    "build (ubuntu-26.04, gcc, GNU)" "build (macos-26, cc, AppleClang)"
    "diagnostics (ubuntu-26.04, linux-x64, gcc, GNU)"
    "diagnostics (macos-26, darwin-arm64, cc, AppleClang)")
  set(job_rows "")
  set(id 0)
  foreach(name IN LISTS names)
    math(EXPR id "${id}+1")
    if(NOT job_rows STREQUAL "")
      string(APPEND job_rows ",")
    endif()
    string(APPEND job_rows "{\"id\":${id},\"name\":\"${name}\",\"run_id\":1,\"head_sha\":\"${source_head}\",\"status\":\"completed\",\"conclusion\":\"success\",\"started_at\":\"2026-11-13T00:00:00Z\",\"completed_at\":\"2026-11-13T00:00:01Z\"}")
  endforeach()
  set(jobs "{\"synthetic_control\":true,\"jobs\":[${job_rows}]}")
  function(control label receipt job_doc run_doc expected)
    set(root "${bin_root}/synthetic-controls/${label}")
    file(MAKE_DIRECTORY "${root}")
    file(WRITE "${root}/hosted.json" "${receipt}\n")
    file(WRITE "${root}/jobs.json" "${job_doc}\n")
    file(WRITE "${root}/run.json" "${run_doc}\n")
    set(control_local "${local}")
    if(ARGC GREATER 5)
      set(control_local "${ARGV5}")
    endif()
    file(WRITE "${root}/local.json" "${control_local}\n")
    execute_process(COMMAND /usr/bin/time -p "${CMAKE_COMMAND}" -DCASE=final-hosted-proof
      "-DSRC=${source_root}" "-DBIN=${root}" "-DHOSTED_RECEIPT=${root}/hosted.json"
      "-DLIVE_RUN=${root}/run.json" "-DLIVE_JOBS=${root}/jobs.json"
      "-DLOCAL_RECEIPT=${root}/local.json" -P "${source_root}/tests/gates/toolchain_spike.cmake"
      RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${root}/validation.log" "${output}${error}")
    if(expected STREQUAL "pass")
      if(NOT rc STREQUAL "0")
        message(FATAL_ERROR "final-proof: synthetic-clean-control-failed:${output}${error}")
      endif()
    elseif(rc STREQUAL "0" OR NOT "${output}${error}" MATCHES "${expected}")
      message(FATAL_ERROR "final-proof: synthetic-control-missed:${label}:${output}${error}")
    endif()
    message(STATUS "final-proof: synthetic parser control ${label} observed; no hosted evidence claimed")
  endfunction()
  control(clean "${hosted}" "${jobs}" "${run}" pass)
  string(REPEAT "0" 40 stale)
  string(JSON changed SET "${run}" head_sha "\"${stale}\"")
  control(stale-head "${hosted}" "${jobs}" "${changed}" "live-run-not-current-green")
  string(JSON changed REMOVE "${hosted}" hosts 0 proof case_ids 0)
  control(missing-case "${changed}" "${jobs}" "${run}" "host-case-id-set-mismatch")
  string(JSON changed REMOVE "${hosted}" hosts 0 proof outputs 0)
  control(missing-output "${changed}" "${jobs}" "${run}" "host-output-count-mismatch")
  string(JSON changed SET "${jobs}" jobs 0 completed_at "\"2026-11-13T00:03:01Z\"")
  control(over-budget "${hosted}" "${changed}" "${run}" "required-job-over-budget")
  string(JSON changed REMOVE "${jobs}" jobs 4)
  control(missing-required-job "${hosted}" "${changed}" "${run}" "required-job-set-mismatch")
  string(JSON changed SET "${jobs}" jobs 4 conclusion "\"failure\"")
  control(red-required-job "${hosted}" "${changed}" "${run}" "required-job-not-current-green")
  string(REPEAT "1" 64 wrong_sha)
  string(JSON changed SET "${hosted}" hosts 0 proof outputs 0 sha256 "\"${wrong_sha}\"")
  control(wrong-hash "${changed}" "${jobs}" "${run}" "hosted-hash-mismatch")
  string(JSON changed_local SET "${local}" macos source_head "\"${stale}\"")
  control(changed-local-authority "${hosted}" "${jobs}" "${run}"
    "host-source-identity-mismatch" "${changed_local}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -DCASE=final-proof-authority-control
    "-DSRC=${source_root}" "-DBIN=${bin_root}/authority-change"
    -P "${source_root}/tests/gates/toolchain_spike.cmake"
    RESULT_VARIABLE authority_rc OUTPUT_VARIABLE authority_out ERROR_VARIABLE authority_err)
  if(authority_rc STREQUAL "0" OR NOT "${authority_out}${authority_err}" MATCHES "source-authority-changed")
    message(FATAL_ERROR "final-proof: source-authority-control-missed:${authority_out}${authority_err}")
  endif()
  file(WRITE "${bin_root}/authority-change.log" "${authority_out}${authority_err}")
  message(STATUS "final-proof: synthetic receipt controls passed (clean plus nine refusals)")
  return()
endif()
