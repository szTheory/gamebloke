  string(JSON changed SET "${hosted}" hosts 0 proof outputs 0 sha256 "\"${wrong_sha}\"")
  control(wrong-hash "${changed}" "${jobs}" "${run}" "hosted-hash-mismatch")
  string(JSON changed SET "${hosted}" hosts 0 group "\"wrong\"")
  control(wrong-group "${changed}" "${jobs}" "${run}" "hosted-job-binding-invalid")
  string(JSON changed REMOVE "${hosted}" hosts 0 group)
  control(missing-group "${changed}" "${jobs}" "${run}" "hosted-job-binding-invalid")
  string(JSON changed SET "${hosted}" hosts 0 proof group "\"thumb\"")
  control(swapped-group "${changed}" "${jobs}" "${run}" "host-group-identity-mismatch")
  string(JSON part GET "${hosted}" hosts 0)
  string(JSON changed SET "${hosted}" hosts 1 "${part}")
  control(duplicate-group "${changed}" "${jobs}" "${run}" "hosted-job-binding-invalid")
  string(JSON changed SET "${hosted}" hosts 1 job_id 8)
  control(duplicate-job-binding "${changed}" "${jobs}" "${run}" "hosted-job-binding-invalid")
  string(JSON changed SET "${hosted}" hosts 0 job_id 9)
  control(swapped-job-binding "${changed}" "${jobs}" "${run}" "hosted-job-binding-invalid")
  string(JSON overlap SET "${x64_arm}" group "\"thumb\"")
  string(JSON overlap SET "${overlap}" job_name "\"diagnostics (linux-x64, thumb)\"")
  string(JSON changed SET "${hosted}" hosts 1 proof "${overlap}")
  control(overlapping-groups "${changed}" "${jobs}" "${run}" "host-output-name-set-mismatch")
  string(JSON changed REMOVE "${hosted}" hosts 1)
  control(incomplete-union "${changed}" "${jobs}" "${run}" "hosted-run-identity-mismatch")
  set(old "{\"run_id\":1,\"hosts\":[{\"host\":\"linux-x64\",\"job_id\":8,\"proof\":${x64}},{\"host\":\"darwin-arm64\",\"job_id\":9,\"proof\":${mac}}]}")
  control(old-two-job-layout "${old}" "${jobs}" "${run}" "hosted-run-identity-mismatch")
  string(JSON changed REMOVE "${hosted}" hosts 0 proof output_names 0)
  control(missing-subset-output "${changed}" "${jobs}" "${run}" "host-output-name-set-mismatch")
  string(JSON changed SET "${jobs}" jobs 8 id 8)
  control(duplicate-live-job "${hosted}" "${changed}" "${run}" "required-job-not-current-green")
  string(JSON changed SET "${hosted}" hosts 0 proof run_id 2)
  control(wrong-proof-run "${changed}" "${jobs}" "${run}" "hosted-proof-job-context-invalid")
  string(JSON changed REMOVE "${hosted}" hosts 0 proof run_id)
  control(missing-proof-run "${changed}" "${jobs}" "${run}" "hosted-proof-job-context-invalid")
  string(JSON changed SET "${hosted}" hosts 0 proof job_name "\"diagnostics (linux-x64, thumb)\"")
  control(wrong-proof-job-name "${changed}" "${jobs}" "${run}" "hosted-proof-job-context-invalid")
  string(JSON changed_local SET "${local}" macos source_head "\"${stale}\"")
  control(changed-local-authority "${hosted}" "${jobs}" "${run}"
    "host-source-identity-mismatch" "${changed_local}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -DCASE=final-proof-authority-control
    "-DSRC=${source_root}" "-DBIN=${bin_root}/authority-change"
    -P "${source_root}/tests/gates/toolchain_spike.cmake"
    RESULT_VARIABLE authority_rc OUTPUT_VARIABLE authority_out ERROR_VARIABLE authority_err)
  if(authority_rc STREQUAL "0" OR NOT "${authority_out}${authority_err}" MATCHES "source-authority-changed")
    message(FATAL_ERROR "final-proof: source-authority-control-missed:${authority_out}${authority_err}")
  endif()
  file(WRITE "${bin_root}/authority-change.log" "${authority_out}${authority_err}")
  message(STATUS "final-proof: synthetic receipt controls passed (clean, nine original refusals and fourteen group/binding refusals)")
  return()
endif()
message(FATAL_ERROR "final-proof: unsupported-case:${CASE}")
