cmake_minimum_required(VERSION 3.25)
set(final_proof_script "${CMAKE_CURRENT_LIST_FILE}")

# Included only by toolchain_spike.cmake's final-* selectors. These receipts
# describe pre-admission build bytes, never production fixture PASS results.
file(REAL_PATH "${SRC}" source_root)
get_filename_component(bin_root "${BIN}" ABSOLUTE BASE_DIR "${source_root}")
set(build_root "${source_root}/build")
cmake_path(IS_PREFIX build_root "${bin_root}" NORMALIZE safe_bin)
if(NOT safe_bin OR bin_root STREQUAL build_root OR
   IS_SYMLINK "${build_root}" OR IS_SYMLINK "${bin_root}")
  message(FATAL_ERROR "final-proof: unsafe-output-root")
endif()
file(MAKE_DIRECTORY "${bin_root}")
execute_process(COMMAND git -C "${source_root}" rev-parse HEAD
  RESULT_VARIABLE head_rc OUTPUT_VARIABLE source_head
  OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT head_rc STREQUAL "0")
  message(FATAL_ERROR "final-proof: source-head-unavailable")
endif()

function(proof_expected)
  # One command examines one immutable source authority. Reuse its derived
  # selection across host receipts; do not parse the whole matrix per host.
  file(SHA256 "${source_root}/diagnostics/armv4t/cases.json" matrix_sha)
  execute_process(COMMAND git -C "${source_root}" rev-parse HEAD
    RESULT_VARIABLE current_rc OUTPUT_VARIABLE current_head
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT current_rc STREQUAL "0" OR NOT current_head STREQUAL source_head)
    message(FATAL_ERROR "final-proof: source-authority-changed")
  endif()
  get_property(names GLOBAL PROPERTY GBL_FINAL_PROOF_NAMES)
  if(names)
    get_property(bound_sha GLOBAL PROPERTY GBL_FINAL_PROOF_MATRIX_SHA)
    if(NOT matrix_sha STREQUAL bound_sha)
      message(FATAL_ERROR "final-proof: source-authority-changed")
    endif()
    get_property(ids GLOBAL PROPERTY GBL_FINAL_PROOF_IDS)
    set(expected_names "${names}" PARENT_SCOPE)
    set(expected_ids "${ids}" PARENT_SCOPE)
    return()
  endif()
  file(READ "${source_root}/diagnostics/armv4t/cases.json" matrix)
  string(JSON rows LENGTH "${matrix}" cases)
  math(EXPR last "${rows}-1")
  set(names smoke/smoke-broken.gba smoke/smoke.gba)
  set(ids 20481)
  foreach(index RANGE 0 ${last})
    string(JSON row GET "${matrix}" cases ${index})
    string(JSON kind ERROR_VARIABLE error GET "${row}" source_test kind)
    if(NOT error STREQUAL "NOTFOUND" OR NOT kind MATCHES "^(semantic|guest-stop)$")
      continue()
    endif()
    string(JSON id GET "${row}" id)
    string(JSON isa GET "${row}" isa)
    list(APPEND ids "${id}")
    if(kind STREQUAL "semantic")
      list(APPEND names "${isa}/${isa}-${id}.gba" "${isa}/${isa}-${id}-broken.gba")
    else()
      list(APPEND names "${isa}/${isa}-stop-${id}.gba")
    endif()
  endforeach()
  list(SORT names)
  list(SORT ids COMPARE NATURAL)
  set_property(GLOBAL PROPERTY GBL_FINAL_PROOF_NAMES "${names}")
  set_property(GLOBAL PROPERTY GBL_FINAL_PROOF_IDS "${ids}")
  set_property(GLOBAL PROPERTY GBL_FINAL_PROOF_MATRIX_SHA "${matrix_sha}")
  set(expected_names "${names}" PARENT_SCOPE)
  set(expected_ids "${ids}" PARENT_SCOPE)
endfunction()

function(proof_inputs out)
  file(STRINGS "${source_root}/diagnostics/armv4t/inputs.txt" inputs)
  set(material "")
  foreach(input IN LISTS inputs)
    if(input MATCHES "^#" OR input STREQUAL "")
      continue()
    endif()
    if(IS_SYMLINK "${source_root}/${input}" OR IS_DIRECTORY "${source_root}/${input}")
      message(FATAL_ERROR "final-proof: producer-input-not-regular:${input}")
    endif()
    execute_process(COMMAND git -C "${source_root}" diff --quiet
      "${source_head}" -- "${input}" RESULT_VARIABLE rc)
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "final-proof: dirty-producer-input:${input}")
    endif()
    file(SHA256 "${source_root}/${input}" sha)
    string(APPEND material "${input}=${sha}\n")
  endforeach()
  string(SHA256 digest "${material}")
  set(${out} "${digest}" PARENT_SCOPE)
endfunction()

if(CASE STREQUAL "final-proof-authority-control")
  set(control_source "${bin_root}/source")
  file(MAKE_DIRECTORY "${control_source}/diagnostics/armv4t")
  file(COPY_FILE "${source_root}/diagnostics/armv4t/cases.json"
    "${control_source}/diagnostics/armv4t/cases.json")
  set(source_root "${control_source}")
  proof_expected()
  file(APPEND "${source_root}/diagnostics/armv4t/cases.json" "\n")
  proof_expected() # Must refuse changed bytes rather than reuse a clean set.
  message(FATAL_ERROR "final-proof: changed-authority-was-reused")
endif()

function(proof_array json field out)
  string(JSON count LENGTH "${json}" "${field}")
  set(values "")
  if(count GREATER 0)
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
      string(JSON value GET "${json}" "${field}" ${index})
      list(APPEND values "${value}")
    endforeach()
  endif()
  set(${out} "${values}" PARENT_SCOPE)
endfunction()

function(proof_assert_set actual expected reason)
  set(sorted "${actual}")
  list(SORT sorted)
  set(sorted_expected "${expected}")
  list(SORT sorted_expected)
  if(NOT sorted STREQUAL sorted_expected)
    message(FATAL_ERROR "final-proof: ${reason}")
  endif()
endfunction()

function(proof_assert_parent_signature_witness witness_path group_count group)
  if(IS_SYMLINK "${witness_path}")
    message(FATAL_ERROR "final-proof: parent-signature-proof-not-regular:${group}")
  endif()
  if(NOT EXISTS "${witness_path}")
    message(FATAL_ERROR "final-proof: parent-signature-proof-missing:${group}")
  endif()
  if(IS_DIRECTORY "${witness_path}")
    message(FATAL_ERROR "final-proof: parent-signature-proof-not-regular:${group}")
  endif()
  execute_process(COMMAND sh -c [=[test -f "$1" && test ! -L "$1"]=] sh
      "${witness_path}"
    RESULT_VARIABLE regular_rc OUTPUT_QUIET ERROR_QUIET)
  if(NOT regular_rc STREQUAL "0")
    message(FATAL_ERROR "final-proof: parent-signature-proof-not-regular:${group}")
  endif()

  file(READ "${witness_path}" signature_proof)
  set(expected_signature "signature: ok (${group_count} files)\n")
  if(NOT signature_proof STREQUAL expected_signature)
    message(FATAL_ERROR "final-proof: parent-signature-proof-invalid:${group}")
  endif()
endfunction()

function(proof_collect)
  proof_expected()
  proof_inputs(input_digest)
  execute_process(COMMAND uname -s OUTPUT_VARIABLE system OUTPUT_STRIP_TRAILING_WHITESPACE)
  execute_process(COMMAND uname -m OUTPUT_VARIABLE machine OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(system STREQUAL "Darwin" AND machine MATCHES "^(arm64|aarch64)$")
    set(host darwin-arm64)
  elseif(system STREQUAL "Linux" AND machine MATCHES "^(arm64|aarch64)$")
    set(host linux-arm64)
  elseif(system STREQUAL "Linux" AND machine MATCHES "^(x86_64|amd64)$")
    set(host linux-x64)
  else()
    message(FATAL_ERROR "final-proof: unsupported-host")
  endif()
  get_filename_component(tool_root "${TOOLCHAIN_ROOT}" ABSOLUTE BASE_DIR "${source_root}")
  execute_process(COMMAND sh "${source_root}/scripts/fetch-toolchain.sh" --check
    --host "${host}" --root "${tool_root}"
    RESULT_VARIABLE tool_rc OUTPUT_VARIABLE tool_out ERROR_VARIABLE tool_err)
  if(NOT tool_rc STREQUAL "0")
    message(FATAL_ERROR "final-proof: tool-verification-failed:${tool_out}${tool_err}")
  endif()
  file(READ "${tool_root}/arm-none-eabi/${host}-15.2.1-1.1/install.json" tool)
  string(JSON tool_sha GET "${tool}" archive_sha256)
  message(STATUS "final-proof: tool host=${host} source=${source_head} archive_sha256=${tool_sha}")
  set(actual_names "")
  set(output_rows "")
  set(names_json "")
  foreach(group IN ITEMS smoke arm thumb)
    if(group STREQUAL "smoke")
      set(root "${source_root}/build/phase05-spike/final-smoke")
    else()
      set(root "${source_root}/build/phase05-matrix/${group}")
    endif()
    file(READ "${root}/proof/build-receipt.json" receipt)
    string(JSON revision GET "${receipt}" source_commit)
    string(JSON receipt_host GET "${receipt}" host)
    string(JSON scan GET "${receipt}" signature_scan)
    if(NOT revision STREQUAL source_head OR NOT receipt_host STREQUAL host OR
       NOT scan STREQUAL "passed")
      message(FATAL_ERROR "final-proof: stale-build-authority:${group}")
    endif()
    proof_array("${receipt}" output_names group_names)
    list(LENGTH group_names group_count)
    proof_assert_parent_signature_witness(
      "${root}/proof/signature-scan.txt" "${group_count}" "${group}")
    file(GLOB actual RELATIVE "${root}/roms" LIST_DIRECTORIES TRUE "${root}/roms/*")
    proof_assert_set("${actual}" "${group_names}" "output-directory-set:${group}")
    file(READ "${root}/proof/matrix-parent.json" parent)
    string(JSON parent_digest GET "${parent}" source_input_sha256)
    if(NOT parent_digest STREQUAL input_digest)
      message(FATAL_ERROR "final-proof: input-digest-mismatch:${group}")
    endif()
    foreach(name IN LISTS group_names)
      if(IS_SYMLINK "${root}/roms/${name}" OR IS_DIRECTORY "${root}/roms/${name}")
        message(FATAL_ERROR "final-proof: output-not-regular:${name}")
      endif()
      if(group STREQUAL "smoke")
        set(id 20481)
        string(REGEX REPLACE "[.]gba$" "" variant "${name}")
        set(proof "${root}/proof/${variant}")
      else()
        string(REGEX MATCH "[0-9]+" id "${name}")
        string(REGEX REPLACE "[.]gba$" "" variant "${name}")
        set(proof "${root}/cases/${id}/proof/${variant}")
        file(READ "${root}/cases/${id}/proof/build-receipt.json" child)
        string(JSON child_scan GET "${child}" signature_scan)
        if(NOT child_scan STREQUAL "deferred-to-matrix-parent")
          message(FATAL_ERROR "final-proof: child-signature-authority-invalid:${name}")
        endif()
      endif()
      file(READ "${proof}/build-receipt.json" variant_receipt)
      string(JSON revision GET "${variant_receipt}" source_commit)
      string(JSON expected_sha GET "${variant_receipt}" rom_sha256)
      string(JSON expected_bytes GET "${variant_receipt}" rom_bytes)
      file(SHA256 "${root}/roms/${name}" sha)
      file(SIZE "${root}/roms/${name}" bytes)
      if(NOT revision STREQUAL source_head OR NOT sha STREQUAL expected_sha OR
         NOT bytes EQUAL expected_bytes)
        message(FATAL_ERROR "final-proof: output-identity-mismatch:${name}")
      endif()
      foreach(attr IN ITEMS startup elf)
        file(READ "${proof}/${attr}.attributes.txt" attributes)
        if(NOT attributes MATCHES "Tag_CPU_arch: v4T" OR
           NOT attributes MATCHES "Tag_THUMB_ISA_use: Thumb-1")
          message(FATAL_ERROR "final-proof: architecture-mismatch:${name}")
        endif()
      endforeach()
      foreach(required IN ITEMS map-inputs.txt elf-sections.txt unresolved-symbols.txt)
        if(NOT EXISTS "${proof}/${required}")
          message(FATAL_ERROR "final-proof: audit-evidence-missing:${name}:${required}")
        endif()
      endforeach()
      if(NOT group STREQUAL "smoke" AND NOT EXISTS "${proof}/link-audit.txt")
        message(FATAL_ERROR "final-proof: link-audit-missing:${name}")
      endif()
      list(APPEND actual_names "${group}/${name}")
      if(NOT output_rows STREQUAL "")
        string(APPEND output_rows ",")
        string(APPEND names_json ",")
      endif()
      string(APPEND output_rows "{\"name\":\"${group}/${name}\",\"case_id\":${id},\"sha256\":\"${sha}\",\"bytes\":${bytes}}")
      string(APPEND names_json "\"${group}/${name}\"")
      message(STATUS "final-proof: output host=${host} source=${source_head} name=${group}/${name} case=${id} sha256=${sha} bytes=${bytes}")
    endforeach()
  endforeach()
  proof_assert_set("${actual_names}" "${expected_names}" "complete-output-set-mismatch")
  string(JOIN "," ids_json ${expected_ids})
  set(json "{\"format\":\"gamebloke.final-diagnostic-host/1\",\"stage\":\"pre-admission\",\"host\":\"${host}\",\"source_head\":\"${source_head}\",\"source_input_sha256\":\"${input_digest}\",\"toolchain_archive_sha256\":\"${tool_sha}\",\"case_ids\":[${ids_json}],\"output_names\":[${names_json}],\"outputs\":[${output_rows}]}\n")
  file(WRITE "${bin_root}/complete-host.json" "${json}")
  list(LENGTH actual_names output_count)
  list(LENGTH expected_ids case_count)
  message(STATUS "final-proof: complete host=${host} source=${source_head} outputs=${output_count} cases=${case_count} stage=pre-admission inputs=${input_digest}")
endfunction()

if(CASE STREQUAL "final-host-build")
  foreach(group IN ITEMS smoke arm thumb)
    if(group STREQUAL "smoke")
      set(root build/phase05-spike/final-smoke)
      set(mode smoke)
      set(isa arm)
    else()
      set(root "build/phase05-matrix/${group}")
      set(mode all)
      set(isa "${group}")
    endif()
    execute_process(COMMAND /usr/bin/time -p "${CMAKE_COMMAND}" "-DSRC=${source_root}"
      "-DOUT=${root}" "-DTOOLCHAIN_ROOT=${TOOLCHAIN_ROOT}" "-DMODE=${mode}"
      "-DISA=${isa}" "-DSOURCE_COMMIT=${source_head}"
      -P "${source_root}/cmake/BuildArmDiagnostics.cmake"
      WORKING_DIRECTORY "${source_root}" RESULT_VARIABLE rc
      OUTPUT_FILE "${bin_root}/${group}-build.log" ERROR_FILE "${bin_root}/${group}-build-error.log")
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "final-proof: build-failed:${group}: inspect ${bin_root}/${group}-build-error.log")
    endif()
  endforeach()
  proof_collect()
  return()
elseif(CASE STREQUAL "final-host-set")
  proof_collect()
  return()
endif()

function(proof_host_receipt json expected_host)
  proof_expected()
  proof_inputs(input_digest)
  foreach(field IN ITEMS format stage source_head host source_input_sha256)
    string(JSON value_${field} GET "${json}" "${field}")
  endforeach()
  if(NOT value_format STREQUAL "gamebloke.final-diagnostic-host/1" OR
     NOT value_stage STREQUAL "pre-admission" OR
     NOT value_source_head STREQUAL source_head OR
     NOT value_host STREQUAL expected_host OR
     NOT value_source_input_sha256 STREQUAL input_digest)
    message(FATAL_ERROR "final-proof: host-source-identity-mismatch")
  endif()
  string(JSON archive_sha GET "${json}" toolchain_archive_sha256)
  file(STRINGS "${source_root}/toolchain/arm-none-eabi.lock" lock_rows
    REGEX "^${expected_host} ")
  string(REPLACE " " ";" lock_fields "${lock_rows}")
  list(GET lock_fields 2 expected_archive_sha)
  if(NOT archive_sha STREQUAL expected_archive_sha)
    message(FATAL_ERROR "final-proof: host-tool-identity-mismatch")
  endif()
  proof_array("${json}" output_names names)
  proof_array("${json}" case_ids ids)
  proof_assert_set("${names}" "${expected_names}" "host-output-name-set-mismatch")
  proof_assert_set("${ids}" "${expected_ids}" "host-case-id-set-mismatch")
  string(JSON outputs GET "${json}" outputs)
  string(JSON count LENGTH "${outputs}")
  list(LENGTH expected_names expected_count)
  if(NOT count EQUAL expected_count)
    message(FATAL_ERROR "final-proof: host-output-count-mismatch")
  endif()
  math(EXPR last "${count}-1")
  set(seen "")
  foreach(index RANGE 0 ${last})
    string(JSON row GET "${outputs}" ${index})
    string(JSON name GET "${row}" name)
    string(JSON id GET "${row}" case_id)
    string(JSON sha GET "${row}" sha256)
    string(JSON bytes GET "${row}" bytes)
    if(NOT name IN_LIST expected_names OR name IN_LIST seen)
      message(FATAL_ERROR "final-proof: host-output-row-set-mismatch")
    endif()
    list(APPEND seen "${name}")
    if(name MATCHES "^smoke/")
      set(expected_id 20481)
    else()
      string(REGEX MATCH "[0-9]+" expected_id "${name}")
    endif()
    string(LENGTH "${sha}" sha_length)
    if(NOT id STREQUAL expected_id OR NOT sha_length EQUAL 64 OR
       NOT sha MATCHES "^[0-9a-f]+$" OR NOT bytes MATCHES "^[1-9][0-9]*$")
      message(FATAL_ERROR "final-proof: host-output-identity-invalid")
    endif()
    string(MAKE_C_IDENTIFIER "${name}" key)
    set("proof_sha_${key}" "${sha}" PARENT_SCOPE)
    set("proof_bytes_${key}" "${bytes}" PARENT_SCOPE)
  endforeach()
endfunction()

if(CASE STREQUAL "final-output-proof")
  # A fresh clone contains tracked source only. Ignored/private working files
  # are never copied into either host's checkout.
  set(native "${bin_root}/native-source")
  if(EXISTS "${native}")
    message(FATAL_ERROR "final-proof: preserve-existing-native-source: choose a fresh BIN")
  endif()
  execute_process(COMMAND git clone --no-local --quiet "${source_root}" "${native}"
    RESULT_VARIABLE clone_rc)
  execute_process(COMMAND git -C "${native}" checkout --detach "${source_head}"
    RESULT_VARIABLE checkout_rc OUTPUT_QUIET)
  if(NOT clone_rc STREQUAL "0" OR NOT checkout_rc STREQUAL "0")
    message(FATAL_ERROR "final-proof: tracked-native-clone-failed")
  endif()
  get_filename_component(tools "${TOOLCHAIN_ROOT}" ABSOLUTE BASE_DIR "${source_root}")
  file(MAKE_DIRECTORY "${native}/build")
  file(CREATE_LINK "${tools}" "${native}/build/toolchains" SYMBOLIC RESULT link_rc)
  if(NOT link_rc STREQUAL "0")
    message(FATAL_ERROR "final-proof: verified-native-tools-link-failed")
  endif()
  # One actual canonical workflow invocation builds and checks the native
  # evidence. Building outside Ninja first would duplicate its first command.
  execute_process(COMMAND /usr/bin/time -p "${CMAKE_COMMAND}" --workflow --preset diagnostics
    WORKING_DIRECTORY "${native}"
    RESULT_VARIABLE native_rc OUTPUT_FILE "${bin_root}/native.log"
    ERROR_FILE "${bin_root}/native-time.log")
  if(NOT native_rc STREQUAL "0")
    message(FATAL_ERROR "final-proof: native-build-failed: inspect native.log/native-time.log")
  endif()
  execute_process(COMMAND docker info --format "{{.OSType}}/{{.Architecture}}"
    RESULT_VARIABLE docker_rc OUTPUT_VARIABLE docker_host OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT docker_rc STREQUAL "0" OR NOT docker_host MATCHES "^linux/(aarch64|arm64)$")
    message(FATAL_ERROR "final-proof: native-linux-arm64-unavailable")
  endif()
  set(image "ubuntu:26.04@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c")
  set(container_script [=[
set -eu
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq --no-install-recommends ca-certificates cmake curl ninja-build git libc6-dev gcc time >/dev/null
git config --global --add safe.directory /src
git clone --no-local --quiet /src /work
cd /work
git checkout --detach "$GBL_PROOF_HEAD"
test "$(uname -m)" = aarch64
/usr/bin/time -p -o /result/linux-build-time.txt cmake -DCASE=final-host-build -DSRC=/work -DBIN=build/final-proof -DTOOLCHAIN_ROOT=/tools -P tests/gates/toolchain_spike.cmake > /result/linux.log 2> /result/linux-error.log
mkdir /result/linux-source
cp -R build/phase05-spike build/phase05-matrix build/final-proof /result/linux-source/
]=])
  execute_process(COMMAND /usr/bin/time -p docker run --pull=never --rm
    --cpus 4 --memory 8g -e "GBL_PROOF_HEAD=${source_head}"
    --mount "type=bind,src=${source_root},dst=/src,readonly"
    --mount "type=bind,src=${tools},dst=/tools,readonly"
    --mount "type=bind,src=${bin_root},dst=/result"
    -w / "${image}" sh -c "${container_script}"
    RESULT_VARIABLE linux_rc OUTPUT_FILE "${bin_root}/linux-container.log"
    ERROR_FILE "${bin_root}/linux-container-time.log")
  if(NOT linux_rc STREQUAL "0")
    message(FATAL_ERROR "final-proof: linux-build-failed: inspect linux logs")
  endif()
  file(READ "${native}/build/final-proof/complete-host.json" native_json)
  file(READ "${bin_root}/linux-source/final-proof/complete-host.json" linux_json)
  proof_host_receipt("${native_json}" darwin-arm64)
  proof_host_receipt("${linux_json}" linux-arm64)
  proof_expected()
  set(mismatches "")
  set(compared 0)
  foreach(name IN LISTS expected_names)
    string(REPLACE "/" ";" parts "${name}")
    list(GET parts 0 group)
    list(GET parts 1 leaf)
    if(group STREQUAL "smoke")
      set(left "${native}/build/phase05-spike/final-smoke/roms/${leaf}")
      set(right "${bin_root}/linux-source/phase05-spike/final-smoke/roms/${leaf}")
    else()
      set(left "${native}/build/phase05-matrix/${group}/roms/${leaf}")
      set(right "${bin_root}/linux-source/phase05-matrix/${group}/roms/${leaf}")
    endif()
    execute_process(COMMAND cmp -s "${left}" "${right}" RESULT_VARIABLE cmp_rc)
    file(APPEND "${bin_root}/literal-cmp.txt" "${name} cmp_exit=${cmp_rc}\n")
    if(cmp_rc STREQUAL "1")
      list(APPEND mismatches "${name}")
    elseif(NOT cmp_rc STREQUAL "0")
      message(FATAL_ERROR "final-proof: literal-cmp-error:${name}")
    endif()
    math(EXPR compared "${compared}+1")
  endforeach()
  file(WRITE "${bin_root}/local-proof.json" "{\"format\":\"gamebloke.final-local-proof/1\",\"source_head\":\"${source_head}\",\"literal_cmp_count\":${compared},\"rom_digest_admitted\":false,\"macos\":${native_json},\"linux_arm64\":${linux_json}}\n")
  if(mismatches)
    file(WRITE "${bin_root}/mismatches.txt" "${mismatches}\n")
    message(FATAL_ERROR "final-proof: cross-host-mismatch: preserved; parent decision required")
  endif()
  message(STATUS "final-proof: literal cmp equal for every ${compared} final ROM; hosted Linux x64/macOS hash witness still pending; no digest admission")
  return()
endif()

function(proof_epoch value out)
  if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    execute_process(COMMAND date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "${value}" +%s
      RESULT_VARIABLE rc OUTPUT_VARIABLE epoch OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  else()
    execute_process(COMMAND date -u -d "${value}" +%s RESULT_VARIABLE rc
      OUTPUT_VARIABLE epoch OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  endif()
  if(NOT rc STREQUAL "0" OR NOT epoch MATCHES "^[0-9]+$")
    message(FATAL_ERROR "final-proof: job-time-invalid")
  endif()
  set(${out} "${epoch}" PARENT_SCOPE)
endfunction()

