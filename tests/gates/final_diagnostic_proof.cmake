cmake_minimum_required(VERSION 3.25)
set(final_proof_script "${CMAKE_CURRENT_LIST_FILE}")

# Included only by toolchain_spike.cmake's final-* selectors. These receipts
# describe pre-admission build bytes, never production fixture PASS results.
file(REAL_PATH "${SRC}" source_root)
get_filename_component(bin_root "${BIN}" ABSOLUTE BASE_DIR "${source_root}")
set(build_root "${source_root}/build")
cmake_path(IS_PREFIX build_root "${bin_root}" NORMALIZE safe_bin)
if(NOT safe_bin OR bin_root STREQUAL build_root OR
   IS_SYMLINK "${build_root}" OR IS_SYMLINK "${bin_root}")
  message(FATAL_ERROR "final-proof: unsafe-output-root")
endif()
file(MAKE_DIRECTORY "${bin_root}")
execute_process(COMMAND git -C "${source_root}" rev-parse HEAD
  RESULT_VARIABLE head_rc OUTPUT_VARIABLE source_head
  OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT head_rc STREQUAL "0")
  message(FATAL_ERROR "final-proof: source-head-unavailable")
endif()

if(NOT DEFINED PROOF_GROUP)
  set(PROOF_GROUP all)
endif()
if(NOT PROOF_GROUP MATCHES "^(all|arm|thumb)$")
  message(FATAL_ERROR "final-proof: invalid-group")
endif()
set(producer_groups smoke arm thumb)
if(PROOF_GROUP STREQUAL "arm")
  set(producer_groups smoke arm)
elseif(PROOF_GROUP STREQUAL "thumb")
  set(producer_groups thumb)
endif()

function(proof_expected)
  # One command examines one immutable source authority. Reuse its derived
  # selection across host receipts; do not parse the whole matrix per host.
  file(SHA256 "${source_root}/diagnostics/armv4t/cases.json" matrix_sha)
  execute_process(COMMAND git -C "${source_root}" rev-parse HEAD
    RESULT_VARIABLE current_rc OUTPUT_VARIABLE current_head
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT current_rc STREQUAL "0" OR NOT current_head STREQUAL source_head)
    message(FATAL_ERROR "final-proof: source-authority-changed")
  endif()
  get_property(names GLOBAL PROPERTY GBL_FINAL_PROOF_NAMES_${PROOF_GROUP})
  if(names)
    get_property(bound_sha GLOBAL PROPERTY GBL_FINAL_PROOF_MATRIX_SHA)
    if(NOT matrix_sha STREQUAL bound_sha)
      message(FATAL_ERROR "final-proof: source-authority-changed")
    endif()
    get_property(ids GLOBAL PROPERTY GBL_FINAL_PROOF_IDS_${PROOF_GROUP})
    set(expected_names "${names}" PARENT_SCOPE)
    set(expected_ids "${ids}" PARENT_SCOPE)
    return()
  endif()
  file(READ "${source_root}/diagnostics/armv4t/cases.json" matrix)
  string(JSON rows LENGTH "${matrix}" cases)
  math(EXPR last "${rows}-1")
  set(names "")
  set(ids "")
  if(NOT PROOF_GROUP STREQUAL "thumb")
    set(names smoke/smoke-broken.gba smoke/smoke.gba)
    set(ids 20481)
  endif()
  foreach(index RANGE 0 ${last})
    string(JSON row GET "${matrix}" cases ${index})
    string(JSON kind ERROR_VARIABLE error GET "${row}" source_test kind)
    if(NOT error STREQUAL "NOTFOUND" OR NOT kind MATCHES "^(semantic|guest-stop)$")
      continue()
    endif()
    string(JSON id GET "${row}" id)
    string(JSON isa GET "${row}" isa)
    if(NOT PROOF_GROUP STREQUAL "all" AND NOT isa STREQUAL PROOF_GROUP)
      continue()
    endif()
    list(APPEND ids "${id}")
    if(kind STREQUAL "semantic")
      list(APPEND names "${isa}/${isa}-${id}.gba" "${isa}/${isa}-${id}-broken.gba")
    else()
      list(APPEND names "${isa}/${isa}-stop-${id}.gba")
    endif()
  endforeach()
  list(SORT names)
  list(SORT ids COMPARE NATURAL)
  set_property(GLOBAL PROPERTY GBL_FINAL_PROOF_NAMES_${PROOF_GROUP} "${names}")
  set_property(GLOBAL PROPERTY GBL_FINAL_PROOF_IDS_${PROOF_GROUP} "${ids}")
  set_property(GLOBAL PROPERTY GBL_FINAL_PROOF_MATRIX_SHA "${matrix_sha}")
  set(expected_names "${names}" PARENT_SCOPE)
  set(expected_ids "${ids}" PARENT_SCOPE)
endfunction()

function(proof_inputs out)
  file(STRINGS "${source_root}/diagnostics/armv4t/inputs.txt" inputs)
  set(material "")
  foreach(input IN LISTS inputs)
    if(input MATCHES "^#" OR input STREQUAL "")
      continue()
    endif()
    if(IS_SYMLINK "${source_root}/${input}" OR IS_DIRECTORY "${source_root}/${input}")
      message(FATAL_ERROR "final-proof: producer-input-not-regular:${input}")
    endif()
    execute_process(COMMAND git -C "${source_root}" diff --quiet
      "${source_head}" -- "${input}" RESULT_VARIABLE rc)
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "final-proof: dirty-producer-input:${input}")
    endif()
    file(SHA256 "${source_root}/${input}" sha)
    string(APPEND material "${input}=${sha}\n")
  endforeach()
  string(SHA256 digest "${material}")
  set(${out} "${digest}" PARENT_SCOPE)
endfunction()

if(CASE STREQUAL "final-proof-authority-control")
  set(control_source "${bin_root}/source")
  file(MAKE_DIRECTORY "${control_source}/diagnostics/armv4t")
  file(COPY_FILE "${source_root}/diagnostics/armv4t/cases.json"
    "${control_source}/diagnostics/armv4t/cases.json")
  set(source_root "${control_source}")
  proof_expected()
  file(APPEND "${source_root}/diagnostics/armv4t/cases.json" "\n")
  proof_expected() # Must refuse changed bytes rather than reuse a clean set.
  message(FATAL_ERROR "final-proof: changed-authority-was-reused")
endif()

function(proof_array json field out)
  string(JSON array GET "${json}" "${field}")
  string(JSON count LENGTH "${array}")
  set(values "")
  if(count GREATER 0)
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
      string(JSON value GET "${array}" ${index})
      list(APPEND values "${value}")
    endforeach()
  endif()
  set(${out} "${values}" PARENT_SCOPE)
endfunction()

function(proof_assert_set actual expected reason)
  set(sorted "${actual}")
  list(SORT sorted)
  set(sorted_expected "${expected}")
  list(SORT sorted_expected)
  if(NOT sorted STREQUAL sorted_expected)
    message(FATAL_ERROR "final-proof: ${reason}")
  endif()
endfunction()

function(proof_assert_parent_signature_witness witness_path group_count group)
  if(IS_SYMLINK "${witness_path}")
    message(FATAL_ERROR "final-proof: parent-signature-proof-not-regular:${group}")
  endif()
  if(NOT EXISTS "${witness_path}")
    message(FATAL_ERROR "final-proof: parent-signature-proof-missing:${group}")
  endif()
  if(IS_DIRECTORY "${witness_path}")
    message(FATAL_ERROR "final-proof: parent-signature-proof-not-regular:${group}")
  endif()
  execute_process(COMMAND sh -c [=[test -f "$1" && test ! -L "$1"]=] sh
      "${witness_path}"
    RESULT_VARIABLE regular_rc OUTPUT_QUIET ERROR_QUIET)
  if(NOT regular_rc STREQUAL "0")
    message(FATAL_ERROR "final-proof: parent-signature-proof-not-regular:${group}")
  endif()

  file(READ "${witness_path}" signature_proof)
  set(expected_signature "signature: ok (${group_count} files)\n")
  if(NOT signature_proof STREQUAL expected_signature)
    message(FATAL_ERROR "final-proof: parent-signature-proof-invalid:${group}")
  endif()
endfunction()

function(proof_collect)
  proof_expected()
  proof_inputs(input_digest)
  execute_process(COMMAND uname -s OUTPUT_VARIABLE system OUTPUT_STRIP_TRAILING_WHITESPACE)
  execute_process(COMMAND uname -m OUTPUT_VARIABLE machine OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(system STREQUAL "Darwin" AND machine MATCHES "^(arm64|aarch64)$")
    set(host darwin-arm64)
  elseif(system STREQUAL "Linux" AND machine MATCHES "^(arm64|aarch64)$")
    set(host linux-arm64)
  elseif(system STREQUAL "Linux" AND machine MATCHES "^(x86_64|amd64)$")
    set(host linux-x64)
  else()
    message(FATAL_ERROR "final-proof: unsupported-host")
  endif()
  get_filename_component(tool_root "${TOOLCHAIN_ROOT}" ABSOLUTE BASE_DIR "${source_root}")
  execute_process(COMMAND sh "${source_root}/scripts/fetch-toolchain.sh" --check
    --host "${host}" --root "${tool_root}"
    RESULT_VARIABLE tool_rc OUTPUT_VARIABLE tool_out ERROR_VARIABLE tool_err)
  if(NOT tool_rc STREQUAL "0")
    message(FATAL_ERROR "final-proof: tool-verification-failed:${tool_out}${tool_err}")
  endif()
  file(READ "${tool_root}/arm-none-eabi/${host}-15.2.1-1.1/install.json" tool)
  string(JSON tool_sha GET "${tool}" archive_sha256)
  message(STATUS "final-proof: tool host=${host} source=${source_head} archive_sha256=${tool_sha} group=${PROOF_GROUP}")
  set(actual_names "")
  set(output_rows "")
  set(names_json "")
  foreach(group IN LISTS producer_groups)
    if(group STREQUAL "smoke")
      set(root "${source_root}/build/phase05-spike/final-smoke")
    else()
      set(root "${source_root}/build/phase05-matrix/${group}")
    endif()
    file(READ "${root}/proof/build-receipt.json" receipt)
    string(JSON revision GET "${receipt}" source_commit)
    string(JSON receipt_host GET "${receipt}" host)
    string(JSON scan GET "${receipt}" signature_scan)
    if(NOT revision STREQUAL source_head OR NOT receipt_host STREQUAL host OR
       NOT scan STREQUAL "passed")
      message(FATAL_ERROR "final-proof: stale-build-authority:${group}")
    endif()
    proof_array("${receipt}" output_names group_names)
    list(LENGTH group_names group_count)
    proof_assert_parent_signature_witness(
      "${root}/proof/signature-scan.txt" "${group_count}" "${group}")
    file(GLOB actual RELATIVE "${root}/roms" LIST_DIRECTORIES TRUE "${root}/roms/*")
    proof_assert_set("${actual}" "${group_names}" "output-directory-set:${group}")
    file(READ "${root}/proof/matrix-parent.json" parent)
    string(JSON parent_digest GET "${parent}" source_input_sha256)
    if(NOT parent_digest STREQUAL input_digest)
      message(FATAL_ERROR "final-proof: input-digest-mismatch:${group}")
    endif()
    foreach(name IN LISTS group_names)
      if(IS_SYMLINK "${root}/roms/${name}" OR IS_DIRECTORY "${root}/roms/${name}")
        message(FATAL_ERROR "final-proof: output-not-regular:${name}")
      endif()
      if(group STREQUAL "smoke")
        set(id 20481)
        string(REGEX REPLACE "[.]gba$" "" variant "${name}")
        set(proof "${root}/proof/${variant}")
      else()
        string(REGEX MATCH "[0-9]+" id "${name}")
        string(REGEX REPLACE "[.]gba$" "" variant "${name}")
        set(proof "${root}/cases/${id}/proof/${variant}")
        file(READ "${root}/cases/${id}/proof/build-receipt.json" child)
        string(JSON child_scan GET "${child}" signature_scan)
        if(NOT child_scan STREQUAL "deferred-to-matrix-parent")
          message(FATAL_ERROR "final-proof: child-signature-authority-invalid:${name}")
        endif()
      endif()
      file(READ "${proof}/build-receipt.json" variant_receipt)
      string(JSON revision GET "${variant_receipt}" source_commit)
      string(JSON expected_sha GET "${variant_receipt}" rom_sha256)
      string(JSON expected_bytes GET "${variant_receipt}" rom_bytes)
      file(SHA256 "${root}/roms/${name}" sha)
      file(SIZE "${root}/roms/${name}" bytes)
      if(NOT revision STREQUAL source_head OR NOT sha STREQUAL expected_sha OR
         NOT bytes EQUAL expected_bytes)
        message(FATAL_ERROR "final-proof: output-identity-mismatch:${name}")
      endif()
      foreach(attr IN ITEMS startup elf)
        file(READ "${proof}/${attr}.attributes.txt" attributes)
        if(NOT attributes MATCHES "Tag_CPU_arch: v4T" OR
           NOT attributes MATCHES "Tag_THUMB_ISA_use: Thumb-1")
          message(FATAL_ERROR "final-proof: architecture-mismatch:${name}")
        endif()
      endforeach()
      foreach(required IN ITEMS map-inputs.txt elf-sections.txt unresolved-symbols.txt)
        if(NOT EXISTS "${proof}/${required}")
          message(FATAL_ERROR "final-proof: audit-evidence-missing:${name}:${required}")
        endif()
      endforeach()
      if(NOT group STREQUAL "smoke" AND NOT EXISTS "${proof}/link-audit.txt")
        message(FATAL_ERROR "final-proof: link-audit-missing:${name}")
      endif()
      list(APPEND actual_names "${group}/${name}")
      if(NOT output_rows STREQUAL "")
        string(APPEND output_rows ",")
        string(APPEND names_json ",")
      endif()
      string(APPEND output_rows "{\"name\":\"${group}/${name}\",\"case_id\":${id},\"sha256\":\"${sha}\",\"bytes\":${bytes}}")
      string(APPEND names_json "\"${group}/${name}\"")
      message(STATUS "final-proof: output host=${host} source=${source_head} name=${group}/${name} case=${id} sha256=${sha} bytes=${bytes} group=${PROOF_GROUP}")
    endforeach()
  endforeach()
  proof_assert_set("${actual_names}" "${expected_names}" "complete-output-set-mismatch")
  string(JOIN "," ids_json ${expected_ids})
  set(json "{\"format\":\"gamebloke.final-diagnostic-host/1\",\"stage\":\"pre-admission\",\"host\":\"${host}\",\"source_head\":\"${source_head}\",\"source_input_sha256\":\"${input_digest}\",\"toolchain_archive_sha256\":\"${tool_sha}\",\"case_ids\":[${ids_json}],\"output_names\":[${names_json}],\"outputs\":[${output_rows}]}\n")
  string(JSON json SET "${json}" group "\"${PROOF_GROUP}\"")
  if(NOT "$ENV{GBL_PROOF_RUN_ID}" STREQUAL "")
    if(NOT "$ENV{GBL_PROOF_RUN_ID}" MATCHES "^[1-9][0-9]*$" OR PROOF_GROUP STREQUAL "all")
      message(FATAL_ERROR "final-proof: invalid-hosted-job-context")
    endif()
    string(JSON json SET "${json}" run_id "$ENV{GBL_PROOF_RUN_ID}")
    string(JSON json SET "${json}" job_name "\"diagnostics (${host}, ${PROOF_GROUP})\"")
    message(STATUS "final-proof: job run_id=$ENV{GBL_PROOF_RUN_ID} name=diagnostics (${host}, ${PROOF_GROUP})")
  endif()
  file(WRITE "${bin_root}/complete-host.json" "${json}\n")
  list(LENGTH actual_names output_count)
  list(LENGTH expected_ids case_count)
  message(STATUS "final-proof: complete host=${host} source=${source_head} outputs=${output_count} cases=${case_count} stage=pre-admission inputs=${input_digest} group=${PROOF_GROUP}")
endfunction()

if(CASE STREQUAL "final-host-build")
