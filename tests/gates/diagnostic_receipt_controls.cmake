cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS SRC BIN)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "diagnostic-receipt-control: missing-${required}")
  endif()
endforeach()
get_filename_component(SRC "${SRC}" ABSOLUTE)
get_filename_component(BIN "${BIN}" ABSOLUTE)
include("${SRC}/cmake/DiagnosticMatrix.cmake")
include("${SRC}/cmake/PathContainment.cmake")
set(root "${BIN}/diagnostic-execution")
gbl_resolve_contained_path(root_real status "${SRC}/build" "${root}")
if(NOT status STREQUAL "ok")
  message(FATAL_ERROR "diagnostic-receipt-control: unsafe-root")
endif()
file(READ "${root}/run.json" original_run)
foreach(field IN ITEMS token stage group tools)
  string(JSON ${field} GET "${original_run}" ${field})
endforeach()
if(NOT tools STREQUAL "available")
  message(FATAL_ERROR "diagnostic-receipt-control: actual-execution-required")
endif()
gbl_diagnostic_matrix("${SRC}" "${group}")
list(GET GBL_DIAG_OUTPUTS 0 fid)
set(receipt_path "${root}/${fid}.json")
file(READ "${receipt_path}" original_receipt)
string(JSON result_path GET "${original_receipt}" result_path)
string(JSON rom_path GET "${original_receipt}" rom_path)
file(READ "${result_path}" original_result)
set(driver "${CMAKE_COMMAND}" "-DSRC=${SRC}" "-DBIN=${BIN}" "-DTOKEN=${token}"
  "-DGROUP=${group}" "-DSTAGE=${stage}" -DREQUIRED=ON)
set(script "${SRC}/tests/gates/diagnostic_receipt.cmake")
file(MAKE_DIRECTORY "${BIN}/diagnostic-receipt-controls")

function(run_control label expected)
  execute_process(COMMAND ${driver} ${ARGN} -P "${script}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  # Restore every borrowed real receipt/result before assessing the control.
  file(WRITE "${receipt_path}" "${original_receipt}")
  file(WRITE "${result_path}" "${original_result}")
  file(WRITE "${root}/run.json" "${original_run}")
  file(WRITE "${BIN}/diagnostic-receipt-controls/${label}.log" "${output}${error}")
  if(expected STREQUAL "clean")
    if(NOT rc STREQUAL "0" OR "${output}${error}" MATCHES "SKIPPED:")
      message(FATAL_ERROR "diagnostic-receipt-control: clean-failed:${label}:${output}${error}")
    endif()
  elseif(rc STREQUAL "0" OR NOT "${output}${error}" MATCHES "${expected}" OR
      "${output}${error}" MATCHES "SKIPPED:")
    message(FATAL_ERROR "diagnostic-receipt-control: wrong-refusal:${label}:${output}${error}")
  endif()
endfunction()
run_control(clean-before clean -DCASE=case "-DFIXTURE=${fid}")
run_control(stale-token stale-token -DCASE=case "-DFIXTURE=${fid}" -DTOKEN=stale-control)
string(JSON changed SET "${original_receipt}" source_commit "\"0000000000000000000000000000000000000000\"")
file(WRITE "${receipt_path}" "${changed}\n")
run_control(wrong-source-pin source-pin-mismatch -DCASE=case "-DFIXTURE=${fid}")
string(JSON changed SET "${original_receipt}" source_input_sha256 "\"changed\"")
file(WRITE "${receipt_path}" "${changed}\n")
run_control(stale-source stale-authority -DCASE=case "-DFIXTURE=${fid}")
file(APPEND "${result_path}" " ")
run_control(changed-result changed-case-bytes -DCASE=case "-DFIXTURE=${fid}")

foreach(control IN ITEMS zero-id missing-id wrong-id incomplete-mailbox guest-failure)
  set(doc "${original_result}")
  set(receipt "${original_receipt}")
  if(control STREQUAL "incomplete-mailbox" OR control STREQUAL "guest-failure")
    set(state pending)
    if(control STREQUAL "guest-failure")
      set(state fail)
    endif()
    string(JSON doc SET "${doc}" semantic state "\"${state}\"")
    string(JSON receipt SET "${receipt}" semantic_state "\"${state}\"")
    set(expected semantic-state-mismatch)
  else()
    set(id "0")
    if(control STREQUAL "wrong-id")
      set(id "1")
    endif()
    if(control STREQUAL "missing-id")
      string(JSON doc SET "${doc}" semantic case_id null)
      string(JSON receipt SET "${receipt}" semantic_case_id null)
    else()
      string(JSON doc SET "${doc}" semantic case_id "\"${id}\"")
      string(JSON receipt SET "${receipt}" semantic_case_id "\"${id}\"")
    endif()
    set(expected semantic-case_id-mismatch)
  endif()
  file(WRITE "${result_path}" "${doc}\n")
  file(SHA256 "${result_path}" sha)
  string(JSON receipt SET "${receipt}" result_sha256 "\"${sha}\"")
  file(WRITE "${receipt_path}" "${receipt}\n")
  run_control("${control}" "${expected}" -DCASE=case "-DFIXTURE=${fid}")
endforeach()

file(RENAME "${receipt_path}" "${receipt_path}.control-save")
execute_process(COMMAND ${driver} -DCASE=case "-DFIXTURE=${fid}" -P "${script}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(RENAME "${receipt_path}.control-save" "${receipt_path}")
if(rc STREQUAL "0" OR NOT "${output}${error}" MATCHES "missing-case:")
  message(FATAL_ERROR "diagnostic-receipt-control: missing-receipt-not-refused:${output}${error}")
endif()
file(RENAME "${rom_path}" "${rom_path}.control-save")
execute_process(COMMAND ${driver} -DCASE=case "-DFIXTURE=${fid}" -P "${script}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(RENAME "${rom_path}.control-save" "${rom_path}")
if(rc STREQUAL "0" OR NOT "${output}${error}" MATCHES "unsafe-rom_path:")
  message(FATAL_ERROR "diagnostic-receipt-control: missing-output-not-refused:${output}${error}")
endif()
file(RENAME "${root}/run.json" "${root}/run.json.control-save")
execute_process(COMMAND ${driver} -DCASE=case "-DFIXTURE=${fid}" -P "${script}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(RENAME "${root}/run.json.control-save" "${root}/run.json")
if(rc STREQUAL "0" OR NOT "${output}${error}" MATCHES "missing-current-setup")
  message(FATAL_ERROR "diagnostic-receipt-control: missing-current-setup-not-refused:${output}${error}")
endif()
string(JSON changed SET "${original_run}" outputs "[]")
file(WRITE "${root}/run.json" "${changed}\n")
run_control(incomplete-set incomplete-execution-set -DCASE=guard)
string(JSON changed SET "${changed}" tools "\"absent\"")
file(WRITE "${root}/run.json" "${changed}\n")
run_control(required-all-skipped required-all-skipped -DCASE=guard)
if(stage STREQUAL "proof")
  run_control(required-proof-stage required-stage-not-admitted -DCASE=guard -DREQUIRED_ADMITTED=ON)
endif()
foreach(stop IN LISTS GBL_DIAG_OUTPUTS)
  if(NOT stop MATCHES "-stop-")
    continue()
  endif()
  set(stop_receipt "${root}/${stop}.json")
  file(READ "${stop_receipt}" stop_original)
  string(JSON stop_result GET "${stop_original}" result_path)
  string(JSON expected_reason GET "${GBL_DIAG_ROW_${stop}}" source_test expected_reason)
  file(READ "${stop_result}" stop_doc_original)
  set(wrong_reason no-bios-swi)
  if(expected_reason STREQUAL wrong_reason)
    set(wrong_reason no-bios-undefined)
  endif()
  string(JSON stop_doc SET "${stop_doc_original}" reason "\"${wrong_reason}\"")
  file(WRITE "${stop_result}" "${stop_doc}\n")
  file(SHA256 "${stop_result}" sha)
  string(JSON changed SET "${stop_original}" result_sha256 "\"${sha}\"")
  string(JSON changed SET "${changed}" reason "\"${wrong_reason}\"")
  file(WRITE "${stop_receipt}" "${changed}\n")
  execute_process(COMMAND ${driver} -DCASE=case "-DFIXTURE=${stop}"
    "-DEXPECTED_STOP_REASON=${expected_reason}" -P "${script}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  file(WRITE "${stop_result}" "${stop_doc_original}")
  file(WRITE "${stop_receipt}" "${stop_original}")
  if(rc STREQUAL "0" OR NOT "${output}${error}" MATCHES "reason-mismatch:")
    message(FATAL_ERROR "diagnostic-receipt-control: exact-stop-not-enforced:${output}${error}")
  endif()
  break()
endforeach()

if(GBL_DIAG_APIS)
  list(GET GBL_DIAG_APIS 0 api)
  string(SHA256 api_sha "${GBL_DIAG_API_${api}}")
  string(JSON selector GET "${GBL_DIAG_API_${api}}" native_evidence 0 selector)
  set(native_path "${root}/native/${selector}.tap")
  file(READ "${native_path}" native_original)
  string(REGEX REPLACE "(^|\n)ok 1 - [^\n]+" "\\1ok 1 - controlled missing assertion" native_changed "${native_original}")
  file(WRITE "${native_path}" "${native_changed}")
  execute_process(COMMAND ${driver} -DCASE=api "-DAPI=${api}" "-DAPI_ROW_SHA256=${api_sha}"
    -P "${script}" RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  file(WRITE "${native_path}" "${native_original}")
  if(rc STREQUAL "0" OR NOT "${output}${error}" MATCHES "native-assertion-missing:")
    message(FATAL_ERROR "diagnostic-receipt-control: missing-native-assertion-not-refused:${output}${error}")
  endif()
endif()
run_control(clean-after clean -DCASE=case "-DFIXTURE=${fid}")
message(STATUS "diagnostic-receipt-control: real clean companions and exact ID/mailbox/source/token/byte/set/skip/stage/native refusals passed")
