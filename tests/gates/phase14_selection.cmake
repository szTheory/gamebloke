function(gbl_phase14_json_property json index wanted property_out found_out)
  set(found FALSE)
  set(value)
  string(JSON property_count ERROR_VARIABLE property_error LENGTH
    "${json}" tests ${index} properties)
  if(NOT "${property_error}" STREQUAL "NOTFOUND")
    set(${property_out} "" PARENT_SCOPE)
    set(${found_out} FALSE PARENT_SCOPE)
    return()
  endif()
  if(property_count GREATER 0)
    math(EXPR property_last "${property_count} - 1")
    foreach(property_index RANGE 0 ${property_last})
      string(JSON property_name GET "${json}" tests ${index}
        properties ${property_index} name)
      if(NOT property_name STREQUAL wanted)
        continue()
      endif()
      string(JSON value_type TYPE "${json}" tests ${index}
        properties ${property_index} value)
      if(value_type STREQUAL "ARRAY")
        string(JSON value_count LENGTH "${json}" tests ${index}
          properties ${property_index} value)
        if(value_count GREATER 0)
          math(EXPR value_last "${value_count} - 1")
          foreach(value_index RANGE 0 ${value_last})
            string(JSON item GET "${json}" tests ${index}
              properties ${property_index} value ${value_index})
            list(APPEND value "${item}")
          endforeach()
        endif()
      elseif(value_type STREQUAL "STRING" OR value_type STREQUAL "BOOLEAN" OR
          value_type STREQUAL "NUMBER")
        string(JSON value GET "${json}" tests ${index}
          properties ${property_index} value)
      endif()
      set(found TRUE)
      break()
    endforeach()
  endif()
  set(${property_out} "${value}" PARENT_SCOPE)
  set(${found_out} "${found}" PARENT_SCOPE)
endfunction()

function(gbl_phase14_find_test json wanted index_out count_out)
  set(found_index -1)
  set(found_count 0)
  string(JSON count ERROR_VARIABLE error LENGTH "${json}" tests)
  if("${error}" STREQUAL "NOTFOUND" AND count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
      string(JSON name GET "${json}" tests ${index} name)
      if(name STREQUAL wanted)
        math(EXPR found_count "${found_count} + 1")
        set(found_index ${index})
      endif()
    endforeach()
  endif()
  set(${index_out} "${found_index}" PARENT_SCOPE)
  set(${count_out} "${found_count}" PARENT_SCOPE)
endfunction()

function(gbl_phase14_expected_command name json index reason_out)
  string(JSON command_count ERROR_VARIABLE command_error LENGTH
    "${json}" tests ${index} command)
  if(NOT "${command_error}" STREQUAL "NOTFOUND" OR command_count LESS 1)
    set(${reason_out} wrong-command PARENT_SCOPE)
    return()
  endif()
  string(JSON program GET "${json}" tests ${index} command 0)
  file(REAL_PATH "${program}" actual_program)
  file(REAL_PATH "${CMAKE_COMMAND}" cmake_program)
  if(name MATCHES "^ppu[.]")
    set(expected_program "${GBL_PHASE14_BIN}/bus_test${CMAKE_EXECUTABLE_SUFFIX}")
    file(REAL_PATH "${expected_program}" expected_program)
    string(JSON argument GET "${json}" tests ${index} command 1)
    if(NOT actual_program STREQUAL expected_program OR
        NOT command_count EQUAL 2 OR NOT argument STREQUAL name)
      set(${reason_out} wrong-command PARENT_SCOPE)
      return()
    endif()
  elseif(name MATCHES "^determinism[.]phase14([.]controls)?$")
    set(expected_program
      "${GBL_PHASE14_BIN}/determinism_test${CMAKE_EXECUTABLE_SUFFIX}")
    file(REAL_PATH "${expected_program}" expected_program)
    if(NOT actual_program STREQUAL expected_program OR NOT command_count EQUAL 2)
      set(${reason_out} wrong-command PARENT_SCOPE)
      return()
    endif()
    if(name STREQUAL "determinism.phase14.controls")
      set(expected_argument phase14-controls)
    else()
      set(expected_argument phase14)
    endif()
    string(JSON argument GET "${json}" tests ${index} command 1)
    if(NOT argument STREQUAL expected_argument)
      set(${reason_out} wrong-command PARENT_SCOPE)
      return()
    endif()
  elseif(name MATCHES "^phase14[.]selection[.](control|verify|order)$")
    if(NOT actual_program STREQUAL cmake_program OR NOT command_count EQUAL 6)
      set(${reason_out} wrong-command PARENT_SCOPE)
      return()
    endif()
    if(name STREQUAL "phase14.selection.control")
      set(expected_case control)
    elseif(name STREQUAL "phase14.selection.order")
      set(expected_case order)
    else()
      set(expected_case verify)
    endif()
    set(expected_args
      "-DSRC=${GBL_PHASE14_SRC}" "-DBIN=${GBL_PHASE14_BIN}"
      "-DCASE=${expected_case}" -P "${GBL_PHASE14_GATE}")
    foreach(command_index RANGE 1 5)
      string(JSON actual_arg GET "${json}" tests ${index} command ${command_index})
      math(EXPR expected_index "${command_index} - 1")
      list(GET expected_args ${expected_index} expected_arg)
      if(NOT actual_arg STREQUAL expected_arg)
        set(${reason_out} wrong-command PARENT_SCOPE)
        return()
      endif()
    endforeach()
  elseif(name STREQUAL "profile.lint")
    set(expected_args
      "-DPROFILE=${GBL_PHASE14_SRC}/profiles/agb.json"
      "-DDOC=${GBL_PHASE14_SRC}/docs/profile-agb.md"
      "-DREGISTRY=${GBL_PHASE14_SRC}/registry/disputes.json"
      "-DVOCAB=${GBL_PHASE14_SRC}/contracts/evidence.json"
      -P "${GBL_PHASE14_SRC}/cmake/CheckProfile.cmake")
    if(NOT actual_program STREQUAL cmake_program OR NOT command_count EQUAL 7)
      set(${reason_out} wrong-command PARENT_SCOPE)
      return()
    endif()
    foreach(command_index RANGE 1 6)
      string(JSON actual_arg GET "${json}" tests ${index} command ${command_index})
      math(EXPR expected_index "${command_index} - 1")
      list(GET expected_args ${expected_index} expected_arg)
      if(NOT actual_arg STREQUAL expected_arg)
        set(${reason_out} wrong-command PARENT_SCOPE)
        return()
      endif()
    endforeach()
  elseif(name STREQUAL "profile.nc.ppu_policy")
    set(expected_args
      "-DSRC=${GBL_PHASE14_SRC}" "-DBIN=${GBL_PHASE14_BIN}"
      -DCASE=ppu_policy -P "${GBL_PHASE14_SRC}/tests/gates/profile_case.cmake")
    if(NOT actual_program STREQUAL cmake_program OR NOT command_count EQUAL 6)
      set(${reason_out} wrong-command PARENT_SCOPE)
      return()
    endif()
    foreach(command_index RANGE 1 5)
      string(JSON actual_arg GET "${json}" tests ${index} command ${command_index})
      math(EXPR expected_index "${command_index} - 1")
      list(GET expected_args ${expected_index} expected_arg)
      if(NOT actual_arg STREQUAL expected_arg)
        set(${reason_out} wrong-command PARENT_SCOPE)
        return()
      endif()
    endforeach()
  else()
    set(${reason_out} wrong-command PARENT_SCOPE)
    return()
  endif()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase14_labels name json index reason_out)
  gbl_phase14_json_property("${json}" ${index} LABELS labels has_labels)
  if(NOT has_labels)
    set(${reason_out} wrong-label PARENT_SCOPE)
    return()
  endif()
  if(name MATCHES "^ppu[.]")
    if(name STREQUAL "ppu.effects.boundary" OR
        name STREQUAL "ppu.effects.controls")
      set(expected_labels bus core ppu unit)
    else()
      set(expected_labels bus core integration ppu)
    endif()
  elseif(name MATCHES "^determinism[.]phase14([.]controls)?$")
    set(expected_labels determinism gate integration)
  elseif(name MATCHES "^phase14[.]selection[.](control|verify|order)$")
    set(expected_labels gate ppu time)
  elseif(name STREQUAL "profile.lint")
    set(expected_labels gate profile)
  else()
    set(expected_labels control profile)
  endif()
  set(actual_labels ${labels})
  list(SORT actual_labels)
  list(SORT expected_labels)
  if(NOT "${actual_labels}" STREQUAL "${expected_labels}")
    set(${reason_out} wrong-label PARENT_SCOPE)
    return()
  endif()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase14_validate_location_and_state json index reason_out)
  gbl_phase14_json_property("${json}" ${index} WORKING_DIRECTORY workdir has_workdir)
  if(NOT has_workdir)
    set(${reason_out} wrong-root PARENT_SCOPE)
    return()
  endif()
  file(REAL_PATH "${workdir}" workdir_real)
  if(NOT workdir_real STREQUAL GBL_PHASE14_BIN)
    set(${reason_out} wrong-root PARENT_SCOPE)
    return()
  endif()
  gbl_phase14_json_property("${json}" ${index} SKIP_REGULAR_EXPRESSION
    skip_expression has_skip)
  if(has_skip)
    set(${reason_out} skippable PARENT_SCOPE)
    return()
  endif()
  gbl_phase14_json_property("${json}" ${index} DISABLED disabled has_disabled)
  if(has_disabled AND disabled)
    set(${reason_out} disabled PARENT_SCOPE)
    return()
  endif()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase14_validate_selection json reason_out)
  string(JSON kind ERROR_VARIABLE kind_error GET "${json}" kind)
  string(JSON count ERROR_VARIABLE count_error LENGTH "${json}" tests)
  if(NOT "${kind_error}" STREQUAL "NOTFOUND" OR NOT kind STREQUAL "ctestInfo" OR
      NOT "${count_error}" STREQUAL "NOTFOUND")
    set(${reason_out} malformed PARENT_SCOPE)
    return()
  endif()
  list(LENGTH GBL_PHASE14_EXPECTED expected_count)
  if(NOT count EQUAL expected_count)
    set(${reason_out} selection-count PARENT_SCOPE)
    return()
  endif()
  set(actual_names)
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    string(JSON name ERROR_VARIABLE name_error GET "${json}" tests ${index} name)
    if(NOT "${name_error}" STREQUAL "NOTFOUND" OR "${name}" STREQUAL "")
      set(${reason_out} malformed PARENT_SCOPE)
      return()
    endif()
    if(name IN_LIST actual_names)
      set(${reason_out} duplicate-selector PARENT_SCOPE)
      return()
    endif()
    list(APPEND actual_names "${name}")
  endforeach()
  foreach(expected IN LISTS GBL_PHASE14_EXPECTED)
    if(NOT expected IN_LIST actual_names)
      set(${reason_out} missing-selector PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(index RANGE 0 ${last})
    string(JSON name GET "${json}" tests ${index} name)
    gbl_phase14_expected_command("${name}" "${json}" ${index} command_reason)
    if(NOT "${command_reason}" STREQUAL "")
      set(${reason_out} "${command_reason}" PARENT_SCOPE)
      return()
    endif()
    gbl_phase14_labels("${name}" "${json}" ${index} label_reason)
    if(NOT "${label_reason}" STREQUAL "")
      set(${reason_out} "${label_reason}" PARENT_SCOPE)
      return()
    endif()
    gbl_phase14_validate_location_and_state("${json}" ${index} state_reason)
    if(NOT "${state_reason}" STREQUAL "")
      set(${reason_out} "${state_reason}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase14_validate_gate_registrations json reason_out)
  foreach(name IN ITEMS phase14.selection.control phase14.selection.verify
      phase14.selection.order)
    gbl_phase14_find_test("${json}" "${name}" index found_count)
    if(NOT found_count EQUAL 1)
      set(${reason_out} "registration-count-${name}-${found_count}" PARENT_SCOPE)
      return()
    endif()
    gbl_phase14_expected_command("${name}" "${json}" ${index} command_reason)
    if(NOT "${command_reason}" STREQUAL "")
      set(${reason_out} "${name}-${command_reason}" PARENT_SCOPE)
      return()
    endif()
    gbl_phase14_labels("${name}" "${json}" ${index} label_reason)
    gbl_phase14_validate_location_and_state("${json}" ${index} state_reason)
    if(NOT "${label_reason}" STREQUAL "")
      set(${reason_out} "${name}-${label_reason}" PARENT_SCOPE)
      return()
    elseif(NOT "${state_reason}" STREQUAL "")
      set(${reason_out} "${name}-${state_reason}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase14_discover build_dir regex output_var)
  execute_process(
    COMMAND "${CTEST_PROGRAM}" --test-dir "${build_dir}" --show-only=json-v1
      --fixture-exclude-any
      "^(phase7_fast|phase8_fast|phase9_fast|phase10_fast|phase11_fast|phase12_fast|phase13_fast)$"
      -R "${regex}"
    RESULT_VARIABLE result OUTPUT_VARIABLE json ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "phase14-selection: discovery-failed: ${result}\n${error}")
  endif()
  set(${output_var} "${json}" PARENT_SCOPE)
endfunction()

function(gbl_phase14_check_inventory path lane reason_out)
  if(NOT EXISTS "${path}")
    set(${reason_out} inventory-missing PARENT_SCOPE)
    return()
  endif()
  file(STRINGS "${path}" rows)
  set(sorted_rows ${rows})
  list(SORT sorted_rows)
  if(NOT "${rows}" STREQUAL "${sorted_rows}")
    set(${reason_out} inventory-unsorted PARENT_SCOPE)
    return()
  endif()
  set(expected_rows ${GBL_PHASE14_INVENTORY_ROWS})
  if(lane STREQUAL "ci")
    list(APPEND expected_rows ${GBL_PHASE14_PROFILE_INVENTORY_ROWS})
  endif()
  file(STRINGS "${path}" phase_rows REGEX
    "^(determinism[.]phase14([.]| )|phase14[.]selection[.]|ppu[.]blank |ppu[.]effects[.]|ppu[.]mosaic[.]|ppu[.]window[.]|profile[.]lint |profile[.]nc[.]ppu_policy )")
  foreach(expected_row IN LISTS expected_rows)
    string(REGEX MATCH "^([^ ]+)" name "${expected_row}")
    string(REPLACE "." "[.]" name_regex "${name}")
    set(matching_rows)
    foreach(actual_row IN LISTS phase_rows)
      if(actual_row MATCHES "^${name_regex} ")
        list(APPEND matching_rows "${actual_row}")
      endif()
    endforeach()
    list(LENGTH matching_rows row_count)
    if(NOT row_count EQUAL 1)
      if(name MATCHES "^profile[.]")
        set(${reason_out} "inherited-${name}-count-${row_count}" PARENT_SCOPE)
      else()
        set(${reason_out} "inventory-${name}-count-${row_count}" PARENT_SCOPE)
      endif()
      return()
    endif()
    list(GET matching_rows 0 actual_row)
    if(NOT actual_row STREQUAL expected_row)
      if(name MATCHES "^profile[.]")
        set(${reason_out} "inherited-${name}-labels" PARENT_SCOPE)
      else()
        set(${reason_out} "inventory-${name}-labels" PARENT_SCOPE)
      endif()
      return()
    endif()
  endforeach()
  foreach(actual_row IN LISTS phase_rows)
    string(REGEX MATCH "^([^ ]+)" name "${actual_row}")
    set(known FALSE)
    foreach(expected_row IN LISTS expected_rows)
      string(REGEX MATCH "^([^ ]+)" expected_name "${expected_row}")
      if(name STREQUAL expected_name)
        set(known TRUE)
        break()
      endif()
    endforeach()
    if(NOT known)
      if(lane STREQUAL "asan" AND name MATCHES "^profile[.]")
        set(${reason_out} asan-invented-profile-gate PARENT_SCOPE)
      else()
        set(${reason_out} "inventory-unexpected-${name}" PARENT_SCOPE)
      endif()
      return()
    endif()
  endforeach()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase14_required_names output_var)
  set(${output_var} phase14.selection.verify phase14.selection.order PARENT_SCOPE)
endfunction()

function(gbl_phase14_validate_order json reason_out)
  set(expected_setup ${GBL_PHASE14_EXPECTED})
  gbl_phase14_required_names(expected_required)
  # Keep the order contract aligned with Plan 10's bounded long-consumer set.
  set(long_consumer_regex
    "^(cpu[.]ppu[.].*|dma[.]ppu[.].*|runner[.]ppu[.].*|result[.](nc|pos)[.]phase10|phase10[.]cli([.]control)?)$")
  string(JSON count ERROR_VARIABLE count_error LENGTH "${json}" tests)
  if(NOT "${count_error}" STREQUAL "NOTFOUND")
    set(${reason_out} malformed PARENT_SCOPE)
    return()
  endif()
  set(actual_setup)
  set(actual_required)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
      string(JSON name GET "${json}" tests ${index} name)
      gbl_phase14_json_property("${json}" ${index} FIXTURES_SETUP setup has_setup)
      gbl_phase14_json_property("${json}" ${index} FIXTURES_REQUIRED required has_required)
      if(name MATCHES "${long_consumer_regex}")
        list(APPEND expected_required "${name}")
      endif()
      if(has_setup AND "phase14_fast" IN_LIST setup)
        list(APPEND actual_setup "${name}")
        if("phase14_fast" IN_LIST required)
          set(${reason_out} "setup-self-cycle-${name}" PARENT_SCOPE)
          return()
        endif()
      endif()
      if(has_required AND "phase14_fast" IN_LIST required)
        list(APPEND actual_required "${name}")
      endif()
    endforeach()
  endif()
  list(SORT actual_setup)
  list(SORT expected_setup)
  if(NOT "${actual_setup}" STREQUAL "${expected_setup}")
    set(${reason_out} setup-set PARENT_SCOPE)
    return()
  endif()
  list(SORT actual_required)
  list(SORT expected_required)
  if(NOT "${actual_required}" STREQUAL "${expected_required}")
    foreach(name IN LISTS expected_required)
      if(NOT name IN_LIST actual_required)
        set(${reason_out} "missing-predecessor-${name}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
    set(${reason_out} unexpected-required-set PARENT_SCOPE)
    return()
  endif()
  foreach(name IN LISTS expected_setup expected_required)
    gbl_phase14_find_test("${json}" "${name}" index found_count)
    if(NOT found_count EQUAL 1)
      set(${reason_out} "registration-count-${name}-${found_count}" PARENT_SCOPE)
      return()
    endif()
    gbl_phase14_expected_command("${name}" "${json}" ${index} command_reason)
    if(NOT "${command_reason}" STREQUAL "")
      set(${reason_out} "${name}-${command_reason}" PARENT_SCOPE)
      return()
    endif()
    gbl_phase14_labels("${name}" "${json}" ${index} label_reason)
    gbl_phase14_validate_location_and_state("${json}" ${index} state_reason)
    if(NOT "${label_reason}" STREQUAL "")
      set(${reason_out} "${name}-${label_reason}" PARENT_SCOPE)
      return()
    elseif(NOT "${state_reason}" STREQUAL "")
      set(${reason_out} "${name}-${state_reason}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(inherited IN LISTS GBL_PHASE14_INHERITED_PROFILE)
    gbl_phase14_find_test("${json}" "${inherited}" index found_count)
    if(NOT found_count EQUAL 1)
      set(${reason_out} "inherited-profile-count-${inherited}-${found_count}" PARENT_SCOPE)
      return()
    endif()
    gbl_phase14_json_property("${json}" ${index} FIXTURES_SETUP setup has_setup)
    if(NOT has_setup OR NOT "phase13_fast" IN_LIST setup OR
        "phase14_fast" IN_LIST setup)
      set(${reason_out} "inherited-profile-not-disjoint-${inherited}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase14_write_scratch_graph source_dir build_dir)
  file(MAKE_DIRECTORY "${source_dir}")
  set(project_text
    "cmake_minimum_required(VERSION 3.25)\nproject(phase14_selection_scratch NONE)\nenable_testing()\n")
  foreach(name IN LISTS GBL_PHASE14_EXPECTED)
    if(name MATCHES "^ppu[.]")
      string(APPEND project_text
        "add_test(NAME ${name} COMMAND \"${GBL_PHASE14_BIN}/bus_test${CMAKE_EXECUTABLE_SUFFIX}\" ${name})\n")
      if(name STREQUAL "ppu.effects.boundary" OR
          name STREQUAL "ppu.effects.controls")
        set(labels "bus;core;ppu;unit")
      else()
        set(labels "bus;core;integration;ppu")
      endif()
    elseif(name MATCHES "^determinism[.]phase14([.]controls)?$")
      if(name STREQUAL "determinism.phase14.controls")
        set(argument phase14-controls)
      else()
        set(argument phase14)
      endif()
      string(APPEND project_text
        "add_test(NAME ${name} COMMAND \"${GBL_PHASE14_BIN}/determinism_test${CMAKE_EXECUTABLE_SUFFIX}\" ${argument})\n")
      set(labels "determinism;gate;integration")
    else()
      string(APPEND project_text
        "add_test(NAME ${name} COMMAND \"${CMAKE_PROGRAM}\" \"-DSRC=${GBL_PHASE14_SRC}\" \"-DBIN=${GBL_PHASE14_BIN}\" -DCASE=control -P \"${GBL_PHASE14_GATE}\")\n")
      set(labels "gate;ppu;time")
    endif()
    string(APPEND project_text
      "set_tests_properties(${name} PROPERTIES LABELS \"${labels}\" WORKING_DIRECTORY \"${GBL_PHASE14_BIN}\" FIXTURES_SETUP phase14_fast FIXTURES_REQUIRED phase13_fast)\n")
  endforeach()
  foreach(name IN LISTS GBL_PHASE14_INHERITED_PROFILE)
    if(name STREQUAL "profile.lint")
      string(APPEND project_text
        "add_test(NAME ${name} COMMAND \"${CMAKE_PROGRAM}\" \"-DPROFILE=${GBL_PHASE14_SRC}/profiles/agb.json\" \"-DDOC=${GBL_PHASE14_SRC}/docs/profile-agb.md\" \"-DREGISTRY=${GBL_PHASE14_SRC}/registry/disputes.json\" \"-DVOCAB=${GBL_PHASE14_SRC}/contracts/evidence.json\" -P \"${GBL_PHASE14_SRC}/cmake/CheckProfile.cmake\")\n")
      set(labels "gate;profile")
    else()
      string(APPEND project_text
        "add_test(NAME ${name} COMMAND \"${CMAKE_PROGRAM}\" \"-DSRC=${GBL_PHASE14_SRC}\" \"-DBIN=${GBL_PHASE14_BIN}\" -DCASE=ppu_policy -P \"${GBL_PHASE14_SRC}/tests/gates/profile_case.cmake\")\n")
      set(labels "control;profile")
    endif()
    string(APPEND project_text
      "set_tests_properties(${name} PROPERTIES LABELS \"${labels}\" WORKING_DIRECTORY \"${GBL_PHASE14_BIN}\" FIXTURES_SETUP phase13_fast)\n")
  endforeach()
  foreach(case IN ITEMS verify order)
    set(name "phase14.selection.${case}")
    string(APPEND project_text
      "add_test(NAME ${name} COMMAND \"${CMAKE_PROGRAM}\" \"-DSRC=${GBL_PHASE14_SRC}\" \"-DBIN=${GBL_PHASE14_BIN}\" -DCASE=${case} -P \"${GBL_PHASE14_GATE}\")\n")
    if(case STREQUAL "control")
      string(APPEND project_text
        "set_tests_properties(${name} PROPERTIES LABELS \"gate;ppu;time\" WORKING_DIRECTORY \"${GBL_PHASE14_BIN}\" FIXTURES_SETUP phase14_fast FIXTURES_REQUIRED phase13_fast)\n")
    else()
      string(APPEND project_text
        "set_tests_properties(${name} PROPERTIES LABELS \"gate;ppu;time\" WORKING_DIRECTORY \"${GBL_PHASE14_BIN}\" FIXTURES_REQUIRED phase14_fast)\n")
    endif()
  endforeach()
  file(WRITE "${source_dir}/CMakeLists.txt" "${project_text}")
  execute_process(
    COMMAND "${CMAKE_PROGRAM}" -S "${source_dir}" -B "${build_dir}"
    RESULT_VARIABLE configure_result OUTPUT_VARIABLE configure_output
    ERROR_VARIABLE configure_error)
  if(NOT "${configure_result}" STREQUAL "0")
    message(FATAL_ERROR
      "phase14-selection-control: scratch-configure\n${configure_output}${configure_error}")
  endif()
endfunction()

function(gbl_phase14_expect_invocation_rejection name marker)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
  set(combined "${output}${error}")
  string(FIND "${combined}" "${marker}" marker_index)
  if("${result}" STREQUAL "0" OR marker_index EQUAL -1)
    message(FATAL_ERROR
      "phase14-selection-control: ${name}: expected-${marker}; result=${result}\n${combined}")
  endif()
  message(STATUS "phase14-selection-control: ${name}: causal rejection ok")
endfunction()

function(gbl_phase14_check_controls scratch_root)
  set(source_dir "${scratch_root}/selection/source")
  set(build_dir "${scratch_root}/selection/build")
  gbl_phase14_write_scratch_graph("${source_dir}" "${build_dir}")
  execute_process(
    COMMAND "${CTEST_PROGRAM}" --test-dir "${build_dir}" --show-only=json-v1
    RESULT_VARIABLE graph_result OUTPUT_VARIABLE graph_json ERROR_VARIABLE graph_error)
  if(NOT "${graph_result}" STREQUAL "0")
    message(FATAL_ERROR
      "phase14-selection-control: scratch-discovery\n${graph_error}")
  endif()
  gbl_phase14_validate_gate_registrations("${graph_json}" gates_reason)
  if(NOT "${gates_reason}" STREQUAL "")
    message(FATAL_ERROR "phase14-selection-control: clean-gates-${gates_reason}")
  endif()
  gbl_phase14_validate_order("${graph_json}" order_reason)
  if(NOT "${order_reason}" STREQUAL "")
    message(FATAL_ERROR "phase14-selection-control: clean-order-${order_reason}")
  endif()
  gbl_phase14_discover("${build_dir}" "${GBL_PHASE14_REGEX}" clean_json)
  gbl_phase14_validate_selection("${clean_json}" clean_reason)
  if(NOT "${clean_reason}" STREQUAL "")
    message(FATAL_ERROR "phase14-selection-control: clean-twin-${clean_reason}")
  endif()
  message(STATUS "phase14-selection-control: scratch clean selection twin passed")

  set(empty_json "{\"kind\":\"ctestInfo\",\"tests\":[]}")
  gbl_phase14_validate_selection("${empty_json}" empty_reason)
  if(NOT empty_reason STREQUAL "selection-count")
    message(FATAL_ERROR
      "phase14-selection-control: empty-selection-not-causal-${empty_reason}")
  endif()

  gbl_phase14_find_test("${clean_json}" ppu.effects.tracer tracer_index tracer_count)
  gbl_phase14_find_test("${clean_json}" ppu.window.rect window_index window_count)
  if(NOT tracer_count EQUAL 1 OR NOT window_count EQUAL 1)
    message(FATAL_ERROR "phase14-selection-control: clean-twin-missing-selector")
  endif()
  string(JSON duplicate_json SET "${clean_json}" tests ${window_index} name
    "\"ppu.effects.tracer\"")
  gbl_phase14_validate_selection("${duplicate_json}" duplicate_reason)
  if(NOT duplicate_reason STREQUAL "duplicate-selector")
    message(FATAL_ERROR
      "phase14-selection-control: duplicate-not-causal-${duplicate_reason}")
  endif()

  string(JSON missing_json REMOVE "${clean_json}" tests ${tracer_index})
  gbl_phase14_validate_selection("${missing_json}" missing_reason)
  if(NOT missing_reason STREQUAL "selection-count")
    message(FATAL_ERROR
      "phase14-selection-control: missing-not-causal-${missing_reason}")
  endif()

  set(wrong_command_json "${clean_json}")
  file(MAKE_DIRECTORY "${scratch_root}/missing")
  file(WRITE "${scratch_root}/missing/bus_test" "wrong executable sentinel\n")
  string(JSON wrong_command_json SET "${wrong_command_json}" tests ${tracer_index}
    command 0 "\"${scratch_root}/missing/bus_test\"")
  gbl_phase14_validate_selection("${wrong_command_json}" command_reason)
  if(NOT command_reason STREQUAL "wrong-command")
    message(FATAL_ERROR
      "phase14-selection-control: wrong-command-not-causal-${command_reason}")
  endif()
  set(wrong_argument_json "${clean_json}")
  string(JSON wrong_argument_json SET "${wrong_argument_json}" tests ${tracer_index}
    command 1 "\"ppu.blank\"")
  gbl_phase14_validate_selection("${wrong_argument_json}" argument_reason)
  if(NOT argument_reason STREQUAL "wrong-command")
    message(FATAL_ERROR
      "phase14-selection-control: wrong-argument-not-causal-${argument_reason}")
  endif()

  string(JSON tracer_properties LENGTH "${clean_json}" tests ${tracer_index} properties)
  set(labels_index -1)
  set(workdir_index -1)
  if(tracer_properties GREATER 0)
    math(EXPR tracer_property_last "${tracer_properties} - 1")
    foreach(property_index RANGE 0 ${tracer_property_last})
      string(JSON property_name GET "${clean_json}" tests ${tracer_index}
        properties ${property_index} name)
      if(property_name STREQUAL "LABELS")
        set(labels_index ${property_index})
      elseif(property_name STREQUAL "WORKING_DIRECTORY")
        set(workdir_index ${property_index})
      endif()
    endforeach()
  endif()
  if(labels_index EQUAL -1 OR workdir_index EQUAL -1)
    message(FATAL_ERROR "phase14-selection-control: clean-twin-missing-properties")
  endif()
  string(JSON wrong_labels_json SET "${clean_json}" tests ${tracer_index}
    properties ${labels_index} value 0 "\"wrong\"")
  gbl_phase14_validate_selection("${wrong_labels_json}" labels_reason)
  if(NOT labels_reason STREQUAL "wrong-label")
    message(FATAL_ERROR
      "phase14-selection-control: wrong-label-not-causal-${labels_reason}")
  endif()
  set(foreign_workdir "${scratch_root}/foreign-workdir")
  file(MAKE_DIRECTORY "${foreign_workdir}")
  string(JSON wrong_root_json SET "${clean_json}" tests ${tracer_index}
    properties ${workdir_index} value "\"${foreign_workdir}\"")
  gbl_phase14_validate_selection("${wrong_root_json}" root_reason)
  if(NOT root_reason STREQUAL "wrong-root")
    message(FATAL_ERROR
      "phase14-selection-control: wrong-root-not-causal-${root_reason}")
  endif()

  string(JSON test_json GET "${clean_json}" tests ${tracer_index})
  string(JSON property_count LENGTH "${test_json}" properties)
  string(JSON test_json SET "${test_json}" properties ${property_count}
    "{\"name\":\"SKIP_REGULAR_EXPRESSION\",\"value\":\"skip\"}")
  set(skipped_json "${clean_json}")
  string(JSON skipped_json SET "${skipped_json}" tests ${tracer_index} "${test_json}")
  gbl_phase14_validate_selection("${skipped_json}" skip_reason)
  if(NOT skip_reason STREQUAL "skippable")
    message(FATAL_ERROR
      "phase14-selection-control: skip-not-causal-${skip_reason}")
  endif()
  string(JSON test_json GET "${clean_json}" tests ${tracer_index})
  string(JSON property_count LENGTH "${test_json}" properties)
  string(JSON test_json SET "${test_json}" properties ${property_count}
    "{\"name\":\"DISABLED\",\"value\":true}")
  set(disabled_json "${clean_json}")
  string(JSON disabled_json SET "${disabled_json}" tests ${tracer_index} "${test_json}")
  gbl_phase14_validate_selection("${disabled_json}" disabled_reason)
  if(NOT disabled_reason STREQUAL "disabled")
    message(FATAL_ERROR
      "phase14-selection-control: disabled-not-causal-${disabled_reason}")
  endif()

  set(ci_inventory "${GBL_PHASE14_SRC}/tests/inventory/ci.txt")
  file(READ "${ci_inventory}" inventory_text)
  set(control_row "phase14.selection.control gate,ppu,time")
  string(REPLACE "${control_row}\n" "${control_row}\n${control_row}\n"
    duplicate_inventory "${inventory_text}")
  set(duplicate_inventory_path "${scratch_root}/duplicate-ci.txt")
  file(WRITE "${duplicate_inventory_path}" "${duplicate_inventory}")
  gbl_phase14_check_inventory("${duplicate_inventory_path}" ci inventory_reason)
  if(NOT inventory_reason STREQUAL
      "inventory-phase14.selection.control-count-2")
    message(FATAL_ERROR
      "phase14-selection-control: duplicate-inventory-not-causal-${inventory_reason}")
  endif()
  string(REPLACE "ppu.blank bus,core,integration,ppu"
    "ppu.blank bus,wrong,label" wrong_inventory "${inventory_text}")
  set(wrong_inventory_path "${scratch_root}/wrong-label-ci.txt")
  file(WRITE "${wrong_inventory_path}" "${wrong_inventory}")
  gbl_phase14_check_inventory("${wrong_inventory_path}" ci wrong_inventory_reason)
  if(NOT wrong_inventory_reason STREQUAL "inventory-ppu.blank-labels")
    message(FATAL_ERROR
      "phase14-selection-control: inventory-label-not-causal-${wrong_inventory_reason}")
  endif()
  string(REPLACE "${control_row}\n" "" missing_inventory "${inventory_text}")
  set(missing_inventory_path "${scratch_root}/missing-control-ci.txt")
  file(WRITE "${missing_inventory_path}" "${missing_inventory}")
  gbl_phase14_check_inventory("${missing_inventory_path}" ci missing_inventory_reason)
  if(NOT missing_inventory_reason STREQUAL
      "inventory-phase14.selection.control-count-0")
    message(FATAL_ERROR
      "phase14-selection-control: missing-inventory-not-causal-${missing_inventory_reason}")
  endif()

  set(foreign_src "${scratch_root}/foreign-source")
  file(MAKE_DIRECTORY "${foreign_src}")
  gbl_phase14_expect_invocation_rejection(foreign-source source-build-mismatch
    "${CMAKE_PROGRAM}" "-DSRC=${foreign_src}" "-DBIN=${GBL_PHASE14_BIN}"
    -DCASE=verify -P "${GBL_PHASE14_GATE}")
  set(foreign_gate "${scratch_root}/foreign-script/phase14_selection.cmake")
  get_filename_component(foreign_gate_dir "${foreign_gate}" DIRECTORY)
  file(MAKE_DIRECTORY "${foreign_gate_dir}")
  file(COPY_FILE "${GBL_PHASE14_GATE}" "${foreign_gate}")
  gbl_phase14_expect_invocation_rejection(foreign-script script-source-mismatch
    "${CMAKE_PROGRAM}" "-DSRC=${GBL_PHASE14_SRC}" "-DBIN=${GBL_PHASE14_BIN}"
    -DCASE=verify -P "${foreign_gate}")
  set(empty_build "${scratch_root}/empty-build")
  file(MAKE_DIRECTORY "${empty_build}")
  gbl_phase14_expect_invocation_rejection(empty-build build-cache-missing
    "${CMAKE_PROGRAM}" "-DSRC=${GBL_PHASE14_SRC}" "-DBIN=${empty_build}"
    -DCASE=verify -P "${GBL_PHASE14_GATE}")
  set(wrong_lane_build "${scratch_root}/wrong-lane-build")
  file(MAKE_DIRECTORY "${wrong_lane_build}")
  file(READ "${GBL_PHASE14_CACHE}" lane_cache)
  string(REPLACE "GBL_LANE:STRING=${GBL_PHASE14_LANE}"
    "GBL_LANE:STRING=unsupported" lane_cache "${lane_cache}")
  file(WRITE "${wrong_lane_build}/CMakeCache.txt" "${lane_cache}")
  gbl_phase14_expect_invocation_rejection(unsupported-lane unsupported-lane-unsupported
    "${CMAKE_PROGRAM}" "-DSRC=${GBL_PHASE14_SRC}"
    "-DBIN=${wrong_lane_build}" -DCASE=verify -P "${GBL_PHASE14_GATE}")

  gbl_phase14_find_test("${graph_json}" phase14.selection.verify verify_index verify_count)
  gbl_phase14_json_property("${graph_json}" ${verify_index} FIXTURES_REQUIRED
    required has_required)
  if(NOT verify_count EQUAL 1 OR NOT has_required OR
      NOT "phase14_fast" IN_LIST required)
    message(FATAL_ERROR "phase14-selection-control: scratch-gate-edge-missing")
  endif()
  string(JSON verify_properties LENGTH "${graph_json}" tests ${verify_index} properties)
  set(required_index -1)
  if(verify_properties GREATER 0)
    math(EXPR verify_property_last "${verify_properties} - 1")
    foreach(property_index RANGE 0 ${verify_property_last})
      string(JSON property_name GET "${graph_json}" tests ${verify_index}
        properties ${property_index} name)
      if(property_name STREQUAL "FIXTURES_REQUIRED")
        set(required_index ${property_index})
      endif()
    endforeach()
  endif()
  set(required_item_index -1)
  list(LENGTH required required_count)
  if(required_count GREATER 0)
    math(EXPR required_last "${required_count} - 1")
    foreach(required_item_index_candidate RANGE 0 ${required_last})
      list(GET required ${required_item_index_candidate} required_item)
      if(required_item STREQUAL "phase14_fast")
        set(required_item_index ${required_item_index_candidate})
        break()
      endif()
    endforeach()
  endif()
  if(required_index EQUAL -1 OR required_item_index EQUAL -1)
    message(FATAL_ERROR "phase14-selection-control: scratch-gate-edge-property-missing")
  endif()
  string(JSON missing_edge_json REMOVE "${graph_json}" tests ${verify_index}
    properties ${required_index} value ${required_item_index})
  gbl_phase14_validate_order("${missing_edge_json}" edge_reason)
  if(NOT edge_reason STREQUAL "missing-predecessor-phase14.selection.verify")
    message(FATAL_ERROR
      "phase14-selection-control: missing-edge-not-causal-${edge_reason}")
  endif()
  message(STATUS "phase14-selection-control: missing-order-edge: causal rejection ok")
  message(STATUS "phase14-selection-control: clean/mutant manifest, inventory and order controls passed")
endfunction()

function(gbl_phase14_check_order_graph)
  execute_process(
    COMMAND "${CTEST_PROGRAM}" --test-dir "${GBL_PHASE14_BIN}" --show-only=json-v1
    RESULT_VARIABLE result OUTPUT_VARIABLE json ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "phase14-order: discovery-failed: ${result}\n${error}")
  endif()
  gbl_phase14_validate_gate_registrations("${json}" gate_reason)
  if(NOT "${gate_reason}" STREQUAL "")
    message(FATAL_ERROR "phase14-order: ${gate_reason}")
  endif()
  gbl_phase14_validate_order("${json}" order_reason)
  if(NOT "${order_reason}" STREQUAL "")
    message(FATAL_ERROR "phase14-order: ${order_reason}")
  endif()
  message(STATUS "phase14-order: exact Phase 14 fixture graph passed")
endfunction()

if(CASE STREQUAL "manifest")
  list(LENGTH GBL_PHASE14_EXPECTED manifest_count)
  message("phase14-manifest-count=${manifest_count}")
  message("phase14-manifest-regex=${GBL_PHASE14_REGEX}")
  list(LENGTH GBL_PHASE14_INHERITED_PROFILE inherited_profile_count)
  message("phase14-manifest-inherited-count=${inherited_profile_count}")
  foreach(name IN LISTS GBL_PHASE14_EXPECTED)
    message("phase14-manifest-name=${name}")
  endforeach()
  foreach(name IN LISTS GBL_PHASE14_INHERITED_PROFILE)
    message("phase14-manifest-inherited-name=${name}")
  endforeach()
elseif(CASE STREQUAL "verify")
  foreach(lane IN ITEMS ci asan)
    gbl_phase14_check_inventory(
      "${GBL_PHASE14_SRC}/tests/inventory/${lane}.txt" "${lane}" inventory_reason)
    if(NOT "${inventory_reason}" STREQUAL "")
      message(FATAL_ERROR "phase14-selection: ${lane}-${inventory_reason}")
    endif()
  endforeach()
  gbl_phase14_discover("${GBL_PHASE14_BIN}" "${GBL_PHASE14_REGEX}" selected_json)
  gbl_phase14_validate_selection("${selected_json}" selection_reason)
  if(NOT "${selection_reason}" STREQUAL "")
    message(FATAL_ERROR "phase14-selection: ${selection_reason}")
  endif()
  gbl_phase14_discover("${GBL_PHASE14_BIN}"
    "^phase14[.]selection[.](control|verify|order)$" graph_json)
  gbl_phase14_validate_gate_registrations("${graph_json}" gate_reason)
  if(NOT "${gate_reason}" STREQUAL "")
    message(FATAL_ERROR "phase14-selection: ${gate_reason}")
  endif()
  message("TAP version 13")
  message("1..1")
  message("ok 1 - exact Phase 14 cheap selector fixture membership")
  message(STATUS "phase14-selection: exact 13-name selection and three gate registrations passed")
elseif(CASE STREQUAL "control")
  gbl_phase14_check_controls("${GBL_PHASE14_BIN}/phase14-selection-controls")
elseif(CASE STREQUAL "order")
  gbl_phase14_check_order_graph()
else()
  message(FATAL_ERROR "phase14-selection: invalid-case")
endif()
