cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS SRC BIN GROUP TOOLCHAIN_ROOT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "diagnostics-case: missing-${required}")
  endif()
endforeach()
get_filename_component(GBL_SOURCE_DIR "${SRC}" ABSOLUTE)
get_filename_component(GBL_OUTPUT_ROOT "${BIN}" ABSOLUTE)
set(GBL_ARTIFACT_ROOT "${GBL_OUTPUT_ROOT}")
set(GBL_PROOF_METADATA OFF)
set(generated "${GBL_OUTPUT_ROOT}/generated")
set(GBL_CONTROL_IMAGE "${generated}/fixtures/owned-arm-pass.gba")
set(GBL_CONTROL_FAIL_IMAGE "${generated}/fixtures/owned-arm-fail.gba")
set(GBL_CONTROL_SKIP_IMAGE "${generated}/fixtures/owned-arm-pass.gba")
set(GBL_CONTROL_ZERO_CASE_IMAGE "${generated}/fixtures/owned-arm-pass-zero-case.gba")
set(GBL_CONTROL_MANIFEST_OUTPUT "${generated}/control/manifest.json")
set(GBL_MANIFEST "${GBL_SOURCE_DIR}/tests/fixtures/manifest.json")
set(GBL_REGISTRY "${GBL_SOURCE_DIR}/registry/disputes.json")
set(GBL_VOCAB "${GBL_SOURCE_DIR}/contracts/evidence.json")
set(GBL_OUT_PRODUCTION "${generated}/production/fixture_index.h")
set(GBL_OUT_CONTROL "${generated}/control/fixture_index.h")

function(gbl_fixture_prepare_admitted_artifacts)
  set(source_root "${GBL_SOURCE_DIR}")
  set(binary_root "${GBL_OUTPUT_ROOT}")
  set(CASE all-admitted)
  include("${GBL_SOURCE_DIR}/tests/gates/prepare_diagnostic_artifacts.cmake")
endfunction()

# All canonical control/production/source/artifact/output checks still run in
# this entry point. Only the duplicate production manifest parse disappears.
include("${GBL_SOURCE_DIR}/cmake/GenerateFixtureIndex.cmake")
gbl_write_file_contained(write_status write_reason "${GBL_OUTPUT_ROOT}"
  "${generated}/diagnostics/prepared-${GROUP}.stamp" "current canonical admitted indexes\n")
if(NOT write_status STREQUAL "ok")
  message(FATAL_ERROR "diagnostics-case: prepared-stamp-${write_reason}")
endif()
