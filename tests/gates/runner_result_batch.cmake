cmake_minimum_required(VERSION 3.25)

# In-process reuse only: nothing is serialized for a later invocation. A file
# identity is checked before every use of the authority parsed from its bytes.
function(batch_bind key path)
  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
    message(FATAL_ERROR "runner-result-batch: authority-changed:${key}")
  endif()
  file(SHA256 "${path}" sha)
  set_property(GLOBAL PROPERTY "GBL_BATCH_PATH_${key}" "${path}")
  set_property(GLOBAL PROPERTY "GBL_BATCH_SHA_${key}" "${sha}")
endfunction()

function(batch_assert key)
  get_property(path GLOBAL PROPERTY "GBL_BATCH_PATH_${key}")
  get_property(bound GLOBAL PROPERTY "GBL_BATCH_SHA_${key}")
  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
    message(FATAL_ERROR "runner-result-batch: authority-changed:${key}")
  endif()
  file(SHA256 "${path}" sha)
  if(NOT sha STREQUAL bound)
    message(FATAL_ERROR "runner-result-batch: authority-changed:${key}")
  endif()
endfunction()

if(DEFINED CONTROL)
  file(MAKE_DIRECTORY "${CONTROL_ROOT}")
  set(path "${CONTROL_ROOT}/authority.json")
  file(REMOVE "${path}" "${path}.original")
  file(WRITE "${path}" "{}\n")
  batch_bind(control "${path}")
  batch_assert(control) # Clean companion uses exactly the same check.
  if(CONTROL STREQUAL "changed")
    file(APPEND "${path}" " ")
  elseif(CONTROL STREQUAL "replaced-by-symlink")
    file(RENAME "${path}" "${path}.original")
    file(CREATE_LINK "${path}.original" "${path}" SYMBOLIC)
  else()
    message(FATAL_ERROR "runner-result-batch: unknown-control")
  endif()
  batch_assert(control)
  message(FATAL_ERROR "runner-result-batch: control-did-not-refuse")
endif()

foreach(required IN ITEMS SRC REQUESTS)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "runner-result-batch: missing-${required}")
  endif()
endforeach()
include("${SRC}/cmake/CheckResult.cmake")
batch_bind(requests "${REQUESTS}")
batch_bind(vocab "${SRC}/contracts/evidence.json")
batch_bind(registry "${SRC}/registry/disputes.json")
gbl_contract_read(V "${SRC}/contracts/evidence.json")
gbl_registry_read(R "${SRC}/registry/disputes.json" V)
gbl_findings_finish(result "batch vocabulary and registry valid")
file(READ "${REQUESTS}" requests)
string(JSON count LENGTH "${requests}")
if(count LESS 1)
  message(FATAL_ERROR "runner-result-batch: empty-requests")
endif()
math(EXPR last "${count}-1")
foreach(index RANGE 0 ${last})
  batch_assert(requests)
  batch_assert(vocab)
  batch_assert(registry)
  foreach(key IN ITEMS name path manifest)
    string(JSON ${key} GET "${requests}" ${index} ${key})
  endforeach()
  if(NOT name MATCHES "^[a-z0-9-]+$")
    message(FATAL_ERROR "runner-result-batch: invalid-name")
  endif()
  string(SHA256 identity "${manifest}")
  set(prefix "M_${identity}")
  if(NOT DEFINED ${prefix}_IDS)
    batch_bind("${identity}" "${manifest}")
    gbl_manifest_read("${prefix}" "${manifest}" R V)
    gbl_findings_finish(result "batch manifest valid")
    list(APPEND manifests "${identity}")
  endif()
  batch_assert("${identity}")
  set_property(GLOBAL PROPERTY GBL_FINDINGS 0)
  message("runner-result-batch: begin:${name}")
  gbl_result_check("${path}" "${prefix}" R V)
  get_property(findings GLOBAL PROPERTY GBL_FINDINGS)
  message("runner-result-batch: end:${name}:${findings}")
  set_property(GLOBAL PROPERTY GBL_FINDINGS 0)
endforeach()
batch_assert(requests)
batch_assert(vocab)
batch_assert(registry)
foreach(identity IN LISTS manifests)
  batch_assert("${identity}")
endforeach()
