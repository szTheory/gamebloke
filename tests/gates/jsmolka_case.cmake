function(jsmolka_binding_reason out expected_revision expected_digest
    expected_address expected_state expected_register actual_revision
    actual_digest actual_address actual_state actual_register)
  set(reason "")
  if(NOT "${actual_revision}" STREQUAL "${expected_revision}")
    set(reason "revision-mismatch")
  elseif(NOT "${actual_digest}" STREQUAL "${expected_digest}")
    set(reason "digest-mismatch")
  elseif(NOT "${actual_address}" STREQUAL "${expected_address}")
    set(reason "address-mismatch")
  elseif(NOT "${actual_state}" STREQUAL "${expected_state}")
    set(reason "state-mismatch")
  elseif(NOT "${actual_register}" STREQUAL "${expected_register}")
    set(reason "register-mismatch")
  endif()
  set(${out} "${reason}" PARENT_SCOPE)
endfunction()

function(jsmolka_cache_rows document)
  string(JSON count LENGTH "${document}" fixtures)
  if(count GREATER 0)
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
      string(JSON row_id GET "${document}" fixtures ${index} id)
      if(row_id MATCHES "^jsmolka-(arm|thumb|memory|bios)(-source)?$")
        string(JSON row GET "${document}" fixtures ${index})
        set_property(GLOBAL PROPERTY "gbl_jsmolka_row_${row_id}" "${row}")
      endif()
    endforeach()
  endif()
  set_property(GLOBAL PROPERTY gbl_jsmolka_rows_cached TRUE)
endfunction()

function(jsmolka_find_row out id)
  get_property(cache_loaded GLOBAL PROPERTY gbl_jsmolka_rows_cached)
  if(NOT cache_loaded)
    file(READ "${manifest}" document)
    jsmolka_cache_rows("${document}")
  endif()
  get_property(found GLOBAL PROPERTY "gbl_jsmolka_row_${id}")
  if(found STREQUAL "")
    message(FATAL_ERROR "jsmolka: manifest-row-missing:${id}")
  endif()
  set(${out} "${found}" PARENT_SCOPE)
endfunction()

function(jsmolka_expect_string row label expected)
  string(JSON actual ERROR_VARIABLE json_error GET "${row}" ${ARGN})
  if(NOT json_error STREQUAL "NOTFOUND" OR NOT actual STREQUAL expected)
    message(FATAL_ERROR "jsmolka: binding-${label}: expected '${expected}', got '${actual}'")
  endif()
endfunction()

function(jsmolka_check_metadata require_binaries)
  file(READ "${manifest}" manifest_text)
  file(READ "${pins}" pins_text)
  file(READ "${audit}" audit_text)
  jsmolka_cache_rows("${manifest_text}")
  if(manifest_text STREQUAL "" OR pins_text STREQUAL "" OR audit_text STREQUAL "")
    message(FATAL_ERROR "jsmolka: source-binding-input-missing")
  endif()
  if(NOT audit_text MATCHES "${commit}" OR
      NOT audit_text MATCHES "redistribution grant" OR
      NOT audit_text MATCHES "before executing the first `m_vsync` instruction")
    message(FATAL_ERROR "jsmolka: source-audit-incomplete")
  endif()
  if(audit_text MATCHES "0x24,0xFF,0xAE,0x51")
    message(FATAL_ERROR "jsmolka: source-audit-contains-content-bytes")
  endif()

  foreach(source_file IN ITEMS
      "arm/arm.asm" "arm/data_processing.asm"
      "thumb/thumb.asm" "thumb/memory.asm" "memory/memory.asm"
      "lib/macros.inc" "lib/text.asm" "lib/header.asm" "LICENSE")
    string(FIND "${audit_text}" "`${source_file}`" audit_source_path)
    if(audit_source_path EQUAL -1)
      message(FATAL_ERROR "jsmolka: source-path-not-recorded:${source_file}")
    endif()
  endforeach()
  foreach(source_binding IN ITEMS
      "arm/data_processing.asm|19fa7c26807bf83dababe46c76b120bc0f20adbb6c7fbf60fd900c6391698a0d"
      "thumb/memory.asm|250b5b0e4a616f2b836d8fe525df4092936a5992f8b2143c7784cdbe42a84e03")
    string(REPLACE "|" ";" source_binding_fields "${source_binding}")
    list(GET source_binding_fields 0 source_path)
    list(GET source_binding_fields 1 source_digest)
    string(FIND "${audit_text}" "| `${source_path}` | `${source_digest}` |"
      audit_source_binding)
    if(audit_source_binding EQUAL -1)
      message(FATAL_ERROR "jsmolka: source-digest-not-bound:${source_path}")
    endif()
  endforeach()

  foreach(index RANGE 0 2)
    list(GET ids ${index} id)
    list(GET source_ids ${index} source_id)
    list(GET source_paths ${index} source_path)
    list(GET rom_names ${index} rom_name)
    list(GET rom_sha256 ${index} source_digest)
    list(GET derived_sha256 ${index} derived_digest)
    list(GET addresses ${index} address)
    list(GET registers ${index} register)
    list(GET destinations ${index} destination)
    set(url "${pin_prefix}${source_path}")
    string(REGEX REPLACE "\\.asm$" ".gba" rom_path "${source_path}")
    set(expected_pin "${source_digest} ${pin_prefix}${rom_path} ${destination}")
    string(FIND "${pins_text}" "${expected_pin}" pin_position)
    if(pin_position EQUAL -1)
      message(FATAL_ERROR "jsmolka: pin-binding-mismatch:${source_id}")
    endif()

    jsmolka_find_row(source_row "${source_id}")
    jsmolka_expect_string("${source_row}" input-source-kind url source kind)
    jsmolka_expect_string("${source_row}" input-source-url "${pin_prefix}${rom_path}" source url)
    jsmolka_expect_string("${source_row}" input-source-digest "${source_digest}" source sha256)
    jsmolka_expect_string("${source_row}" input-license MIT license spdx)
    jsmolka_expect_string("${source_row}" input-redistribution no license redistributable)
    jsmolka_expect_string("${source_row}" input-notice tests/fixtures/jsmolka-NOTICE.md license notices 0)
    jsmolka_expect_string("${source_row}" input-local-use local-only permitted_use 0)
    jsmolka_expect_string("${source_row}" input-destination "${destination}" fetch pin_dest)
    string(JSON source_channel_type ERROR_VARIABLE source_channel_error
      TYPE "${source_row}" result_channel)
    if(source_channel_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR "jsmolka: raw-input-has-result-channel:${source_id}")
    endif()

    jsmolka_find_row(row "${id}")
    jsmolka_expect_string("${row}" derived-source-kind git source kind)
    jsmolka_expect_string("${row}" derived-source-url https://github.com/jsmolka/gba-tests source url)
    jsmolka_expect_string("${row}" derived-source-commit "${commit}" source commit)
    jsmolka_expect_string("${row}" license MIT license spdx)
    jsmolka_expect_string("${row}" redistribution no license redistributable)
    jsmolka_expect_string("${row}" notice tests/fixtures/jsmolka-NOTICE.md license notices 0)
    jsmolka_expect_string("${row}" local-use local-only permitted_use 0)
    jsmolka_expect_string("${row}" bios none bios_requirement)
    jsmolka_expect_string("${row}" provenance suite-self-checking expected provenance_class)
    jsmolka_expect_string("${row}" channel register-eval result_channel kind)
    jsmolka_expect_string("${row}" channel-revision "${commit}" result_channel source_commit)
    jsmolka_expect_string("${row}" channel-source "${source_path}" result_channel source_path)
    jsmolka_expect_string("${row}" channel-address "${address}" result_channel entry_address)
    jsmolka_expect_string("${row}" channel-state arm result_channel instruction_set)
    jsmolka_expect_string("${row}" artifact-path "generated/local-cpu-suites/${id}.gba" build artifact path)
    jsmolka_expect_string("${row}" artifact-digest "${derived_digest}" build artifact sha256)
    string(JSON actual_register GET "${row}" result_channel register_index)
    if(NOT actual_register STREQUAL register)
      message(FATAL_ERROR "jsmolka: binding-register-mismatch:${id}")
    endif()
    string(JSON use_count LENGTH "${row}" permitted_use)
    string(JSON channel_type TYPE "${row}" result_channel)
    string(JSON derived_fetch_type ERROR_VARIABLE derived_fetch_error
      TYPE "${row}" fetch)
    if(NOT use_count EQUAL 1 OR NOT channel_type STREQUAL "OBJECT" OR
        derived_fetch_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR "jsmolka: derived-binding-shape-invalid:${id}")
    endif()

    foreach(evidence IN ITEMS "${source_digest}" "${derived_digest}"
        "${address}" "ARM" "R${register}")
      string(FIND "${audit_text}" "${evidence}" evidence_position)
      if(evidence_position EQUAL -1)
        message(FATAL_ERROR "jsmolka: audit-binding-missing:${id}:${evidence}")
      endif()
    endforeach()

    if(require_binaries)
      set(local_rom "${SRC}/.fixtures/${destination}")
      if(NOT EXISTS "${local_rom}" OR IS_DIRECTORY "${local_rom}" OR IS_SYMLINK "${local_rom}")
        message(FATAL_ERROR "jsmolka: missing-rom:${source_id}")
      endif()
      file(SHA256 "${local_rom}" actual_source_digest)
      if(NOT actual_source_digest STREQUAL source_digest)
        message(FATAL_ERROR "jsmolka: binary-digest-mismatch:${source_id}")
      endif()
      list(GET offsets ${index} offset)
      file(READ "${local_rom}" actual_entry_bytes HEX LIMIT 32 OFFSET ${offset})
      string(TOLOWER "${actual_entry_bytes}" actual_entry_bytes)
      if(NOT actual_entry_bytes STREQUAL entry_bytes)
        message(FATAL_ERROR "jsmolka: binary-entry-opcode-mismatch:${source_id}")
      endif()
      string(FIND "${audit_text}" "${rom_name}" audit_rom_name)
      if(audit_rom_name EQUAL -1)
        message(FATAL_ERROR "jsmolka: binary-source-path-not-recorded:${source_id}")
      endif()

      set(derived_rom "${BIN}/generated/local-cpu-suites/${id}.gba")
      if(NOT EXISTS "${derived_rom}" OR IS_DIRECTORY "${derived_rom}" OR IS_SYMLINK "${derived_rom}")
        message(FATAL_ERROR "jsmolka: missing-derived-rom:${id}")
      endif()
      file(SHA256 "${derived_rom}" actual_derived_digest)
      if(NOT actual_derived_digest STREQUAL derived_digest)
        message(FATAL_ERROR "jsmolka: derived-binary-digest-mismatch:${id}")
      endif()
      file(READ "${derived_rom}" actual_branch HEX LIMIT 4 OFFSET 0)
      file(READ "${derived_rom}" actual_bootstrap HEX LIMIT 8 OFFSET 184)
      string(TOLOWER "${actual_branch}" actual_branch)
      string(TOLOWER "${actual_bootstrap}" actual_bootstrap)
      if(NOT actual_branch STREQUAL "2c0000ea" OR
          NOT actual_bootstrap STREQUAL "03d4a0e37fdc8de3")
        message(FATAL_ERROR "jsmolka: derived-bootstrap-mismatch:${id}")
      endif()
      file(READ "${local_rom}" source_logo HEX LIMIT 156 OFFSET 4)
      file(READ "${derived_rom}" derived_logo HEX LIMIT 156 OFFSET 4)
      string(TOLOWER "${source_logo}" source_logo)
      string(TOLOWER "${derived_logo}" derived_logo)
      if(NOT source_logo STREQUAL derived_logo)
        message(FATAL_ERROR "jsmolka: derived-logo-changed:${id}")
      endif()
    endif()

    jsmolka_binding_reason(reason "${commit}" "${derived_digest}" "${address}" arm
      "${register}" "${commit}" "${derived_digest}" "${address}" arm "${register}")
    if(NOT reason STREQUAL "")
      message(FATAL_ERROR "jsmolka: binding-${reason}:${id}")
    endif()
  endforeach()

  jsmolka_find_row(bios_row jsmolka-bios)
  jsmolka_expect_string("${bios_row}" bios-url
    "${pin_prefix}bios/bios.gba" source url)
  jsmolka_expect_string("${bios_row}" bios-digest
    9d7b369fa1aa661ff03692b3d79c6f644b623d72983d0fc890e6d87a0409a3c9 source sha256)
  jsmolka_expect_string("${bios_row}" bios-requirement user-official bios_requirement)
  string(JSON bios_fetch_type ERROR_VARIABLE bios_fetch_error
    TYPE "${bios_row}" fetch)
  if(bios_fetch_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "jsmolka: bios-fetch-path-present")
  endif()
  string(FIND "${pins_text}" "bios/bios.gba" bios_pin_position)
  if(NOT bios_pin_position EQUAL -1)
    message(FATAL_ERROR "jsmolka: bios-fetch-pin-present")
  endif()
endfunction()

