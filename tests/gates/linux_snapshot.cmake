cmake_minimum_required(VERSION 3.25)
foreach(arg IN ITEMS SRC BIN)
  if(NOT DEFINED ${arg} OR "${${arg}}" STREQUAL "")
    message(FATAL_ERROR "linux-snapshot: missing-${arg}")
  endif()
endforeach()
get_filename_component(SRC "${SRC}" ABSOLUTE)
get_filename_component(BIN "${BIN}" ABSOLUTE)
include("${SRC}/cmake/PathContainment.cmake")
gbl_resolve_contained_path(safe_bin bin_status "${SRC}/build" "${BIN}")
if(NOT bin_status STREQUAL "ok" OR BIN STREQUAL "${SRC}/build")
  message(FATAL_ERROR "linux-snapshot: unsafe-root")
endif()
if(NOT DEFINED CASE)
  set(CASE all)
endif()
if(NOT CASE MATCHES "^(all|history-mutant|privacy-mutant|mode-mutant|signal-mutant|cleanup-mutant)$")
  message(FATAL_ERROR "linux-snapshot: unknown-case")
endif()
set(root "${BIN}/linux-snapshot-${CASE}")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}/repo/scripts" "${root}/bin" "${root}/tmp")
set(repo "${root}/repo")
file(READ "${SRC}/scripts/linux-lane.sh" helper)
if(CASE STREQUAL "history-mutant")
  string(REPLACE "--quiet --no-hardlinks" "--quiet --no-local --depth 1" helper "${helper}")
elseif(CASE STREQUAL "privacy-mutant")
  string(REPLACE "-v \"$snapshot/source\":/src:ro" "-v \"$root\":/src:ro" helper "${helper}")
elseif(CASE STREQUAL "mode-mutant")
  string(REPLACE "git -c core.filemode=true -C" "git -C" helper "${helper}")
elseif(CASE STREQUAL "signal-mutant")
  string(REPLACE "trap 'exit 130' INT" "trap ':' INT" helper "${helper}")
elseif(CASE STREQUAL "cleanup-mutant")
  string(REPLACE "trap 'rm -rf \"$snapshot\"' EXIT" ": # omitted cleanup" helper "${helper}")
endif()
file(WRITE "${repo}/scripts/linux-lane.sh" "${helper}")
file(WRITE "${repo}/.gitignore" "/private/\n/build*/\n")
file(WRITE "${repo}/tracked.txt" "committed\n")
file(WRITE "${repo}/deleted.txt" "delete-me\n")
file(WRITE "${repo}/mode.sh" "synthetic-mode\n")
file(CHMOD "${repo}/mode.sh" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
file(WRITE "${repo}/ancestor-only.txt" "original-ancestor-bytes\n")
function(fixture_git)
  execute_process(COMMAND git -c core.hooksPath=/dev/null -c commit.gpgsign=false
    -C "${repo}" ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "linux-snapshot: fixture-git:${out}${err}")
  endif()
  string(STRIP "${out}" out)
  set(git_output "${out}" PARENT_SCOPE)
endfunction()
fixture_git(init -q)
fixture_git(config user.name "Synthetic control")
fixture_git(config user.email "controls@example.com")
fixture_git(add .gitignore scripts/linux-lane.sh tracked.txt deleted.txt mode.sh ancestor-only.txt)
fixture_git(commit -qm root)
fixture_git(rev-parse HEAD)
set(base "${git_output}")
file(REMOVE "${repo}/ancestor-only.txt")
fixture_git(add -u ancestor-only.txt)
fixture_git(commit -qm second)
fixture_git(rev-parse HEAD)
set(head "${git_output}")
fixture_git(config core.filemode false)
file(WRITE "${repo}/tracked.txt" "working-edit\n")
file(REMOVE "${repo}/deleted.txt")
file(CHMOD "${repo}/mode.sh" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ WORLD_READ)
file(WRITE "${repo}/untracked name.txt" "unignored-new-file\n")
file(MAKE_DIRECTORY "${repo}/private/owner-roms" "${repo}/build-old")
file(WRITE "${repo}/private/owner-roms/sentinel.txt" "synthetic-private-stand-in\n")
file(WRITE "${repo}/build-old/sentinel.txt" "synthetic-build-stand-in\n")
file(CREATE_LINK private/owner-roms/sentinel.txt "${repo}/dangling-owned-link" SYMBOLIC)
file(COPY_FILE "${SRC}/tests/gates/linux_snapshot_docker.sh" "${root}/bin/docker")
file(CHMOD "${root}/bin/docker" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
set(actions success failure HUP INT TERM)
if(CASE MATCHES "^(history|privacy|mode|cleanup)-mutant$")
  set(actions success)
elseif(CASE STREQUAL "signal-mutant")
  set(actions INT)
endif()
foreach(action IN LISTS actions)
  set(mount_file "${root}/${action}.mount")
  set(pid_file "${root}/${action}.pid")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env
    "PATH=${root}/bin:$ENV{PATH}" "TMPDIR=${root}/tmp"
    --unset=GBL_LINUX_IMAGE "GBL_STUB_ACTION=${action}" "GBL_STUB_MOUNT=${mount_file}"
    "GBL_STUB_PID=${pid_file}" "GBL_STUB_HEAD=${head}" "GBL_STUB_BASE=${base}"
    "GBL_TEST_HELPER=${repo}/scripts/linux-lane.sh"
    sh -c "printf '%s\\n' \"$$\" > \"$GBL_STUB_PID\"; exec sh \"$GBL_TEST_HELPER\" ci gcc"
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
  file(WRITE "${root}/${action}.log" "${output}${error}")
  set(expected 0)
  if(action STREQUAL "failure")
    set(expected 37)
  elseif(action STREQUAL "HUP")
    set(expected 129)
  elseif(action STREQUAL "INT")
    set(expected 130)
  elseif(action STREQUAL "TERM")
    set(expected 143)
  endif()
  if(NOT "${rc}" STREQUAL "${expected}")
    message(FATAL_ERROR "linux-snapshot: exit-mismatch:${action}:got=${rc}:expected=${expected}:${output}${error}")
  endif()
  if(NOT EXISTS "${mount_file}")
    message(FATAL_ERROR "linux-snapshot: Docker witness did not run")
  endif()
  file(STRINGS "${mount_file}" mounted)
  file(GLOB leftovers "${root}/tmp/gamebloke-linux-lane.*")
  if(EXISTS "${mounted}" OR leftovers)
    message(FATAL_ERROR "linux-snapshot: cleanup-missing:${action}")
  endif()
endforeach()
if(CASE STREQUAL "all")
  foreach(pair IN ITEMS "history|history-depth" "privacy|ignored-content" "mode|working-mode"
      "signal|exit-mismatch:INT:got=0" "cleanup|cleanup-missing:success")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 mutant)
    list(GET parts 1 expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSRC=${SRC}" "-DBIN=${BIN}"
      "-DCASE=${mutant}-mutant" -P "${SRC}/tests/gates/linux_snapshot.cmake"
      RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
    file(WRITE "${root}/${mutant}-control.log" "${output}${error}")
    if(rc STREQUAL "0" OR NOT "${output}${error}" MATCHES "${expected}")
      message(FATAL_ERROR "linux-snapshot: mutant-not-detected:${mutant}:${output}${error}")
    endif()
    if(mutant STREQUAL "cleanup")
      # The negative deliberately leaks only its synthetic snapshot. Preserve
      # its failure log, then remove that owned stand-in after observing it.
      file(REMOVE_RECURSE "${BIN}/linux-snapshot-cleanup-mutant/tmp")
    endif()
  endforeach()
endif()
message(STATUS "linux-snapshot: passed synthetic privacy/working-tree/full-history/arguments/cleanup/signals and meaningful mutation controls")
