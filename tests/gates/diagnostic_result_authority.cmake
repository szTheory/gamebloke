cmake_minimum_required(VERSION 3.25)
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/CheckResult.cmake")

# The setup and its included observation consumers inherit the parsed prefixes
# in one CMake invocation. No persisted cache or alternate parser is involved.
# Bind every authority file and refuse changes before reusing those prefixes.
macro(gbl_diagnostic_result_authority source)
  get_property(_bound_source GLOBAL PROPERTY GBL_DIAGNOSTIC_RESULT_SOURCE)
  if(_bound_source AND NOT _bound_source STREQUAL "${source}")
    message(FATAL_ERROR "diagnostic-authority: source-changed")
  endif()
  foreach(_file IN ITEMS contracts/evidence.json registry/disputes.json tests/fixtures/manifest.json)
    if(NOT EXISTS "${source}/${_file}" OR IS_DIRECTORY "${source}/${_file}" OR
       IS_SYMLINK "${source}/${_file}")
      message(FATAL_ERROR "diagnostic-authority: changed:${_file}")
    endif()
    file(SHA256 "${source}/${_file}" _sha)
    get_property(_bound_sha GLOBAL PROPERTY "GBL_DIAGNOSTIC_RESULT_SHA_${_file}")
    if(_bound_source AND NOT _bound_sha STREQUAL _sha)
      message(FATAL_ERROR "diagnostic-authority: changed:${_file}")
    endif()
    set_property(GLOBAL PROPERTY "GBL_DIAGNOSTIC_RESULT_SHA_${_file}" "${_sha}")
  endforeach()
  if(NOT _bound_source)
    gbl_contract_read(V "${source}/contracts/evidence.json")
    gbl_registry_read(R "${source}/registry/disputes.json" V)
    gbl_manifest_read(M "${source}/tests/fixtures/manifest.json" R V)
    gbl_findings_finish(result "raw execution refusal authority valid")
    set_property(GLOBAL PROPERTY GBL_DIAGNOSTIC_RESULT_SOURCE "${source}")
  elseif(NOT DEFINED M_IDS OR NOT DEFINED R_IDS)
    message(FATAL_ERROR "diagnostic-authority: parsed-scope-missing")
  endif()
endmacro()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  if(NOT DEFINED CONTROL OR NOT DEFINED CONTROL_ROOT OR NOT DEFINED SRC)
    message(FATAL_ERROR "diagnostic-authority: control-usage")
  endif()
  file(REMOVE "${CONTROL_ROOT}/tests/fixtures/manifest.json"
    "${CONTROL_ROOT}/tests/fixtures/manifest.json.original")
  file(MAKE_DIRECTORY "${CONTROL_ROOT}/tests/fixtures" "${CONTROL_ROOT}/contracts"
    "${CONTROL_ROOT}/registry")
  file(COPY_FILE "${SRC}/contracts/examples/manifest.json" "${CONTROL_ROOT}/tests/fixtures/manifest.json")
  file(COPY_FILE "${SRC}/contracts/evidence.json" "${CONTROL_ROOT}/contracts/evidence.json")
  file(COPY_FILE "${SRC}/registry/disputes.json" "${CONTROL_ROOT}/registry/disputes.json")
  gbl_diagnostic_result_authority("${CONTROL_ROOT}")
  gbl_diagnostic_result_authority("${CONTROL_ROOT}") # Actual unchanged reuse.
  set(path "${CONTROL_ROOT}/tests/fixtures/manifest.json")
  if(CONTROL STREQUAL "registry")
    set(path "${CONTROL_ROOT}/registry/disputes.json")
  elseif(CONTROL STREQUAL "vocab")
    set(path "${CONTROL_ROOT}/contracts/evidence.json")
  endif()
  if(CONTROL STREQUAL "symlink")
    file(RENAME "${path}" "${path}.original")
    file(CREATE_LINK "${path}.original" "${path}" SYMBOLIC)
  else()
    file(APPEND "${path}" " ")
  endif()
  gbl_diagnostic_result_authority("${CONTROL_ROOT}")
  message(FATAL_ERROR "diagnostic-authority: mutation-not-refused")
endif()
