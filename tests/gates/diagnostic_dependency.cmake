cmake_minimum_required(VERSION 3.25)

foreach(required IN ITEMS CASE SRC BIN)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "diagnostic-dependency: missing-${required}")
  endif()
endforeach()
get_filename_component(SRC "${SRC}" ABSOLUTE)
get_filename_component(BIN "${BIN}" ABSOLUTE)
include("${SRC}/cmake/DiagnosticMatrix.cmake")
include("${SRC}/cmake/PathContainment.cmake")
set(build_root "${SRC}/build")
gbl_resolve_contained_path(safe_bin bin_status "${build_root}" "${BIN}")
if(NOT bin_status STREQUAL "ok" OR BIN STREQUAL build_root)
  message(FATAL_ERROR "diagnostic-dependency: unsafe-control-root")
endif()
file(MAKE_DIRECTORY "${BIN}")
if(NOT DEFINED HOST)
  execute_process(COMMAND uname -s OUTPUT_VARIABLE system OUTPUT_STRIP_TRAILING_WHITESPACE)
  execute_process(COMMAND uname -m OUTPUT_VARIABLE machine OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(system STREQUAL "Darwin" AND machine MATCHES "^(arm64|aarch64)$")
    set(HOST darwin-arm64)
  elseif(system STREQUAL "Linux" AND machine MATCHES "^(x86_64|amd64)$")
    set(HOST linux-x64)
  elseif(system STREQUAL "Linux" AND machine MATCHES "^(aarch64|arm64)$")
    set(HOST linux-arm64)
  else()
    message(FATAL_ERROR "diagnostic-dependency: unsupported-host")
  endif()
endif()

if(CASE STREQUAL "tool-probe")
  gbl_diagnostic_tool("${SRC}" "${TOOLCHAIN_ROOT}" "${HOST}" "${REQUIRED}" tools)
  if(tools STREQUAL "absent")
    message("SKIPPED: arm-toolchain-absent")
  else()
    message(STATUS "diagnostic-dependency: real pinned tool available")
  endif()
  return()
endif()

if(CASE STREQUAL "mandatory-final")
  file(READ "${BIN}/diagnostic-execution/run.json" run)
  foreach(field IN ITEMS token group stage)
    string(JSON ${field} GET "${run}" ${field})
  endforeach()
  execute_process(COMMAND "${CMAKE_COMMAND}" -DCASE=guard
    "-DSRC=${SRC}" "-DBIN=${BIN}" "-DTOKEN=${token}" "-DGROUP=${group}"
    "-DSTAGE=${stage}" -DREQUIRED=ON -DREQUIRED_ADMITTED=ON
    -P "${SRC}/tests/gates/diagnostic_receipt.cmake"
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "diagnostic-dependency: mandatory-final-refused:${output}${error}")
  endif()
  include("${SRC}/tests/gates/diagnostic_hosted_log.cmake")
  message(STATUS "diagnostic-dependency: mandatory final admitted execution verified")
  return()
endif()

if(CASE STREQUAL "all")
  set(root "${BIN}/diagnostic-dependency-controls")
  gbl_resolve_contained_path(control_real control_status "${BIN}" "${root}")
  if(NOT control_status STREQUAL "ok" OR NOT control_real STREQUAL root)
    message(FATAL_ERROR "diagnostic-dependency: control-root-${control_status}")
  endif()
  file(REMOVE_RECURSE "${root}")
  file(MAKE_DIRECTORY "${root}")
  set(absent "${root}/absent-tools")
  function(tool_control label tool_root required expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" -DCASE=tool-probe "-DSRC=${SRC}"
      "-DBIN=${BIN}" "-DHOST=${HOST}" "-DTOOLCHAIN_ROOT=${tool_root}"
      "-DREQUIRED=${required}" -P "${SRC}/tests/gates/diagnostic_dependency.cmake"
      RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${root}/${label}.log" "${output}${error}")
    if(expected STREQUAL "SKIPPED: arm-toolchain-absent")
      if(NOT rc STREQUAL "0" OR NOT "${output}${error}" MATCHES "${expected}")
        message(FATAL_ERROR "diagnostic-dependency: optional-absence-control-failed:${output}${error}")
      endif()
    elseif(rc STREQUAL "0" OR NOT "${output}${error}" MATCHES "${expected}" OR
        "${output}${error}" MATCHES "SKIPPED:")
      message(FATAL_ERROR "diagnostic-dependency: tool-refusal-control-failed:${label}:${output}${error}")
    endif()
  endfunction()
  tool_control(optional-absent "${absent}" OFF "SKIPPED: arm-toolchain-absent")
  tool_control(required-absent "${absent}" ON "required-arm-toolchain-absent")
  set(unusable "${root}/unusable-tools")
  set(install "${unusable}/arm-none-eabi/${HOST}-15.2.1-1.1")
  file(MAKE_DIRECTORY "${install}/bin")
  file(STRINGS "${SRC}/toolchain/arm-none-eabi.lock" lock REGEX "^${HOST} ")
  string(REPLACE " " ";" lock "${lock}")
  list(GET lock 1 bytes)
  list(GET lock 2 sha)
  set(receipt "\"host\": \"${HOST}\",\n\"release\": \"15.2.1-1.1\",\n\"archive_bytes\": ${bytes},\n\"archive_sha256\": \"${sha}\",\n\"archive_root\": \"xpack-arm-none-eabi-gcc-15.2.1-1.1\"\n")
  file(WRITE "${install}/install.json" "${receipt}")
  tool_control(present-unusable "${unusable}" OFF "assembler-missing")
  file(WRITE "${install}/install.json" "wrong host receipt\n")
  tool_control(required-wrong-host "${unusable}" ON "receipt-host-mismatch")
  file(WRITE "${install}/install.json" "${receipt}")
  foreach(tool IN ITEMS as readelf gcc)
    file(WRITE "${install}/bin/arm-none-eabi-${tool}" "#!/bin/sh\nexit 57\n")
    file(CHMOD "${install}/bin/arm-none-eabi-${tool}"
      PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  endforeach()
  tool_control(present-unusable-compiler "${unusable}" OFF "gcc-version-mismatch")
  # Exercise the actual CTest skip mechanism and strict inventory post-check.
  set(project "${root}/optional-ctest")
  file(MAKE_DIRECTORY "${project}/tests/inventory" "${project}/scripts")
  file(COPY_FILE "${SRC}/scripts/check-junit.sh" "${project}/scripts/check-junit.sh")
  file(WRITE "${project}/tests/inventory/optional.txt"
    "dependency.optional control,diagnostics skip-ok\ninventory.junit post\n")
  file(WRITE "${project}/CMakeLists.txt"
    "cmake_minimum_required(VERSION 3.25)\nproject(optional_dependency NONE)\nenable_testing()\nset(GBL_LANE optional)\ninclude(\"${SRC}/cmake/GblTests.cmake\")\ngbl_add_test(NAME dependency.optional LABELS control diagnostics SKIPPABLE COMMAND \"${CMAKE_COMMAND}\" -DCASE=tool-probe -DSRC=${SRC} -DBIN=${BIN} -DHOST=${HOST} -DTOOLCHAIN_ROOT=${absent} -DREQUIRED=OFF -P \"${SRC}/tests/gates/diagnostic_dependency.cmake\")\ninclude(\"${SRC}/cmake/DiagnosticSkip.cmake\")\ngbl_diagnostic_skip(dependency.optional OFF)\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${project}" -B "${project}/build"
    RESULT_VARIABLE configure_rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT configure_rc STREQUAL "0")
    message(FATAL_ERROR "diagnostic-dependency: optional-ctest-setup-failed:${output}${error}")
  endif()
  execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${project}/build"
    -LE "^post$" --output-junit junit.xml
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  file(READ "${project}/build/junit.xml" junit)
  if(NOT rc STREQUAL "0" OR NOT junit MATCHES "<skipped" OR
     NOT junit MATCHES "SKIPPED: arm-toolchain-absent")
    message(FATAL_ERROR "diagnostic-dependency: optional-skip-not-visible-in-junit:${output}${error}${junit}")
  endif()
  execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${project}/build"
    -L "^post$" --output-on-failure RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "diagnostic-dependency: optional-inventory-reconciliation-failed:${output}${error}")
  endif()
  # A forwarded marker in a failing CMake process must never become an allowed
  # skip. Use the real registration helper and inspect CTest's actual JUnit.
  set(marker_project "${root}/marker-ctest")
  file(MAKE_DIRECTORY "${marker_project}/tests/inventory" "${marker_project}/scripts")
  file(COPY_FILE "${SRC}/scripts/check-junit.sh" "${marker_project}/scripts/check-junit.sh")
  file(WRITE "${marker_project}/tests/inventory/marker.txt"
    "dependency.embedded control,diagnostics skip-ok\ndependency.marker control,diagnostics skip-ok\ndependency.optional control,diagnostics skip-ok\ninventory.junit post\n")
  file(WRITE "${marker_project}/marker.cmake"
    "message(\"SKIPPED: arm-toolchain-absent\")\nmessage(FATAL_ERROR \"actual downstream failure\")\n")
  file(WRITE "${marker_project}/embedded.cmake"
    "message(FATAL_ERROR \"tool failed: SKIPPED: arm-toolchain-absent\")\n")
  file(WRITE "${marker_project}/CMakeLists.txt"
    "cmake_minimum_required(VERSION 3.25)\nproject(marker_dependency NONE)\nenable_testing()\nset(GBL_LANE marker)\ninclude(\"${SRC}/cmake/GblTests.cmake\")\n"
    "gbl_add_test(NAME dependency.optional LABELS control diagnostics SKIPPABLE COMMAND \"${CMAKE_COMMAND}\" -DCASE=tool-probe -DSRC=${SRC} -DBIN=${BIN} -DHOST=${HOST} -DTOOLCHAIN_ROOT=${absent} -DREQUIRED=\${REQUIRED} -P \"${SRC}/tests/gates/diagnostic_dependency.cmake\")\n"
    "gbl_add_test(NAME dependency.marker LABELS control diagnostics SKIPPABLE COMMAND \"${CMAKE_COMMAND}\" -P \"${marker_project}/marker.cmake\")\n"
    "gbl_add_test(NAME dependency.embedded LABELS control diagnostics SKIPPABLE COMMAND \"${CMAKE_COMMAND}\" -P \"${marker_project}/embedded.cmake\")\n"
    "if(EXISTS \"${SRC}/cmake/DiagnosticSkip.cmake\")\ninclude(\"${SRC}/cmake/DiagnosticSkip.cmake\")\nforeach(test dependency.optional dependency.marker dependency.embedded)\ngbl_diagnostic_skip(\"\${test}\" \"\${REQUIRED}\")\nendforeach()\nendif()\n")
  foreach(required_mode IN ITEMS OFF ON)
    set(marker_build "${marker_project}/build-${required_mode}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${marker_project}" -B "${marker_build}"
      "-DREQUIRED=${required_mode}"
      RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "diagnostic-dependency: marker-control-configure-failed:${output}${error}")
    endif()
    execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${marker_build}"
      -LE "^post$" --output-junit junit.xml
      RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(READ "${marker_build}/junit.xml" marker_junit)
    string(REGEX MATCHALL "<skipped" skipped "${marker_junit}")
    list(LENGTH skipped skips)
    if(required_mode)
      set(expected_failures 3)
      set(expected_skips 0)
    else()
      set(expected_failures 2)
      set(expected_skips 1)
    endif()
    if(rc STREQUAL "0" OR NOT skips EQUAL expected_skips OR
       NOT marker_junit MATCHES "failures=\"${expected_failures}\"")
      message(FATAL_ERROR "diagnostic-dependency: failing-marker-was-skipped:${required_mode}:${output}${error}${marker_junit}")
    endif()
    execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${marker_build}"
      -L "^post$" --output-on-failure
      RESULT_VARIABLE post_rc OUTPUT_QUIET ERROR_QUIET)
    if(post_rc STREQUAL "0")
      message(FATAL_ERROR "diagnostic-dependency: failed-marker-inventory-was-accepted")
    endif()
  endforeach()
  if(NOT DEFINED RUNNER_BIN)
    set(RUNNER_BIN "${BIN}")
    if(NOT EXISTS "${RUNNER_BIN}/gamebloke-run-control")
      set(RUNNER_BIN "${SRC}/build/ci")
    endif()
  endif()
  set(control "${RUNNER_BIN}/gamebloke-run-control")
  if(NOT EXISTS "${control}")
    message(FATAL_ERROR "diagnostic-dependency: producer-control-runner-missing")
  endif()
  function(producer label rom fixture status reason state id ran)
    set(args "")
    if(NOT fixture STREQUAL "")
      set(args --fixture "${fixture}")
    endif()
    execute_process(COMMAND "${control}" --rom "${RUNNER_BIN}/generated/fixtures/${rom}.gba"
      ${args} --cycles 1000 RESULT_VARIABLE rc OUTPUT_VARIABLE doc ERROR_VARIABLE error)
    file(WRITE "${root}/${label}.json" "${doc}")
    set(expected_rc 1)
    if(status STREQUAL "PASS")
      set(expected_rc 0)
    endif()
    foreach(field IN ITEMS status reason)
      string(JSON actual GET "${doc}" ${field})
      if(NOT actual STREQUAL "${${field}}")
        message(FATAL_ERROR "diagnostic-dependency: producer-${label}-${field}:${doc}${error}")
      endif()
    endforeach()
    string(JSON actual_state GET "${doc}" semantic state)
    string(JSON actual_id GET "${doc}" semantic case_id)
    string(JSON actual_ran GET "${doc}" fixture ran)
    string(JSON cycles GET "${doc}" time cycles)
    string(JSON instructions GET "${doc}" time instructions)
    if(NOT rc STREQUAL expected_rc OR NOT actual_state STREQUAL state OR
       NOT actual_id STREQUAL id OR NOT actual_ran STREQUAL ran OR
       (NOT ran AND (NOT cycles EQUAL 0 OR NOT instructions EQUAL 0)))
      message(FATAL_ERROR "diagnostic-dependency: producer-${label}-postcondition:${doc}")
    endif()
    set("producer_${label}" "${doc}" PARENT_SCOPE)
  endfunction()
  producer(clean owned-arm-pass synthetic-control-pass PASS guest-mailbox-pass pass 36865 ON)
  producer(bios owned-arm-pass synthetic-control-bios-required SKIPPED required-bios-unavailable absent 0 OFF)
  producer(zero owned-arm-pass-zero-case synthetic-control-pass-zero-case TIMEOUT cycle-budget malformed 0 ON)
  producer(partial owned-arm-partial "" TIMEOUT cycle-budget pending 36867 ON)
  producer(missing owned-arm-loop "" TIMEOUT cycle-budget absent 0 ON)
  foreach(completed IN ITEMS PASS GUEST_FAIL)
  foreach(kind IN ITEMS zero missing partial)
    set(doc "${producer_${kind}}")
    set(state pass)
    if(completed STREQUAL "GUEST_FAIL")
      set(state fail)
    endif()
    string(JSON doc SET "${doc}" status "\"${completed}\"")
    string(JSON doc SET "${doc}" reason "\"guest-mailbox-${state}\"")
    string(JSON doc SET "${doc}" termination "\"mailbox-complete\"")
    if(NOT kind STREQUAL "partial")
      string(JSON doc SET "${doc}" semantic state "\"${state}\"")
      if(kind STREQUAL "missing")
        string(JSON doc SET "${doc}" semantic case_id null)
      endif()
    endif()
    set(result "${root}/${kind}-${completed}-false-completion.json")
    file(WRITE "${result}" "${doc}\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DRESULT=${result}"
      "-DMANIFEST=${RUNNER_BIN}/generated/control/manifest.json"
      "-DREGISTRY=${SRC}/registry/disputes.json" "-DVOCAB=${SRC}/contracts/evidence.json"
      -P "${SRC}/cmake/CheckResult.cmake"
      RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(kind STREQUAL "partial")
      set(expected status-semantic-mismatch)
    else()
      set(expected bad-semantic)
    endif()
    file(WRITE "${root}/${kind}-${completed}-checker-refusal.log" "${output}${error}")
    if(rc STREQUAL "0" OR NOT "${output}${error}" MATCHES "result: ${expected}:")
      message(FATAL_ERROR "diagnostic-dependency: false-${kind}-completion-accepted:${output}${error}")
    endif()
  endforeach()
  endforeach()
  message(STATUS "diagnostic-dependency: optional CTest/JUnit inventory, required/wrong/unusable tools, actual BIOS ran=false and zero/missing/incomplete mailbox refusals passed")
  return()
endif()

if(CASE STREQUAL "proof-refusal")
  # These are historical real source-built bytes, not a fabricated PASS fixture.
  # The caller prepares a proof-only runner; matching canonical bytes must not
  # make its historical metadata executable.
  set(rom "${SRC}/build/phase05-spike/admission-pair/roms/arm-343721884.gba")
  if(NOT EXISTS "${rom}" OR NOT EXISTS "${BIN}/gamebloke-run")
    message(FATAL_ERROR "diagnostic-dependency: proof-control-setup-missing")
  endif()
  execute_process(COMMAND "${BIN}/gamebloke-run" --rom "${rom}"
    --fixture arm-343721884 --cycles 1000
    RESULT_VARIABLE rc OUTPUT_VARIABLE doc ERROR_VARIABLE error)
  file(WRITE "${BIN}/proof-refusal.json" "${doc}")
  foreach(field IN ITEMS status reason termination)
    string(JSON actual_${field} ERROR_VARIABLE field_error GET "${doc}" ${field})
    if(NOT field_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR "diagnostic-dependency: proof-control-invalid-result:${error}")
    endif()
  endforeach()
  string(JSON ran GET "${doc}" fixture ran)
  string(JSON cycles GET "${doc}" time cycles)
  string(JSON instructions GET "${doc}" time instructions)
  if(NOT rc STREQUAL "1" OR NOT actual_status STREQUAL "REFUSED" OR
     NOT actual_reason STREQUAL "fixture-unknown" OR
     NOT actual_termination STREQUAL "refused-before-run" OR
     ran OR NOT cycles EQUAL 0 OR NOT instructions EQUAL 0)
    message(FATAL_ERROR "diagnostic-dependency: proof-metadata-qualified-historical-fixture:${doc}")
  endif()
  message(STATUS "diagnostic-dependency: proof historical matching bytes refused before guest execution")
  return()
endif()
message(FATAL_ERROR "diagnostic-dependency: unsupported-case:${CASE}")
