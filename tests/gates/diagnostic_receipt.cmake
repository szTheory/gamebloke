cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS SRC BIN CASE TOKEN GROUP STAGE)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "diagnostic-receipt: missing-${required}")
  endif()
endforeach()
get_filename_component(SRC "${SRC}" ABSOLUTE)
get_filename_component(BIN "${BIN}" ABSOLUTE)
include("${SRC}/cmake/PathContainment.cmake")
include("${SRC}/cmake/DiagnosticMatrix.cmake")
gbl_resolve_contained_path(binary_real binary_status "${SRC}/build" "${BIN}")
if(NOT binary_status STREQUAL "ok" OR BIN STREQUAL "${SRC}/build")
  message(FATAL_ERROR "diagnostic-receipt: unsafe-binary-root")
endif()
set(root "${BIN}/diagnostic-execution")
gbl_resolve_contained_path(root_real root_status "${BIN}" "${root}")
if(NOT root_status STREQUAL "ok")
  message(FATAL_ERROR "diagnostic-receipt: output-${root_status}")
endif()

function(check_run_token doc)
  foreach(pair IN ITEMS "token|${TOKEN}" "group|${GROUP}" "stage|${STAGE}")
    string(REPLACE "|" ";" pair "${pair}")
    list(GET pair 0 key)
    list(GET pair 1 expected)
    string(JSON actual GET "${doc}" ${key})
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "diagnostic-receipt: stale-${key}")
    endif()
  endforeach()
endfunction()

function(check_identity doc)
  check_run_token("${doc}")
  string(JSON source_commit GET "${doc}" source_commit)
  string(JSON expected_source GET "${run}" source_commit)
  if(NOT source_commit STREQUAL expected_source)
    message(FATAL_ERROR "diagnostic-receipt: source-pin-mismatch")
  endif()
  file(SHA256 "${SRC}/tests/fixtures/manifest.json" manifest_sha)
  string(JSON bound_manifest GET "${doc}" manifest_sha256)
  gbl_diagnostic_input_digest("${SRC}" inputs_sha)
  string(JSON bound_inputs GET "${doc}" source_input_sha256)
  if(NOT bound_manifest STREQUAL manifest_sha OR NOT bound_inputs STREQUAL inputs_sha)
    message(FATAL_ERROR "diagnostic-receipt: stale-authority")
  endif()
  file(SHA256 "${BIN}/gamebloke-run" runner_sha)
  string(JSON bound_runner GET "${doc}" runner_sha256)
  if(NOT runner_sha STREQUAL bound_runner)
    message(FATAL_ERROR "diagnostic-receipt: stale-runner")
  endif()
  file(SHA256 "${BIN}/cpu_test" native_sha)
  string(JSON bound_native GET "${doc}" native_sha256)
  if(NOT native_sha STREQUAL bound_native)
    message(FATAL_ERROR "diagnostic-receipt: stale-native-runner")
  endif()
endfunction()

function(check_case fid)
  set(path "${root}/${fid}.json")
  if(NOT EXISTS "${path}" OR IS_SYMLINK "${path}" OR IS_DIRECTORY "${path}")
    message(FATAL_ERROR "diagnostic-receipt: missing-case:${fid}")
  endif()
  file(READ "${path}" receipt)
  check_identity("${receipt}")
  string(JSON actual_fid GET "${receipt}" fixture_id)
  string(JSON result_path GET "${receipt}" result_path)
  string(JSON result_sha GET "${receipt}" result_sha256)
  string(JSON rom_path GET "${receipt}" rom_path)
  string(JSON rom_sha GET "${receipt}" rom_sha256)
  foreach(input IN ITEMS result_path rom_path)
    gbl_resolve_contained_path(resolved status "${SRC}/build" "${${input}}")
    if(NOT status STREQUAL "ok" OR NOT EXISTS "${resolved}" OR
       IS_DIRECTORY "${resolved}" OR IS_SYMLINK "${${input}}")
      message(FATAL_ERROR "diagnostic-receipt: unsafe-${input}:${fid}")
    endif()
  endforeach()
  file(SHA256 "${result_path}" actual_result)
  file(SHA256 "${rom_path}" actual_rom)
  if(NOT actual_fid STREQUAL fid OR NOT actual_result STREQUAL result_sha OR
     NOT actual_rom STREQUAL rom_sha)
    message(FATAL_ERROR "diagnostic-receipt: changed-case-bytes:${fid}")
  endif()
  file(READ "${result_path}" doc)
  set(expected_id 20481)
  if(fid MATCHES "^(arm|thumb)-(stop-)?([1-9][0-9]*)(-broken)?$")
    set(expected_id "${CMAKE_MATCH_3}")
  elseif(NOT fid MATCHES "^smoke(-broken)?$")
    message(FATAL_ERROR "diagnostic-receipt: unknown-case-name:${fid}")
  endif()
  set(expected_state pass)
  set(expected_status GUEST_STOP)
  set(expected_reason unregistered-content)
  set(expected_termination unregistered-content)
  if(fid MATCHES "-stop-")
    set(expected_state pending)
    if(DEFINED GBL_DIAG_ROW_${fid})
      string(JSON expected_reason GET "${GBL_DIAG_ROW_${fid}}" source_test expected_reason)
    elseif(DEFINED EXPECTED_STOP_REASON AND NOT EXPECTED_STOP_REASON STREQUAL "")
      set(expected_reason "${EXPECTED_STOP_REASON}")
    else()
      message(FATAL_ERROR "diagnostic-receipt: missing-exact-stop-reason:${fid}")
    endif()
    set(expected_termination "${expected_reason}")
  else()
    if(fid MATCHES "-broken$")
      set(expected_state fail)
    endif()
    if(STAGE STREQUAL "admitted")
      set(expected_termination mailbox-complete)
      if(expected_state STREQUAL "pass")
        set(expected_status PASS)
        set(expected_reason guest-mailbox-pass)
      else()
        set(expected_status GUEST_FAIL)
        set(expected_reason guest-mailbox-fail)
      endif()
    endif()
  endif()
  foreach(field IN ITEMS status reason termination)
    string(JSON actual GET "${doc}" ${field})
    string(JSON expected GET "${receipt}" ${field})
    if(NOT actual STREQUAL expected OR NOT actual STREQUAL "${expected_${field}}")
      message(FATAL_ERROR "diagnostic-receipt: ${field}-mismatch:${fid}")
    endif()
  endforeach()
  foreach(field IN ITEMS state case_id)
    string(JSON actual GET "${doc}" semantic ${field})
    string(JSON expected GET "${receipt}" semantic_${field})
    set(required_value "${expected_state}")
    if(field STREQUAL "case_id")
      set(required_value "${expected_id}")
    endif()
    if(NOT actual STREQUAL expected OR NOT actual STREQUAL required_value)
      message(FATAL_ERROR "diagnostic-receipt: semantic-${field}-mismatch:${fid}")
    endif()
  endforeach()
  string(JSON ran GET "${doc}" fixture ran)
  string(JSON loaded GET "${doc}" fixture rom_sha256)
  string(JSON claimed GET "${doc}" claim cart rom_sha256)
  string(JSON cycles GET "${doc}" time cycles)
  string(JSON instructions GET "${doc}" time instructions)
  string(JSON budget GET "${doc}" time budget_cycles)
  if(NOT ran OR NOT loaded STREQUAL rom_sha OR NOT claimed STREQUAL rom_sha OR
     NOT cycles MATCHES "^[1-9][0-9]*$" OR NOT instructions MATCHES "^[1-9][0-9]*$" OR
     NOT budget STREQUAL "1000" OR cycles GREATER 1000)
    message(FATAL_ERROR "diagnostic-receipt: executed-identity-mismatch:${fid}")
  endif()
  if(STAGE STREQUAL "admitted")
    string(JSON indexed GET "${doc}" expected_sha256)
    string(JSON fixture GET "${doc}" fixture id)
    if(NOT indexed STREQUAL rom_sha OR NOT fixture STREQUAL fid)
      message(FATAL_ERROR "diagnostic-receipt: admitted-identity-mismatch:${fid}")
    endif()
  endif()
endfunction()

if(NOT EXISTS "${root}/run.json" OR IS_SYMLINK "${root}/run.json")
  message(FATAL_ERROR "diagnostic-receipt: missing-current-setup")
endif()
file(READ "${root}/run.json" run)
check_run_token("${run}")
string(JSON run_tools GET "${run}" tools)
# No guest executes when the current setup established genuine optional
# absence. Rehashing the same binaries and 22 producer inputs for every skipped
# case adds no execution evidence. Keep every named skip and its fresh token;
# actual execution below retains all source/byte checks.
if(run_tools STREQUAL "absent" AND CASE MATCHES "^(case|guard)$")
  if(REQUIRED OR REQUIRED_ADMITTED)
    message(FATAL_ERROR "diagnostic-receipt: required-all-skipped")
  endif()
  message("SKIPPED: arm-toolchain-absent")
  return()
endif()
check_identity("${run}")
if(CASE STREQUAL "case")
  string(JSON tools GET "${run}" tools)
  if(tools STREQUAL "absent")
    if(REQUIRED)
      message(FATAL_ERROR "diagnostic-receipt: required-all-skipped")
    endif()
    message("SKIPPED: arm-toolchain-absent")
    return()
  endif()
  check_case("${FIXTURE}")
elseif(CASE STREQUAL "api")
  gbl_resolve_contained_path(api_real api_status "${BIN}" "${root}/api-${API}.json")
  if(NOT api_status STREQUAL "ok" OR IS_SYMLINK "${root}/api-${API}.json")
    message(FATAL_ERROR "diagnostic-receipt: unsafe-api-receipt")
  endif()
  file(READ "${root}/api-${API}.json" api_receipt)
  check_identity("${api_receipt}")
  string(JSON actual_api GET "${api_receipt}" evidence id)
  if(NOT actual_api STREQUAL API)
    message(FATAL_ERROR "diagnostic-receipt: api-id-mismatch")
  endif()
  string(JSON api_row GET "${api_receipt}" evidence)
  string(SHA256 api_row_sha "${api_row}")
  if(NOT api_row_sha STREQUAL API_ROW_SHA256)
    message(FATAL_ERROR "diagnostic-receipt: changed-api-evidence:${API}")
  endif()
  string(JSON evidence GET "${api_receipt}" evidence native_evidence)
  string(JSON count LENGTH "${evidence}")
  math(EXPR last "${count}-1")
  foreach(index RANGE 0 ${last})
    string(JSON row GET "${evidence}" ${index})
    string(JSON selector GET "${row}" selector)
    string(JSON expected_count GET "${row}" assertion_count)
    gbl_resolve_contained_path(native_real native_status "${BIN}" "${root}/native/${selector}.tap")
    if(NOT native_status STREQUAL "ok" OR IS_SYMLINK "${root}/native/${selector}.tap")
      message(FATAL_ERROR "diagnostic-receipt: unsafe-native-receipt")
    endif()
    file(READ "${root}/native/${selector}.tap" tap)
    if(NOT tap MATCHES "^TAP version 13\n1\\.\\.${expected_count}\n" OR tap MATCHES "(^|\n)not ok ")
      message(FATAL_ERROR "diagnostic-receipt: native-tap-invalid:${selector}")
    endif()
    string(REGEX MATCHALL "(^|\n)ok [0-9]+ - [^\n]+" passed "${tap}")
    list(LENGTH passed actual_count)
    if(NOT actual_count EQUAL expected_count)
      message(FATAL_ERROR "diagnostic-receipt: native-count-mismatch:${selector}")
    endif()
    string(JSON assertions GET "${row}" assertions)
    string(JSON assertion_count LENGTH "${assertions}")
    math(EXPR assertion_last "${assertion_count}-1")
    foreach(assertion_index RANGE 0 ${assertion_last})
      string(JSON assertion GET "${assertions}" ${assertion_index})
      set(found FALSE)
      foreach(line IN LISTS passed)
        string(REGEX REPLACE "^\nok [0-9]+ - |^ok [0-9]+ - " "" text "${line}")
        if(text STREQUAL assertion)
          set(found TRUE)
        endif()
      endforeach()
      if(NOT found)
        message(FATAL_ERROR "diagnostic-receipt: native-assertion-missing:${API}:${selector}:${assertion}")
      endif()
    endforeach()
  endforeach()
elseif(CASE STREQUAL "guard")
  if(REQUIRED_ADMITTED AND NOT STAGE STREQUAL "admitted")
    message(FATAL_ERROR "diagnostic-receipt: required-stage-not-admitted")
  endif()
  gbl_diagnostic_matrix("${SRC}" "${GROUP}")
  string(JSON tools GET "${run}" tools)
  if(tools STREQUAL "absent")
    if(REQUIRED OR REQUIRED_ADMITTED)
      message(FATAL_ERROR "diagnostic-receipt: required-all-skipped")
    endif()
    message("SKIPPED: arm-toolchain-absent")
    return()
  endif()
  include("${SRC}/cmake/CheckDiagnosticAuthority.cmake")
  string(JSON source_commit GET "${run}" source_commit)
  gbl_check_diagnostic_authority("${SRC}" "${source_commit}")
  string(JSON outputs GET "${run}" outputs)
  string(JSON count LENGTH "${outputs}")
  list(LENGTH GBL_DIAG_OUTPUTS expected_count)
  if(NOT count EQUAL expected_count OR count EQUAL 0)
    message(FATAL_ERROR "diagnostic-receipt: incomplete-execution-set")
  endif()
  set(actual_ids "")
  math(EXPR last "${count}-1")
  foreach(index RANGE 0 ${last})
    string(JSON fid GET "${outputs}" ${index})
    list(APPEND actual_ids "${fid}")
    check_case("${fid}")
  endforeach()
  list(SORT actual_ids)
  if(NOT actual_ids STREQUAL GBL_DIAG_OUTPUTS)
    message(FATAL_ERROR "diagnostic-receipt: execution-id-set-mismatch")
  endif()
  foreach(api IN LISTS GBL_DIAG_APIS)
    string(SHA256 api_sha "${GBL_DIAG_API_${api}}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -DCASE=api "-DSRC=${SRC}" "-DBIN=${BIN}"
      "-DTOKEN=${TOKEN}" "-DGROUP=${GROUP}" "-DSTAGE=${STAGE}"
      "-DAPI=${api}" "-DAPI_ROW_SHA256=${api_sha}"
      -P "${SRC}/tests/gates/diagnostic_receipt.cmake"
      RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "diagnostic-receipt: incomplete-native-boundary-set:${api}:${output}${error}")
    endif()
  endforeach()
  message(STATUS "diagnostic-receipt: exact ${count} real ${STAGE} output receipts checked")
else()
  message(FATAL_ERROR "diagnostic-receipt: unsupported-case:${CASE}")
endif()
