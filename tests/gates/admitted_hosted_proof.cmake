include_guard(GLOBAL)

# Independently check collected execution semantics and exact native evidence;
# source-output proof is still checked separately against immutable local proof.
function(proof_admitted_execution receipt host group)
  include("${source_root}/cmake/DiagnosticMatrix.cmake")
  gbl_diagnostic_matrix("${source_root}" "${group}")
  file(SHA256 "${source_root}/tests/fixtures/manifest.json" manifest_sha)
  string(JSON identity GET "${receipt}" execution_identity)
  string(JSON archive_sha GET "${receipt}" toolchain_archive_sha256)
  foreach(pair IN ITEMS "format|gamebloke.admitted-host-log/1" "stage|admitted"
      "host|${host}" "group|${group}" "source_commit|${source_head}"
      "source_input_sha256|${GBL_CI_PRODUCER_INPUT}" "reviewed_head|${reviewed_head}"
      "manifest_sha256|${manifest_sha}" "run_id|${run_id}"
      "job_name|diagnostics (${host}, ${group})" "tools|available"
      "toolchain_archive_sha256|${archive_sha}")
    string(REPLACE "|" ";" pair "${pair}")
    list(GET pair 0 key)
    list(GET pair 1 expected)
    string(JSON actual GET "${identity}" "${key}")
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "final-proof: admitted-identity-mismatch:${key}")
    endif()
  endforeach()
  foreach(field IN ITEMS runner_sha256 native_sha256 token)
    string(JSON value GET "${identity}" "${field}")
    string(LENGTH "${value}" length)
    set(expected_length 64)
    if(field STREQUAL "token")
      set(expected_length 24)
    endif()
    if(NOT length EQUAL expected_length OR NOT value MATCHES "^[0-9a-f]+$")
      message(FATAL_ERROR "final-proof: admitted-digest-invalid:${field}")
    endif()
  endforeach()
  string(JSON executions GET "${receipt}" executions)
  proof_output_rows("${executions}" rows)
  string(JSON output_rows GET "${receipt}" outputs)
  proof_output_rows("${output_rows}" bound_outputs)
  foreach(output_row IN LISTS bound_outputs)
    string(JSON output_name GET "${output_row}" name)
    string(MAKE_C_IDENTIFIER "${output_name}" key)
    set("output_${key}" "${output_row}")
  endforeach()
  set(seen "")
  foreach(row IN LISTS rows)
    string(JSON fid GET "${row}" fixture_id)
    if(NOT fid IN_LIST GBL_DIAG_OUTPUTS OR fid IN_LIST seen)
      message(FATAL_ERROR "final-proof: admitted-fixture-set-mismatch")
    endif()
    list(APPEND seen "${fid}")
    set(ledger "${GBL_DIAG_ROW_${fid}}")
    string(JSON expected_id GET "${ledger}" id)
    string(JSON kind GET "${ledger}" source_test kind)
    set(state pass)
    set(status PASS)
    set(reason guest-mailbox-pass)
    set(termination mailbox-complete)
    if(fid MATCHES "-broken$")
      set(state fail)
      set(status GUEST_FAIL)
      set(reason guest-mailbox-fail)
    elseif(kind STREQUAL "guest-stop")
      set(state pending)
      set(status GUEST_STOP)
      string(JSON reason GET "${ledger}" source_test expected_reason)
      set(termination "${reason}")
    endif()
    foreach(field IN ITEMS state status reason termination)
      string(JSON actual GET "${row}" "${field}")
      if(NOT actual STREQUAL "${${field}}")
        message(FATAL_ERROR "final-proof: admitted-semantic-mismatch:${fid}:${field}")
      endif()
    endforeach()
    string(JSON case_id GET "${row}" case_id)
    string(JSON name GET "${row}" name)
    set(expected_name "${GBL_DIAG_GROUP_${fid}}/${fid}.gba")
    string(JSON ran GET "${row}" ran)
    string(JSON ran_type TYPE "${row}" ran)
    string(JSON budget GET "${row}" budget_cycles)
    if(NOT case_id STREQUAL expected_id OR NOT name STREQUAL expected_name OR
        NOT ran_type STREQUAL "BOOLEAN" OR NOT ran OR NOT budget STREQUAL "1000")
      message(FATAL_ERROR "final-proof: admitted-progress-mismatch:${fid}")
    endif()
    foreach(field IN ITEMS cycles instructions bytes)
      string(JSON value GET "${row}" "${field}")
      string(JSON type TYPE "${row}" "${field}")
      if(NOT type STREQUAL "NUMBER" OR NOT value MATCHES "^[1-9][0-9]*$" OR
          (field STREQUAL "cycles" AND value GREATER 1000))
        message(FATAL_ERROR "final-proof: admitted-progress-mismatch:${fid}")
      endif()
    endforeach()
    foreach(field IN ITEMS sha256 result_sha256)
      string(JSON value GET "${row}" "${field}")
      string(LENGTH "${value}" length)
      if(NOT length EQUAL 64 OR NOT value MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "final-proof: admitted-result-digest-invalid:${fid}")
      endif()
    endforeach()
    # This exact row must carry the same output identity checked by the source
    # witness, rather than a second independent unchecked output projection.
    string(MAKE_C_IDENTIFIER "${name}" key)
    foreach(field IN ITEMS name case_id sha256 bytes)
      string(JSON actual GET "${row}" "${field}")
      string(JSON expected GET "${output_${key}}" "${field}")
      if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "final-proof: admitted-output-identity-mismatch:${fid}")
      endif()
    endforeach()
  endforeach()
  proof_assert_set("${seen}" "${GBL_DIAG_OUTPUTS}" "admitted-fixture-set-mismatch")
  string(JSON apis GET "${receipt}" native_apis)
  string(JSON count LENGTH "${apis}")
  list(LENGTH GBL_DIAG_APIS expected_count)
  if(NOT count EQUAL expected_count)
    message(FATAL_ERROR "final-proof: admitted-api-set-mismatch")
  endif()
  set(seen "")
  if(count GREATER 0)
    math(EXPR last "${count}-1")
    foreach(i RANGE 0 ${last})
      string(JSON api GET "${apis}" ${i})
      string(JSON evidence GET "${api}" evidence)
      string(JSON id GET "${evidence}" id)
      if(NOT id IN_LIST GBL_DIAG_APIS OR id IN_LIST seen)
        message(FATAL_ERROR "final-proof: admitted-api-set-mismatch")
      endif()
      list(APPEND seen "${id}")
      string(JSON equal EQUAL "${evidence}" "${GBL_DIAG_API_${id}}")
      if(NOT equal)
        message(FATAL_ERROR "final-proof: admitted-native-evidence-mismatch")
      endif()
      foreach(field IN ITEMS token stage group reviewed_head source_commit source_input_sha256
          manifest_sha256 runner_sha256 native_sha256)
        string(JSON actual GET "${api}" "${field}")
        string(JSON expected GET "${identity}" "${field}")
        if(NOT actual STREQUAL expected)
          message(FATAL_ERROR "final-proof: admitted-native-identity-mismatch:${field}")
        endif()
      endforeach()
    endforeach()
  endif()
  message(STATUS "final-proof: actual admitted ${host}/${group} guest set and ${count} native API rows verified")
endfunction()
