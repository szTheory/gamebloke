find_program(CTEST_PROGRAM NAMES ctest REQUIRED)
find_program(CMAKE_PROGRAM NAMES cmake REQUIRED)
file(STRINGS "${GBL_PHASE15_CACHE}" GBL_PHASE15_LANE_LINE
  REGEX "^GBL_LANE:STRING=")
list(LENGTH GBL_PHASE15_LANE_LINE GBL_PHASE15_LANE_COUNT)
if(NOT GBL_PHASE15_LANE_COUNT EQUAL 1)
  message(FATAL_ERROR "phase15-selection: lane-missing-or-duplicate")
endif()
string(REPLACE "GBL_LANE:STRING=" "" GBL_PHASE15_LANE
  "${GBL_PHASE15_LANE_LINE}")
if(NOT GBL_PHASE15_LANE STREQUAL "ci" AND
    NOT GBL_PHASE15_LANE STREQUAL "asan")
  message(FATAL_ERROR "phase15-selection: unsupported-lane-${GBL_PHASE15_LANE}")
