function(gbl_phase15_json_property json index wanted property_out found_out)
  set(found FALSE)
  set(value)
  string(JSON property_count ERROR_VARIABLE property_error LENGTH
    "${json}" tests ${index} properties)
  if(NOT "${property_error}" STREQUAL "NOTFOUND")
    set(${property_out} "" PARENT_SCOPE)
    set(${found_out} FALSE PARENT_SCOPE)
    return()
  endif()
  if(property_count GREATER 0)
    math(EXPR property_last "${property_count} - 1")
    foreach(property_index RANGE 0 ${property_last})
      string(JSON property_name GET "${json}" tests ${index}
        properties ${property_index} name)
      if(NOT property_name STREQUAL wanted)
        continue()
      endif()
      string(JSON value_type TYPE "${json}" tests ${index}
        properties ${property_index} value)
      if(value_type STREQUAL "ARRAY")
        string(JSON value_count LENGTH "${json}" tests ${index}
          properties ${property_index} value)
        if(value_count GREATER 0)
          math(EXPR value_last "${value_count} - 1")
          foreach(value_index RANGE 0 ${value_last})
            string(JSON item GET "${json}" tests ${index}
              properties ${property_index} value ${value_index})
            list(APPEND value "${item}")
          endforeach()
        endif()
      elseif(value_type STREQUAL "STRING" OR value_type STREQUAL "BOOLEAN" OR
          value_type STREQUAL "NUMBER")
        string(JSON value GET "${json}" tests ${index}
          properties ${property_index} value)
      endif()
      set(found TRUE)
      break()
    endforeach()
  endif()
  set(${property_out} "${value}" PARENT_SCOPE)
  set(${found_out} "${found}" PARENT_SCOPE)
endfunction()

function(gbl_phase15_find_test json wanted index_out count_out)
  set(found_index -1)
  set(found_count 0)
  string(JSON count ERROR_VARIABLE error LENGTH "${json}" tests)
  if("${error}" STREQUAL "NOTFOUND" AND count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
      string(JSON name GET "${json}" tests ${index} name)
      if(name STREQUAL wanted)
        math(EXPR found_count "${found_count} + 1")
        set(found_index ${index})
      endif()
    endforeach()
  endif()
  set(${index_out} "${found_index}" PARENT_SCOPE)
  set(${count_out} "${found_count}" PARENT_SCOPE)
endfunction()

function(gbl_phase15_expected_command name json index reason_out)
  string(JSON count ERROR_VARIABLE error LENGTH "${json}" tests ${index} command)
  if(NOT "${error}" STREQUAL "NOTFOUND" OR count LESS 1)
    set(${reason_out} wrong-command PARENT_SCOPE)
    return()
  endif()
  string(JSON program GET "${json}" tests ${index} command 0)
  if(name MATCHES "^cpu[.]ppu[.]access")
    set(expected_program "${GBL_PHASE15_BIN}/cpu_test${CMAKE_EXECUTABLE_SUFFIX}")
    if(name STREQUAL "cpu.ppu.access-controls")
      set(argument ppu.access-controls)
    else()
      set(argument ppu.access)
    endif()
    set(expected_args "${argument}")
  elseif(name STREQUAL "cpu.ppu.refusal")
    set(expected_program "${GBL_PHASE15_BIN}/cpu_test${CMAKE_EXECUTABLE_SUFFIX}")
    set(expected_args ppu.refusal)
  elseif(name MATCHES "^dma[.]ppu[.]access")
    set(expected_program "${GBL_PHASE15_BIN}/dma_test${CMAKE_EXECUTABLE_SUFFIX}")
    if(name STREQUAL "dma.ppu.access-controls")
      set(argument ppu.access-controls)
    else()
      set(argument ppu.access)
    endif()
    set(expected_args "${argument}")
  elseif(name STREQUAL "dma.ppu.refusal")
    set(expected_program "${GBL_PHASE15_BIN}/dma_test${CMAKE_EXECUTABLE_SUFFIX}")
    set(expected_args ppu.refusal)
  elseif(name STREQUAL "ppu.refusal")
    set(expected_program "${GBL_PHASE15_BIN}/bus_test${CMAKE_EXECUTABLE_SUFFIX}")
    set(expected_args ppu.refusal)
  elseif(name MATCHES "^runner[.]ppu[.]production")
    set(expected_program "${GBL_PHASE15_BIN}/runner_test${CMAKE_EXECUTABLE_SUFFIX}")
    if(name STREQUAL "runner.ppu.production-controls")
      set(argument ppu.production-controls)
      set(scratch runner-ppu-production-controls)
    else()
      set(argument ppu.production)
      set(scratch runner-ppu-production)
    endif()
    set(expected_args "${argument}" "${GBL_PHASE15_BIN}/${scratch}")
  elseif(name MATCHES "^determinism[.]phase14([.]controls)?$")
    set(expected_program "${GBL_PHASE15_BIN}/determinism_test${CMAKE_EXECUTABLE_SUFFIX}")
    if(name STREQUAL "determinism.phase14.controls")
      set(expected_args phase14-controls)
    else()
      set(expected_args phase14)
    endif()
  elseif(name MATCHES "^phase15[.]selection[.](verify|control|order)$")
    set(expected_program "${CMAKE_PROGRAM}")
    if(name STREQUAL "phase15.selection.control")
      set(gate_case control)
    elseif(name STREQUAL "phase15.selection.order")
      set(gate_case order)
    else()
      set(gate_case verify)
    endif()
    set(expected_args
      "-DSRC=${GBL_PHASE15_SRC}" "-DBIN=${GBL_PHASE15_BIN}"
      "-DCASE=${gate_case}" -P "${GBL_PHASE15_GATE}")
  else()
    set(${reason_out} unexpected-test PARENT_SCOPE)
    return()
  endif()
  list(LENGTH expected_args expected_count)
  math(EXPR expected_command_count "${expected_count} + 1")
  if(NOT program STREQUAL expected_program OR NOT count EQUAL
      expected_command_count)
    set(${reason_out} wrong-command PARENT_SCOPE)
    return()
  endif()
  math(EXPR last "${expected_count} - 1")
  foreach(expected_index RANGE 0 ${last})
    math(EXPR actual_index "${expected_index} + 1")
    string(JSON actual_arg GET "${json}" tests ${index} command ${actual_index})
    list(GET expected_args ${expected_index} expected_arg)
    if(NOT actual_arg STREQUAL expected_arg)
      set(${reason_out} wrong-command PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase15_labels name json index reason_out)
  gbl_phase15_json_property("${json}" ${index} LABELS labels has_labels)
  if(NOT has_labels)
    set(${reason_out} wrong-label PARENT_SCOPE)
    return()
  endif()
  if(name MATCHES "^cpu[.]ppu[.]")
    set(expected_labels core cpu ppu unit)
  elseif(name MATCHES "^dma[.]ppu[.]")
    set(expected_labels core dma ppu unit)
  elseif(name MATCHES "^runner[.]ppu[.]")
    set(expected_labels integration ppu runner)
  elseif(name MATCHES "^determinism[.]")
    set(expected_labels determinism gate integration)
  elseif(name MATCHES "^phase15[.]selection[.]")
    set(expected_labels gate ppu time)
  elseif(name STREQUAL "ppu.refusal")
    set(expected_labels bus core ppu unit)
  else()
    set(${reason_out} unexpected-test PARENT_SCOPE)
    return()
  endif()
  set(actual_labels ${labels})
  list(SORT actual_labels)
  list(SORT expected_labels)
  if(NOT "${actual_labels}" STREQUAL "${expected_labels}")
    set(${reason_out} wrong-label PARENT_SCOPE)
    return()
  endif()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase15_validate_location_and_state json index reason_out)
  gbl_phase15_json_property("${json}" ${index} WORKING_DIRECTORY workdir has_workdir)
  if(NOT has_workdir)
    set(${reason_out} wrong-root PARENT_SCOPE)
    return()
  endif()
  file(REAL_PATH "${workdir}" workdir_real)
  if(NOT workdir_real STREQUAL GBL_PHASE15_BIN)
    set(${reason_out} wrong-root PARENT_SCOPE)
    return()
  endif()
  gbl_phase15_json_property("${json}" ${index} SKIP_REGULAR_EXPRESSION
    skip_expression has_skip)
  if(has_skip)
    set(${reason_out} skippable PARENT_SCOPE)
    return()
  endif()
  gbl_phase15_json_property("${json}" ${index} DISABLED disabled has_disabled)
  if(has_disabled AND disabled)
    set(${reason_out} disabled PARENT_SCOPE)
    return()
  endif()
  gbl_phase15_json_property("${json}" ${index} PASS_REGULAR_EXPRESSION
    pass_expression has_pass)
  if(has_pass)
    set(${reason_out} pass-regex PARENT_SCOPE)
    return()
  endif()
  gbl_phase15_json_property("${json}" ${index} WILL_FAIL will_fail has_will_fail)
  if(has_will_fail AND will_fail)
    set(${reason_out} will-fail PARENT_SCOPE)
    return()
  endif()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase15_validate_selection json reason_out)
  string(JSON kind ERROR_VARIABLE kind_error GET "${json}" kind)
  string(JSON count ERROR_VARIABLE count_error LENGTH "${json}" tests)
  if(NOT "${kind_error}" STREQUAL "NOTFOUND" OR NOT kind STREQUAL "ctestInfo" OR
      NOT "${count_error}" STREQUAL "NOTFOUND")
    set(${reason_out} malformed PARENT_SCOPE)
    return()
  endif()
  list(LENGTH GBL_PHASE15_EXPECTED expected_count)
  if(NOT count EQUAL expected_count)
    set(${reason_out} selection-count PARENT_SCOPE)
    return()
  endif()
  set(actual_names)
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    string(JSON name ERROR_VARIABLE name_error GET "${json}" tests ${index} name)
    if(NOT "${name_error}" STREQUAL "NOTFOUND" OR name STREQUAL "")
      set(${reason_out} malformed PARENT_SCOPE)
      return()
    endif()
    if(name IN_LIST actual_names)
      set(${reason_out} duplicate-selector PARENT_SCOPE)
      return()
    endif()
    list(APPEND actual_names "${name}")
  endforeach()
  foreach(expected IN LISTS GBL_PHASE15_EXPECTED)
    if(NOT expected IN_LIST actual_names)
      set(${reason_out} missing-selector PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(index RANGE 0 ${last})
    string(JSON name GET "${json}" tests ${index} name)
    gbl_phase15_expected_command("${name}" "${json}" ${index} command_reason)
    if(NOT "${command_reason}" STREQUAL "")
      set(${reason_out} "${command_reason}" PARENT_SCOPE)
      return()
    endif()
    gbl_phase15_labels("${name}" "${json}" ${index} label_reason)
    if(NOT "${label_reason}" STREQUAL "")
      set(${reason_out} "${label_reason}" PARENT_SCOPE)
      return()
    endif()
    gbl_phase15_validate_location_and_state("${json}" ${index} state_reason)
    if(NOT "${state_reason}" STREQUAL "")
      set(${reason_out} "${state_reason}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase15_validate_gate_registrations json reason_out)
  foreach(name IN LISTS GBL_PHASE15_GATES)
    gbl_phase15_find_test("${json}" "${name}" index found_count)
    if(NOT found_count EQUAL 1)
      set(${reason_out} "registration-count-${name}-${found_count}" PARENT_SCOPE)
      return()
    endif()
    gbl_phase15_expected_command("${name}" "${json}" ${index} command_reason)
    gbl_phase15_labels("${name}" "${json}" ${index} label_reason)
    gbl_phase15_validate_location_and_state("${json}" ${index} state_reason)
    if(NOT "${command_reason}" STREQUAL "")
      set(${reason_out} "${name}-${command_reason}" PARENT_SCOPE)
      return()
    elseif(NOT "${label_reason}" STREQUAL "")
      set(${reason_out} "${name}-${label_reason}" PARENT_SCOPE)
      return()
    elseif(NOT "${state_reason}" STREQUAL "")
      set(${reason_out} "${name}-${state_reason}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase15_discover build_dir regex output_var)
  execute_process(
    COMMAND "${CTEST_PROGRAM}" --test-dir "${build_dir}" --show-only=json-v1
      --fixture-exclude-any
      "^(phase7_fast|phase8_fast|phase9_fast|phase10_fast|phase11_fast|phase12_fast|phase13_fast|phase14_fast|phase15_fast)$"
      -R "${regex}"
    RESULT_VARIABLE result OUTPUT_VARIABLE json ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "phase15-selection: discovery-failed: ${result}\n${error}")
  endif()
  set(${output_var} "${json}" PARENT_SCOPE)
endfunction()

function(gbl_phase15_check_inventory path reason_out)
  if(NOT EXISTS "${path}")
    set(${reason_out} inventory-missing PARENT_SCOPE)
    return()
  endif()
  file(STRINGS "${path}" rows)
  set(sorted_rows ${rows})
  list(SORT sorted_rows)
  if(NOT "${rows}" STREQUAL "${sorted_rows}")
    set(${reason_out} inventory-unsorted PARENT_SCOPE)
    return()
  endif()
  foreach(expected_row IN LISTS GBL_PHASE15_INVENTORY_ROWS)
    string(REGEX MATCH "^([^ ]+)" name "${expected_row}")
    string(REPLACE "." "[.]" escaped "${name}")
    set(matching)
    foreach(row IN LISTS rows)
      if(row MATCHES "^${escaped} ")
        list(APPEND matching "${row}")
      endif()
    endforeach()
    list(LENGTH matching count)
    if(NOT count EQUAL 1)
      set(${reason_out} "inventory-${name}-count-${count}" PARENT_SCOPE)
      return()
    endif()
    list(GET matching 0 actual)
    if(NOT actual STREQUAL expected_row)
      set(${reason_out} "inventory-${name}-labels" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(row IN LISTS rows)
    if(row MATCHES "^(phase15[.]selection[.])")
      set(known FALSE)
      foreach(expected_row IN LISTS GBL_PHASE15_INVENTORY_ROWS)
        if(row STREQUAL expected_row)
          set(known TRUE)
        endif()
      endforeach()
      if(NOT known)
        set(${reason_out} inventory-unexpected-phase15-selector PARENT_SCOPE)
        return()
      endif()
    endif()
  endforeach()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase15_order_regex output_var)
  set(parts ${GBL_PHASE15_EXPECTED} ${GBL_PHASE15_GATES})
  # Include every PPU and replay selector so a semantic case cannot be hidden
  # from setup-set validation by receiving the cheap fixture accidentally.
  list(APPEND parts "ppu[.].*" "determinism[.].*"
    "cpu[.]ppu[.].*" "dma[.]ppu[.].*" "runner[.]ppu[.].*")
  list(JOIN parts "|" body)
  set(${output_var} "^(${body})$" PARENT_SCOPE)
endfunction()

function(gbl_phase15_validate_order json reason_out)
  set(actual_setup)
  set(actual_required)
  set(expected_required)
  set(expected_consumers)
  string(JSON count ERROR_VARIABLE count_error LENGTH "${json}" tests)
  if(NOT "${count_error}" STREQUAL "NOTFOUND")
    set(${reason_out} malformed PARENT_SCOPE)
    return()
  endif()
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
      string(JSON name GET "${json}" tests ${index} name)
      gbl_phase15_json_property("${json}" ${index} FIXTURES_SETUP setup has_setup)
      gbl_phase15_json_property("${json}" ${index} FIXTURES_REQUIRED required has_required)
      if(name MATCHES "^(cpu[.]ppu[.].*|dma[.]ppu[.].*|runner[.]ppu[.].*)$")
        list(APPEND expected_required "${name}")
        list(APPEND expected_consumers "${name}")
      endif()
      if(has_setup AND "phase15_fast" IN_LIST setup)
        list(APPEND actual_setup "${name}")
        if("phase15_fast" IN_LIST required)
          set(${reason_out} "setup-self-cycle-${name}" PARENT_SCOPE)
          return()
        endif()
      endif()
      if(has_required AND "phase15_fast" IN_LIST required)
        list(APPEND actual_required "${name}")
      endif()
    endforeach()
  endif()
  list(SORT actual_setup)
  set(expected_setup ${GBL_PHASE15_GATES})
  list(SORT expected_setup)
  if(NOT "${actual_setup}" STREQUAL "${expected_setup}")
    set(${reason_out} setup-set PARENT_SCOPE)
    return()
  endif()
  list(SORT actual_required)
  list(SORT expected_required)
  if(NOT "${actual_required}" STREQUAL "${expected_required}")
    foreach(name IN LISTS expected_required)
      if(NOT name IN_LIST actual_required)
        set(${reason_out} "missing-predecessor-${name}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
    set(${reason_out} unexpected-required-set PARENT_SCOPE)
    return()
  endif()
  gbl_phase15_validate_gate_registrations("${json}" gate_reason)
  if(NOT "${gate_reason}" STREQUAL "")
    set(${reason_out} "gate-${gate_reason}" PARENT_SCOPE)
    return()
  endif()
  foreach(name IN LISTS expected_consumers)
    gbl_phase15_find_test("${json}" "${name}" index found_count)
    if(NOT found_count EQUAL 1)
      set(${reason_out} "consumer-registration-${name}-${found_count}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase15_check_order)
  gbl_phase15_order_regex(regex)
  gbl_phase15_discover("${GBL_PHASE15_BIN}" "${regex}" json)
  gbl_phase15_validate_order("${json}" reason)
  if(NOT "${reason}" STREQUAL "")
    message(FATAL_ERROR "phase15-order: ${reason}")
  endif()
  message(STATUS "phase15-order: three independent gates and affected-consumer fixture edges passed")
endfunction()

function(gbl_phase15_expect_reason actual expected label)
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "phase15-selection-control: ${label}: expected-${expected}; actual-${actual}")
  endif()
  message(STATUS "phase15-selection-control: ${label}: causal rejection passed")
endfunction()

function(gbl_phase15_check_controls)
  set(scratch_root "${GBL_PHASE15_BIN}/phase15-selection-controls")
  file(REMOVE_RECURSE "${scratch_root}")
  set(scratch_graph "${scratch_root}/scratch-graph")
  file(MAKE_DIRECTORY "${scratch_graph}")
  file(COPY_FILE "${GBL_PHASE15_BIN}/CTestTestfile.cmake"
    "${scratch_graph}/CTestTestfile.cmake")
  gbl_phase15_order_regex(order_regex)
  gbl_phase15_discover("${GBL_PHASE15_BIN}" "${order_regex}" live_graph)
  set(fixture_graph_text "\nset_tests_properties(${GBL_PHASE15_GATES} PROPERTIES FIXTURES_SETUP \"phase15_fast\")\n")
  string(JSON live_count LENGTH "${live_graph}" tests)
  if(live_count GREATER 0)
    math(EXPR live_last "${live_count} - 1")
    foreach(live_index RANGE 0 ${live_last})
      string(JSON live_name GET "${live_graph}" tests ${live_index} name)
      if(NOT live_name MATCHES "^(cpu[.]ppu[.].*|dma[.]ppu[.].*|runner[.]ppu[.].*)$")
        continue()
      endif()
      gbl_phase15_json_property("${live_graph}" ${live_index}
        FIXTURES_REQUIRED required has_required)
      list(APPEND required phase15_fast)
      list(REMOVE_DUPLICATES required)
      list(JOIN required ";" required_value)
      string(APPEND fixture_graph_text
        "set_tests_properties(\"${live_name}\" PROPERTIES FIXTURES_REQUIRED \"${required_value}\")\n")
    endforeach()
  endif()
  file(APPEND "${scratch_graph}/CTestTestfile.cmake" "${fixture_graph_text}")
  set(workdir_tests ${GBL_PHASE15_EXPECTED} ${GBL_PHASE15_GATES})
  list(JOIN workdir_tests " " workdir_test_args)
  file(APPEND "${scratch_graph}/CTestTestfile.cmake"
    "\nset_tests_properties(${workdir_test_args} PROPERTIES WORKING_DIRECTORY \"${GBL_PHASE15_BIN}\")\n")
  foreach(lane IN ITEMS ci asan)
    file(COPY_FILE "${GBL_PHASE15_SRC}/tests/inventory/${lane}.txt"
      "${scratch_root}/${lane}.txt")
  endforeach()
  gbl_phase15_discover("${scratch_graph}" "${GBL_PHASE15_REGEX}" clean_json)
  gbl_phase15_validate_selection("${clean_json}" clean_reason)
  gbl_phase15_expect_reason("${clean_reason}" "" clean-selection-twin)
  set(empty_json "{\"kind\":\"ctestInfo\",\"tests\":[]}")
  gbl_phase15_validate_selection("${empty_json}" reason)
  gbl_phase15_expect_reason("${reason}" selection-count empty-selection)

  gbl_phase15_find_test("${clean_json}" cpu.ppu.access index count)
  gbl_phase15_find_test("${clean_json}" cpu.ppu.access-controls duplicate_index duplicate_count)
  if(NOT count EQUAL 1 OR NOT duplicate_count EQUAL 1)
    message(FATAL_ERROR "phase15-selection-control: clean twin lacks CPU selectors")
  endif()
  string(JSON missing_json REMOVE "${clean_json}" tests ${index})
  gbl_phase15_validate_selection("${missing_json}" reason)
  gbl_phase15_expect_reason("${reason}" selection-count missing-selector)
  string(JSON duplicate_json SET "${clean_json}" tests ${duplicate_index} name "\"cpu.ppu.access\"")
  gbl_phase15_validate_selection("${duplicate_json}" reason)
  gbl_phase15_expect_reason("${reason}" duplicate-selector duplicate-selector)
  string(JSON clean_count LENGTH "${clean_json}" tests)
  string(JSON extra_json SET "${clean_json}" tests ${clean_count}
    "{\"name\":\"phase15.extra\",\"command\":[\"unused\"],\"properties\":[]}")
  gbl_phase15_validate_selection("${extra_json}" reason)
  gbl_phase15_expect_reason("${reason}" selection-count extra-selector)

  set(mutated "${clean_json}")
  string(JSON mutated SET "${mutated}" tests ${index} command 0 "\"${GBL_PHASE15_BIN}/wrong-test\"")
  gbl_phase15_validate_selection("${mutated}" reason)
  gbl_phase15_expect_reason("${reason}" wrong-command wrong-command)
  string(JSON wrong_argument SET "${clean_json}" tests ${index} command 1 "\"ppu.refusal\"")
  gbl_phase15_validate_selection("${wrong_argument}" reason)
  gbl_phase15_expect_reason("${reason}" wrong-command wrong-argument)

  string(JSON property_count LENGTH "${clean_json}" tests ${index} properties)
  set(labels_index -1)
  set(workdir_index -1)
  foreach(property_index RANGE 0 ${property_count})
    if(property_index EQUAL property_count)
      break()
    endif()
    string(JSON property_name GET "${clean_json}" tests ${index} properties ${property_index} name)
    if(property_name STREQUAL "LABELS")
      set(labels_index ${property_index})
    elseif(property_name STREQUAL "WORKING_DIRECTORY")
      set(workdir_index ${property_index})
    endif()
  endforeach()
  if(labels_index EQUAL -1 OR workdir_index EQUAL -1)
    message(FATAL_ERROR "phase15-selection-control: clean twin missing label/root properties")
  endif()
  string(JSON wrong_label SET "${clean_json}" tests ${index} properties ${labels_index} value 0 "\"wrong\"")
  gbl_phase15_validate_selection("${wrong_label}" reason)
  gbl_phase15_expect_reason("${reason}" wrong-label wrong-label)
  set(foreign_root "${scratch_root}/foreign-root")
  file(MAKE_DIRECTORY "${foreign_root}")
  string(JSON wrong_root SET "${clean_json}" tests ${index} properties ${workdir_index} value "\"${foreign_root}\"")
  gbl_phase15_validate_selection("${wrong_root}" reason)
  gbl_phase15_expect_reason("${reason}" wrong-root wrong-root)

  foreach(property_json IN ITEMS SKIP_REGULAR_EXPRESSION PASS_REGULAR_EXPRESSION DISABLED WILL_FAIL)
    string(JSON test_json GET "${clean_json}" tests ${index})
    string(JSON property_length LENGTH "${test_json}" properties)
    if(property_json STREQUAL "DISABLED" OR property_json STREQUAL "WILL_FAIL")
      set(value true)
    else()
      set(value "\"green\"")
    endif()
    string(JSON test_json SET "${test_json}" properties ${property_length}
      "{\"name\":\"${property_json}\",\"value\":${value}}")
    set(mutant "${clean_json}")
    string(JSON mutant SET "${mutant}" tests ${index} "${test_json}")
    gbl_phase15_validate_selection("${mutant}" reason)
    if(property_json STREQUAL "SKIP_REGULAR_EXPRESSION")
      set(expected skippable)
    elseif(property_json STREQUAL "PASS_REGULAR_EXPRESSION")
      set(expected pass-regex)
    elseif(property_json STREQUAL "DISABLED")
      set(expected disabled)
    else()
      set(expected will-fail)
    endif()
    gbl_phase15_expect_reason("${reason}" "${expected}" "property-${property_json}")
  endforeach()

  foreach(lane IN ITEMS ci asan)
    set(path "${scratch_root}/${lane}.txt")
    gbl_phase15_check_inventory("${path}" reason)
    gbl_phase15_expect_reason("${reason}" "" "inventory-${lane}")
    file(READ "${path}" inventory)
    set(row "phase15.selection.control gate,ppu,time")
    string(REPLACE "${row}\n" "${row}\n${row}\n" duplicated "${inventory}")
    set(scratch "${GBL_PHASE15_BIN}/phase15-selection-controls/${lane}-duplicate.txt")
    file(MAKE_DIRECTORY "${GBL_PHASE15_BIN}/phase15-selection-controls")
    file(WRITE "${scratch}" "${duplicated}")
    gbl_phase15_check_inventory("${scratch}" reason)
    gbl_phase15_expect_reason("${reason}" inventory-phase15.selection.control-count-2 "inventory-duplicate-${lane}")
    string(REPLACE "${row}\n" "" missing "${inventory}")
    file(WRITE "${scratch}" "${missing}")
    gbl_phase15_check_inventory("${scratch}" reason)
    gbl_phase15_expect_reason("${reason}" inventory-phase15.selection.control-count-0 "inventory-missing-${lane}")
    string(REPLACE "${row}" "phase15.selection.control gate,wrong,label" wrong "${inventory}")
    file(WRITE "${scratch}" "${wrong}")
    gbl_phase15_check_inventory("${scratch}" reason)
    gbl_phase15_expect_reason("${reason}" inventory-phase15.selection.control-labels "inventory-label-${lane}")
  endforeach()

  gbl_phase15_discover("${scratch_graph}" "${order_regex}" clean_graph)
  gbl_phase15_validate_order("${clean_graph}" order_reason)
  gbl_phase15_expect_reason("${order_reason}" "" clean-fixture-graph)
  gbl_phase15_find_test("${clean_graph}" cpu.ppu.access cpu_index cpu_count)
  if(NOT cpu_count EQUAL 1)
    message(FATAL_ERROR "phase15-selection-control: clean graph lacks cpu.ppu.access")
  endif()
  string(JSON cpu_test GET "${clean_graph}" tests ${cpu_index})
  string(JSON property_count LENGTH "${cpu_test}" properties)
  set(required_property -1)
  foreach(property_index RANGE 0 ${property_count})
    if(property_index EQUAL property_count)
      break()
    endif()
    string(JSON property_name GET "${cpu_test}" properties ${property_index} name)
    if(property_name STREQUAL "FIXTURES_REQUIRED")
      set(required_property ${property_index})
      break()
    endif()
  endforeach()
  if(required_property EQUAL -1)
    message(FATAL_ERROR "phase15-selection-control: consumer missing fixture property")
  endif()
  string(JSON required_count LENGTH "${cpu_test}" properties ${required_property} value)
  set(phase15_fixture_index -1)
  foreach(fixture_index RANGE 0 ${required_count})
    if(fixture_index EQUAL required_count)
      break()
    endif()
    string(JSON fixture_name GET "${cpu_test}" properties ${required_property} value ${fixture_index})
    if(fixture_name STREQUAL "phase15_fast")
      set(phase15_fixture_index ${fixture_index})
      break()
    endif()
  endforeach()
  if(phase15_fixture_index EQUAL -1)
    message(FATAL_ERROR "phase15-selection-control: clean graph missing phase15 edge")
  endif()
  string(JSON cpu_test REMOVE "${cpu_test}" properties ${required_property} value ${phase15_fixture_index})
  set(missing_edge_json "${clean_graph}")
  string(JSON missing_edge_json SET "${missing_edge_json}" tests ${cpu_index} "${cpu_test}")
  gbl_phase15_validate_order("${missing_edge_json}" reason)
  gbl_phase15_expect_reason("${reason}" missing-predecessor-cpu.ppu.access missing-fixture-edge)

  gbl_phase15_find_test("${clean_graph}" phase15.selection.verify gate_index gate_count)
  if(NOT gate_count EQUAL 1)
    message(FATAL_ERROR "phase15-selection-control: clean graph lacks verify gate")
  endif()
  string(JSON gate_test GET "${clean_graph}" tests ${gate_index})
  string(JSON gate_property_count LENGTH "${gate_test}" properties)
  string(JSON gate_test SET "${gate_test}" properties ${gate_property_count}
    "{\"name\":\"FIXTURES_REQUIRED\",\"value\":[\"phase15_fast\"]}")
  set(cycle_json "${clean_graph}")
  string(JSON cycle_json SET "${cycle_json}" tests ${gate_index} "${gate_test}")
  gbl_phase15_validate_order("${cycle_json}" reason)
  gbl_phase15_expect_reason("${reason}" setup-self-cycle-phase15.selection.verify fixture-cycle)

  gbl_phase15_find_test("${clean_graph}" ppu.refusal semantic_index semantic_count)
  if(NOT semantic_count EQUAL 1)
    message(FATAL_ERROR "phase15-selection-control: clean graph lacks ppu.refusal")
  endif()
  string(JSON semantic_test GET "${clean_graph}" tests ${semantic_index})
  string(JSON semantic_property_count LENGTH "${semantic_test}" properties)
  set(semantic_setup_property -1)
  foreach(property_index RANGE 0 ${semantic_property_count})
    if(property_index EQUAL semantic_property_count)
      break()
    endif()
    string(JSON property_name GET "${semantic_test}" properties ${property_index} name)
    if(property_name STREQUAL "FIXTURES_SETUP")
      set(semantic_setup_property ${property_index})
      break()
    endif()
  endforeach()
  if(semantic_setup_property EQUAL -1)
    string(JSON semantic_test SET "${semantic_test}" properties ${semantic_property_count}
      "{\"name\":\"FIXTURES_SETUP\",\"value\":[\"phase15_fast\"]}")
  else()
    string(JSON semantic_setup_count LENGTH "${semantic_test}" properties ${semantic_setup_property} value)
    set(semantic_setup_json_value "[")
    if(semantic_setup_count GREATER 0)
      math(EXPR semantic_setup_last "${semantic_setup_count} - 1")
      foreach(value_index RANGE 0 ${semantic_setup_last})
        string(JSON fixture_name GET "${semantic_test}" properties ${semantic_setup_property} value ${value_index})
        if(value_index GREATER 0)
          string(APPEND semantic_setup_json_value ",")
        endif()
        string(APPEND semantic_setup_json_value "\"${fixture_name}\"")
      endforeach()
      string(APPEND semantic_setup_json_value ",")
    endif()
    string(APPEND semantic_setup_json_value "\"phase15_fast\"]")
    string(JSON semantic_test SET "${semantic_test}" properties ${semantic_setup_property} value "${semantic_setup_json_value}")
  endif()
  set(semantic_setup_json "${clean_graph}")
  string(JSON semantic_setup_json SET "${semantic_setup_json}" tests ${semantic_index} "${semantic_test}")
  gbl_phase15_validate_order("${semantic_setup_json}" reason)
  gbl_phase15_expect_reason("${reason}" setup-set semantic-test-as-setup)

  set(wrong_lane_root "${scratch_root}/wrong-lane-build")
  file(MAKE_DIRECTORY "${wrong_lane_root}")
  file(READ "${GBL_PHASE15_CACHE}" lane_cache)
  string(REPLACE "GBL_LANE:STRING=${GBL_PHASE15_LANE}"
    "GBL_LANE:STRING=unsupported" lane_cache "${lane_cache}")
  file(WRITE "${wrong_lane_root}/CMakeCache.txt" "${lane_cache}")
  execute_process(
    COMMAND "${CMAKE_PROGRAM}" "-DSRC=${GBL_PHASE15_SRC}"
      "-DBIN=${wrong_lane_root}" -DCASE=verify -P "${GBL_PHASE15_GATE}"
    RESULT_VARIABLE lane_result OUTPUT_VARIABLE lane_output ERROR_VARIABLE lane_error)
  set(lane_combined "${lane_output}${lane_error}")
  string(FIND "${lane_combined}" "unsupported-lane-unsupported" lane_marker)
  if("${lane_result}" STREQUAL "0" OR lane_marker EQUAL -1)
    message(FATAL_ERROR "phase15-selection-control: wrong-lane-not-causal\n${lane_combined}")
  endif()
  message(STATUS "phase15-selection-control: wrong-lane: causal rejection passed")
  file(REMOVE_RECURSE "${scratch_root}")
  message(STATUS "phase15-selection-control: clean twin and selection/property/inventory mutants passed")
endfunction()

if(CASE STREQUAL "manifest")
  list(LENGTH GBL_PHASE15_EXPECTED count)
  message("phase15-manifest-count=${count}")
  message("phase15-manifest-regex=${GBL_PHASE15_REGEX}")
  foreach(name IN LISTS GBL_PHASE15_EXPECTED)
    message("phase15-manifest-name=${name}")
  endforeach()
elseif(CASE STREQUAL "verify")
  foreach(lane IN ITEMS ci asan)
    gbl_phase15_check_inventory("${GBL_PHASE15_SRC}/tests/inventory/${lane}.txt" reason)
    if(NOT "${reason}" STREQUAL "")
      message(FATAL_ERROR "phase15-selection: ${lane}-${reason}")
    endif()
  endforeach()
  gbl_phase15_discover("${GBL_PHASE15_BIN}" "${GBL_PHASE15_REGEX}" selected_json)
  gbl_phase15_validate_selection("${selected_json}" selection_reason)
  if(NOT "${selection_reason}" STREQUAL "")
    message(FATAL_ERROR "phase15-selection: ${selection_reason}")
  endif()
  gbl_phase15_discover("${GBL_PHASE15_BIN}"
    "^phase15[.]selection[.](control|verify|order)$" gate_json)
  gbl_phase15_validate_gate_registrations("${gate_json}" gate_reason)
  if(NOT "${gate_reason}" STREQUAL "")
    message(FATAL_ERROR "phase15-selection: ${gate_reason}")
  endif()
  message(STATUS "phase15-selection: exact 11-selector manifest and inventories passed")
elseif(CASE STREQUAL "control")
  gbl_phase15_check_controls()
elseif(CASE STREQUAL "order")
  gbl_phase15_check_order()
else()
  message(FATAL_ERROR "phase15-selection: invalid-case")
endif()
