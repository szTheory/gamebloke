  message(FATAL_ERROR "phase15-selection: build-source-missing")
endif()
string(REGEX REPLACE "^CMAKE_HOME_DIRECTORY:INTERNAL=" ""
  GBL_PHASE15_CACHE_SOURCE "${GBL_PHASE15_CACHE_HOME}")
file(REAL_PATH "${GBL_PHASE15_CACHE_SOURCE}" GBL_PHASE15_CACHE_SOURCE)
