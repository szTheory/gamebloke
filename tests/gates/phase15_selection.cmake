    NOT IS_DIRECTORY "${GBL_PHASE15_BIN}")
  message(FATAL_ERROR "phase15-selection: source-or-build-directory-missing")
endif()
if(NOT EXISTS "${GBL_PHASE15_CACHE}")
  message(FATAL_ERROR "phase15-selection: build-cache-missing")
endif()
file(REAL_PATH "${GBL_PHASE15_ROOT}" GBL_PHASE15_ROOT)
file(STRINGS "${GBL_PHASE15_CACHE}" GBL_PHASE15_CACHE_HOME
