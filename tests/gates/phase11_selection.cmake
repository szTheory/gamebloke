cmake_minimum_required(VERSION 3.25)

foreach(required IN ITEMS SRC BIN CASE)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "phase11-selection: missing-${required}")
  endif()
endforeach()
if(NOT CASE MATCHES "^(verify|control|order)$")
  message(FATAL_ERROR "phase11-selection: invalid-case")
endif()

get_filename_component(GBL_PHASE11_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)
get_filename_component(GBL_PHASE11_SRC "${SRC}" REALPATH
  BASE_DIR "${GBL_PHASE11_ROOT}")
get_filename_component(GBL_PHASE11_BIN "${BIN}" REALPATH
  BASE_DIR "${CMAKE_BINARY_DIR}")
set(GBL_PHASE11_CACHE "${GBL_PHASE11_BIN}/CMakeCache.txt")
if(NOT IS_DIRECTORY "${GBL_PHASE11_ROOT}" OR
    NOT IS_DIRECTORY "${GBL_PHASE11_BIN}")
  message(FATAL_ERROR "phase11-selection: source-or-build-directory-missing")
endif()
if(NOT EXISTS "${GBL_PHASE11_CACHE}")
  message(FATAL_ERROR "phase11-selection: build-cache-missing")
endif()
file(REAL_PATH "${GBL_PHASE11_ROOT}" GBL_PHASE11_ROOT)
if(NOT GBL_PHASE11_SRC STREQUAL GBL_PHASE11_ROOT)
  message(FATAL_ERROR "phase11-selection: source-build-mismatch")
endif()
file(STRINGS "${GBL_PHASE11_CACHE}" GBL_PHASE11_CACHE_HOME
  REGEX "^CMAKE_HOME_DIRECTORY:INTERNAL=")
list(LENGTH GBL_PHASE11_CACHE_HOME GBL_PHASE11_CACHE_HOME_COUNT)
if(NOT GBL_PHASE11_CACHE_HOME_COUNT EQUAL 1)
  message(FATAL_ERROR "phase11-selection: build-source-missing")
endif()
string(REGEX REPLACE "^CMAKE_HOME_DIRECTORY:INTERNAL=" ""
  GBL_PHASE11_CACHE_SOURCE "${GBL_PHASE11_CACHE_HOME}")
file(REAL_PATH "${GBL_PHASE11_CACHE_SOURCE}" GBL_PHASE11_CACHE_SOURCE)
if(NOT GBL_PHASE11_CACHE_SOURCE STREQUAL GBL_PHASE11_SRC)
  message(FATAL_ERROR "phase11-selection: source-build-mismatch")
endif()
set(GBL_PHASE11_GATE "${GBL_PHASE11_SRC}/tests/gates/phase11_selection.cmake")
file(REAL_PATH "${GBL_PHASE11_GATE}" GBL_PHASE11_GATE)
file(REAL_PATH "${CMAKE_CURRENT_LIST_FILE}" GBL_PHASE11_CURRENT_GATE)
if(NOT GBL_PHASE11_CURRENT_GATE STREQUAL GBL_PHASE11_GATE)
  message(FATAL_ERROR "phase11-selection: script-source-mismatch")
endif()

find_program(CTEST_PROGRAM NAMES ctest REQUIRED)
find_program(CMAKE_PROGRAM NAMES cmake REQUIRED)
file(STRINGS "${GBL_PHASE11_CACHE}" GBL_PHASE11_LANE_LINE
  REGEX "^GBL_LANE:STRING=")
string(REPLACE "GBL_LANE:STRING=" "" GBL_PHASE11_LANE
  "${GBL_PHASE11_LANE_LINE}")

# This is the bounded Phase 11 cheap set. The profile contract controls only
# exist in CI; ASan keeps its own lane-specific inventory.
set(GBL_PHASE11_EXPECTED
  ppu.latch
  ppu.registers
  ppu.refusal
  phase11.selection.control)
if(GBL_PHASE11_LANE STREQUAL "ci")
  list(APPEND GBL_PHASE11_EXPECTED profile.lint profile.nc.ppu_policy)
elseif(NOT GBL_PHASE11_LANE STREQUAL "asan")
  message(FATAL_ERROR "phase11-selection: unsupported-lane-${GBL_PHASE11_LANE}")
endif()
set(GBL_PHASE11_REGEX
  "^(ppu[.](latch|registers|refusal)|phase11[.]selection[.]control|profile[.](lint|nc[.]ppu_policy))$")
set(GBL_PHASE11_INVENTORY_ROWS
  "phase11.selection.control gate,ppu,time"
  "phase11.selection.order gate,ppu,time"
  "phase11.selection.verify gate,ppu,time")

function(gbl_phase11_json_property json index wanted property_out found_out)
  set(found FALSE)
  set(value)
  string(JSON property_count ERROR_VARIABLE property_error LENGTH
    "${json}" tests ${index} properties)
  if(NOT "${property_error}" STREQUAL "NOTFOUND")
    set(${property_out} "" PARENT_SCOPE)
    set(${found_out} FALSE PARENT_SCOPE)
    return()
  endif()
  if(property_count GREATER 0)
    math(EXPR property_last "${property_count} - 1")
    foreach(property_index RANGE 0 ${property_last})
      string(JSON property_name GET "${json}" tests ${index}
        properties ${property_index} name)
      if(NOT property_name STREQUAL wanted)
        continue()
      endif()
      string(JSON value_type TYPE "${json}" tests ${index}
        properties ${property_index} value)
      if(value_type STREQUAL "ARRAY")
        string(JSON value_count LENGTH "${json}" tests ${index}
          properties ${property_index} value)
        if(value_count GREATER 0)
          math(EXPR value_last "${value_count} - 1")
          foreach(value_index RANGE 0 ${value_last})
            string(JSON item GET "${json}" tests ${index}
              properties ${property_index} value ${value_index})
            list(APPEND value "${item}")
          endforeach()
        endif()
      elseif(value_type STREQUAL "STRING" OR value_type STREQUAL "BOOLEAN")
        string(JSON value GET "${json}" tests ${index}
          properties ${property_index} value)
      endif()
      set(found TRUE)
      break()
    endforeach()
  endif()
  set(${property_out} "${value}" PARENT_SCOPE)
  set(${found_out} "${found}" PARENT_SCOPE)
endfunction()

function(gbl_phase11_find_test json wanted index_out count_out)
  set(found_index -1)
  set(found_count 0)
  string(JSON count ERROR_VARIABLE error LENGTH "${json}" tests)
  if("${error}" STREQUAL "NOTFOUND" AND count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
      string(JSON name GET "${json}" tests ${index} name)
      if(name STREQUAL wanted)
        math(EXPR found_count "${found_count} + 1")
        set(found_index ${index})
      endif()
    endforeach()
  endif()
  set(${index_out} "${found_index}" PARENT_SCOPE)
  set(${count_out} "${found_count}" PARENT_SCOPE)
endfunction()

function(gbl_phase11_expected_command name json index reason_out)
  string(JSON command_count ERROR_VARIABLE command_error LENGTH
    "${json}" tests ${index} command)
  if(NOT "${command_error}" STREQUAL "NOTFOUND" OR command_count LESS 1)
    set(${reason_out} wrong-command PARENT_SCOPE)
    return()
  endif()
  string(JSON program GET "${json}" tests ${index} command 0)
  file(REAL_PATH "${program}" actual_program)
  file(REAL_PATH "${CMAKE_COMMAND}" cmake_program)
  if(name MATCHES "^ppu[.]")
    set(expected_program "${GBL_PHASE11_BIN}/bus_test${CMAKE_EXECUTABLE_SUFFIX}")
    file(REAL_PATH "${expected_program}" expected_program)
    string(JSON argument GET "${json}" tests ${index} command 1)
    if(NOT actual_program STREQUAL expected_program OR
        NOT command_count EQUAL 2 OR NOT argument STREQUAL name)
      set(${reason_out} wrong-command PARENT_SCOPE)
      return()
    endif()
  elseif(name MATCHES "^phase11[.]selection[.](control|verify|order)$")
    if(NOT actual_program STREQUAL cmake_program OR NOT command_count EQUAL 6)
      set(${reason_out} wrong-command PARENT_SCOPE)
      return()
    endif()
    if(name STREQUAL "phase11.selection.control")
      set(expected_case control)
    elseif(name STREQUAL "phase11.selection.order")
      set(expected_case order)
    else()
      set(expected_case verify)
    endif()
    set(expected_args
      "-DSRC=${GBL_PHASE11_SRC}" "-DBIN=${GBL_PHASE11_BIN}"
      "-DCASE=${expected_case}" -P "${GBL_PHASE11_GATE}")
    foreach(command_index RANGE 1 5)
      string(JSON actual_arg GET "${json}" tests ${index} command ${command_index})
      math(EXPR expected_index "${command_index} - 1")
      list(GET expected_args ${expected_index} expected_arg)
      if(NOT actual_arg STREQUAL expected_arg)
        set(${reason_out} wrong-command PARENT_SCOPE)
        return()
      endif()
    endforeach()
  elseif(name STREQUAL "profile.lint")
    set(expected_program "${CMAKE_COMMAND}")
    file(REAL_PATH "${expected_program}" expected_program)
    set(expected_args
      "-DPROFILE=${GBL_PHASE11_SRC}/profiles/agb.json"
      "-DDOC=${GBL_PHASE11_SRC}/docs/profile-agb.md"
      "-DREGISTRY=${GBL_PHASE11_SRC}/registry/disputes.json"
      "-DVOCAB=${GBL_PHASE11_SRC}/contracts/evidence.json"
      -P "${GBL_PHASE11_SRC}/cmake/CheckProfile.cmake")
    if(NOT actual_program STREQUAL expected_program OR NOT command_count EQUAL 7)
      set(${reason_out} wrong-command PARENT_SCOPE)
      return()
    endif()
    foreach(command_index RANGE 1 6)
      string(JSON actual_arg GET "${json}" tests ${index} command ${command_index})
      math(EXPR expected_index "${command_index} - 1")
      list(GET expected_args ${expected_index} expected_arg)
      if(NOT actual_arg STREQUAL expected_arg)
        set(${reason_out} wrong-command PARENT_SCOPE)
        return()
      endif()
    endforeach()
  elseif(name STREQUAL "profile.nc.ppu_policy")
    if(NOT actual_program STREQUAL cmake_program OR NOT command_count EQUAL 6)
      set(${reason_out} wrong-command PARENT_SCOPE)
      return()
    endif()
    set(expected_args
      "-DSRC=${GBL_PHASE11_SRC}" "-DBIN=${GBL_PHASE11_BIN}"
      -DCASE=ppu_policy -P "${GBL_PHASE11_SRC}/tests/gates/profile_case.cmake")
    foreach(command_index RANGE 1 5)
      string(JSON actual_arg GET "${json}" tests ${index} command ${command_index})
      math(EXPR expected_index "${command_index} - 1")
      list(GET expected_args ${expected_index} expected_arg)
      if(NOT actual_arg STREQUAL expected_arg)
        set(${reason_out} wrong-command PARENT_SCOPE)
        return()
      endif()
    endforeach()
  else()
    set(${reason_out} wrong-command PARENT_SCOPE)
    return()
  endif()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase11_validate_selection json reason_out)
  string(JSON kind ERROR_VARIABLE kind_error GET "${json}" kind)
  string(JSON count ERROR_VARIABLE count_error LENGTH "${json}" tests)
  if(NOT "${kind_error}" STREQUAL "NOTFOUND" OR NOT kind STREQUAL "ctestInfo" OR
      NOT "${count_error}" STREQUAL "NOTFOUND")
    set(${reason_out} malformed PARENT_SCOPE)
    return()
  endif()
  list(LENGTH GBL_PHASE11_EXPECTED expected_count)
  if(NOT count EQUAL expected_count)
    set(${reason_out} selection-count PARENT_SCOPE)
    return()
  endif()
  set(actual_names)
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    string(JSON name ERROR_VARIABLE name_error GET "${json}" tests ${index} name)
    if(NOT "${name_error}" STREQUAL "NOTFOUND" OR "${name}" STREQUAL "")
      set(${reason_out} malformed PARENT_SCOPE)
      return()
    endif()
    if(name IN_LIST actual_names)
      set(${reason_out} duplicate-selector PARENT_SCOPE)
      return()
    endif()
    list(APPEND actual_names "${name}")
  endforeach()
  foreach(expected IN LISTS GBL_PHASE11_EXPECTED)
    if(NOT expected IN_LIST actual_names)
      set(${reason_out} missing-selector PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(index RANGE 0 ${last})
    string(JSON name GET "${json}" tests ${index} name)
    gbl_phase11_expected_command("${name}" "${json}" ${index} command_reason)
    if(NOT "${command_reason}" STREQUAL "")
      set(${reason_out} "${command_reason}" PARENT_SCOPE)
      return()
    endif()
    gbl_phase11_json_property("${json}" ${index} LABELS labels has_labels)
    if(NOT has_labels)
      set(${reason_out} wrong-label PARENT_SCOPE)
      return()
    endif()
    if(name MATCHES "^ppu[.]")
      set(expected_labels bus core ppu unit)
    elseif(name STREQUAL "phase11.selection.control")
      set(expected_labels gate ppu time)
    elseif(name STREQUAL "profile.lint")
      set(expected_labels gate profile)
    elseif(name STREQUAL "profile.nc.ppu_policy")
      set(expected_labels control profile)
    endif()
    set(actual_labels ${labels})
    list(SORT actual_labels)
    list(SORT expected_labels)
    if(NOT "${actual_labels}" STREQUAL "${expected_labels}")
      set(${reason_out} wrong-label PARENT_SCOPE)
      return()
    endif()
    gbl_phase11_json_property("${json}" ${index} WORKING_DIRECTORY
      working_directory has_working_directory)
    if(NOT has_working_directory)
      set(${reason_out} wrong-root PARENT_SCOPE)
      return()
    endif()
    file(REAL_PATH "${working_directory}" working_directory_real)
    if(NOT working_directory_real STREQUAL GBL_PHASE11_BIN)
      set(${reason_out} wrong-root PARENT_SCOPE)
      return()
    endif()
    gbl_phase11_json_property("${json}" ${index} SKIP_REGULAR_EXPRESSION
      skip_expression has_skip_expression)
    if(has_skip_expression)
      set(${reason_out} skippable PARENT_SCOPE)
      return()
    endif()
    gbl_phase11_json_property("${json}" ${index} DISABLED disabled has_disabled)
    if(has_disabled AND disabled)
      set(${reason_out} disabled PARENT_SCOPE)
      return()
    endif()
    gbl_phase11_json_property("${json}" ${index} FIXTURES_SETUP setup has_setup)
    if(NOT has_setup OR NOT "phase11_fast" IN_LIST setup)
      set(${reason_out} setup-set PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

function(gbl_phase11_discover build_dir regex output_var)
  execute_process(
    COMMAND "${CTEST_PROGRAM}" --test-dir "${build_dir}" --show-only=json-v1
      --fixture-exclude-any "^(phase7_fast|phase8_fast|phase9_fast|phase10_fast)$"
      -R "${regex}"
    RESULT_VARIABLE result OUTPUT_VARIABLE json ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "phase11-selection: discovery-failed: ${result}\n${error}")
  endif()
  set(${output_var} "${json}" PARENT_SCOPE)
endfunction()

function(gbl_phase11_check_inventory path lane reason_out)
  if(NOT EXISTS "${path}")
    set(${reason_out} inventory-missing PARENT_SCOPE)
    return()
  endif()
  file(STRINGS "${path}" rows)
  set(sorted_rows ${rows})
  list(SORT sorted_rows)
  if(NOT "${rows}" STREQUAL "${sorted_rows}")
    set(${reason_out} inventory-unsorted PARENT_SCOPE)
    return()
  endif()
  foreach(expected_row IN LISTS GBL_PHASE11_INVENTORY_ROWS)
    string(REGEX MATCH "^([^ ]+)" name "${expected_row}")
    string(REPLACE "." "[.]" name_regex "${name}")
    file(STRINGS "${path}" matching_rows REGEX "^${name_regex} ")
    list(LENGTH matching_rows row_count)
    if(NOT row_count EQUAL 1)
      set(${reason_out} "inventory-${name}-count-${row_count}" PARENT_SCOPE)
      return()
    endif()
    list(GET matching_rows 0 actual_row)
    if(NOT actual_row STREQUAL expected_row)
      set(${reason_out} "inventory-${name}-labels" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  if(lane STREQUAL "asan")
    file(STRINGS "${path}" profile_rows REGEX "^profile[.]lint |^profile[.]nc[.]ppu_policy ")
    if(profile_rows)
      set(${reason_out} asan-invented-profile-gate PARENT_SCOPE)
      return()
    endif()
  endif()
  set(${reason_out} "" PARENT_SCOPE)
endfunction()

if(CASE STREQUAL "verify")
  foreach(lane IN ITEMS ci asan)
    gbl_phase11_check_inventory(
      "${GBL_PHASE11_SRC}/tests/inventory/${lane}.txt" "${lane}" inventory_reason)
    if(NOT "${inventory_reason}" STREQUAL "")
      message(FATAL_ERROR "phase11-selection: ${lane}-${inventory_reason}")
    endif()
  endforeach()
  gbl_phase11_discover("${GBL_PHASE11_BIN}" "${GBL_PHASE11_REGEX}" selected_json)
  gbl_phase11_validate_selection("${selected_json}" selection_reason)
  if(NOT "${selection_reason}" STREQUAL "")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "TAP version 13")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "1..1")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo
      "not ok 1 - exact Phase 11 cheap selector fixture membership")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo
      "# observed ${selection_reason}; expected the exact lane set to set up phase11_fast")
    message(FATAL_ERROR "phase11-selection: ${selection_reason}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "TAP version 13")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "1..1")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo
    "ok 1 - exact Phase 11 cheap selector fixture membership")
  message(STATUS "phase11-selection: exact cheap selector set passed")
elseif(CASE STREQUAL "control")
  message(FATAL_ERROR "phase11-selection: controls-not-implemented")
else()
  message(FATAL_ERROR "phase11-selection: order-not-implemented")
endif()
