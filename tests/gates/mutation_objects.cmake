# Build-local preparation for the existing semantic mutation controls. This is
# not a persistent cache: every normal build prepares a fresh, instrumented set.
function(gbl__mutation_identity output)
  file(REAL_PATH "${COMPILER}" compiler_path)
  file(SHA256 "${compiler_path}" compiler_sha)
  set(material "${compiler_path}|${compiler_sha}|${COMPILER_ID}|${VERSION}|${C_FLAGS}|${C_FLAGS_CONFIG}|${LINKER_FLAGS}|${LINKER_FLAGS_CONFIG}")
  foreach(input IN ITEMS tests/gates/core_mutation.cmake
      tests/gates/mutation_objects.cmake src/version.c src/machine.c src/bus.c
      src/loader.c src/cpu.c src/inspect.c src/logo_sha256.h src/cpu_helpers.h
      include/gamebloke/gamebloke.h tests/check.h tests/state_check.h
      tests/bus_test.c tests/loader_test.c tests/cpu_test.c)
    file(SHA256 "${SRC}/${input}" sha)
    string(APPEND material "|${input}=${sha}")
  endforeach()
  string(SHA256 identity "${material}")
  set(${output} "${identity}" PARENT_SCOPE)
endfunction()

function(gbl__mutation_reuse_controls)
  foreach(control IN ITEMS flags source header)
    execute_process(COMMAND "${CMAKE_COMMAND}"
      "-DSRC=${SRC}" "-DBIN=${BIN}" -DCASE=reuse-control -DSELECTOR=all
      "-DCONTROL=${control}" "-DPREPARED_ROOT=${PREPARED_ROOT}"
      "-DCOMPILER=${COMPILER}" "-DCOMPILER_ID=${COMPILER_ID}"
      "-DC_FLAGS=${C_FLAGS}" "-DC_FLAGS_CONFIG=${C_FLAGS_CONFIG}"
      "-DLINKER_FLAGS=${LINKER_FLAGS}" "-DLINKER_FLAGS_CONFIG=${LINKER_FLAGS_CONFIG}"
      "-DVERSION=${VERSION}" -P "${SRC}/tests/gates/core_mutation.cmake"
      RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(control STREQUAL "flags")
      set(reason reuse-identity-mismatch)
    else()
      set(reason reuse-input-mismatch)
    endif()
    if(rc STREQUAL "0" OR NOT "${out}${err}" MATCHES "mutation: ${reason}")
      message(FATAL_ERROR "mutation: reuse-control-missed:${control}:${out}${err}")
    endif()
    message(STATUS "mutation: reuse refused changed ${control} before compilation")
  endforeach()
endfunction()

function(gbl__mutation_sources family output)
  set(sources src/version.c src/machine.c src/bus.c src/loader.c src/cpu.c)
  if(family STREQUAL "cpu")
    list(APPEND sources src/inspect.c)
  endif()
  list(APPEND sources "tests/${family}_test.c")
  set(${output} "${sources}" PARENT_SCOPE)
endfunction()

function(gbl__prepare_mutation_objects)
  set(root "${BIN}/mutation-objects")
  file(REMOVE_RECURSE "${root}")
  foreach(family IN ITEMS bus loader cpu)
    set(sandbox "${root}/${family}/inputs")
    if(family STREQUAL "bus")
      gbl__copy_inputs("${sandbox}")
    elseif(family STREQUAL "loader")
      gbl__copy_loader_inputs("${sandbox}")
    else()
      gbl__copy_cpu_inputs("${sandbox}")
    endif()
    gbl__mutation_sources("${family}" sources)
    foreach(source IN LISTS sources)
      string(REPLACE "/" "_" key "${source}")
      gbl__compile_cpu_object("${sandbox}" "${source}" "${root}/${family}" "${key}" object)
      file(SHA256 "${object}" sha)
      file(WRITE "${object}.sha256" "${sha}")
    endforeach()
  endforeach()
  gbl__mutation_identity(identity)
  file(WRITE "${root}/identity.txt" "${identity}")
  message(STATUS "mutation: prepared fresh objects with the exact control compiler and flags")
endfunction()

# Returns false only when no preparation was requested (standalone script use).
# A stale prepared set is an explicit failure, never semantic mutation evidence.
function(gbl__reuse_mutation_objects sandbox family changed_source output used)
  if(NOT DEFINED PREPARED_ROOT OR PREPARED_ROOT STREQUAL "")
    set(${used} FALSE PARENT_SCOPE)
    return()
  endif()
  gbl__mutation_identity(identity)
  if(NOT EXISTS "${PREPARED_ROOT}/identity.txt")
    message(FATAL_ERROR "mutation: reuse-identity-missing")
  endif()
  file(READ "${PREPARED_ROOT}/identity.txt" prepared_identity)
  if(NOT identity STREQUAL prepared_identity)
    message(FATAL_ERROR "mutation: reuse-identity-mismatch")
  endif()
  set(clean "${PREPARED_ROOT}/${family}/inputs")
  file(GLOB_RECURSE inputs RELATIVE "${sandbox}" "${sandbox}/*")
  file(GLOB_RECURSE prepared_inputs RELATIVE "${clean}" "${clean}/*")
  list(SORT inputs)
  list(SORT prepared_inputs)
  if(NOT inputs STREQUAL prepared_inputs)
    message(FATAL_ERROR "mutation: reuse-input-set-mismatch")
  endif()
  foreach(input IN LISTS inputs)
    file(SHA256 "${sandbox}/${input}" actual)
    file(SHA256 "${clean}/${input}" expected)
    if(input STREQUAL changed_source)
      if(actual STREQUAL expected)
        message(FATAL_ERROR "mutation: reuse-mutation-missing:${input}")
      endif()
    elseif(NOT actual STREQUAL expected)
      message(FATAL_ERROR "mutation: reuse-input-mismatch:${input}")
    endif()
  endforeach()
  gbl__mutation_sources("${family}" sources)
  set(objects "")
  foreach(source IN LISTS sources)
    string(REPLACE "/" "_" key "${source}")
    set(object "${PREPARED_ROOT}/${family}/${key}.o")
    file(SHA256 "${object}" actual)
    file(READ "${object}.sha256" expected)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "mutation: reuse-object-mismatch:${source}")
    endif()
    if(source STREQUAL changed_source)
      gbl__compile_cpu_object("${sandbox}" "${source}" "${sandbox}/objects" "${key}" object)
    endif()
    list(APPEND objects "${object}")
  endforeach()
  gbl__link_cpu("${sandbox}" "${sandbox}/objects" "${family}" "${objects}" executable)
  message(STATUS "mutation: exact prepared inputs verified for ${family}; changed=${changed_source}")
  set(${output} "${executable}" PARENT_SCOPE)
  set(${used} TRUE PARENT_SCOPE)
endfunction()
