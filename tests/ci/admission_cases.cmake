cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS SRC BIN)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "ci-admission-controls: missing-${required}")
  endif()
endforeach()
get_filename_component(SRC "${SRC}" ABSOLUTE)
get_filename_component(BIN "${BIN}" ABSOLUTE)
file(MAKE_DIRECTORY "${BIN}")
file(READ "${SRC}/CMakePresets.json" original)
function(check label presets expected)
  file(WRITE "${BIN}/${label}.json" "${presets}")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DSRC=${SRC}"
    "-DPRESETS=${BIN}/${label}.json" -P "${SRC}/cmake/CiPreflight.cmake"
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  file(WRITE "${BIN}/${label}.log" "${output}${error}")
  if(expected STREQUAL "pass")
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "ci-admission-controls: clean-failed:${output}${error}")
    endif()
  elseif(rc STREQUAL "0" OR NOT "${output}${error}" MATCHES "${expected}")
    message(FATAL_ERROR "ci-admission-controls: missed:${label}:${output}${error}")
  endif()
endfunction()
check(clean "${original}" pass)
string(JSON count LENGTH "${original}" configurePresets)
math(EXPR last "${count} - 1")
foreach(i RANGE 0 ${last})
  string(JSON name GET "${original}" configurePresets ${i} name)
  if(name MATCHES "^(ci|asan|diagnostics|diagnostics-arm|diagnostics-thumb)$")
    string(JSON changed SET "${original}" configurePresets ${i} cacheVariables GBL_DIAGNOSTIC_STAGE "\"proof\"")
    check("proof-${name}" "${changed}" "preset-admission-required:${name}")
    string(JSON changed REMOVE "${original}" configurePresets ${i} cacheVariables GBL_DIAGNOSTIC_STAGE)
    check("missing-${name}" "${changed}" "preset-admission-required:${name}")
  endif()
endforeach()
string(REPLACE "\"GBL_DIAGNOSTIC_STAGE\": \"admitted\""
  "\"GBL_DIAGNOSTIC_STAGE\": \"proof\", \"GBL_DIAGNOSTIC_STAGE\": \"admitted\""
  duplicate "${original}")
check(duplicate-stage "${duplicate}" "json: duplicate-key")
message(STATUS "ci-admission-controls: clean plus five proof and five missing-stage refusals passed")
