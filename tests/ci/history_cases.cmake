cmake_minimum_required(VERSION 3.25)
# Local pre-publication check: real independent full/shallow Git clones. No
# hosted request, installed tools, guest execution or changed producer input.
foreach(required IN ITEMS SRC BIN)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "ci-history-controls: missing-${required}")
  endif()
endforeach()
get_filename_component(SRC "${SRC}" ABSOLUTE)
get_filename_component(BIN "${BIN}" ABSOLUTE)
include("${SRC}/cmake/PathContainment.cmake")
gbl_resolve_contained_path(safe status "${SRC}/build" "${BIN}")
if(NOT status STREQUAL "ok" OR BIN STREQUAL "${SRC}/build" OR EXISTS "${BIN}")
  message(FATAL_ERROR "ci-history-controls: fresh-contained-root-required")
endif()
file(MAKE_DIRECTORY "${BIN}")
set(overlays CMakePresets.json cmake/CiPreflight.cmake tests/toolchain.cmake
  tests/ci/admission_cases.cmake tests/ci/preflight_cases.cmake tests/ci/ci_cases.cmake
  scripts/check-workflow.sh .github/workflows/ci.yml)
foreach(kind IN ITEMS full shallow)
  set(extra --no-local)
  if(kind STREQUAL "shallow")
    set(extra --depth=1)
  endif()
  execute_process(COMMAND git clone --quiet ${extra} "file://${SRC}" "${BIN}/${kind}"
    RESULT_VARIABLE rc ERROR_VARIABLE error)
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "ci-history-controls: clone-failed:${error}")
  endif()
  foreach(path IN LISTS overlays)
    file(COPY_FILE "${SRC}/${path}" "${BIN}/${kind}/${path}")
  endforeach()
  execute_process(COMMAND git -C "${BIN}/${kind}" rev-parse --is-shallow-repository
    OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE)
  if((kind STREQUAL "full" AND NOT actual STREQUAL "false") OR
      (kind STREQUAL "shallow" AND NOT actual STREQUAL "true"))
    message(FATAL_ERROR "ci-history-controls: wrong-clone-kind")
  endif()
endforeach()
function(configure kind lane stage expected)
  set(source "${BIN}/${kind}")
  set(tool_root "${source}/build/absent")
  if(kind STREQUAL "full" AND lane MATCHES "^diagnostics")
    set(tool_root "${SRC}/build/toolchains")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env CI=false
    "${CMAKE_COMMAND}" --preset "${lane}" -S "${source}"
    -B "${source}/build/${lane}-${stage}" "-DGBL_DIAGNOSTIC_STAGE=${stage}"
    "-DCMAKE_C_COMPILER=/usr/bin/clang" "-DGBL_TOOLCHAIN_ROOT=${tool_root}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  file(WRITE "${BIN}/${kind}-${lane}-${stage}.log" "${output}${error}")
  if(expected STREQUAL "pass")
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "ci-history-controls: clean-failed:${kind}:${lane}:${output}${error}")
    endif()
  elseif(rc STREQUAL "0" OR NOT "${output}${error}" MATCHES "${expected}" OR
      "${output}${error}" MATCHES "C compiler identification")
    message(FATAL_ERROR "ci-history-controls: missed:${kind}:${lane}:${output}${error}")
  endif()
endfunction()
foreach(lane IN ITEMS ci asan)
  configure(full "${lane}" admitted pass)
  configure(shallow "${lane}" admitted admitted-full-history-required)
endforeach()
foreach(lane IN ITEMS diagnostics diagnostics-arm diagnostics-thumb)
  configure(full "${lane}" admitted pass)
endforeach()
configure(shallow diagnostics admitted admitted-full-history-required)
configure(full diagnostics proof required-proof-stage-forbidden)
configure(shallow ci proof pass)
message(STATUS "ci-history-controls: full ci/asan configured; shallow admitted refused before compiler discovery; explicit optional developer proof configured")
